export module render.context;
import std;
import toy;

import render.resource;
import render.device;
import render.instance;
import render.surface;
import render.executor;
import render.image;
import render.framebuffer;
import input;
import glfw;

export namespace rd {

class Context : public toy::ProactiveSingleton<Context> {
public:
  Context(const std::string& app_name, uint32 width, uint32 height);

  // private:
  std::unique_ptr<glfw::Context>         _glfw_ctx;
  std::unique_ptr<glfw::Window>          _glfw_window;
  std::unique_ptr<input::InputProcessor> _input_processor;

  std::unique_ptr<InstanceResource>       _instance;
  std::unique_ptr<rs::Surface>            _surface;
  std::unique_ptr<Device>                 _device;
  std::unique_ptr<CommandExecutorManager> _command_executor_manager;
  std::unique_ptr<ImageContext>           _image_context;
  std::unique_ptr<FramebufferPool>        _framebuffer_pool;
};

} // namespace rd
