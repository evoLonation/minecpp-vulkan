module;
#include <toy.h>
export module render.vk.image;

import std;
import toy;

import <vulkan_config.h>;
import render.vk.resource;
import render.vk.memory;
import render.vk.tracker;

export namespace rd::vk {

struct MipRange {
  uint32 base_level;
  uint32 count;
};

auto getSubresourceRange(VkImageAspectFlags aspect, MipRange mip_range) -> VkImageSubresourceRange;

auto getSubresourceLayers(VkImageAspectFlags aspect, uint32 mip_level) -> VkImageSubresourceLayers;

auto createImage(
  VkFormat              format,
  uint32                width,
  uint32                height,
  VkImageUsageFlags     usage,
  uint32                mip_levels,
  VkSampleCountFlagBits sample_count
) -> rs::Image;

auto createImageView(VkImage image, VkFormat format, VkImageAspectFlags aspect, uint32 mip_levels)
  -> rs::ImageView;

class ImageContext : public toy::ProactiveSingleton<ImageContext> {
public:
  ImageContext();
  auto getAvailableSampleCounts() -> VkSampleCountFlags { return _available_sample_counts; }

private:
  VkSampleCountFlags _available_sample_counts;
};

class ImageManager {
public:
  ImageManager(VkImage image, VkImageView image_view, VkImageSubresourceRange sub_range)
    : _image(image), _image_view(image_view), _tracker(image, sub_range) {}

  auto getImage() -> VkImage { return _image; }
  auto getImageView() -> VkImageView { return _image_view; }
  auto getTracker() -> ImageBarrierTracker& { return _tracker; }

private:
  VkImage             _image;
  VkImageView         _image_view;
  ImageBarrierTracker _tracker;
};

struct ImageResource {
public:
  ImageResource(
    VkFormat              format,
    uint32                width,
    uint32                height,
    VkImageUsageFlags     usage,
    VkImageAspectFlags    aspect,
    uint32                mip_levels,
    VkSampleCountFlagBits sample_count
  )
    : _image(createImage(
        format,
        width,
        height,
        usage,
        mip_levels,
        [&]() {
          TOY_ASSERT(
            (ImageContext::getInstance().getAvailableSampleCounts() & sample_count) > 0,
            sample_count
          );
          return sample_count;
        }()
      )),
      _memory(_image, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT),
      _image_view(createImageView(_image, format, aspect, mip_levels)) {}

protected:
  rs::Image     _image;
  Memory        _memory;
  rs::ImageView _image_view;
};

struct Image : public ImageResource, public ImageManager {
public:
  Image(
    VkFormat              format,
    uint32                width,
    uint32                height,
    VkImageUsageFlags     usage,
    VkImageAspectFlags    aspect,
    uint32                mip_levels,
    VkSampleCountFlagBits sample_count
  )
    : ImageResource(format, width, height, usage, aspect, mip_levels, sample_count),
      ImageManager(
        ImageResource::_image,
        ImageResource::_image_view,
        getSubresourceRange(aspect, MipRange{ 0, 1 })
      ) {}
};

void copyBufferToImage(
  VkCommandBuffer       cmdbuf,
  VkBuffer              buffer,
  VkImage               image,
  VkImageAspectFlagBits aspect,
  uint32                width,
  uint32                height,
  uint32                mip_level
);

struct ImageBlit {
  VkImage               image;
  VkImageAspectFlagBits aspect;
  VkImageLayout         layout;
  uint32                mip_level;
  VkExtent2D            extent;
};

void blitImage(VkCommandBuffer cmdbuf, ImageBlit src, ImageBlit dst);

auto computeMipExtents(VkExtent2D extent) -> std::vector<VkExtent2D>;

} // namespace rd::vk