module;
#include <toy.h>
export module render.vk.descriptor;
import std;
import toy;

import render.vk.resource;
import render.vk.executor;
import render.vk.device;
import render.vk.tracker;
import render.vk.sync;

import <vulkan_config.h>;

export namespace rd::vk {

class DescriptorSetLayout : public rs::DescriptorSetLayout {
public:
  struct BindingInfo {
    VkDescriptorType   type;
    VkShaderStageFlags stage;
    uint32             count;
  };
  DescriptorSetLayout(std::vector<BindingInfo> infos) : _infos(std::move(infos)) {
    auto bindings = std::vector<VkDescriptorSetLayoutBinding>{};
    for (auto [index, info] : _infos | toy::enumerate) {
      bindings.push_back(VkDescriptorSetLayoutBinding{
        .binding = index,
        .descriptorType = info.type,
        .descriptorCount = info.count,
        .stageFlags = info.stage,
        .pImmutableSamplers = nullptr,
      });
    }
    rs::DescriptorSetLayout::operator=(VkDescriptorSetLayoutCreateInfo{
      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
      .bindingCount = static_cast<uint32>(_infos.size()),
      .pBindings = bindings.data(),
    });
  }
  auto getInfo() const -> std::span<BindingInfo const> { return _infos; }

private:
  std::vector<BindingInfo> _infos;
};

/**
 * @brief when consumed by some batch, need add the waitable to dset and call waitIdle to
 * wait all batches to execution done
 * note: can not destruct when has valid handle, need recycled by pool
 *
 * @param waitable
 * @return auto
 */
class DescriptorSet : toy::AutoMoveAssigner<DescriptorSet>, public rs::DescriptorSet {
public:
  DescriptorSet(rs::DescriptorSet dset, DescriptorSetLayout* layout)
    : rs::DescriptorSet{ std::move(dset) }, _layout{ layout } {}

  void addWaitable(std::shared_ptr<Waitable> waitable) {
    removeIdles();
    _waitables.push_back(std::move(waitable));
  }
  auto waitIdle(uint64 nano_timeout = TimelineSemaphore::max_timeout) -> bool {
    auto res = Waitable::wait(
      _waitables | views::transform([](auto& w) {
        return std::pair{ w.get(), VkPipelineStageFlags2{ VK_PIPELINE_STAGE_ALL_COMMANDS_BIT } };
      }) |
        ranges::to<std::vector>(),
      false,
      nano_timeout
    );
    if (res) {
      _waitables.clear();
    } else {
      removeIdles();
    }
    return res;
  }
  auto getInfo() -> std::span<DescriptorSetLayout::BindingInfo const> { return _layout->getInfo(); }

  auto valid() const -> bool { return get(); }

  ~DescriptorSet() { beforeDestroy(); }
  DEFAULT_MOVEABLE(DescriptorSet);

private:
  DescriptorSetLayout* _layout;

  std::vector<std::shared_ptr<Waitable>> _waitables;

  void removeIdles() {
    auto new_end = std::remove_if(_waitables.begin(), _waitables.end(), [](auto& w) {
      return w->wait(VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0);
    });
    _waitables.erase(new_end, _waitables.end());
  }

  friend toy::AutoMoveAssigner<DescriptorSet>;
  void beforeDestroy() {
    if (valid()) {
      waitIdle();
    }
  }
};

class DescriptorPool : public toy::ObjectPoolHelper<DescriptorPool, DescriptorSet>,
                       public DescriptorSetLayout {
public:
  using Base = toy::ObjectPoolHelper<DescriptorPool, DescriptorSet>;
  friend Base;
  DescriptorPool(std::vector<BindingInfo> infos) : Base{}, DescriptorSetLayout(std::move(infos)) {
    _pool_sizes = getInfo() | views::transform([](auto info) {
                    return VkDescriptorPoolSize{
                      .type = info.type,
                      .descriptorCount = info.count,
                    };
                  }) |
                  ranges::to<std::vector>();
    for (auto& pool_size : _pool_sizes) {
      pool_size.descriptorCount *= _allocate_count;
    }
    _pool_info = {
      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
      .maxSets = _allocate_count,
      .poolSizeCount = static_cast<uint32>(_pool_sizes.size()),
      .pPoolSizes = _pool_sizes.data(),
    };
    _dset_layouts.append_range(views::repeat(get()) | views::take(_allocate_count));
  }

  UNCOPYABLE_MOVEABLE(DescriptorPool);

  void recycle(DescriptorSet dset) { _working_resources.push_back(std::move(dset)); }

private:
  std::set<std::pair<size_t, VkDescriptorPool>, std::greater<>> _pool_counts;
  using PoolResource = std::pair<rs::DescriptorPool, rs::DescriptorSets>;
  std::unordered_map<VkDescriptorPool, PoolResource> _resources;
  std::vector<DescriptorSet>                         _working_resources;

  // used for create resources
  VkDescriptorPoolCreateInfo _pool_info;
  // all the same
  std::vector<VkDescriptorSetLayout> _dset_layouts;
  std::vector<VkDescriptorPoolSize>  _pool_sizes;

  static constexpr auto _allocate_count = 5;

  auto extract() -> DescriptorSet {
    auto  pool_handle = _pool_counts.extract(_pool_counts.begin()).value().second;
    auto& dsets = _resources.at(pool_handle).second;
    auto  dset = dsets.exit();
    _pool_counts.emplace(dsets.size(), dsets.getPool());
    return { std::move(dset), this };
  }

  auto isEmpty() -> bool { return _pool_counts.empty() || _pool_counts.begin()->first == 0; }

  void expand() {
    auto pool = rs::DescriptorPool{ _pool_info };
    auto dsets = rs::DescriptorSets{ VkDescriptorSetAllocateInfo{
      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
      .descriptorPool = pool,
      .descriptorSetCount = static_cast<uint32_t>(_dset_layouts.size()),
      .pSetLayouts = _dset_layouts.data(),
    } };
    auto handle = pool.get();
    _pool_counts.emplace(_allocate_count, handle);
    _resources.emplace(handle, std::pair{ std::move(pool), std::move(dsets) });
  }

  void tryShrink() {
    auto idle_pool_num = 3;
    if (_pool_counts.size() <= idle_pool_num) {
      return;
    }
    auto iter = _pool_counts.begin();
    std::advance(iter, idle_pool_num);
    while (iter != _pool_counts.end() && iter->first == _allocate_count) {
      _resources.extract(iter->second);
      iter = _pool_counts.erase(iter);
    }
  }

  void workingToIdle() {
    auto new_end =
      std::remove_if(_working_resources.begin(), _working_resources.end(), [](auto& dset) {
        return dset.waitIdle(0);
      });
    for (auto& dset : ranges::subrange{ new_end, _working_resources.end() }) {
      auto& dsets = _resources.at(dset.getPool()).second;
      _pool_counts.extract(std::pair{ dsets.size(), dsets.getPool() });
      dsets.join(std::move(dset));
      _pool_counts.emplace(dsets.size(), dsets.getPool());
    }
    _working_resources.erase(new_end, _working_resources.end());
  }
};

struct DescriptorResource {
  struct ImageContext {
    VkDescriptorImageInfo dscriptor_info;
    ImageBarrierTracker*  tracker;
  };
  struct BufferContext {
    VkDescriptorBufferInfo dscriptor_info;
    BufferBarrierTracker*  tracker;
  };
  using Context = std::variant<BufferContext, ImageContext>;
  virtual auto getDescriptorContext() -> Context = 0;
};

struct ResourceBinding {
  ResourceBinding(std::initializer_list<DescriptorResource*> resources) : resources{ resources } {}
  ResourceBinding(DescriptorResource* resource) : resources{ resource } {}
  std::vector<DescriptorResource*> resources;
};

class ResourceSet : public toy::RecyclableObject<DescriptorPool, DescriptorSet> {
private:
  using Base = toy::RecyclableObject<DescriptorPool, DescriptorSet>;

public:
  ResourceSet(DescriptorPool* pool, std::initializer_list<ResourceBinding> bindings)
    : Base{ pool } {
    auto write_infos = std::vector<VkWriteDescriptorSet>{};
    auto all_image_infos = std::vector<std::vector<VkDescriptorImageInfo>>{};
    auto all_buffer_infos = std::vector<std::vector<VkDescriptorBufferInfo>>{};
    for (auto [binding_i, binding] : bindings | toy::enumerate) {
      for (auto [array_i, resource] : binding.resources | toy::enumerate) {
        _resources.push_back({ binding_i, array_i, resource });
      }
      auto resource_ctxs = std::vector<DescriptorResource::Context>{};
      for (auto* r : binding.resources) {
        resource_ctxs.push_back(r->getDescriptorContext());
      }
      auto write_info = VkWriteDescriptorSet{
        .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
        .dstSet = get(),
        .dstBinding = binding_i,
        // 数组起始索引
        .dstArrayElement = 0,
        .descriptorCount = static_cast<uint32>(resource_ctxs.size()),
        .descriptorType = pool->getInfo()[binding_i].type,
      };
      using BufferContext = DescriptorResource::BufferContext;
      using ImageContext = DescriptorResource::ImageContext;
      if (ranges::all_of(resource_ctxs, [](auto& x) {
            return std::holds_alternative<BufferContext>(x);
          })) {
        auto buffer_infos = std::vector<VkDescriptorBufferInfo>{};
        for (auto& ctx : resource_ctxs) {
          buffer_infos.push_back(std::get<BufferContext>(ctx).dscriptor_info);
        }
        write_info.pBufferInfo = buffer_infos.data();
        all_buffer_infos.push_back(std::move(buffer_infos));
      } else if (ranges::all_of(resource_ctxs, [](auto& x) {
                   return std::holds_alternative<ImageContext>(x);
                 })) {
        auto image_infos = std::vector<VkDescriptorImageInfo>{};
        for (auto& ctx : resource_ctxs) {
          image_infos.push_back(std::get<ImageContext>(ctx).dscriptor_info);
        }
        write_info.pImageInfo = image_infos.data();
        all_image_infos.push_back(std::move(image_infos));
      } else {
        toy::throwf("different resource type in same binding");
      }
      write_infos.push_back(write_info);
    }
    vkUpdateDescriptorSets(
      Device::getInstance(), write_infos.size(), write_infos.data(), 0, nullptr
    );
  }
  struct ResourceInfo {
    uint32              binding_i;
    uint32              array_i;
    DescriptorResource* resource;
  };
  auto getResources() const -> std::span<ResourceInfo const> { return _resources; }

private:
  std::vector<ResourceInfo> _resources;
};

} // namespace rd::vk