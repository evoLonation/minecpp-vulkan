module;
#include <toy.h>

export module render.vk.render_pass2;

import <vulkan_config.h>;
import render.vk.resource;
import render.vk.buffer;
import render.vk.descriptor;
import render.vk.pipeline;
import render.vk.framebuffer;
import render.vertex;

import std;
import toy;

export namespace rd::vk {

struct AttachmentInfo {
  AttachmentFormat      format;
  VkSampleCountFlagBits sample_count;
  bool                  keep_old_content;
  bool                  keep_new_content;
};

struct SubpassInfo {
  // if resolves has value, every color attachment in colors must has the same sample_count
  std::vector<uint32> colors;
  struct MultiSample {
    // size must equal to colors
    std::vector<std::optional<uint32>> resolves;
    // must not sample_1
    VkSampleCountFlagBits sample_count;
  };
  std::optional<MultiSample> multi_sample;
  std::optional<uint32>      depst;
  std::vector<uint32>        inputs;
};
struct AttachmentSyncInfo {
  VkPipelineStageFlagBits2 initial_stage;
  VkPipelineStageFlagBits2 final_stage;
  VkImageLayout            initial_layout;
  VkImageLayout            final_layout;
};
auto createRenderPass(
  std::span<AttachmentInfo const> attachments, std::span<SubpassInfo const> subpasses
) -> std::pair<rs::RenderPass, std::vector<AttachmentSyncInfo>>;

struct SubpassPipelineInfo {
  std::vector<uint32>                     colors;
  std::vector<uint32>                     inputs;
  std::optional<SubpassInfo::MultiSample> multi_sample;
  struct DepthStencil {
    uint32 attachment;
    // if has value, depth_option and stencil_option is used depend on attachment format
    DepthOption   depth_option;
    StencilOption stencil_option;
  };
  std::optional<DepthStencil>        depst;
  std::string                        vertex_shader_name;
  std::string                        frag_shader_name;
  VkPrimitiveTopology                topology;
  VertexInfo                         vertex_info;
  std::vector<VkDescriptorSetLayout> dset_layouts;
};

class RenderPass : public rs::RenderPass {
public:
  RenderPass(
    std::span<AttachmentInfo const> attachments, std::span<SubpassPipelineInfo const> subpasses
  );

  struct PipelineResource {
    rs::ShaderModule   vertex_shader;
    rs::ShaderModule   frag_shader;
    rs::PipelineLayout layout;
    rs::Pipeline       pipeline;
  };
  auto getPipelines() const -> std::span<PipelineResource const> { return _pipelines; }
  auto getSyncInfos() const -> std::span<AttachmentSyncInfo const> { return _attachment_syncs; }

private:
  std::vector<AttachmentSyncInfo> _attachment_syncs;
  std::vector<PipelineResource>   _pipelines;
};

// todo: change to abstract class
class PipelineDrawer {
public:
  static auto forRecord(
    VkCommandBuffer cmdbuf, VkPipeline pipeline, VkPipelineLayout layout, VkExtent2D extent
  ) -> PipelineDrawer;
  static auto forGetResources(VkPipeline pipeline, VkPipelineLayout layout, VkExtent2D extent)
    -> PipelineDrawer;

  void bindVertexBuffer(VertexBuffer* vertex_buffer);
  void bindIndexBuffer(IndexBuffer* index_buffer);
  void bindResourceSet(uint32 index, ResourceSet* resource_set);
  void draw();

  auto getVertexBuffers() -> std::span<Buffer* const> { return _vertex_buffers; }
  auto getIndexBuffers() -> std::span<Buffer* const> { return _index_buffers; }
  auto getResourceSets() -> std::span<ResourceSet* const> { return _resource_sets; }

private:
  enum ExecuteType {
    RECORD,
    GET_RESOURCES,
  };
  PipelineDrawer(
    VkCommandBuffer  cmdbuf,
    VkPipeline       pipeline,
    VkPipelineLayout layout,
    VkExtent2D       extent,
    ExecuteType      execute_type
  )
    : _cmdbuf(cmdbuf), _pipeline(pipeline), _layout(layout), _extent(extent), _index_count(0),
      _execute_type(execute_type) {}

  VkCommandBuffer  _cmdbuf;
  VkPipeline       _pipeline;
  VkPipelineLayout _layout;
  VkExtent2D       _extent;
  uint32           _index_count;

  ExecuteType _execute_type;

  std::vector<Buffer*>      _vertex_buffers;
  std::vector<Buffer*>      _index_buffers;
  std::vector<ResourceSet*> _resource_sets;
};

using PipelineDrawRecorder = std::function<void(PipelineDrawer)>;

struct RenderPassDrawInfo {
  VkRenderPass              render_pass;
  VkFramebuffer             framebuffer;
  std::vector<VkClearValue> clear_values;
  VkExtent2D                extent;
  struct PipelineDrawInfo {
    VkPipeline           pipeline;
    VkPipelineLayout     layout;
    PipelineDrawRecorder recorder;
  };
  std::vector<PipelineDrawInfo> pipeline_infos;
};

void recordRenderPassDraw(VkCommandBuffer cmdbuf, RenderPassDrawInfo info);

class RenderPassManager : public RenderPass {
public:
  RenderPassManager(
    std::span<AttachmentInfo const> attachments, std::span<SubpassPipelineInfo const> subpasses
  )
    : RenderPass(attachments, subpasses) {
    _recorders.resize(subpasses.size());
  }

  void setRecorder(uint32 index, PipelineDrawRecorder recorder) {
    _recorders[index] = std::move(recorder);
  }
  void recordDraw(
    std::span<FrameImageManager*> images, std::vector<VkClearValue> clear_values, VkExtent2D extent
  );

private:
  std::vector<PipelineDrawRecorder> _recorders;
};

} // namespace rd::vk