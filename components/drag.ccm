module;
#include <toy.h>
export module drag;

import std;
import toy;

import framework;
import math;

import glm;

import render;

export namespace drag {

auto cursor2Plane(
  uint32           pos_x,
  uint32           pos_y,
  const glm::mat4& perspective_iv,
  const glm::mat4& view,
  const glm::mat4& model
) -> std::optional<glm::mat4> {
  auto extent = rd::Presentation::getInstance().getSwapchain().getExtent();
  auto ndc_x = float(pos_x) / extent.width * 2 - 1;
  auto ndc_y = float(pos_y) / extent.height * 2 - 1;
  auto start = glm::vec3{ ndc_x, ndc_y, -1.0f };
  auto end = glm::vec3{ ndc_x, ndc_y, 1.0f };
  start = mt::transformDot(mt::inverse(model) * mt::inverse(view) * perspective_iv, start);
  end = mt::transformDot(mt::inverse(model) * mt::inverse(view) * perspective_iv, end);
  auto inter = mt::intersection(
    mt::Line{
      .direction = end - start,
      .point = start,
    },
    mt::Surface{
      .normal = glm::vec3{ 1.0f, 0.0f, 0.0f },
      .dot = 0.0f,
    }
  );
  if (inter.index() == 0) {
    auto inter_point = std::get<0>(inter);
    if (glm::dot(inter_point - start, inter_point - end) < 0) {
      // toy::debug(std::tuple{ inter_point.x, inter_point.y, inter_point.z });
      return model * mt::translate(inter_point);
    }
  }
  return std::nullopt;
}

class CursorDragger : private fw::Action {
private:
  glm::mat4        _perspective_iv;
  const glm::mat4* _view_trans;
  glm::mat4*       _model_trans;

public:
  CursorDragger(const glm::mat4* view_trans, glm::mat4* model_trans)
    : fw::Action(fw::Stage::BEFORE_RENDER), _view_trans(view_trans), _model_trans(model_trans) {
    auto extent = rd::Presentation::getInstance().getSwapchain().getExtent();
    _perspective_iv =
      mt::proj::perspectiveInverse({ .width = extent.width, .height = extent.height });
  }
  void runLoop(const fw::ActionContext& ctx) override {
    if (ctx.recreated) {
      auto extent = rd::Presentation::getInstance().getSwapchain().getExtent();
      _perspective_iv =
        mt::proj::perspectiveInverse({ .width = extent.width, .height = extent.height });
    }
    auto& cursor = fw::InputProcessor::getInstance().getCursorState();
    if (cursor.visible) {
      if (auto opt =
            cursor2Plane(cursor.x, cursor.y, _perspective_iv, *_view_trans, *_model_trans)) {
        *_model_trans = opt.value();
      }
    }
  }
};

} // namespace drag