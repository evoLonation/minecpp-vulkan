module;
#include <toy.h>
export module tool.move;

import std;
import toy;
import glm;
import loop;
import render;
import pipeline.basic;
import transform;
import pipeline.uniform;

export namespace tool {

using Vertex = pl::ColorVertex;

const auto cube_vertices = std::array{
  Vertex{ glm::vec3{ 0.0f, 0.0f, 0.0f } }, Vertex{ glm::vec3{ 0.0f, 0.0f, 1.0f } },
  Vertex{ glm::vec3{ 0.0f, 1.0f, 1.0f } }, Vertex{ glm::vec3{ 0.0f, 1.0f, 0.0f } },
  Vertex{ glm::vec3{ 1.0f, 0.0f, 0.0f } }, Vertex{ glm::vec3{ 1.0f, 0.0f, 1.0f } },
  Vertex{ glm::vec3{ 1.0f, 1.0f, 1.0f } }, Vertex{ glm::vec3{ 1.0f, 1.0f, 0.0f } },
};
const auto cube_index = std::array<uint16, 36>{
  0, 1, 2, 2, 3, 0, 4, 7, 6, 6, 5, 4, 1, 5, 6, 6, 2, 1,
  0, 3, 7, 7, 4, 0, 7, 3, 2, 2, 6, 7, 5, 1, 0, 0, 4, 5,
};

auto generateCone(float radius = 1.0f, float height = 2.0f)
  -> std::pair<std::vector<glm::vec3>, std::vector<uint16>> {
  auto bottom_split_num = 40;
  auto vertices = std::vector<glm::vec3>{};
  auto indices = std::vector<uint16>{};
  vertices.push_back(glm::vec3{ 0.0f, 0.0f, 0.0f });
  vertices.push_back(glm::vec3{ 0.0f, 0.0f, height });
  for (auto i : views::iota(0, bottom_split_num)) {
    auto x = radius * glm::cos(glm::radians(360.0f * i / bottom_split_num));
    auto y = radius * glm::sin(glm::radians(360.0f * i / bottom_split_num));
    vertices.push_back(glm::vec3{ x, y, 0.0f });
    indices.push_back(0);
    indices.push_back((i + 1) % bottom_split_num + 2);
    indices.push_back(i + 2);
    indices.push_back(1);
    indices.push_back(i + 2);
    indices.push_back((i + 1) % bottom_split_num + 2);
  }
  return { std::move(vertices), std::move(indices) };
}

auto generateCylinder(float radius = 1.0f, float height = 2.0f)
  -> std::pair<std::vector<glm::vec3>, std::vector<uint16>> {
  auto bottom_split_num = 40;
  auto vertices = std::vector<glm::vec3>{};
  auto indices = std::vector<uint16>{};
  vertices.push_back(glm::vec3{ 0, 0, 0 });
  for (auto i : views::iota(0, bottom_split_num)) {
    auto x = radius * glm::cos(glm::radians(360.0f * i / bottom_split_num));
    auto y = radius * glm::sin(glm::radians(360.0f * i / bottom_split_num));
    vertices.push_back(glm::vec3{ x, y, 0 });
    indices.push_back(0);
    auto offset = 1;
    indices.push_back(offset + (i + 1) % bottom_split_num);
    indices.push_back(offset + i);
  }
  vertices.push_back(glm::vec3{ 0, 0, height });
  for (auto i : views::iota(0, bottom_split_num)) {
    auto x = radius * glm::cos(glm::radians(360.0f * i / bottom_split_num));
    auto y = radius * glm::sin(glm::radians(360.0f * i / bottom_split_num));
    vertices.push_back(glm::vec3{ x, y, height });
    indices.push_back(bottom_split_num + 1);
    auto offset = bottom_split_num + 2;
    indices.push_back(offset + i);
    indices.push_back(offset + (i + 1) % bottom_split_num);
  }
  for (auto i : views::iota(0, bottom_split_num)) {
    auto offset_0 = 1;
    auto offset_1 = bottom_split_num + 2;
    indices.push_back(offset_1 + i);
    indices.push_back(offset_0 + i);
    indices.push_back(offset_0 + (i + 1) % bottom_split_num);
    indices.push_back(offset_0 + (i + 1) % bottom_split_num);
    indices.push_back(offset_1 + (i + 1) % bottom_split_num);
    indices.push_back(offset_1 + i);
  }
  return { std::move(vertices), std::move(indices) };
}

auto generateSphere(float radius = 1.0f) -> std::pair<std::vector<glm::vec3>, std::vector<uint16>> {
  // v: 纬度, u: 经度
  // x = r * cos(u) * sin(v)
  // y = r * sin(u) * sin(v)
  // z = r * cos(v)
  auto split_num = 40;
  auto vertices = std::vector<glm::vec3>{};
  // 维度 major
  for (int i = 0; i < split_num; i++) {
    auto u = glm::radians(360.0f * i / split_num);
    for (int j = 0; j < split_num; j++) {
      auto v = glm::radians(180.0f * j / split_num);
      auto x = radius * glm::cos(u) * glm::sin(v);
      auto y = radius * glm::sin(u) * glm::sin(v);
      auto z = radius * glm::cos(v);
      vertices.push_back(glm::vec3{ x, y, z });
    }
  }
  auto indices = std::vector<uint16>{};
  for (int i = 0; i < split_num; i++) {
    for (int j = 0; j < split_num - 1; j++) {
      indices.push_back(i * split_num + j);
      indices.push_back(i * split_num + j + 1);
      indices.push_back((i + 1) % split_num * split_num + j + 1);
      indices.push_back((i + 1) % split_num * split_num + j + 1);
      indices.push_back((i + 1) % split_num * split_num + j);
      indices.push_back(i * split_num + j);
    }
  }
  return { std::move(vertices), std::move(indices) };
}

auto generateArrow() -> std::pair<std::vector<glm::vec3>, std::vector<uint16>> {
  auto vertices = std::vector<glm::vec3>{};
  auto indices = std::vector<uint16>{};
  auto [cone_vertices, cone_indices] = generateCone(0.1, 0.4);
  auto [cylinder_vertices, cylinder_indices] = generateCylinder(0.05, 1);
  auto model_trans = trans::translate(glm::vec3{ 0, 0, 1.0 });
  cone_vertices = cone_vertices |
                  views::transform([&](auto& vec) { return trans::transform(model_trans, vec); }) |
                  ranges::to<std::vector>();
  vertices.append_range(cone_vertices);
  indices.append_range(cone_indices);
  vertices.append_range(cylinder_vertices);
  indices.append_range(cylinder_indices | views::transform([delta = cone_vertices.size()](auto& i) {
                         return i + delta;
                       }));
  return { vertices, indices };
}

auto generateAxis() -> std::pair<std::vector<Vertex>, std::vector<uint16>> {
  auto vertices = std::vector<Vertex>{};
  auto indices = std::vector<uint16>{};
  auto [arrow_vertices, arrow_indices] = generateArrow();
  using trans::Axis;
  indices.append_range(arrow_indices);
  indices.append_range(arrow_indices | views::transform([delta = arrow_vertices.size()](auto& i) {
                         return i + delta;
                       }));
  indices.append_range(
    arrow_indices |
    views::transform([delta = arrow_vertices.size() * 2](auto& i) { return i + delta; })
  );
  // x axis
  vertices.append_range(arrow_vertices | views::transform([&](auto& vec) {
                          return trans::transform(trans::rotate<Axis::Y>(90), vec);
                        }));
  // y axis
  vertices.append_range(arrow_vertices | views::transform([&](auto& vec) {
                          return trans::transform(trans::rotate<Axis::X>(-90), vec);
                        }));
  // z axis
  vertices.append_range(arrow_vertices);
  return { vertices, indices };
}

template <bool is_line = false>
using BasicColorUnit = std::conditional_t<is_line, pl::BasicColorLineUnit, pl::BasicColorUnit>;

template <bool is_line = false>
class SimpleShapeTemp : public BasicColorUnit<is_line> {
public:
  SimpleShapeTemp() = default;
  SimpleShapeTemp(
    auto&& vertices, auto&& indices, glm::vec3 const& location = glm::vec3{ 0.0f, 0.0f, 0.0f }
  ) {
    set(FORWARD(vertices), FORWARD(indices), location);
  }
  SimpleShapeTemp(auto&& vertices, glm::vec3 const& location = glm::vec3{ 0.0f, 0.0f, 0.0f }) {
    set(FORWARD(vertices), location);
  }
  void set(
    auto&& vertices, auto&& indices, glm::vec3 const& location = glm::vec3{ 0.0f, 0.0f, 0.0f }
  ) {
    _uniform_model = trans::model::create(location);
    _vertex_buf = { FORWARD(vertices) };
    _index_buf = { FORWARD(indices) };
    _uniform_color = glm::vec3{ 0.7f, 0.2f, 0.5f };
    // self reference, so can not directly move
    BasicColorUnit<is_line>::operator=(
      { &_vertex_buf, &_index_buf, { &_uniform_model, &_uniform_color } }
    );
  }
  void set(auto&& vertices, glm::vec3 const& location = glm::vec3{ 0.0f, 0.0f, 0.0f }) {
    _uniform_model = trans::model::create(location);
    _vertex_buf = { FORWARD(vertices) };
    _uniform_color = glm::vec3{ 0.7f, 0.2f, 0.5f };
    // self reference, so can not directly move
    BasicColorUnit<is_line>::operator=(
      { &_vertex_buf, nullptr, { &_uniform_model, &_uniform_color } }
    );
  }
  auto getModelTrans() -> glm::mat4& { return _uniform_model; }
  auto getColor() -> glm::vec3& { return _uniform_color; }

  UNCOPYABLE_MOVEABLE(SimpleShapeTemp);

private:
  rd::VertexBuffer                   _vertex_buf;
  rd::IndexBuffer                    _index_buf;
  pl::UniformBuffer<rd::align::mat4> _uniform_model;
  pl::UniformBuffer<rd::align::vec3> _uniform_color;
};

using SimpleShape = SimpleShapeTemp<false>;
using SimpleShapeLine = SimpleShapeTemp<true>;

class Cone : public SimpleShape {
public:
  Cone(glm::vec3 const& location = glm::vec3{ 0.0f, 0.0f, 0.0f }) {
    auto [vertices, indices] = generateCone();
    set(std::move(vertices), std::move(indices), location);
  }
};

class Cube : public SimpleShape {
public:
  Cube(glm::vec3 const& location = glm::vec3{ 0.0f, 0.0f, 0.0f })
    : SimpleShape{ cube_vertices, cube_index, location } {}
};

class Sphere : public SimpleShape {
public:
  Sphere(glm::vec3 const& location = glm::vec3{ 0.0f, 0.0f, 0.0f }) {
    auto [vertices, indices] = generateSphere();
    set(std::move(vertices), std::move(indices), location);
  }
};

class Cylinder : public SimpleShape {
public:
  Cylinder(glm::vec3 const& location = glm::vec3{ 0.0f, 0.0f, 0.0f }) {
    auto [vertices, indices] = generateCylinder();
    set(std::move(vertices), std::move(indices), location);
  }
};

class Arrow : public SimpleShape {
public:
  Arrow(glm::vec3 const& location = glm::vec3{ 0.0f, 0.0f, 0.0f }) {
    auto [vertices, indices] = generateArrow();
    set(std::move(vertices), std::move(indices), location);
  }
};

class Axis : public SimpleShape {
public:
  Axis(glm::vec3 const& location = glm::vec3{ 0.0f, 0.0f, 0.0f }) {
    auto [vertices, indices] = generateAxis();
    toy::debug(indices);
    set(std::move(vertices), std::move(indices), location);
  }
};

} // namespace tool
