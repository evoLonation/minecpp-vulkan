export namespace cp {

class MovePlane {
public:
  MovePlane() = default;
  MovePlane(mt::Axis normal_axis, SceneComponent* component) {
    _component = component;
    auto normal = mt::unitVec(normal_axis);
    auto cube = SceneComponent{ createShape(generateCube(), glm::vec3{ 0.5, 0.5, 0.5 }) };
    cube.getTransform().scale_factor =
      glm::vec3{ 1, 1, 1 } - normal * (1 - _thickness) - (glm::vec3{ 1, 1, 1 } - normal) * _edge;
    cube.getTransform().location = -normal * (_thickness / 2);

    auto unit_2 = mt::unitVec(mt::Axis(((int)normal_axis + 2) % 3));
    auto unit_1 = mt::unitVec(mt::Axis(((int)normal_axis + 1) % 3));
    auto edge_1 = SceneComponent{ createShape(generateCylinder(_thickness / 2, _edge), unit_1) };
    if (auto cross = glm::cross(glm::vec3{ 0, 0, 1 }, unit_1);
        !mt::eq(cross, glm::vec3{ 0, 0, 0 })) {
      edge_1.getTransform().rotate(cross, 90);
    }
    edge_1.getTransform().translate(unit_2 * _edge);
    auto edge_2 = SceneComponent{ createShape(generateCylinder(_thickness / 2, _edge), unit_2) };
    if (auto cross = glm::cross(glm::vec3{ 0, 0, 1 }, unit_2);
        !mt::eq(cross, glm::vec3{ 0, 0, 0 })) {
      edge_2.getTransform().rotate(cross, 90);
    }
    edge_2.getTransform().translate(unit_1 * _edge);

    cube.getObject().setUplayer();
    edge_1.getObject().setUplayer();
    edge_2.getObject().setUplayer();
    _component->addSubcomponent(std::move(cube));
    _component->addSubcomponent(std::move(edge_1));
    _component->addSubcomponent(std::move(edge_2));
  }
  auto isSelected() -> bool {
    return ranges::find_if(_component->getSubComponents(), [](auto& c) {
             return c.isSelected();
           }) != _component->getSubComponents().end();
  }
  // todo: set color

private:
  cp::ptr<SceneComponent> _component;

  constexpr static float _thickness = 0.05f;
  constexpr static float _edge = 0.5f;
};

// 1. 监听_component的Transform，如果mode为WORLD，只绑定location，
// 如果mode为LOCAL，绑定location和rotate
// 2. 只对_component的Transform的location进行操作
class MoveController : public cp::Component {
public:
  MoveController() = default;
  // must is root component
  MoveController(SceneComponent* component) {
    setStage(fw::Stage::BEFORE_RENDER);
    TOY_ASSERT(component->isRoot());
    _component = component;
    _root = {};
    _root.getTransform().location = _component->getTransform().location;
    auto x_axis = SceneComponent{};
    _axises[0] = &x_axis;
    x_axis.getTransform().rotate(mt::Axis::Y, 90);
    auto y_axis = SceneComponent{};
    _axises[1] = &y_axis;
    y_axis.getTransform().rotate(mt::Axis::X, -90);
    auto z_axis = SceneComponent{};
    _axises[2] = &z_axis;
    _root.addSubcomponent(std::move(x_axis));
    _root.addSubcomponent(std::move(y_axis));
    _root.addSubcomponent(std::move(z_axis));
    setAxisObject(mt::Axis::X, glm::vec3{ 1, 0, 0 });
    setAxisObject(mt::Axis::Y, glm::vec3{ 0, 1, 0 });
    setAxisObject(mt::Axis::Z, glm::vec3{ 0, 0, 1 });
    auto x_plane = SceneComponent{};
    _planes[0] = MovePlane(mt::Axis::X, &x_plane);
    auto y_plane = SceneComponent{};
    _planes[1] = MovePlane(mt::Axis::Y, &y_plane);
    auto z_plane = SceneComponent{};
    _planes[2] = MovePlane(mt::Axis::Z, &z_plane);
    _root.addSubcomponent(std::move(x_plane));
    _root.addSubcomponent(std::move(y_plane));
    _root.addSubcomponent(std::move(z_plane));
  }

  enum Mode { LOCAL, WORLD };
  Mode mode = WORLD;

private:
  cp::ptr<SceneComponent>                _component;
  SceneComponent                         _root;
  std::array<cp::ptr<SceneComponent>, 3> _axises;
  std::array<MovePlane, 3>               _planes;

  void runLoop(fw::ActionContext const& ctx) override {
    auto& input = fw::InputProcessor::getInstance();
    if (input.getState(fw::Mouse::LEFT)->state == fw::ButtonState::DOWN) {
      auto& x_axis = _root.getSubComponents()[0];
      auto& y_axis = _root.getSubComponents()[1];
      auto& z_axis = _root.getSubComponents()[2];
      auto& x_plane = _planes[0];
      auto& y_plane = _planes[1];
      auto& z_plane = _planes[2];
      if (x_axis.isSelected()) {
        _axis = mt::Axis::X;
      } else if (y_axis.isSelected()) {
        _axis = mt::Axis::Y;
      } else if (z_axis.isSelected()) {
        _axis = mt::Axis::Z;
      } else if (x_plane.isSelected()) {
        _plane = mt::Axis::X;
      } else if (y_plane.isSelected()) {
        _plane = mt::Axis::Y;
      } else if (z_plane.isSelected()) {
        _plane = mt::Axis::Z;
      }
      if (_axis) {
        setAxisObject(*_axis, glm::vec3{ 1, 1, 0 });
        _start_pos = getAxisPos(*_axis);
      } else if (_plane) {
        // todo
        auto ret = getPlanePos(*_plane);
        TOY_ASSERT(ret);
        _start_plane_pos = *ret;
      }
    } else if (input[fw::Mouse::LEFT]->state == fw::ButtonState::RELEASE) {
      if (_axis) {
        setAxisObject(*_axis, mt::unitVec(*_axis));
      } else if (_plane) {
        // todo
      }
      _plane = {};
      _axis = {};
    } else if (_axis) {
      auto now_pos = getAxisPos(*_axis);
      if (glm::abs(now_pos - _start_pos) >= _unit_length) {
        _root.getTransform().translate(*_axis, now_pos - _start_pos);
        _component->getTransform().translate(*_axis, now_pos - _start_pos);
      }
    } else if (_plane) {
      auto ret = getPlanePos(*_plane);
      if (ret) {
        auto now_pos_1 = ret->x;
        auto now_pos_2 = ret->y;
        auto start_pos_1 = _start_plane_pos.x;
        auto start_pos_2 = _start_plane_pos.y;
        if (glm::abs(now_pos_1 - start_pos_1) >= _unit_length ||
            glm::abs(now_pos_2 - start_pos_2) >= _unit_length) {
          _root.getTransform().translate(mt::Axis(((int)*_plane + 1) % 3), now_pos_1 - start_pos_1);
          _root.getTransform().translate(mt::Axis(((int)*_plane + 2) % 3), now_pos_2 - start_pos_2);
          _component->getTransform().translate(
            mt::Axis(((int)*_plane + 1) % 3), now_pos_1 - start_pos_1
          );
          _component->getTransform().translate(
            mt::Axis(((int)*_plane + 2) % 3), now_pos_2 - start_pos_2
          );
        }
      }
    }
  }

  void setAxisObject(mt::Axis axis, glm::vec3 const& color) {
    auto& axis_obj = _axises[(int)axis];
    axis_obj->setObject(createShape(generateArrow(), color));
    axis_obj->getObject().setUplayer();
  }

  auto getAxisPos(mt::Axis axis) -> float {
    auto  cursor = fw::InputProcessor::getInstance().getCursorState();
    auto& camera = camera::Camera::getInstance();
    auto  extent = rd::Presentation::getInstance().getSwapchain().getExtent();
    auto  ndc_x = float(cursor.x) / extent.width * 2 - 1;
    auto  ndc_y = float(cursor.y) / extent.height * 2 - 1;
    auto  start = glm::vec3{ ndc_x, ndc_y, 0 };
    auto  end = glm::vec3{ ndc_x, ndc_y, 1 };
    auto  trans = mt::inverse(camera.getView()) * camera.getProjIV();
    // TOY_DEBUG(trans);
    start = mt::transformDot(trans, start);
    end = mt::transformDot(trans, end);
    auto line_cursor = mt::Line{
      .direction = end - start,
      .point = start,
    };
    auto line_axis = mt::Line{
      .direction = mt::transformVec(_root.getTransToWorld(), mt::unitVec(*_axis)),
      .point = mt::transformDot(_root.getTransToWorld(), glm::vec3{ 0, 0, 0 }),
    };
    // TOY_DEBUG(_root.getTransToWorld());
    // TOY_DEBUG(line_cursor.point, line_cursor.direction);
    // TOY_DEBUG(line_axis.point, line_axis.direction);
    auto ret = mt::distance(line_cursor, line_axis);
    // TOY_DEBUG(ret.distance, ret.point2);
    auto d = glm::dot(ret.point2 - line_axis.point, line_axis.direction);
    // TOY_DEBUG(d);
    return d;
  }
  auto getPlanePos(mt::Axis axis) -> std::optional<glm::vec2> {
    auto  cursor = fw::InputProcessor::getInstance().getCursorState();
    auto& camera = camera::Camera::getInstance();
    auto  extent = rd::Presentation::getInstance().getSwapchain().getExtent();
    auto  ndc_x = float(cursor.x) / extent.width * 2 - 1;
    auto  ndc_y = float(cursor.y) / extent.height * 2 - 1;
    auto  start = glm::vec3{ ndc_x, ndc_y, 0 };
    auto  end = glm::vec3{ ndc_x, ndc_y, 1 };
    auto  trans = mt::inverse(camera.getView()) * camera.getProjIV();
    start = mt::transformDot(trans, start);
    end = mt::transformDot(trans, end);
    auto line_cursor = mt::Line{
      .direction = end - start,
      .point = start,
    };
    auto plane_point = mt::transformDot(_root.getTransToWorld(), glm::vec3{ 0, 0, 0 });
    auto plane = mt::Surface{
      .normal = mt::transformVec(_root.getTransToWorld(), mt::unitVec(axis)),
    };
    plane.dot = glm::dot(plane_point, plane.normal);
    // TOY_DEBUG(plane.normal, plane.dot);
    auto ret = mt::intersection(line_cursor, plane);
    if (std::holds_alternative<glm::vec3>(ret)) {
      auto point = std::get<glm::vec3>(ret) - plane_point;
      // TOY_DEBUG(point);
      auto unit_1 =
        mt::transformVec(_root.getTransToWorld(), mt::unitVec(mt::Axis(((int)axis + 1) % 3)));
      auto unit_2 =
        mt::transformVec(_root.getTransToWorld(), mt::unitVec(mt::Axis(((int)axis + 2) % 3)));
      auto res = glm::vec2{ glm::dot(point, unit_1), glm::dot(point, unit_2) };
      // TOY_DEBUG(glm::vec3{ res, 0 });
      return res;
    }
    return std::nullopt;
  }

  std::optional<mt::Axis> _axis;
  std::optional<mt::Axis> _plane;
  float                   _start_pos;
  glm::vec2               _start_plane_pos;

  float _unit_length = 0.3;
};

class MoveControllerManager : public fw::Action {
public:
  MoveControllerManager() : fw::Action(fw::Stage::BEFORE_RENDER) {}

private:
  void runLoop(fw::ActionContext const& ctx) override {
    if (auto selected = ObjectClickObserver::getInstance().getClick()) {
      if (selected->isRoot()) {
        _controller = selected;
      }
    }
  }
  MoveController _controller;
};

} // namespace cp
