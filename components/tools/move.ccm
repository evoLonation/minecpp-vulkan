export namespace tool {

using Vertex = pl::ColorVertex;

const auto cube_vertices = std::array{
  Vertex{ glm::vec3{ 0.0f, 0.0f, 0.0f } }, Vertex{ glm::vec3{ 0.0f, 0.0f, 1.0f } },
  Vertex{ glm::vec3{ 0.0f, 1.0f, 1.0f } }, Vertex{ glm::vec3{ 0.0f, 1.0f, 0.0f } },
  Vertex{ glm::vec3{ 1.0f, 0.0f, 0.0f } }, Vertex{ glm::vec3{ 1.0f, 0.0f, 1.0f } },
  Vertex{ glm::vec3{ 1.0f, 1.0f, 1.0f } }, Vertex{ glm::vec3{ 1.0f, 1.0f, 0.0f } },
};
const auto cube_index = std::array<uint16, 36>{
  0, 1, 2, 2, 3, 0, 4, 7, 6, 6, 5, 4, 1, 5, 6, 6, 2, 1,
  0, 3, 7, 7, 4, 0, 7, 3, 2, 2, 6, 7, 5, 1, 0, 0, 4, 5,
};

auto generateCone(float radius = 1.0f, float height = 2.0f)
  -> std::pair<std::vector<glm::vec3>, std::vector<uint16>> {
  auto bottom_vertex_num = 40;
  auto vertices = std::vector<glm::vec3>{};
  auto indices = std::vector<uint16>{};
  vertices.push_back(glm::vec3{ 0.0f, 0.0f, 0.0f });
  vertices.push_back(glm::vec3{ 0.0f, 0.0f, height });
  for (auto i : views::iota(0, bottom_vertex_num)) {
    auto x = radius * glm::cos(glm::radians(360.0f * i / bottom_vertex_num));
    auto y = radius * glm::sin(glm::radians(360.0f * i / bottom_vertex_num));
    vertices.push_back(glm::vec3{ x, y, 0.0f });
    indices.push_back(0);
    indices.push_back((i + 1) % bottom_vertex_num + 2);
    indices.push_back(i + 2);
    indices.push_back(1);
    indices.push_back(i + 2);
    indices.push_back((i + 1) % bottom_vertex_num + 2);
  }
  return { std::move(vertices), std::move(indices) };
}

auto generateAxis()
  -> std::pair<std::pair<std::vector<Vertex>, std::vector<uint16>>, std::vector<Vertex>> {
  auto vertices = std::vector<Vertex>{};
  auto indices = std::vector<uint16>{};
  auto [cone_vertices, cone_indices] = generateCone();
  using trans::Axis;
  auto model_trans = trans::model::create(glm::vec3{ 1, 0, 0 }, 0.2) * trans::rotate<Axis::Y>(90) *
                     trans::scale(glm::vec3{ 0.5, 0.5, 1.0 });
  (glm::vec3{ 0.5, 0.5, 1.0 });
  indices.append_range(cone_indices);
  vertices.append_range(cone_vertices | views::transform([&](auto& vec) {
                          return trans::transform(model_trans, vec);
                        }));
  model_trans = trans::model::create(glm::vec3{ 0, 1, 0 }, 0.2) * trans::rotate<Axis::X>(-90) *
                trans::scale(glm::vec3{ 0.5, 0.5, 1.0 });
  indices.append_range(cone_indices | views::transform([delta = vertices.size()](auto& i) {
                         return i + delta;
                       }));
  vertices.append_range(cone_vertices | views::transform([&](auto& vec) {
                          return trans::transform(model_trans, vec);
                        }));
  model_trans =
    trans::model::create(glm::vec3{ 0, 0, 1 }, 0.2) * trans::scale(glm::vec3{ 0.5, 0.5, 1.0 });
  indices.append_range(cone_indices | views::transform([delta = vertices.size()](auto& i) {
                         return i + delta;
                       }));
  vertices.append_range(cone_vertices | views::transform([&](auto& vec) {
                          return trans::transform(model_trans, vec);
                        }));

  auto line_vertices = std::vector<Vertex>{};
  line_vertices.push_back(glm::vec3{ 0, 0, 0 });
  line_vertices.push_back(glm::vec3{ 1, 0, 0 });
  line_vertices.push_back(glm::vec3{ 0, 0, 0 });
  line_vertices.push_back(glm::vec3{ 0, 1, 0 });
  line_vertices.push_back(glm::vec3{ 0, 0, 0 });
  line_vertices.push_back(glm::vec3{ 0, 0, 1 });
  // vertices.append_range(line_vertices);
  // indices.append_range(line_indices);
  // vertices.push_back(glm::vec3{ 0, 0, 0 });
  // vertices.push_back(glm::vec3{ 1, 0, 0 });
  // indices.push_back(vertices.size() - 2);
  // indices.push_back(vertices.size() - 1);
  // indices.push_back(vertices.size() - 2);
  // toy::debug(indices);
  return { { vertices, indices }, line_vertices };
}

template <bool is_line = false>
using BasicColorUnit = std::conditional_t<is_line, pl::BasicColorLineUnit, pl::BasicColorUnit>;

template <bool is_line = false>
class SimpleShapeTemp : public BasicColorUnit<is_line> {
public:
  SimpleShapeTemp() = default;
  SimpleShapeTemp(
    auto&& vertices, auto&& indices, glm::vec3 const& location = glm::vec3{ 0.0f, 0.0f, 0.0f }
  ) {
    set(FORWARD(vertices), FORWARD(indices), location);
  }
  SimpleShapeTemp(auto&& vertices, glm::vec3 const& location = glm::vec3{ 0.0f, 0.0f, 0.0f }) {
    set(FORWARD(vertices), location);
  }
  void set(
    auto&& vertices, auto&& indices, glm::vec3 const& location = glm::vec3{ 0.0f, 0.0f, 0.0f }
  ) {
    _uniform_model = trans::model::create(location);
    _vertex_buf = { FORWARD(vertices) };
    _index_buf = { FORWARD(indices) };
    _uniform_color = glm::vec3{ 0.7f, 0.2f, 0.5f };
    // self reference, so can not directly move
    BasicColorUnit<is_line>::operator=(
      { &_vertex_buf, &_index_buf, { &_uniform_model, &_uniform_color } }
    );
  }
  void set(auto&& vertices, glm::vec3 const& location = glm::vec3{ 0.0f, 0.0f, 0.0f }) {
    _uniform_model = trans::model::create(location);
    _vertex_buf = { FORWARD(vertices) };
    _uniform_color = glm::vec3{ 0.7f, 0.2f, 0.5f };
    // self reference, so can not directly move
    BasicColorUnit<is_line>::operator=(
      { &_vertex_buf, nullptr, { &_uniform_model, &_uniform_color } }
    );
  }
  auto getModelTrans() -> glm::mat4& { return _uniform_model; }
  auto getColor() -> glm::vec3& { return _uniform_color; }

  UNCOPYABLE_MOVEABLE(SimpleShapeTemp);

private:
  rd::VertexBuffer                   _vertex_buf;
  rd::IndexBuffer                    _index_buf;
  pl::UniformBuffer<rd::align::mat4> _uniform_model;
  pl::UniformBuffer<rd::align::vec3> _uniform_color;
};

using SimpleShape = SimpleShapeTemp<false>;
using SimpleShapeLine = SimpleShapeTemp<true>;

class Cone : public SimpleShape {
public:
  Cone(glm::vec3 const& location = glm::vec3{ 0.0f, 0.0f, 0.0f }) {
    auto [vertices, indices] = generateCone();
    set(std::move(vertices), std::move(indices), location);
  }
};

class Cube : public SimpleShape {
public:
  Cube(glm::vec3 const& location = glm::vec3{ 0.0f, 0.0f, 0.0f })
    : SimpleShape{ cube_vertices, cube_index, location } {}
};

class Axis {
public:
  Axis(glm::vec3 const& location = glm::vec3{ 0.0f, 0.0f, 0.0f }) {
    auto [triangle, line_vertices] = generateAxis();
    auto& [vertices, indices] = triangle;
    _triangle.set(std::move(vertices), std::move(indices), location);
    _line.set(std::move(line_vertices), location);
  }

private:
  SimpleShape     _triangle;
  SimpleShapeLine _line;
};

} // namespace tool
