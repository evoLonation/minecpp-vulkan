class DescriptorPools : public PROACTIVE_SINGLETON(DescriptorPools) {
  using BindingInfo = rd::DescriptorSetLayout::BindingInfo;

#define DEFINE_POOL(name, ...)                                                                     \
private:                                                                                           \
  rd::DescriptorPool _dset_pool_##name;                                                            \
                                                                                                   \
public:                                                                                            \
  static auto get##name()->rd::DescriptorPool& {                                                   \
    auto&       instance = DescriptorPools::getInstance();                                         \
    static auto call_once = [&]() -> int {                                                         \
      instance._dset_pool_##name = __VA_ARGS__;                                                    \
      return 0;                                                                                    \
    }();                                                                                           \
    return instance._dset_pool_##name;                                                             \
  }

  DEFINE_POOL(
    Model,
    rd::DescriptorPool{ std::vector{
      BindingInfo{
        .type = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER,
        .stage = VK_SHADER_STAGE_VERTEX_BIT,
        .count = 1,
      },
      BindingInfo{
        .type = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
        .stage = VK_SHADER_STAGE_FRAGMENT_BIT,
        .count = 1,
      },
    } }
  );

  DEFINE_POOL(
    ModelOutline,
    rd::DescriptorPool{ std::vector{ BindingInfo{
      .type = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER,
      .stage = VK_SHADER_STAGE_VERTEX_BIT,
      .count = 1,
    } } }
  );

  DEFINE_POOL(
    Camera,
    rd::DescriptorPool{ std::vector{
      // view
      BindingInfo{
        .type = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER,
        .stage = VK_SHADER_STAGE_VERTEX_BIT,
        .count = 1,
      },
      // projection
      BindingInfo{
        .type = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER,
        .stage = VK_SHADER_STAGE_VERTEX_BIT,
        .count = 1,
      },
    } }
  );

}; // namespace layouts

class DrawUnit : public loop::Action {
public:
  DrawUnit(glm::vec3 const& location = glm::vec3{ 0.0f, 0.0f, 0.0f }) {
    setStage(loop::Stage::BEFORE_RENDER);

    _texture = rd::SampledTexture::create(
      "model/viking_room.png", true, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT
    );
    _model_trans = std::make_unique<glm::mat4>(trans::model::create(location));
    _uniform_model = rd::UniformBuffer<glm::mat4>{ _model_trans.get() };
    _dset_model = rd::ResourceSet{ &DescriptorPools::getModel(), { &_uniform_model, &_texture } };

    _model_trans_outline =
      std::make_unique<glm::mat4>(*_model_trans * trans::scale(glm::vec3{ 1.05f, 1.05f, 1.05f }));
    _uniform_model_outline = rd::UniformBuffer<glm::mat4>{ _model_trans_outline.get() };
    _dset_model_outline =
      rd::ResourceSet{ &DescriptorPools::getModelOutline(), { &_uniform_model_outline } };

    auto [vertexes, indices] = model::getModelInfo("model/viking_room.obj");
    _vertex_buf = rd::VertexBuffer{ vertexes };
    _index_buf = rd::IndexBuffer{ indices };
  }

  auto getModelTrans() -> glm::mat4& { return *_model_trans; }
  auto getDsetModel() -> rd::ResourceSet& { return _dset_model; }
  auto getDsetModelOutline() -> rd::ResourceSet& { return _dset_model_outline; }
  auto getVertexBuffer() -> rd::VertexBuffer& { return _vertex_buf; }
  auto getIndexBuffer() -> rd::IndexBuffer& { return _index_buf; }

  DrawUnit(DrawUnit&&) noexcept = default;
  auto operator=(DrawUnit&& e) noexcept -> DrawUnit& {
    _dset_model_outline = std::move(e._dset_model_outline);
    _uniform_model_outline = std::move(e._uniform_model_outline);
    _model_trans_outline = std::move(e._model_trans_outline);

    _dset_model = std::move(e._dset_model);
    _texture = std::move(e._texture);
    _uniform_model = std::move(e._uniform_model);
    _model_trans = std::move(e._model_trans);

    _vertex_buf = std::move(e._vertex_buf);
    _index_buf = std::move(e._index_buf);
    return *this;
  }

  void runLoop(loop::ActionContext const& ctx) override {
    using Keyboard = input::Keyboard;
    using ButtonState = input::ButtonState;
    auto& input = input::InputProcessor::getInstance();
    // if (auto opt = input.getState(Keyboard::KEY_A); opt && opt->state == ButtonState::DOWN) {
    //   *_model_trans = *_model_trans * trans::rotate<trans::Axis::Z>(90.0f);
    //   _uniform_model.update();
    // }
  }

private:
  rd::SampledTexture           _texture;
  std::unique_ptr<glm::mat4>   _model_trans;
  rd::UniformBuffer<glm::mat4> _uniform_model;
  rd::ResourceSet              _dset_model;

  std::unique_ptr<glm::mat4>   _model_trans_outline;
  rd::UniformBuffer<glm::mat4> _uniform_model_outline;
  rd::ResourceSet              _dset_model_outline;

  rd::VertexBuffer _vertex_buf;
  rd::IndexBuffer  _index_buf;
};

class Camera : public loop::Action {
public:
  Camera() {
    setStage(loop::Stage::BEFORE_RENDER);
    _view = std::make_unique<glm::mat4>(trans::view::create(glm::vec3{ 5.0f, 5.0f, 5.0f }));
    _uniform_view = { _view.get() };
    auto& swapchain = rd::Presentation::getInstance().getSwapchain();
    _projection = std::make_unique<glm::mat4>(trans::proj::perspective({
      .width = swapchain.getExtent().width,
      .height = swapchain.getExtent().height,
    }));
    _uniform_proj = { _projection.get() };
    _dset = rd::ResourceSet{ &DescriptorPools::getCamera(), { &_uniform_view, &_uniform_proj } };
  }

  Camera(Camera&&) noexcept = default;
  auto operator=(Camera&& e) noexcept -> Camera& {
    _dset = std::move(e._dset);
    _uniform_view = std::move(e._uniform_view);
    _uniform_proj = std::move(e._uniform_proj);
    _view = std::move(e._view);
    _projection = std::move(e._projection);
    return *this;
  }
  void runLoop(loop::ActionContext const& ctx) override {
    if (ctx.recreated) {
      auto& swapchain = rd::Presentation::getInstance().getSwapchain();
      *_projection = trans::proj::perspective({
        .width = swapchain.getExtent().width,
        .height = swapchain.getExtent().height,
      });
      _uniform_proj.update();
    }
    _uniform_view.update();
  }

  auto getView() -> glm::mat4& { return *_view; }
  auto getProj() -> glm::mat4& { return *_projection; }
  auto getDset() -> rd::ResourceSet& { return _dset; }

private:
  std::unique_ptr<glm::mat4>   _view;
  rd::UniformBuffer<glm::mat4> _uniform_view;
  std::unique_ptr<glm::mat4>   _projection;
  rd::UniformBuffer<glm::mat4> _uniform_proj;
  rd::ResourceSet              _dset;
};

class Pipeline : loop::Action {
public:
  Pipeline() : loop::Action{ loop::Stage::RENDER } {
    auto& swapchain = rd::Presentation::getInstance().getSwapchain();
    TOY_ASSERT((rd::ImageContext::getInstance().getAvailableSampleCounts() & _sample_count) > 0);

    auto attachment_infos = std::vector<rd::AttachmentInfo>{
      rd::AttachmentInfo{
        .format = swapchain.getFormat(),
        .sample_count = _sample_count,
        .keep_old_content = false,
        .keep_new_content = false,
      },
      rd::AttachmentInfo{
        .format = swapchain.getFormat(),
        .sample_count = VK_SAMPLE_COUNT_1_BIT,
        .keep_old_content = false,
        .keep_new_content = true,
      },
      rd::AttachmentInfo{
        .format = _depth_format,
        // .sample_count = VK_SAMPLE_COUNT_1_BIT,
        .sample_count = _sample_count,
        .keep_old_content = false,
        .keep_new_content = false,
      },
    };
    auto subpass_infos = std::vector<rd::SubpassPipelineInfo>{
      rd::SubpassPipelineInfo{
        .colors = {0},
        .inputs = {},
        .multi_sample = {{
          .resolves = {1},
          .sample_count = _sample_count,
        }},
        .depst = {{
          .attachment = 2,
          .depth_option = {
            .compare_op = VK_COMPARE_OP_LESS,
            .overwrite = true,
          },
        }},
        .vertex_shader_name = "hello.vert",
        .frag_shader_name = "hello.frag",
        .topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST,
        .cull_mode = VK_CULL_MODE_BACK_BIT,
        .vertex_info = model::Vertex::getVertexInfo(),
        .dset_layouts = { DescriptorPools::getModel(), DescriptorPools::getCamera() },
      }
    };
    _render_pass = rd::RenderPassPipeline{ attachment_infos, subpass_infos };

    createFramebuffers();
  }

  void createFramebuffers() {
    auto& swapchain = rd::Presentation::getInstance().getSwapchain();
    _sample_image = rd::FrameImage{
      swapchain.getFormat(),
      swapchain.getExtent().width,
      swapchain.getExtent().height,
      _sample_count,
    };
    _depth_image = rd::FrameImage{
      _depth_format,
      swapchain.getExtent().width,
      swapchain.getExtent().height,
      _sample_count,
    };
  }

  void runLoop(loop::ActionContext const& ctx) override {
    if (ctx.recreated) {
      createFramebuffers();
    }
    _render_pass.setRecorder(0, [&](rd::PipelineDrawer drawer) {
      for (auto* draw_unit : _draw_units) {
        drawer.bindVertexBuffer(&draw_unit->getVertexBuffer());
        drawer.bindIndexBuffer(&draw_unit->getIndexBuffer());
        drawer.bindResourceSet(0, &draw_unit->getDsetModel());
        drawer.bindResourceSet(1, &_camera->getDset());
        drawer.draw();
      }
    });
    auto attachments = std::array<rd::FrameImageManager*, 3>{
      &_sample_image,
      ctx.image_manager,
      &_depth_image,
    };
    auto clear_values = std::vector{
      VkClearValue{ .color = { .float32 = { 0.5f, 0.5f, 0.5f, 1.0f } } },
      VkClearValue{ .color = { .float32 = { 1.0f, 1.0f, 1.0f, 1.0f } } },
      VkClearValue{ .depthStencil = { .depth = 1.0f, } },
    };
    _render_pass.recordDraw(attachments, clear_values);
  }

  void setCamera(Camera* camera) { _camera = camera; }
  void addDrawUnit(DrawUnit* draw_unit) { _draw_units.insert(draw_unit); }
  void removeDrawUnit(DrawUnit* draw_unit) { _draw_units.erase(draw_unit); }

private:
  rd::RenderPassPipeline _render_pass;

  rd::FrameImage _sample_image;
  rd::FrameImage _depth_image;

  Camera*                       _camera;
  std::unordered_set<DrawUnit*> _draw_units;

  static constexpr auto _sample_count = VK_SAMPLE_COUNT_8_BIT;
  static constexpr auto _depth_format = VK_FORMAT_D32_SFLOAT;
};

class OutlinePipeline : loop::Action {
public:
  OutlinePipeline() : loop::Action{ loop::Stage::RENDER } {
    auto& swapchain = rd::Presentation::getInstance().getSwapchain();
    TOY_ASSERT((rd::ImageContext::getInstance().getAvailableSampleCounts() & _sample_count) > 0);

    auto attachment_infos = std::vector<rd::AttachmentInfo>{
      rd::AttachmentInfo{
        .format = swapchain.getFormat(),
        .sample_count = _sample_count,
        .keep_old_content = false,
        .keep_new_content = false,
      },
      rd::AttachmentInfo{
        .format = swapchain.getFormat(),
        .sample_count = VK_SAMPLE_COUNT_1_BIT,
        .keep_old_content = false,
        .keep_new_content = true,
      },
      rd::AttachmentInfo{
        .format = _depst_format,
        // .sample_count = VK_SAMPLE_COUNT_1_BIT,
        .sample_count = _sample_count,
        .keep_old_content = false,
        .keep_new_content = false,
      },
    };
    auto subpass_infos = std::vector<rd::SubpassPipelineInfo>{
      rd::SubpassPipelineInfo{
        .colors = {0},
        .inputs = {},
        .multi_sample = {{
          .resolves = {std::nullopt},
          .sample_count = _sample_count,
        }},
        .depst = {{
          .attachment = 2,
          .depth_option = {
            .compare_op = VK_COMPARE_OP_LESS,
            .overwrite = true,
          },
          .stencil_option = {
            // cull back, so set front stencil
            .front = VkStencilOpState{
              // set the dynamic reference to attachment used to compare by subpass[1]
              .passOp = VK_STENCIL_OP_REPLACE,
              .compareOp = VK_COMPARE_OP_ALWAYS,
              .writeMask = 0xFFFFFFFF,
            },
            .dynamic_reference = true,
          },
        }},
        .vertex_shader_name = "hello.vert",
        .frag_shader_name = "hello.frag",
        .topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST,
        .cull_mode = VK_CULL_MODE_BACK_BIT,
        .vertex_info = model::Vertex::getVertexInfo(),
        .dset_layouts = { DescriptorPools::getModel(), DescriptorPools::getCamera() },
      },
      rd::SubpassPipelineInfo{
        .colors = {0},
        .inputs = {},
        .multi_sample = {{
          .resolves = {1},
          .sample_count = _sample_count,
        }},
        .depst = {{
          .attachment = 2,
          .depth_option = {
            .compare_op = VK_COMPARE_OP_LESS,
            .overwrite = true,
          },
          .stencil_option = {
            .back = VkStencilOpState{
              // fail the stencil test
              .failOp = VK_STENCIL_OP_KEEP,
              // pass both the depth and stencil tests
              .passOp = VK_STENCIL_OP_KEEP,
              // pass the stencil test and fail the depth test
              .depthFailOp = VK_STENCIL_OP_KEEP,
              .compareOp = VK_COMPARE_OP_NOT_EQUAL,
              // used when compare attachment value and reference
              .compareMask = 0xffffffff,
              // used when write new value to attachment
              .writeMask = 0xffffffff,
              // .reference = 73,
            },
          .dynamic_reference = true,
          },
        }},
        .vertex_shader_name = "outline.vert",
        .frag_shader_name = "outline.frag",
        .topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST,
        // cull front
        .cull_mode = VK_CULL_MODE_FRONT_BIT,
        .vertex_info = model::Vertex::getVertexInfo(),
        .dset_layouts = { DescriptorPools::getModelOutline(), DescriptorPools::getCamera() },
      }
    };
    _render_pass = rd::RenderPassPipeline{ attachment_infos, subpass_infos };

    createFramebuffers();
  }

  void createFramebuffers() {
    auto& swapchain = rd::Presentation::getInstance().getSwapchain();
    _sample_image = rd::FrameImage{
      swapchain.getFormat(),
      swapchain.getExtent().width,
      swapchain.getExtent().height,
      _sample_count,
    };
    _depth_image = rd::FrameImage{
      _depst_format,
      swapchain.getExtent().width,
      swapchain.getExtent().height,
      _sample_count,
    };
  }

  void runLoop(loop::ActionContext const& ctx) override {
    if (ctx.recreated) {
      createFramebuffers();
    }
    _render_pass.setRecorder(0, [&](rd::PipelineDrawer drawer) {
      // todo: easy to overflow
      uint8 reference = 1;
      for (auto* draw_unit : _draw_units) {
        drawer.bindVertexBuffer(&draw_unit->getVertexBuffer());
        drawer.bindIndexBuffer(&draw_unit->getIndexBuffer());
        drawer.bindResourceSet(0, &draw_unit->getDsetModel());
        drawer.bindResourceSet(1, &_camera->getDset());
        drawer.setStencilReference(reference++);
        drawer.draw();
      }
    });
    _render_pass.setRecorder(1, [&](rd::PipelineDrawer drawer) {
      // todo: easy to overflow
      uint8 reference = 1;
      for (auto* draw_unit : _draw_units) {
        drawer.bindVertexBuffer(&draw_unit->getVertexBuffer());
        drawer.bindIndexBuffer(&draw_unit->getIndexBuffer());
        drawer.bindResourceSet(0, &draw_unit->getDsetModelOutline());
        drawer.bindResourceSet(1, &_camera->getDset());
        drawer.setStencilReference(reference++);
        drawer.draw();
      }
    });
    auto attachments = std::array<rd::FrameImageManager*, 3>{
      &_sample_image,
      ctx.image_manager,
      &_depth_image,
    };
    auto clear_values = std::vector{
      VkClearValue{ .color = { .float32 = { 0.5f, 0.5f, 0.5f, 1.0f } } },
      VkClearValue{ .color = { .float32 = { 1.0f, 1.0f, 1.0f, 1.0f } } },
      VkClearValue{ .depthStencil = { .depth = 1.0f, .stencil = 0, } },
    };
    _render_pass.recordDraw(attachments, clear_values);
  }

  void setCamera(Camera* camera) { _camera = camera; }
  void addDrawUnit(DrawUnit* draw_unit) { _draw_units.insert(draw_unit); }
  void removeDrawUnit(DrawUnit* draw_unit) { _draw_units.erase(draw_unit); }

private:
  rd::RenderPassPipeline _render_pass;

  rd::FrameImage _sample_image;
  rd::FrameImage _depth_image;

  Camera*                       _camera;
  std::unordered_set<DrawUnit*> _draw_units;

  static constexpr auto _sample_count = VK_SAMPLE_COUNT_8_BIT;
  static constexpr auto _depst_format = VK_FORMAT_D24_UNORM_S8_UINT;
};

} // namespace pipeline