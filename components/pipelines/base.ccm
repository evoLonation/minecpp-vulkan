module;
#include <toy.h>
export module pipeline.base;

import std;
import toy;
import glm;
import render;
import loop;

import pipeline.uniform;
import camera;

export namespace pl {

using SampledTexture = rd::SampledTexture;

template <typename Vertex>
struct VertexBuffer : rd::VertexBuffer {
  VertexBuffer() = default;
  VertexBuffer(std::span<const Vertex> vertex_data) : rd::VertexBuffer(vertex_data) {}
};

using IndexBuffer = rd::IndexBuffer;

template <typename T>
using type = std::type_identity<T>;

enum Stage { VERTEX, FRAGMENT };
enum Type { UNIFORM, SAMPLED_IMAGE };

template <typename DataType>
struct UniformBinding {
  type<DataType> data_type;
  Stage          stage;
  uint32         count = 1;

  static constexpr Type type = Type::UNIFORM;
  using ResourceType = pl::UniformBuffer<DataType>;
};

struct TextureBinding {
  Stage  stage;
  uint32 count = 1;

  static constexpr Type type = Type::SAMPLED_IMAGE;
  using ResourceType = rd::SampledTexture;
};

auto toBindingInfo(auto binding_info) -> rd::BindingInfo {
  auto toVkShaderStage = [](Stage stage) -> VkShaderStageFlagBits {
    switch (stage) {
    case Stage::VERTEX:
      return VK_SHADER_STAGE_VERTEX_BIT;
    case Stage::FRAGMENT:
      return VK_SHADER_STAGE_FRAGMENT_BIT;
    }
  };
  auto toVkDescriptorType = [](Type type) -> VkDescriptorType {
    switch (type) {
    case Type::UNIFORM:
      return VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER;
    case Type::SAMPLED_IMAGE:
      return VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
    }
  };
  return {
    .type = toVkDescriptorType(binding_info.type),
    .stage = toVkShaderStage(binding_info.stage),
    .count = binding_info.count,
  };
}

template <typename... BindingInfos>
struct DescriptorLayout : toy::Tuple<BindingInfos...> {};
template <typename... BindingInfos>
DescriptorLayout(BindingInfos...) -> DescriptorLayout<BindingInfos...>;

class DescriptorPools : public PROACTIVE_SINGLETON(DescriptorPools) {
public:
  DescriptorPools() = default;

  /**
   * @tparam layout: must is @ref DescriptorLayout
   */
  template <auto layout>
  auto getPool() -> rd::DescriptorPool& {
    static rd::DescriptorPool* _pool;
    if (!_pool) {
      auto new_pool = std::make_unique<rd::DescriptorPool>(std::apply(
        [](auto... infos) { return std::vector<rd::BindingInfo>{ toBindingInfo(infos)... }; },
        layout.toTuple()
      ));
      _pool = _pools.emplace_back(std::move(new_pool)).get();
    }
    return *_pool;
  }

private:
  std::vector<std::unique_ptr<rd::DescriptorPool>> _pools;
};

template <auto layout, auto... binding_infos>
class DescriptorSet_ : public rd::ResourceSet {
public:
  template <typename ResourceType, uint32 count>
  using ResourceBinding =
    std::conditional_t<count == 1, ResourceType*, std::array<ResourceType*, count>>;

  DescriptorSet_(
    ResourceBinding<typename decltype(binding_infos)::ResourceType, binding_infos.count>... bindings
  )
    : rd::ResourceSet{
        &DescriptorPools::getInstance().getPool<layout>(),
        { toResourceBinding(bindings)... },
      } {}

private:
  static auto toResourceBinding(auto binding) -> rd::ResourceBinding {
    if constexpr (ranges::range<decltype(binding)>) {
      auto resources = std::vector<rd::DescriptorResource*>{};
      for (auto* r : binding) {
        resources.push_back(r);
      }
      return { resources };
    } else {
      return { binding };
    }
  }
};

/**
 * @tparam layout must be type of @ref DescriptorLayout
 */
template <auto layout>
using DescriptorSet = APPLY_INDEX_SEQUENCE_TYPE(std::tuple_size_v<decltype(layout.toTuple())>, {
  return type<DescriptorSet_<layout, std::get<indices>(layout.toTuple())...>>{};
});

template <typename VertexT, typename DescriptorLayoutT>
struct PipelineLayout {
  type<VertexT>     vertex;
  DescriptorLayoutT dset_layout;
  uint32            color_n;
  bool              depst;
};

using DepthStencil = rd::SubpassPipelineInfo::DepthStencil;

template <auto pipeline_layout>
struct PipelineInfo {
  using DepthStencil =
    std::conditional_t<pipeline_layout.depst, DepthStencil, std::type_identity<void>>;
  std::array<uint32, pipeline_layout.color_n> colors;
  DepthStencil                                depst;
  std::string                                 vertex_shader_name;
  std::string                                 frag_shader_name;
  VkPrimitiveTopology                         topology;
  VkCullModeFlagBits                          cull_mode;

  static constexpr auto layout = pipeline_layout;
};

template <typename... PipelineInfoTs>
struct RenderPassInfo {
  std::vector<VkFormat>                color_formats;
  std::vector<VkFormat>                depst_formats;
  std::optional<VkSampleCountFlagBits> multi_sampling;
  std::tuple<PipelineInfoTs...>        pipelines;

  static constexpr auto layouts = std::tuple{ (PipelineInfoTs::layout)... };
};

template <auto pipeline_layout>
class DrawUnit;
class DrawUnits : public PROACTIVE_SINGLETON(DrawUnits) {
public:
  DrawUnits() = default;

  template <auto pipeline_layout>
  auto getDrawUnits() -> std::unordered_set<DrawUnit<pipeline_layout>*>& {
    static std::unordered_set<DrawUnit<pipeline_layout>*> draw_units;
    return draw_units;
  }
  template <auto pipeline_layout>
  auto add(DrawUnit<pipeline_layout>* draw_unit) -> void {
    getDrawUnits<pipeline_layout>().emplace(draw_unit);
  }
  template <auto pipeline_layout>
  auto remove(DrawUnit<pipeline_layout>* draw_unit) -> void {
    getDrawUnits<pipeline_layout>().erase(draw_unit);
  }
};

template <typename Derived>
class DrawUnitLoader {
public:
  DrawUnitLoader() { add(); }
  ~DrawUnitLoader() { remove(); }
  DrawUnitLoader(const DrawUnitLoader&) noexcept = delete;
  DrawUnitLoader(DrawUnitLoader&&) noexcept { add(); }
  auto operator=(const DrawUnitLoader&) noexcept -> DrawUnitLoader& = delete;
  auto operator=(DrawUnitLoader&&) noexcept -> DrawUnitLoader& = default;

private:
  auto self() -> Derived& { return static_cast<Derived&>(*this); }
  void add() { DrawUnits::getInstance().add(&self()); }
  void remove() { DrawUnits::getInstance().remove(&self()); }
};

template <auto pipeline_layout>
class DrawUnit : public DrawUnitLoader<DrawUnit<pipeline_layout>> {
public:
  using VertexBuffer = VertexBuffer<typename decltype(pipeline_layout.vertex)::type>;
  using DescriptorSet = DescriptorSet<pipeline_layout.dset_layout>;
  DrawUnit(VertexBuffer* vertex_buffer, rd::IndexBuffer* index_buffer, DescriptorSet dset)
    : _vertex_buffer(vertex_buffer), _index_buffer(index_buffer), _dset(std::move(dset)) {}
  DrawUnit(
    VertexBuffer*    vertex_buffer,
    rd::IndexBuffer* index_buffer,
    DescriptorSet    dset,
    uint8            stencil_ref
  )
    : _vertex_buffer(vertex_buffer), _index_buffer(index_buffer), _dset(std::move(dset)),
      _stencil_ref(stencil_ref) {}
  ONLY_MOVEABLE(DrawUnit);
  auto getVertexBuffer() -> VertexBuffer& { return *_vertex_buffer; }
  auto getIndexBuffer() -> IndexBuffer& { return *_index_buffer; }
  auto getDescriptorSet() -> DescriptorSet& { return _dset; }
  auto getStencilRef() -> uint8 { return _stencil_ref; }

private:
  VertexBuffer*    _vertex_buffer;
  rd::IndexBuffer* _index_buffer;
  DescriptorSet    _dset;
  uint8            _stencil_ref;
};

template <typename RenderPassInfoT>
class RenderPass : public loop::Action {
public:
  RenderPass(RenderPassInfoT info) {
    setStage(loop::Stage::RENDER);
    auto& swapchain = rd::Presentation::getInstance().getSwapchain();
    auto  attachment_infos = std::vector<rd::AttachmentInfo>{};
    auto  color_formats = std::vector<VkFormat>{};
    color_formats.push_back(swapchain.getFormat());
    color_formats.append_range(info.color_formats);
    for (auto& color_format : color_formats) {
      attachment_infos.push_back(rd::AttachmentInfo{
        .format = color_format,
        .sample_count = info.multi_sampling.value_or(VK_SAMPLE_COUNT_1_BIT),
        .load_op = rd::LoadOp::CLEAR,
        .is_store = !info.multi_sampling,
      });
      if (info.multi_sampling) {
        attachment_infos.push_back(rd::AttachmentInfo{
          .format = color_format,
          .sample_count = VK_SAMPLE_COUNT_1_BIT,
        });
      }
    }
    for (auto& depst_format : info.depst_formats) {
      attachment_infos.push_back(rd::AttachmentInfo{
        .format = depst_format,
        .sample_count = info.multi_sampling.value_or(VK_SAMPLE_COUNT_1_BIT),
        .load_op = rd::LoadOp::CLEAR,
        .is_store = false,
      });
    }
    auto subpass_infos = std::vector<rd::SubpassPipelineInfo>{};
    auto addSubpassInfoAndDynRef = [&](auto subpass) {
      constexpr auto pipeline_layout = subpass.layout;

      auto colors = std::vector<uint32>{};
      auto resolves = std::vector<std::optional<uint32>>{};
      for (auto i : subpass.colors) {
        if (info.multi_sampling) {
          colors.push_back(i * 2);
          resolves.push_back(i * 2 + 1);
        } else {
          colors.push_back(i);
        }
      }

      auto subpass_info = rd::SubpassPipelineInfo{
        .colors = colors,
        .multi_sample = info.multi_sampling.transform(
          [&](auto x) { return rd::SubpassInfo::MultiSample{ resolves, x }; }
        ),
        .vertex_shader_name = subpass.vertex_shader_name,
        .frag_shader_name = subpass.frag_shader_name,
        .topology = subpass.topology,
        .cull_mode = subpass.cull_mode,
        .vertex_info = decltype(pipeline_layout.vertex)::type::getVertexInfo(),
        .dset_layouts = { 
          DescriptorPools::getInstance().getPool<pipeline_layout.dset_layout>(),
        },
        .push_constants = { 
          rd::PushConstantInfo{ 
            .stage = VK_SHADER_STAGE_VERTEX_BIT, 
            .size = sizeof(camera::CameraData), 
            .alignment = alignof(camera::CameraData),
          },
        },
      };
      auto dynamic_reference = false;
      if constexpr (pipeline_layout.depst) {
        subpass_info.depst = subpass.depst;
        subpass_info.depst->attachment +=
          pipeline_layout.color_n + (info.multi_sampling ? pipeline_layout.color_n : 0);
        dynamic_reference = subpass.depst.stencil_option->dyn_ref;
      }
      subpass_infos.push_back(subpass_info);
      _dynamic_references.push_back(dynamic_reference);
    };
    std::apply([&](auto... subpass) { (addSubpassInfoAndDynRef(subpass), ...); }, info.pipelines);

    _render_pass = rd::RenderPassPipeline{ attachment_infos, subpass_infos };

    createFramebuffers(info.color_formats, info.depst_formats, info.multi_sampling);
  }
  auto getColorAttachment(uint32 index, bool resolved = false) -> rd::FrameImageManager& {
    if (resolved) {
      return _resolve_images[index];
    } else {
      return _color_images[index];
    }
  }
  auto getDepstAttachment(uint32 index) -> rd::FrameImageManager& { return _depst_images[index]; }
  void setColorClearValue(uint32 index, VkClearColorValue clear_value) {
    if (_present_color_image.valid()) {
      _render_pass.setClearValue(2 * index, clear_value);
    } else {
      _render_pass.setClearValue(index, clear_value);
    }
  }
  void setDepstClearValue(uint32 index, VkClearDepthStencilValue clear_value) {
    if (_present_color_image.valid()) {
      _render_pass.setClearValue(2 * _color_images.size() + 2 + index, clear_value);
    } else {
      _render_pass.setClearValue(_color_images.size() + 1 + index, clear_value);
    }
  }
  void setCamera(camera::CameraData* camera) { _camera = camera; }

  void runLoop(loop::ActionContext const& ctx) override {
    if (ctx.recreated) {
      recreateFramebuffers();
    }
    auto setRecorder = [&]<size_t index>() {
      _render_pass.setRecorder(index, [&](rd::PipelineDrawer drawer) {
        drawer.bindPushConstant(VK_SHADER_STAGE_VERTEX_BIT, std::as_bytes(std::span{ _camera, 1 }));
        for (auto& draw_unit :
             DrawUnits::getInstance().getDrawUnits<std::get<index>(RenderPassInfoT::layouts)>()) {
          drawer.bindVertexBuffer(&draw_unit->getVertexBuffer());
          drawer.bindIndexBuffer(&draw_unit->getIndexBuffer());
          drawer.bindResourceSet(0, &draw_unit->getDescriptorSet());
          if (_dynamic_references[index]) {
            drawer.setStencilReference(draw_unit->getStencilRef());
          }
          drawer.draw();
        }
      });
    };
    toy::templateForEach<std::tuple_size_v<decltype(RenderPassInfoT::layouts)>>(setRecorder);
    auto attachments = std::vector<rd::FrameImageManager*>{};
    if (_present_color_image.valid()) {
      attachments.push_back(&_present_color_image);
      attachments.push_back(ctx.image_manager);
      for (auto [color, resolve] : views::zip(_color_images, _resolve_images)) {
        attachments.push_back(&color);
        attachments.push_back(&resolve);
      }
    } else {
      attachments.push_back(ctx.image_manager);
      for (auto& color : _color_images) {
        attachments.push_back(&color);
      }
    }
    for (auto& depst : _depst_images) {
      attachments.push_back(&depst);
    }
    _render_pass.recordDraw(attachments);
  }

private:
  rd::RenderPassPipeline      _render_pass;
  rd::FrameImage              _present_color_image;
  std::vector<rd::FrameImage> _color_images;
  std::vector<rd::FrameImage> _resolve_images;
  std::vector<rd::FrameImage> _depst_images;

  camera::CameraData* _camera;

  std::vector<bool> _dynamic_references;

  void createFramebuffers(
    std::span<VkFormat const>            color_formats,
    std::span<VkFormat const>            depst_formats,
    std::optional<VkSampleCountFlagBits> multi_sampling
  ) {
    _color_images.clear();
    _resolve_images.clear();
    _depst_images.clear();
    auto& swapchain = rd::Presentation::getInstance().getSwapchain();
    if (multi_sampling) {
      _present_color_image = rd::FrameImage{
        swapchain.getFormat(),
        swapchain.getExtent().width,
        swapchain.getExtent().height,
        multi_sampling.value(),
        {},
      };
    }
    for (auto& color_format : color_formats) {
      _color_images.push_back(rd::FrameImage{
        color_format,
        swapchain.getExtent().width,
        swapchain.getExtent().height,
        multi_sampling.value_or(VK_SAMPLE_COUNT_1_BIT),
        {},
      });
      if (multi_sampling) {
        _resolve_images.push_back(rd::FrameImage{
          color_format,
          swapchain.getExtent().width,
          swapchain.getExtent().height,
          VK_SAMPLE_COUNT_1_BIT,
          {},
        });
      }
    }
    for (auto& depst_format : depst_formats) {
      _depst_images.push_back(rd::FrameImage{
        depst_format,
        swapchain.getExtent().width,
        swapchain.getExtent().height,
        multi_sampling.value_or(VK_SAMPLE_COUNT_1_BIT),
        {},
      });
    }
  }
  void recreateFramebuffers() {
    auto color_formats = std::vector<VkFormat>{};
    for (auto& image : _color_images) {
      color_formats.push_back(image.getFormat());
    }
    auto depst_formats = std::vector<VkFormat>{};
    for (auto& image : _depst_images) {
      depst_formats.push_back(image.getFormat());
    }
    auto multi_sampling = std::optional<VkSampleCountFlagBits>{};
    if (_present_color_image.valid()) {
      multi_sampling = _present_color_image.getSampleCount();
    }
    createFramebuffers(color_formats, depst_formats, multi_sampling);
  }
};

