module;
#include <toy.h>
export module pipeline.base2;

import std;
import toy;
import glm;
import render;
import loop;

import pipeline.uniform;
import camera;

export namespace pl {

struct PipelineInfo {
  std::vector<uint32>            colors;
  std::optional<rd::DepstOption> depst;
  std::string                    vertex_shader_name;
  std::string                    frag_shader_name;
  VkPrimitiveTopology            topology;
  VkCullModeFlagBits             cull_mode;
  rd::VertexInfo                 vertex_info;
  VkDescriptorSetLayout          unit_dset_layout;
  VkDescriptorSetLayout          global_dset_layout; // nullable
};

struct RenderPassInfo {
  std::vector<VkFormat>                color_formats;
  std::vector<VkFormat>                depst_formats;
  std::optional<VkSampleCountFlagBits> multi_sampling;
  std::vector<PipelineInfo>            pipelines;
};

template <typename Derived>
class DrawUnitLoader {
public:
  DrawUnitLoader() = default;
  DrawUnitLoader(uint32 subpass_n) : _subpass_n(subpass_n) { add(); }
  ~DrawUnitLoader() { remove(); }
  DrawUnitLoader(const DrawUnitLoader&) noexcept = delete;
  DrawUnitLoader(DrawUnitLoader&& e) noexcept {
    _subpass_n = e._subpass_n;
    add();
  }
  auto operator=(const DrawUnitLoader&) noexcept -> DrawUnitLoader& = delete;
  auto operator=(DrawUnitLoader&& e) noexcept -> DrawUnitLoader& {
    remove();
    _subpass_n = e._subpass_n;
    add();
    return *this;
  }

private:
  auto self() -> Derived& { return static_cast<Derived&>(*this); }
  void add();
  void remove();

  std::optional<uint32> _subpass_n;
};

class DrawUnit : public DrawUnitLoader<DrawUnit> {
public:
  DrawUnit() = default;
  /**
   * @param index_buffer nullable
   */
  DrawUnit(
    uint32               subpass_n,
    rd::VertexBuffer*    vertex_buffer,
    rd::IndexBuffer*     index_buffer,
    rd::DescriptorSet    dset,
    std::optional<uint8> stencil_ref = {}
  )
    : DrawUnitLoader<DrawUnit>{ subpass_n }, _vertex_buffer(vertex_buffer),
      _index_buffer(index_buffer), _dset(std::move(dset)), _stencil_ref(stencil_ref) {}
  ONLY_MOVEABLE(DrawUnit);
  auto getVertexBuffer() -> rd::VertexBuffer& { return *_vertex_buffer; }
  auto getIndexBuffer() -> rd::IndexBuffer* { return _index_buffer; }
  auto getDescriptorSet() -> rd::DescriptorSet& { return _dset; }
  auto getStencilRef() -> uint8 {
    TOY_CHECK_ASSERT(_stencil_ref.has_value());
    return *_stencil_ref;
  }

private:
  void add();
  void remove();

  rd::VertexBuffer*    _vertex_buffer;
  rd::IndexBuffer*     _index_buffer;
  rd::DescriptorSet    _dset;
  std::optional<uint8> _stencil_ref;
};

class RenderPass : public PROACTIVE_SINGLETON(RenderPass), public loop::Action {
public:
  RenderPass() : PROACTIVE_SINGLETON(RenderPass)(false) {}
  RenderPass(RenderPassInfo info) {
    setStage(loop::Stage::RENDER);
    auto& swapchain = rd::Presentation::getInstance().getSwapchain();
    auto  attachment_infos = std::vector<rd::AttachmentInfo>{};
    {
      auto color_formats = std::vector<VkFormat>{};
      color_formats.push_back(swapchain.getFormat());
      color_formats.append_range(info.color_formats);
      for (auto& color_format : color_formats) {
        attachment_infos.push_back(rd::AttachmentInfo{
          .format = color_format,
          .sample_count = info.multi_sampling.value_or(VK_SAMPLE_COUNT_1_BIT),
          .load_op = rd::LoadOp::CLEAR,
          .is_store = !info.multi_sampling,
        });
        if (info.multi_sampling) {
          attachment_infos.push_back(rd::AttachmentInfo{
            .format = color_format,
            .sample_count = VK_SAMPLE_COUNT_1_BIT,
          });
        }
      }
      for (auto& depst_format : info.depst_formats) {
        attachment_infos.push_back(rd::AttachmentInfo{
          .format = depst_format,
          .sample_count = info.multi_sampling.value_or(VK_SAMPLE_COUNT_1_BIT),
          .load_op = rd::LoadOp::CLEAR,
          .is_store = false,
        });
      }
    }
    auto subpass_infos = std::vector<rd::SubpassPipelineInfo>{};
    for (auto& pipeline : info.pipelines) {
      auto colors = std::vector<uint32>{};
      auto resolves = std::vector<std::optional<uint32>>{};
      for (auto i : pipeline.colors) {
        if (info.multi_sampling) {
          colors.push_back(i * 2);
          resolves.push_back(i * 2 + 1);
        } else {
          colors.push_back(i);
        }
      }
      auto dset_layouts = std::vector<VkDescriptorSetLayout>{ pipeline.unit_dset_layout };
      if (pipeline.global_dset_layout) {
        dset_layouts.push_back(pipeline.global_dset_layout);
      }
      auto subpass_info = rd::SubpassPipelineInfo{
        .colors = colors,
        .multi_sample = info.multi_sampling.transform(
          [&](auto x) { return rd::SubpassInfo::MultiSample{ resolves, x }; }
        ),
        .depst = pipeline.depst,
        .vertex_shader_name = pipeline.vertex_shader_name,
        .frag_shader_name = pipeline.frag_shader_name,
        .topology = pipeline.topology,
        .cull_mode = pipeline.cull_mode,
        .vertex_info = pipeline.vertex_info,
        .dset_layouts = std::move(dset_layouts),
        .push_constants = { 
          rd::PushConstantInfo{ 
            .stage = VK_SHADER_STAGE_VERTEX_BIT, 
            .size = sizeof(camera::CameraData), 
            .alignment = alignof(camera::CameraData),
          },
        },
      };
      if (subpass_info.depst) {
        subpass_info.depst->attachment +=
          info.multi_sampling ? info.color_formats.size() * 2 + 2 : info.color_formats.size() + 1;
      }
      subpass_infos.push_back(subpass_info);
      auto dyn_ref =
        pipeline.depst ? pipeline.depst->stencil ? pipeline.depst->stencil->dyn_ref : false : false;
      _dynamic_references.push_back(dyn_ref);
    }
    _render_pass = rd::RenderPassPipeline{ attachment_infos, subpass_infos };
    _draw_units.resize(info.pipelines.size());

    createFramebuffers(info.color_formats, info.depst_formats, info.multi_sampling);
  }
  auto getColorAttachment(uint32 index, bool resolved = false) -> rd::FrameImageManager& {
    if (resolved) {
      return _resolve_images[index];
    } else {
      return _color_images[index];
    }
  }
  auto getDepstAttachment(uint32 index) -> rd::FrameImageManager& { return _depst_images[index]; }
  void setColorClearValue(uint32 index, rd::ColorClearValue clear_value) {
    index = _present_color_image.valid() ? index * 2 : index;
    _render_pass.setColorClear(index, clear_value);
  }
  void setDepstClearValue(uint32 index, rd::DepstClearValue clear_value) {
    index += _present_color_image.valid() ? 2 * _color_images.size() + 2 : _color_images.size() + 1;
    _render_pass.setDepstClear(index, clear_value);
  }
  void setCamera(camera::CameraData* camera) { _camera = camera; }
  void setGlobalDescriptorSet(rd::DescriptorSet* dset) { _global_dset = dset; }

  void runLoop(loop::ActionContext const& ctx) override {
    if (ctx.recreated) {
      recreateFramebuffers();
    }
    for (auto [index, draw_units] : _draw_units | toy::enumerate) {
      _render_pass.setRecorder(index, [&](rd::PipelineDrawer drawer) {
        drawer.bindPushConstant(VK_SHADER_STAGE_VERTEX_BIT, std::as_bytes(std::span{ _camera, 1 }));
        if (_global_dset) {
          drawer.bindDescriptorSet(1, _global_dset);
        }
        for (auto& draw_unit : draw_units) {
          drawer.bindVertexBuffer(&draw_unit->getVertexBuffer());
          auto* index_buf = draw_unit->getIndexBuffer();
          if (index_buf) {
            drawer.bindIndexBuffer(index_buf);
          }
          drawer.bindDescriptorSet(0, &draw_unit->getDescriptorSet());
          if (_dynamic_references[index]) {
            drawer.setStencilReference(draw_unit->getStencilRef());
          }
          drawer.draw();
        }
      });
    }
    auto attachments = std::vector<rd::FrameImageManager*>{};
    if (_present_color_image.valid()) {
      attachments.push_back(&_present_color_image);
      attachments.push_back(ctx.image_manager);
      for (auto [color, resolve] : views::zip(_color_images, _resolve_images)) {
        attachments.push_back(&color);
        attachments.push_back(&resolve);
      }
    } else {
      attachments.push_back(ctx.image_manager);
      for (auto& color : _color_images) {
        attachments.push_back(&color);
      }
    }
    for (auto& depst : _depst_images) {
      attachments.push_back(&depst);
    }
    _render_pass.recordDraw(attachments);
  }

  ONLY_MOVEABLE(RenderPass);

private:
  rd::RenderPassPipeline      _render_pass;
  rd::FrameImage              _present_color_image;
  std::vector<rd::FrameImage> _color_images;
  std::vector<rd::FrameImage> _resolve_images;
  std::vector<rd::FrameImage> _depst_images;

  camera::CameraData* _camera = nullptr;
  rd::DescriptorSet*  _global_dset = nullptr;

  std::vector<bool> _dynamic_references;

  template <typename>
  friend class DrawUnitLoader;
  std::vector<std::unordered_set<DrawUnit*>> _draw_units;

  void createFramebuffers(
    std::span<VkFormat const>            color_formats,
    std::span<VkFormat const>            depst_formats,
    std::optional<VkSampleCountFlagBits> multi_sampling
  ) {
    _color_images.clear();
    _resolve_images.clear();
    _depst_images.clear();
    auto& swapchain = rd::Presentation::getInstance().getSwapchain();
    if (multi_sampling) {
      _present_color_image = rd::FrameImage{
        swapchain.getFormat(),
        swapchain.getExtent().width,
        swapchain.getExtent().height,
        multi_sampling.value(),
        {},
      };
    }
    for (auto& color_format : color_formats) {
      _color_images.push_back(rd::FrameImage{
        color_format,
        swapchain.getExtent().width,
        swapchain.getExtent().height,
        multi_sampling.value_or(VK_SAMPLE_COUNT_1_BIT),
        {},
      });
      if (multi_sampling) {
        _resolve_images.push_back(rd::FrameImage{
          color_format,
          swapchain.getExtent().width,
          swapchain.getExtent().height,
          VK_SAMPLE_COUNT_1_BIT,
          {},
        });
      }
    }
    for (auto& depst_format : depst_formats) {
      _depst_images.push_back(rd::FrameImage{
        depst_format,
        swapchain.getExtent().width,
        swapchain.getExtent().height,
        multi_sampling.value_or(VK_SAMPLE_COUNT_1_BIT),
        {},
      });
    }
  }
  void recreateFramebuffers() {
    auto color_formats = std::vector<VkFormat>{};
    for (auto& image : _color_images) {
      color_formats.push_back(image.getFormat());
    }
    auto depst_formats = std::vector<VkFormat>{};
    for (auto& image : _depst_images) {
      depst_formats.push_back(image.getFormat());
    }
    auto multi_sampling = std::optional<VkSampleCountFlagBits>{};
    if (_present_color_image.valid()) {
      multi_sampling = _present_color_image.getSampleCount();
    }
    createFramebuffers(color_formats, depst_formats, multi_sampling);
  }
};

template <typename Derived>
void DrawUnitLoader<Derived>::add() {
  if (_subpass_n) {
    RenderPass::getInstance()._draw_units[*_subpass_n].insert(&self());
  }
}

template <typename Derived>
void DrawUnitLoader<Derived>::remove() {
  if (_subpass_n) {
    RenderPass::getInstance()._draw_units[*_subpass_n].erase(&self());
  }
}

template <auto dset_layout, uint32 subpass_n>
class DrawUnitTemplate : public DrawUnit {
public:
  DrawUnitTemplate() = default;
  DrawUnitTemplate(
    rd::VertexBuffer*                    vertex_buffer,
    rd::IndexBuffer*                     index_buffer,
    rd::meta::DescriptorSet<dset_layout> dset,
    std::optional<uint8>                 stencil_ref = {}
  )
    : DrawUnit(subpass_n, vertex_buffer, index_buffer, std::move(dset), stencil_ref) {}
};

template <auto dset_layout>
auto getLayoutHandle() -> VkDescriptorSetLayout {
  return rd::meta::DescriptorPools::getInstance().getPool<dset_layout>();
}

} // namespace pl
