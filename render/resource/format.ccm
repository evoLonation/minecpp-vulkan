  VK_FORMAT_D16_UNORM_S8_UINT,
  VK_FORMAT_D24_UNORM_S8_UINT,
  VK_FORMAT_D32_SFLOAT_S8_UINT,
});

constexpr auto getFormatInfo(VkFormat format) -> FormatInfo {
  auto opt = format_infos.at(format);
  TOY_ASSERT(opt);
  return opt.value();
}

