module;
#include <toy.h>
export module render.format;

import std;
import toy;
import glm;
import <vulkan_config.h>;
import render.device;
import render.reflections;

export namespace rd {

template <VkFormat format_, typename T>
  requires std::is_trivially_copyable_v<T>
struct FormatTypePair {
  static constexpr auto format = format_;
  using type = T;
};

// todo: add packed formats
/**
 * @brief use to map between vertex type and format
 *
 */
using FormatTypeInfos = toy::TypePack<
  FormatTypePair<VK_FORMAT_R32_SFLOAT, float>,               //
  FormatTypePair<VK_FORMAT_R32G32_SFLOAT, glm::vec2>,        //
  FormatTypePair<VK_FORMAT_R32G32B32_SFLOAT, glm::vec3>,     //
  FormatTypePair<VK_FORMAT_R32G32B32A32_SFLOAT, glm::vec4>,  //
  FormatTypePair<VK_FORMAT_R64_SFLOAT, double>,              //
  FormatTypePair<VK_FORMAT_R64G64_SFLOAT, glm::dvec2>,       //
  FormatTypePair<VK_FORMAT_R64G64B64_SFLOAT, glm::dvec3>,    //
  FormatTypePair<VK_FORMAT_R64G64B64A64_SFLOAT, glm::dvec4>, //
  FormatTypePair<VK_FORMAT_R32_SINT, int>,                   //
  FormatTypePair<VK_FORMAT_R32G32_SINT, glm::ivec2>,         //
  FormatTypePair<VK_FORMAT_R32G32B32_SINT, glm::ivec3>,      //
  FormatTypePair<VK_FORMAT_R32G32B32A32_SINT, glm::ivec4>,   //
  FormatTypePair<VK_FORMAT_R32_UINT, uint32>,                //
  FormatTypePair<VK_FORMAT_R32G32_UINT, glm::uvec2>,         //
  FormatTypePair<VK_FORMAT_R32G32B32_UINT, glm::uvec3>,      //
  FormatTypePair<VK_FORMAT_R32G32B32A32_UINT, glm::uvec4>>;

template <typename Type>
consteval auto typeToFormat() -> VkFormat {
  return FormatTypeInfos::filter<[]<typename T>() {
    return std::same_as<typename T::type, Type>;
  }>::template at<0>::format;
}
template <VkFormat format>
using formatToType =
  FormatTypeInfos::filter<[]<typename T>() { return T::format == format; }>::template at<0>::type;

constexpr auto _color_formats = std::array{
  VK_FORMAT_R8G8B8A8_SRGB, VK_FORMAT_R8G8B8A8_UNORM, VK_FORMAT_R8G8B8A8_UINT,
  VK_FORMAT_B8G8R8A8_SRGB, VK_FORMAT_B8G8R8A8_UNORM, VK_FORMAT_B8G8R8A8_UINT,

  VK_FORMAT_R32_UINT,
};
constexpr auto _depth_formats = std::array{
  VK_FORMAT_D16_UNORM,
  VK_FORMAT_D32_SFLOAT,
};
constexpr auto _stencil_formats = std::array{
  VK_FORMAT_S8_UINT,
};
constexpr auto _depth_stencil_formats = std::array{
  VK_FORMAT_D24_UNORM_S8_UINT,
};

/**
 * @brief
 * 1. follow formats map to float types
 * SRGB: The R, G, and B components are unsigned normalized values that represent values using sRGB
 * nonlinear encoding, while the A component (if one exists) is a regular unsigned normalized value
 * U/S NORM: The components are unsigned/signed normalized values in the range [0,1]/[-1,1].
 * U/S SCALED: The components are unsigned/signed integer values that get converted to
 * floating-point in the range [0,2^n-1]/[-2^(n-1),2^(n-1)-1].
 * U/S FLOAT: directly map to float
 * 2. folow formats map to integer types: U/S INT
 */
enum ScalarType {
  SINT = 0b00000001,
  UINT = 0b00000010,
  SFLOAT = 0b00000100,
  UNORM = 0b00001000,
  SNORM = 0b00010000,
  USCALED = 0b00100000,
  SSCALED = 0b01000000,
  SRGB = 0b10000000,
  DEST_SFLOAT = SFLOAT | SNORM | SSCALED,
  DEST_UFLOAT = UNORM | USCALED | SRGB,
  DEST_FLOAT = DEST_SFLOAT | DEST_UFLOAT,
  DEST_INTEGER = SINT | UINT,
};

enum ComponentType {
  R = 0b000001,
  RG = 0b000010,
  RGB = 0b000100,
  BGR = 0b001000,
  RGBA = 0b010000,
  BGRA = 0b100000,
  NUM_1 = R,
  NUM_2 = RG,
  NUM_3 = RGB | BGR,
  NUM_4 = RGBA | BGRA,
};

enum FormatType {
  COLOR = 0b001,
  DEPTH = 0b010,
  STENCIL = 0b100,
  DEPTH_STENCIL = 0b110,
};

struct ColorFormatInfo {
  // by byte each component
  uint32        component_size;
  ComponentType components;
  ScalarType    scalar;
};

struct DepstFormatInfo {
  // by byte
  uint32     depth_size;
  ScalarType depth_scalar;
  // by byte
  uint32     stencil_size;
  ScalarType stencil_scalar;
};

struct FormatInfo {
  FormatType type;
  uint32     size;
  union {
    ColorFormatInfo color;
    DepstFormatInfo depst;
  };

  constexpr auto getSize() -> uint32 {
    switch (type) {
    case COLOR: {
      using enum ComponentType;
      auto component_n = color.components & NUM_1   ? 1
                         : color.components & NUM_2 ? 2
                         : color.components & NUM_3 ? 3
                                                    : 4;

      return color.component_size * component_n;
    }
    case DEPTH:
      return depst.depth_size;
    case STENCIL:
      return depst.stencil_size;
    case DEPTH_STENCIL:
      return depst.depth_size + depst.stencil_size;
    }
  }
};

consteval auto computeFormatInfo(VkFormat format) -> FormatInfo {
  auto str = refl::enum2str(format);
  using namespace std::string_literals;
  using enum FormatType;
  str = str.substr("VK_FORMAT_"s.size());
  auto forwardCompare = [](std::string_view& str, auto str2) -> bool {
    if (str.starts_with(str2)) {
      if constexpr (std::is_same_v<decltype(str2), char>) {
        str = str.substr(1);
      } else {
        str = str.substr(std::string_view{ str2 }.size());
      }
      return true;
    } else {
      return false;
    }
  };
  auto skip = [&]() {
    while (str.size() && str[0] == '_') {
      str = str.substr(1);
    }
  };
  auto getSize = [&]() -> uint32 {
    skip();
    if (forwardCompare(str, "8")) {
      return 1;
    } else if (forwardCompare(str, "16")) {
      return 2;
    } else if (forwardCompare(str, "24")) {
      return 3;
    } else if (forwardCompare(str, "32")) {
      return 4;
    } else if (forwardCompare(str, "64")) {
      return 8;
    }
    toy::throwf("unsupported format: {}", format);
  };
  auto getScalarType = [&]() -> ScalarType {
    skip();
    using enum ScalarType;
    if (forwardCompare(str, "SFLOAT")) {
      return SFLOAT;
    } else if (forwardCompare(str, "SINT")) {
      return SINT;
    } else if (forwardCompare(str, "UINT")) {
      return ScalarType::UINT;
    } else if (forwardCompare(str, "UNORM")) {
      return UNORM;
    } else if (forwardCompare(str, "SNORM")) {
      return SNORM;
    } else if (forwardCompare(str, "SRGB")) {
      return SRGB;
    } else if (forwardCompare(str, "USCALED")) {
      return USCALED;
    } else if (forwardCompare(str, "SSCALED")) {
      return SSCALED;
    }
    toy::throwf("unsupported format: {}", format);
  };
  auto compareWith = [&](char c) -> bool {
    skip();
    return forwardCompare(str, c);
  };
  if (compareWith('D')) {
    auto depth_size = getSize();
    auto depth_type = getScalarType();
    if (str.size() == 0) {
      auto info = DepstFormatInfo{
        .depth_size = depth_size,
        .depth_scalar = depth_type,
      };
      return { .type = DEPTH, .size = info.depth_size, .depst = info };
    } else {
      TOY_ASSERT(compareWith('S'));
      auto stencil_size = getSize();
      auto stencil_type = getScalarType();
      auto info = DepstFormatInfo{
        .depth_size = depth_size,
        .depth_scalar = depth_type,
        .stencil_size = stencil_size,
        .stencil_scalar = stencil_type,
      };
      return { .type = DEPTH_STENCIL, .size = info.stencil_size + info.depth_size, .depst = info };
    }
  } else if (compareWith('S')) {
    auto stencil_size = getSize();
    auto stencil_type = getScalarType();
    auto info = DepstFormatInfo{
      .stencil_size = stencil_size,
      .stencil_scalar = stencil_type,
    };
    return { .type = STENCIL, .size = info.stencil_size, .depst = info };
  } else {
    auto info = ColorFormatInfo{};
    if (compareWith('R')) {
      uint32 r_size{}, g_size{}, b_size{}, a_size{};
      r_size = getSize();
      auto component = ComponentType::R;
      if (compareWith('G')) {
        g_size = getSize();
        component = ComponentType::RG;
        if (compareWith('B')) {
          b_size = getSize();
          component = ComponentType::RGB;
          if (compareWith('A')) {
            a_size = getSize();
            component = ComponentType::RGBA;
          }
        }
      }
      auto type = getScalarType();
      info = ColorFormatInfo{
        .component_size = r_size,
        .components = component,
        .scalar = type,
      };
    } else if (compareWith('B')) {
      uint32 b_size = getSize();
      TOY_ASSERT(compareWith('G'));
      uint32 g_size = getSize();
      TOY_ASSERT(compareWith('R'));
      uint32 r_size = getSize();
      uint32 a_size{};
      auto   component = ComponentType::BGR;
      if (compareWith('A')) {
        uint32 a_size = getSize();
        component = ComponentType::BGRA;
      }
      auto type = getScalarType();
      info = ColorFormatInfo{
        .component_size = b_size,
        .components = component,
        .scalar = type,
      };
    }
    using enum ComponentType;
    auto component_n = //
      info.components & NUM_1   ? 1
      : info.components & NUM_2 ? 2
      : info.components & NUM_3 ? 3
                                : 4;
    return { .type = COLOR, .size = info.component_size * component_n, .color = info };
  }
  toy::throwf("unsupported format");
}
consteval auto computeFormatInfos(std::initializer_list<VkFormat> formats)
  -> std::array<std::optional<FormatInfo>, 200> {
  auto ret = std::array<std::optional<FormatInfo>, 200>{};
  for (auto format : formats) {
    ret[format] = computeFormatInfo(format);
  }
  return ret;
}

