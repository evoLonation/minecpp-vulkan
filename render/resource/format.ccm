module;
#include <toy.h>
export module render.format;

import std;
import toy;
import glm;
import <vulkan_config.h>;
import render.device;

export namespace rd {

/**
 * @brief
 * 1. follow formats map to float types
 * SRGB: The R, G, and B components are unsigned normalized values that represent values using sRGB
 * nonlinear encoding, while the A component (if one exists) is a regular unsigned normalized value
 * U/S NORM: The components are unsigned/signed normalized values in the range [0,1]/[-1,1].
 * U/S SCALED: The components are unsigned/signed integer values that get converted to
 * floating-point in the range [0,2^n-1]/[-2^(n-1),2^(n-1)-1].
 * U/S FLOAT: directly map to float
 * 2. folow formats map to integer types: U/S INT
 */

template <VkFormat format_, typename T>
  requires std::is_trivially_copyable_v<T>
struct FormatTypeInfo {
  static constexpr auto format = format_;
  using type = T;
};

// todo: add packed formats
/**
 * @brief use to map between vertex type and format
 *
 */
using FormatTypeInfos = toy::TypePack<
  FormatTypeInfo<VK_FORMAT_R32_SFLOAT, float>,               //
  FormatTypeInfo<VK_FORMAT_R32G32_SFLOAT, glm::vec2>,        //
  FormatTypeInfo<VK_FORMAT_R32G32B32_SFLOAT, glm::vec3>,     //
  FormatTypeInfo<VK_FORMAT_R32G32B32A32_SFLOAT, glm::vec4>,  //
  FormatTypeInfo<VK_FORMAT_R64_SFLOAT, double>,              //
  FormatTypeInfo<VK_FORMAT_R64G64_SFLOAT, glm::dvec2>,       //
  FormatTypeInfo<VK_FORMAT_R64G64B64_SFLOAT, glm::dvec3>,    //
  FormatTypeInfo<VK_FORMAT_R64G64B64A64_SFLOAT, glm::dvec4>, //
  FormatTypeInfo<VK_FORMAT_R32_SINT, int>,                   //
  FormatTypeInfo<VK_FORMAT_R32G32_SINT, glm::ivec2>,         //
  FormatTypeInfo<VK_FORMAT_R32G32B32_SINT, glm::ivec3>,      //
  FormatTypeInfo<VK_FORMAT_R32G32B32A32_SINT, glm::ivec4>,   //
  FormatTypeInfo<VK_FORMAT_R32_UINT, uint32>,                //
  FormatTypeInfo<VK_FORMAT_R32G32_UINT, glm::uvec2>,         //
  FormatTypeInfo<VK_FORMAT_R32G32B32_UINT, glm::uvec3>,      //
  FormatTypeInfo<VK_FORMAT_R32G32B32A32_UINT, glm::uvec4>>;

template <typename Type>
consteval auto typeToFormat() -> VkFormat {
  return FormatTypeInfos::filter<[]<typename T>() {
    return std::same_as<typename T::type, Type>;
  }>::template at<0>::format;
}
template <VkFormat format>
using formatToType =
  FormatTypeInfos::filter<[]<typename T>() { return T::format == format; }>::template at<0>::type;

/**
 * @brief use to get the size of a format store in buffer or image
 */
constexpr auto getFormatSize(VkFormat format) -> uint32 {

#define FROM_TYPE(format)                                                                          \
  case format:                                                                                     \
    return sizeof(formatToType<format>);

  switch (format) {
    FROM_TYPE(VK_FORMAT_R32_SFLOAT);
    FROM_TYPE(VK_FORMAT_R32G32_SFLOAT);
    FROM_TYPE(VK_FORMAT_R32G32B32_SFLOAT);
    FROM_TYPE(VK_FORMAT_R32G32B32A32_SFLOAT);
    FROM_TYPE(VK_FORMAT_R64_SFLOAT);
    FROM_TYPE(VK_FORMAT_R64G64_SFLOAT);
    FROM_TYPE(VK_FORMAT_R64G64B64_SFLOAT);
    FROM_TYPE(VK_FORMAT_R64G64B64A64_SFLOAT);
    FROM_TYPE(VK_FORMAT_R32_SINT);
    FROM_TYPE(VK_FORMAT_R32G32_SINT);
    FROM_TYPE(VK_FORMAT_R32G32B32_SINT);
    FROM_TYPE(VK_FORMAT_R32G32B32A32_SINT);
    FROM_TYPE(VK_FORMAT_R32_UINT);
    FROM_TYPE(VK_FORMAT_R32G32_UINT);
    FROM_TYPE(VK_FORMAT_R32G32B32_UINT);
    FROM_TYPE(VK_FORMAT_R32G32B32A32_UINT);
    // color and depth format that could not directly map with a type
  case VK_FORMAT_R8G8B8A8_SRGB:
  case VK_FORMAT_B8G8R8A8_SRGB:
  case VK_FORMAT_R8G8B8A8_UNORM:
  case VK_FORMAT_B8G8R8A8_UNORM:
  case VK_FORMAT_R8G8B8A8_UINT:
  case VK_FORMAT_B8G8R8A8_UINT:
  case VK_FORMAT_D24_UNORM_S8_UINT:
    return 4;
  default:
    toy::throwf("unsupported format: {}", format);
  }

#undef FROM_TYPE
}

constexpr auto _color_formats = std::array{
  VK_FORMAT_R8G8B8A8_SRGB, VK_FORMAT_R8G8B8A8_UNORM, VK_FORMAT_R8G8B8A8_UINT,
  VK_FORMAT_B8G8R8A8_SRGB, VK_FORMAT_B8G8R8A8_UNORM, VK_FORMAT_B8G8R8A8_UINT,

  VK_FORMAT_R32_UINT,
};
constexpr auto _depth_formats = std::array{
  VK_FORMAT_D16_UNORM,
  VK_FORMAT_D32_SFLOAT,
};
constexpr auto _stencil_formats = std::array{
  VK_FORMAT_S8_UINT,
};
constexpr auto _depth_stencil_formats = std::array{
  VK_FORMAT_D24_UNORM_S8_UINT,
};

} // namespace rd
