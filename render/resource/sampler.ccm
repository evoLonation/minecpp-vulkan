module;
#include <toy.h>
export module render.sampler;

import <vulkan_config.h>;
import render.resource;
import render.device;
import render.image;
import render.buffer;
import render.descriptor;
import render.copy;

import std;
import toy;

export namespace rd {

class SampledImage {
public:
  SampledImage() = default;
  SampledImage(ImageManager& image, float max_anisotropy);
  // only call when resource is NOT using as descriptor set
  void setImage(ImageManager& image) { _image = &image; }
  operator ResourceContext<VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER>();

private:
  ImageManager* _image;
  rs::Sampler   _sampler;

  static std::vector<VkFormat> _available_formats;

public:
  static auto checkPdevice(DeviceCapabilityBuilder& request) -> toy::Expected<void>;
};

class SampledTexture : toy::AutoMoveAssigner<SampledTexture> {
public:
  SampledTexture() = default;
  SampledTexture(
    std::span<std::byte const> data,
    VkFormat                   format,
    VkExtent2D                 extent,
    bool                       mipmap,
    VkPipelineStageFlagBits    use_stage
  );
  ~SampledTexture();
  SampledTexture(const SampledTexture&) noexcept = delete;
  SampledTexture(SampledTexture&&) noexcept;
  auto operator=(const SampledTexture&) noexcept -> SampledTexture& = delete;
  auto operator=(SampledTexture&&) noexcept -> SampledTexture&;

  static auto fromFile(const std::string& path, bool mipmap, VkPipelineStageFlagBits use_stage)
    -> SampledTexture;
  void writeContent(std::span<std::byte const> data);
  auto getImage() -> Image& { return _image; }
  auto getUseStage() const -> VkPipelineStageFlagBits { return _use_stage; }

  operator ResourceContext<VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER>() { return _sampled_image; }

private:
  VkPipelineStageFlagBits _use_stage;
  ImageLocalWriter        _writer;
  Image                   _image;
  SampledImage            _sampled_image;

private:
  static constexpr auto _usage =
    VkImageUsageFlags{ VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT |
                       VK_IMAGE_USAGE_TRANSFER_SRC_BIT };
  static constexpr auto _aspect = VK_IMAGE_ASPECT_COLOR_BIT;
  static inline auto    _max_anisotropy = float{};
};

} // namespace rd