export module render.alignment;

import <vulkan_config.h>;

import glm;
import toy;
import std;

import render.device;

export namespace rd::align {

namespace device_checkers {

auto alignment(DeviceCapabilityBuilder& builder) -> bool {
  return builder.enableFeature(&VkPhysicalDeviceVulkan12Features::uniformBufferStandardLayout);
}

} // namespace device_checkers

#define DEFINE_VEC(name, align)                                                                    \
  struct alignas(align) name : glm::name {                                                         \
    name(const glm::name& v) : glm::name(v) {}                                                     \
    using glm::name::name;                                                                         \
    using glm::name::operator=;                                                                    \
  };

#define DEFINE_VECS(prefix)                                                                        \
  DEFINE_VEC(prefix##2, sizeof(glm::prefix##2))                                                    \
  DEFINE_VEC(prefix##3, sizeof(glm::prefix##3) / 3 * 4)                                            \
  DEFINE_VEC(prefix##4, sizeof(glm::prefix##4))

DEFINE_VECS(vec);
DEFINE_VECS(dvec);
DEFINE_VECS(ivec);
DEFINE_VECS(uvec);

/**
 * @brief max[n]x[m] means n columns and m rows
 *
 */

#define INITIALIZER_COLUMN_2 m[0], m[1]
#define INITIALIZER_COLUMN_3 m[0], m[1], m[2]
#define INITIALIZER_COLUMN_4 m[0], m[1], m[2], m[3]
#define CONVERT_COLUMN_2 columns[0], columns[1]
#define CONVERT_COLUMN_3 columns[0], columns[1], columns[2]
#define CONVERT_COLUMN_4 columns[0], columns[1], columns[2], columns[3]
#define DEFINE_MAT_ROW3(prefix, vec, suffix, col_n)                                                \
  struct prefix##suffix {                                                                          \
    std::array<vec##3, col_n> columns;                                                             \
    prefix##suffix() = default;                                                                    \
    prefix##suffix(const glm::prefix##suffix& m) : columns{ INITIALIZER_COLUMN_##col_n } {}        \
    auto operator=(const glm::prefix##suffix& m) -> prefix##suffix& {                              \
      columns = { INITIALIZER_COLUMN_##col_n };                                                    \
      return *this;                                                                                \
    }                                                                                              \
    operator glm::prefix##suffix() const { return { CONVERT_COLUMN_##col_n }; }                    \
  };
#define DEFINE_MAT(name)                                                                           \
  struct alignas(sizeof(glm::name::col_type)) name : glm::name {                                   \
    using glm::name::name;                                                                         \
    name(const glm::name& v) : glm::name(v) {}                                                     \
    using glm::name::operator=;                                                                    \
  };
#define DEFINE_MATS(prefix, vec)                                                                   \
  DEFINE_MAT(prefix##2)                                                                            \
  DEFINE_MAT(prefix##3x2)                                                                          \
  DEFINE_MAT(prefix##4x2)                                                                          \
  DEFINE_MAT_ROW3(prefix, vec, 2x3, 2)                                                             \
  DEFINE_MAT_ROW3(prefix, vec, 3, 3)                                                               \
  DEFINE_MAT_ROW3(prefix, vec, 4x3, 4)                                                             \
  DEFINE_MAT(prefix##2x4)                                                                          \
  DEFINE_MAT(prefix##3x4)                                                                          \
  DEFINE_MAT(prefix##4)

DEFINE_MATS(mat, vec)
DEFINE_MATS(dmat, dvec)

} // namespace rd::align