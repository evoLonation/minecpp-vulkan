module;
#include <toy.h>
export module render.image;

import std;
import toy;

import <vulkan_config.h>;
import render.resource;
import render.memory;
import render.tracker;
import render.buffer;
import render.executor;
import render.sync;
import render.format;

export namespace rd {

auto getAspect(VkFormat format) -> VkImageAspectFlags {
  using enum FormatType;
  switch (getFormatInfo(format).type) {
  case COLOR:
    return VK_IMAGE_ASPECT_COLOR_BIT;
  case DEPTH:
    return VK_IMAGE_ASPECT_DEPTH_BIT;
  case STENCIL:
    return VK_IMAGE_ASPECT_STENCIL_BIT;
  case DEPTH_STENCIL:
    return VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT;
  }
}

struct MipRange {
  uint32 base_level;
  uint32 count;
};

auto getSubresourceRange(VkImageAspectFlags aspect, MipRange mip_range) -> VkImageSubresourceRange;

auto getSubresourceLayers(VkImageAspectFlags aspect, uint32 mip_level) -> VkImageSubresourceLayers;

auto createImage(
  VkFormat              format,
  uint32                width,
  uint32                height,
  VkImageUsageFlags     usage,
  uint32                mip_levels,
  VkSampleCountFlagBits sample_count
) -> rs::Image;

auto createImageView(VkImage image, VkFormat format, uint32 mip_levels) -> rs::ImageView;

class ImageContext : public PROACTIVE_SINGLETON(ImageContext) {
public:
  ImageContext();
  auto getAvailableSampleCounts() -> VkSampleCountFlags { return _available_sample_counts; }

private:
  VkSampleCountFlags _available_sample_counts;
};

class ImageManager {
public:
  ImageManager() = default;
  ImageManager(
    VkImage               image,
    VkImageView           image_view,
    VkImageUsageFlags     usage,
    VkExtent2D            extent,
    VkFormat              format,
    uint32                mip_levels,
    VkSampleCountFlagBits sample_count
  )
    : _image(image), _image_view(image_view),
      _tracker(image, getSubresourceRange(getAspect(format), MipRange{ 0, mip_levels })),
      _usage(usage), _extent(extent), _format(format), _sample_count(sample_count),
      _mip_levels(mip_levels) {}

  auto getImage() -> VkImage { return _image; }
  auto getImageView() -> VkImageView { return _image_view; }
  auto getTracker() -> ImageBarrierTracker& { return _tracker; }
  auto getUsage() -> VkImageUsageFlags { return _usage; }
  auto getExtent() -> VkExtent2D { return _extent; }
  auto getFormat() -> VkFormat { return _format; }
  auto getSampleCount() -> VkSampleCountFlagBits { return _sample_count; }
  auto getMipLevels() -> uint32 { return _mip_levels; }
  auto valid() -> bool { return _tracker.valid(); }

private:
  VkImage               _image;
  VkImageView           _image_view;
  ImageBarrierTracker   _tracker;
  VkImageUsageFlags     _usage;
  VkExtent2D            _extent;
  VkFormat              _format;
  VkSampleCountFlagBits _sample_count;
  uint32                _mip_levels;
};

struct ImageResource {
public:
  ImageResource() = default;
  ImageResource(
    VkFormat              format,
    uint32                width,
    uint32                height,
    VkImageUsageFlags     usage,
    uint32                mip_levels,
    VkSampleCountFlagBits sample_count
  );
  ImageResource(ImageResource&&) noexcept = default;
  auto operator=(ImageResource&& e) noexcept -> ImageResource&;

protected:
  rs::Image     _image;
  Memory        _memory;
  rs::ImageView _image_view;
};

struct Image : public ImageResource, public ImageManager {
public:
  Image() = default;
  Image(
    VkFormat              format,
    uint32                width,
    uint32                height,
    VkImageUsageFlags     usage,
    uint32                mip_levels,
    VkSampleCountFlagBits sample_count
  );
  Image(Image&&) noexcept = default;
  auto operator=(Image&& e) noexcept -> Image&;
};

} // namespace rd