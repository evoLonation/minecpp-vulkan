export module render.buffer;

import std;
import toy;

import <vulkan_config.h>;
import render.resource;
import render.memory;
import render.tracker;
import render.descriptor;

export namespace rd {

auto createBuffer(VkDeviceSize buffer_size, VkBufferUsageFlags usage) -> rs::Buffer;

class Buffer : public rs::Buffer {
public:
  Buffer() = default;
  Buffer(VkDeviceSize buffer_size, VkBufferUsageFlags usage, VkMemoryPropertyFlags property_flags)
    : _size(buffer_size), rs::Buffer{ createBuffer(buffer_size, usage) },
      _memory{ get(), property_flags }, _tracker{ get() } {}
  auto getMemory() const -> VkDeviceMemory { return _memory; }
  auto getTracker() -> BufferBarrierTracker& { return _tracker; }
  auto size() const -> VkDeviceSize { return _size; }

  Buffer(Buffer&&) noexcept = default;
  auto operator=(Buffer&& e) noexcept -> Buffer&;

private:
  VkDeviceSize         _size;
  Memory               _memory;
  BufferBarrierTracker _tracker;
};

class HostBuffer : public Buffer {
public:
  HostBuffer() = default;
  HostBuffer(VkDeviceSize buffer_size, VkBufferUsageFlags usage)
    : Buffer(buffer_size, usage, HostMemoryManager::propreties),
      _memory(Buffer::getMemory(), buffer_size) {}
  HostBuffer(std::span<std::byte const> buffer_data, VkBufferUsageFlags usage)
    : HostBuffer(buffer_data.size(), usage) {
    getMemory().fill(buffer_data);
  }
  auto getMemory() -> HostMemoryManager& { return _memory; }

  HostBuffer(HostBuffer&&) noexcept = default;
  auto operator=(HostBuffer&& e) noexcept -> HostBuffer&;

private:
  HostMemoryManager _memory;
};

class StagingBuffer : public HostBuffer {
public:
  StagingBuffer() = default;
  StagingBuffer(VkDeviceSize buffer_size)
    : HostBuffer(buffer_size, VK_BUFFER_USAGE_TRANSFER_SRC_BIT) {}
  StagingBuffer(std::span<std::byte const> buffer_data)
    : HostBuffer(buffer_data, VK_BUFFER_USAGE_TRANSFER_SRC_BIT) {}
};

/**
 * @tparam DataType : all vec and matrix member must be from rd::align
 */
template <typename DataType>
  requires std::is_trivially_copyable_v<DataType> &&
             std::is_trivially_default_constructible_v<DataType>
class UniformBuffer : private HostBuffer, public DescriptorResource {
public:
  UniformBuffer() : UniformBuffer(DataType{}) {}
  UniformBuffer(DataType const& data)
    : HostBuffer(
        std::as_bytes(std::span<DataType const>{ &data, 1 }), VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT
      ),
      DescriptorResource{ VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER } {}

  void update(DataType const& data) {
    // because uniform is read only, so no need to execute available operation from device to host
    getTracker().waitIdle();
    getMemory().fill(std::as_bytes(std::span<DataType const>{ &data, 1 }));
    getTracker().clearScope();
  }
  auto read() -> DataType {
    DataType data;
    auto     writable = std::as_writable_bytes(std::span<DataType>{ &data, 1 });
    ranges::copy(getMemory().data(), writable.begin());
    return data;
  }
  auto getDescriptorContext() -> Context override {
    return BufferContext{
      .dscriptor_info =
        VkDescriptorBufferInfo{
          .buffer = get(),
          .offset = 0,
          .range = VK_WHOLE_SIZE,
        },
      .tracker = &getTracker(),
    };
  }
};

class DeviceLocalBuffer : public Buffer {
public:
  DeviceLocalBuffer() = default;
  DeviceLocalBuffer(std::span<std::byte const> buffer_data, VkBufferUsageFlags usage);

private:
  // todo: destroy after transfer
  StagingBuffer _staging_buffer;
};

void recordCopyBuffer(
  VkCommandBuffer transfer_cmdbuf,
  VkBuffer        src_buffer,
  VkBuffer        dst_buffer,
  VkDeviceSize    buffer_size
);

} // namespace rd