module;
#include <toy.h>
export module render.descriptor;
import std;
import toy;

import render.resource;
import render.executor;
import render.tracker;
import render.sync;

import <vulkan_config.h>;

export namespace rd {

struct BindingInfo {
  VkDescriptorType   type;
  VkShaderStageFlags stage;
  uint32             count;
};

class DescriptorSetLayout : public rs::DescriptorSetLayout {
public:
  DescriptorSetLayout() = default;
  DescriptorSetLayout(std::vector<BindingInfo> infos);
  auto getInfo() const -> std::span<BindingInfo const> { return _infos; }

private:
  std::vector<BindingInfo> _infos;
};

/**
 * @brief when consumed by some batch, need add the waitable to dset and call waitIdle to
 * wait all batches to execution done
 * note: can not destruct when has valid handle, need recycled by pool
 */
class ReusableDescriptorSet : toy::AutoMoveAssigner<ReusableDescriptorSet>,
                              public rs::DescriptorSet {
public:
  ReusableDescriptorSet() = default;
  ReusableDescriptorSet(rs::DescriptorSet dset, DescriptorSetLayout* layout)
    : rs::DescriptorSet{ std::move(dset) }, _layout{ layout } {}

  void addWaitable(std::shared_ptr<Waitable> waitable);
  auto waitIdle(uint64 nano_timeout = max_timeout) -> bool;
  auto getInfo() -> std::span<BindingInfo const> { return _layout->getInfo(); }
  auto getLayout() -> VkDescriptorSetLayout { return _layout->get(); }

  auto valid() const -> bool { return get(); }

  REGISTER_BEFORE_DESTROY(ReusableDescriptorSet, { TOY_CHECK(!valid()); })

private:
  DescriptorSetLayout*                   _layout;
  std::vector<std::shared_ptr<Waitable>> _waitables;

  void removeIdles();
};

class DescriptorPool : public toy::ObjectPoolHelper<ReusableDescriptorSet>,
                       public DescriptorSetLayout {
public:
  DescriptorPool() = default;
  DescriptorPool(std::vector<BindingInfo> infos);

  void recycle(ReusableDescriptorSet dset);

  ~DescriptorPool() { beforeDestroy_(); }

private:
  std::set<std::pair<size_t, VkDescriptorPool>, std::greater<>> _pool_counts;
  using PoolResource = std::pair<rs::DescriptorPool, rs::DescriptorSets>;
  std::unordered_map<VkDescriptorPool, PoolResource> _resources;
  std::vector<ReusableDescriptorSet>                 _working_resources;

  // used for create resources
  VkDescriptorPoolCreateInfo         _pool_info;
  // all the same
  std::vector<VkDescriptorSetLayout> _dset_layouts;
  std::vector<VkDescriptorPoolSize>  _pool_sizes;

  static constexpr auto _allocate_count = 5;

  friend toy::ObjectPoolHelper<ReusableDescriptorSet>;
  auto extract() -> ReusableDescriptorSet;
  auto isEmpty() -> bool;
  void expand();
  void tryShrink();
  void workingToIdle();

  void beforeDestroy_();
};

// ResourceContext contains resource's information needed by descriptor set and sync.
// NOTE: When create a dset using ResourceContext, the real resource can not being destroyed (or
// moved because hold the ptr of tracker) until the dset is destroyed
struct ImageResourceContext {
  VkDescriptorImageInfo dscriptor_info;
  ImageBarrierTracker*  tracker;
};
struct BufferResourceContext {
  VkDescriptorBufferInfo dscriptor_info;
  BufferBarrierTracker*  tracker;
};
template <VkDescriptorType type>
struct ResourceContext;
template <VkDescriptorType type>
  requires(type == VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER)
struct ResourceContext<type> : BufferResourceContext {};
template <VkDescriptorType type>
  requires(type == VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER)
struct ResourceContext<type> : ImageResourceContext {};

// a array of ResourceContext
struct ResourceBinding {
public:
  template <VkDescriptorType type>
  ResourceBinding(std::span<ResourceContext<type> const> resources) {
    _type = type;
    _resources = //
      resources | views::transform([](auto& ctx) {
        if constexpr (std::derived_from<std::remove_cvref_t<decltype(ctx)>, ImageResourceContext>) {
          return static_cast<ImageResourceContext>(ctx);
        } else {
          return static_cast<BufferResourceContext>(ctx);
        }
      }) |
      ranges::to<std::vector>();
  }
  template <VkDescriptorType type>
  ResourceBinding(std::span<ResourceContext<type>> resources)
    : ResourceBinding{ std::span<ResourceContext<type> const>{ resources } } {}
  template <VkDescriptorType type>
  ResourceBinding(std::initializer_list<ResourceContext<type>> resources)
    : ResourceBinding{ std::span{ resources } } {}
  template <VkDescriptorType type>
  ResourceBinding(ResourceContext<type> resource_ctx)
    : ResourceBinding{ std::span{ &resource_ctx, 1 } } {}

  auto getType() const -> VkDescriptorType { return _type; }
  auto size() const -> size_t {
    return std::visit([](auto const& ctxs) { return ctxs.size(); }, _resources);
  }
  using ImageContexts = std::span<ImageResourceContext const>;
  using BufferContexts = std::span<BufferResourceContext const>;
  using VariantContexts = std::variant<ImageContexts, BufferContexts>;
  auto getResourceContexts() const -> VariantContexts {
    if (auto* p = std::get_if<std::vector<ImageResourceContext>>(&_resources)) {
      return std::span{ p->begin(), p->end() };
    } else {
      auto& r = std::get<std::vector<BufferResourceContext>>(_resources);
      return std::span{ r.begin(), r.end() };
    }
  }

private:
  VkDescriptorType _type;
  using VariantContextVector =
    std::variant<std::vector<ImageResourceContext>, std::vector<BufferResourceContext>>;
  VariantContextVector _resources;
};

class DescriptorSet : public toy::RecyclableObject<DescriptorPool, ReusableDescriptorSet> {
public:
  DescriptorSet() = default;
  DescriptorSet(DescriptorPool* pool, std::initializer_list<ResourceBinding> bindings);
  auto getResourceBindings() const -> std::span<ResourceBinding const> {
    return _resource_bindings;
  }

private:
  std::vector<ResourceBinding> _resource_bindings;
};

struct PushConstantInfo {
  VkShaderStageFlags stage;
  uint32             size;
  uint32             alignment;

  template <typename T>
  static auto get(VkShaderStageFlags stage) -> PushConstantInfo {
    return { stage, sizeof(T), alignof(T) };
  }
};

/**
 * @brief guaranteed at least 128 bytes on all devices
 */
auto getPushConstantRanges(std::span<PushConstantInfo const> infos) //
  -> std::vector<VkPushConstantRange>;

} // namespace rd