export module render.pipeline;

import <vulkan_config.h>;
import render.resource;
import render.vertex;

import std;

export namespace rd {

auto createShaderModule(std::string_view filename) -> rs::ShaderModule;
auto createPipelineLayout(std::span<VkDescriptorSetLayout const> dset_layouts) //
  -> rs::PipelineLayout;

struct StencilOption {
  VkStencilOpState front;
  VkStencilOpState back;

  bool dynamic_reference;
};

struct DepthOption {
  VkCompareOp compare_op;
  bool        overwrite;
};

auto createGraphicsPipeline(
  VkRenderPass                                       render_pass,
  uint32                                             subpass_i,
  VkShaderModule                                     vertex_shader,
  VkShaderModule                                     frag_shader,
  VkPipelineLayout                                   layout,
  VkPrimitiveTopology                                topology,
  VkCullModeFlagBits                                 cull_mode,
  VkSampleCountFlagBits                              sample_count,
  std::optional<StencilOption>                       stencil_option,
  std::optional<DepthOption>                         depth_option,
  std::span<VkVertexInputBindingDescription const>   vertex_bindings,
  std::span<VkVertexInputAttributeDescription const> vertex_attribs
) -> rs::Pipeline;

struct PipelineInfo {
  VkRenderPass                       render_pass;
  uint32                             subpass_i;
  std::string                        vertex_shader_name;
  std::string                        frag_shader_name;
  std::vector<VkDescriptorSetLayout> dset_layouts;
  VkPrimitiveTopology                topology;
  VkCullModeFlagBits                 cull_mode;
  VkSampleCountFlagBits              sample_count;
  std::optional<StencilOption>       stencil_option;
  std::optional<DepthOption>         depth_option;
  VertexInfo                         vertex_info;
};

struct Pipeline {
public:
  Pipeline(const PipelineInfo& info);
  auto getPipeline() -> VkPipeline { return _pipeline; }
  auto getLayout() -> VkPipelineLayout { return _layout; }

private:
  rs::ShaderModule   _vertex_shader;
  rs::ShaderModule   _frag_shader;
  rs::PipelineLayout _layout;
  rs::Pipeline       _pipeline;
};

} // namespace rd