module;
#include <toy.h>

export module render.render_pass;

import <vulkan_config.h>;
import render.resource;
import render.buffer;
import render.descriptor;
import render.pipeline;
import render.framebuffer;
import render.vertex;
import render.executor;
import render.device;
import render.format;
import render.submitter;

import std;
import toy;

export namespace rd {

namespace device_checkers {
auto attachment(DeviceCapabilityBuilder&) -> bool;
} // namespace device_checkers

enum LoadOp {
  DONT_CARE,
  LOAD,
  CLEAR,
};

struct AttachmentInfo {
  VkFormat              format;
  VkSampleCountFlagBits sample_count;
  LoadOp                load_op = LoadOp::DONT_CARE;
  bool                  is_store = true;
};

struct SubpassInfo {
  // if resolves has value, every color attachment in colors must has the same sample_count
  std::vector<uint32> colors;
  struct MultiSample {
    // size must equal to colors
    std::vector<std::optional<uint32>> resolves;
    // must not sample_1
    VkSampleCountFlagBits sample_count;
  };
  std::optional<MultiSample> multi_sample;
  std::optional<uint32>      depst;
  std::vector<uint32>        inputs;
};
struct AttachmentSyncInfo {
  VkPipelineStageFlagBits2 initial_stage;
  VkPipelineStageFlagBits2 final_stage;
  VkImageLayout            initial_layout;
  VkImageLayout            final_layout;
};

struct ColorClearValue {
  VkClearColorValue clear_value;
  ComponentType     component_n;
  ScalarType        scalar_type;
  ColorClearValue(uint32 r)
    : clear_value({ .uint32 = { r } }), component_n(ComponentType::NUM_1),
      scalar_type(ScalarType::UINT) {}
  ColorClearValue(float r)
    : clear_value({ .float32 = { r } }), component_n(ComponentType::NUM_1),
      scalar_type(ScalarType::DEST_FLOAT) {}
  ColorClearValue(int32 r)
    : clear_value({ .int32 = { r } }), component_n(ComponentType::NUM_1),
      scalar_type(ScalarType::SINT) {}
  ColorClearValue(uint32 r, uint32 g)
    : clear_value({ .uint32 = { r, g } }), component_n(ComponentType::NUM_2),
      scalar_type(ScalarType::UINT) {}
  ColorClearValue(float r, float g)
    : clear_value({ .float32 = { r, g } }), component_n(ComponentType::NUM_2),
      scalar_type(ScalarType::DEST_FLOAT) {}
  ColorClearValue(int32 r, int32 g)
    : clear_value({ .int32 = { r, g } }), component_n(ComponentType::NUM_2),
      scalar_type(ScalarType::SINT) {}
  ColorClearValue(uint32 r, uint32 g, uint32 b)
    : clear_value({ .uint32 = { r, g, b } }), component_n(ComponentType::NUM_3),
      scalar_type(ScalarType::UINT) {}
  ColorClearValue(float r, float g, float b)
    : clear_value({ .float32 = { r, g, b } }), component_n(ComponentType::NUM_3),
      scalar_type(ScalarType::DEST_FLOAT) {}
  ColorClearValue(int32 r, int32 g, int32 b)
    : clear_value({ .int32 = { r, g, b } }), component_n(ComponentType::NUM_3),
      scalar_type(ScalarType::SINT) {}
  ColorClearValue(uint32 r, uint32 g, uint32 b, uint32 a)
    : clear_value({ .uint32 = { r, g, b, a } }), component_n(ComponentType::NUM_4),
      scalar_type(ScalarType::UINT) {}
  ColorClearValue(float r, float g, float b, float a)
    : clear_value({ .float32 = { r, g, b, a } }), component_n(ComponentType::NUM_4),
      scalar_type(ScalarType::DEST_FLOAT) {}
  ColorClearValue(int32 r, int32 g, int32 b, int32 a)
    : clear_value({ .int32 = { r, g, b, a } }), component_n(ComponentType::NUM_4),
      scalar_type(ScalarType::SINT) {}

  void checkFormat(VkFormat format) {
    auto info = getFormatInfo(format);
    TOY_ASSERT(info.type == FormatType::COLOR && (info.color.scalar & scalar_type));
    TOY_ASSERT(component_n & info.color.components);
  }
};

struct DepstClearValue {
  VkClearDepthStencilValue clear_value;
  FormatType               type;
  DepstClearValue(float depth, uint32 stencil)
    : clear_value(depth, stencil), type(FormatType::DEPTH_STENCIL) {}
  DepstClearValue(float depth) : clear_value{ .depth = depth }, type(FormatType::DEPTH) {}
  DepstClearValue(uint32 stencil) : clear_value{ .stencil = stencil }, type(FormatType::STENCIL) {}

  void checkFormat(VkFormat format) {
    auto info = getFormatInfo(format);
    TOY_ASSERT(info.type == type, (int)info.type, (int)type);
  }
};

class RenderPass : public rs::RenderPass {
public:
  RenderPass() = default;
  RenderPass(std::span<AttachmentInfo const> attachments, std::span<SubpassInfo const> subpasses);
  auto getSyncInfos() const -> std::span<AttachmentSyncInfo const> { return _attachment_syncs; }
  void setDepstClear(uint32 index, DepstClearValue value) {
    value.checkFormat(_formats.at(index));
    _clear_values[index] = VkClearValue{ .depthStencil = value.clear_value };
    _is_set_clears[index] = true;
  }
  void setColorClear(uint32 index, ColorClearValue value) {
    value.checkFormat(_formats.at(index));
    _clear_values[index] = VkClearValue{ .color = value.clear_value };
    _is_set_clears[index] = true;
  }
  auto record(
    std::function<void(Submitter&)> const&                            synchronizer,
    std::span<FrameImageManager* const>                               images,
    std::span<std::function<void(VkCommandBuffer, VkExtent2D)> const> pipeline_recorders
  ) -> Waitable;

  static auto getFamilyType() -> FamilyType { return _family_type; }

private:
  std::vector<VkFormat>              _formats;
  std::vector<VkSampleCountFlagBits> _sample_counts;
  std::vector<bool>                  _need_clears;
  std::vector<bool>                  _is_set_clears;
  std::vector<AttachmentSyncInfo>    _attachment_syncs;
  std::vector<VkClearValue>          _clear_values;

  static inline FamilyType _family_type = FamilyType::GRAPHICS;
};

struct DepstOption {
  uint32                       attachment;
  std::optional<DepthOption>   depth;
  std::optional<StencilOption> stencil;
};

struct SubpassPipelineInfo {
  std::vector<uint32>                     colors;
  std::vector<uint32>                     inputs;
  std::optional<SubpassInfo::MultiSample> multi_sample;
  std::optional<DepstOption>              depst;
  std::string                             vertex_shader_name;
  std::string                             frag_shader_name;
  VkPrimitiveTopology                     topology;
  VkCullModeFlagBits                      cull_mode;
  VertexLayout                            vertex_layout;
  std::vector<VkDescriptorSetLayout>      dset_layouts;
  std::vector<PushConstantInfo>           push_constants;
};

class RenderPassPipeline : toy::AutoMoveAssigner<RenderPassPipeline>, private RenderPass {
public:
  RenderPassPipeline() = default;
  RenderPassPipeline(
    std::span<AttachmentInfo const> attachments, std::span<SubpassPipelineInfo const> subpasses
  );

  void setRecorder(uint32 index, PipelineRecorder recorder) {
    _recorders.at(index) = std::move(recorder);
  }
  using RenderPass::setColorClear;
  using RenderPass::setDepstClear;
  void recordDraw(std::span<FrameImageManager*> images);

  REGISTER_BEFORE_DESTROY(RenderPassPipeline, { _pipelines.clear(); })

private:
  std::vector<Pipeline>         _pipelines;
  std::vector<PipelineRecorder> _recorders;
};

} // namespace rd