module;
#include <toy.h>
export module render.framebuffer;

import <vulkan_config.h>;
import render.resource;
import render.image;
import render.device;
import render.format;

import std;
import toy;

export namespace rd {

class FramebufferPool;

class FrameImageManager : toy::AutoMoveAssigner<FrameImageManager>, public ImageManager {
public:
  FrameImageManager() = default;
  FrameImageManager(
    VkImage                 image,
    VkImageView             image_view,
    VkExtent2D              extent,
    VkFormat                format,
    VkSampleCountFlagBits   sample_count,
    VkImageSubresourceRange sub_range
  )
    : ImageManager(image, image_view, extent, format, sample_count, sub_range) {}

  REGISTER_BEFORE_DESTROY(FrameImageManager);

private:
  void beforeDestroy();
};

class FramebufferPool : public PROACTIVE_SINGLETON(FramebufferPool) {
public:
  FramebufferPool() : _use_counter(0) {}

  auto getFramebuffer(VkRenderPass render_pass, std::span<FrameImageManager* const> images)
    -> std::pair<VkFramebuffer, VkExtent2D>;

private:
  // _image_views2framebuffer cannot be unordered map because:
  // 1. key(std::vector<VkImageView>) is pointed by _image_view2image_views, so can not invalid
  // 2. key(std::vector<VkImageView>) is not hashable
  std::unordered_map<VkFramebuffer, rs::Framebuffer>                 _framebuffers;
  std::map<std::vector<VkImageView>, VkFramebuffer>                  _image_views2framebuffer;
  std::unordered_map<VkFramebuffer, std::vector<VkImageView> const*> _framebuffer2image_views;
  std::unordered_map<VkImageView, std::unordered_set<VkFramebuffer>> _image_view2framebuffers;

  // LRU: removed longest time unused framebuffer
  std::map<uint64, VkFramebuffer>           _counter2framebuffer;
  std::unordered_map<VkFramebuffer, uint64> _framebuffer2counter;

  uint64                _use_counter;
  static constexpr auto _max_capacity = 10;

  friend PROACTIVE_SINGLETON(FramebufferPool);
  friend FrameImageManager;

  void check(std::source_location loc = std::source_location::current());

  void destroyRelativeFramebuf(FrameImageManager& image);
};

class FrameImage : public ImageResource, public FrameImageManager {
public:
  FrameImage() = default;

  FrameImage(
    VkFormat              format,
    uint32                width,
    uint32                height,
    VkSampleCountFlagBits sample_count,
    VkImageUsageFlags     usage
  )
    : ImageResource(
        format,
        width,
        height,
        toUsage(getFormatInfo(format).type) | usage,
        toAspect(getFormatInfo(format).type),
        1,
        sample_count
      ),
      FrameImageManager(
        ImageResource::_image,
        ImageResource::_image_view,
        VkExtent2D{ width, height },
        format,
        sample_count,
        getSubresourceRange(toAspect(getFormatInfo(format).type), MipRange{ 0, 1 })
      ) {}

  FrameImage& operator=(FrameImage&& e) noexcept {
    FrameImageManager::operator=(std::move(e));
    ImageResource::operator=(std::move(e));
    return *this;
  }
  FrameImage(FrameImage&& e) noexcept = default;

private:
  static auto toUsage(FormatType type) -> VkImageUsageFlags {
    using enum FormatType;
    switch (type) {
    case COLOR:
      return VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
    case DEPTH:
    case STENCIL:
    case DEPTH_STENCIL:
      return VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT;
    }
  }
  static auto toAspect(FormatType type) -> VkImageAspectFlags {
    using enum FormatType;
    switch (type) {
    case COLOR:
      return VK_IMAGE_ASPECT_COLOR_BIT;
    case DEPTH:
      return VK_IMAGE_ASPECT_DEPTH_BIT;
    case STENCIL:
      return VK_IMAGE_ASPECT_STENCIL_BIT;
    case DEPTH_STENCIL:
      return VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT;
    }
  }
};

} // namespace rd
