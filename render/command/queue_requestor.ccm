export module render.queue_requestor;

import <vulkan_config.h>;
import render.device;
import render.executor;

import std;

export namespace rd {

struct QueueFamilyCheckContext {
  VkPhysicalDevice        device;
  size_t                  index;
  VkQueueFamilyProperties properties;
};

using QueueFamilyChecker = std::function<bool(QueueFamilyCheckContext)>;

struct QueueFamilyRequirement {
  FamilyType         family;
  QueueFamilyChecker checker;
  uint32             queue_count;
};

auto getGraphicQueueChecker() -> QueueFamilyChecker {
  return [](const QueueFamilyCheckContext& ctx) -> bool {
    return ctx.properties.queueFlags & VK_QUEUE_GRAPHICS_BIT;
  };
}

auto getPresentQueueChecker(VkSurfaceKHR surface) -> QueueFamilyChecker {
  return [surface](const QueueFamilyCheckContext& ctx) -> bool {
    VkBool32 presentSupport = VK_FALSE;
    vkGetPhysicalDeviceSurfaceSupportKHR(ctx.device, ctx.index, surface, &presentSupport);
    return presentSupport == VK_TRUE;
  };
}

auto getTransferQueueChecker() -> QueueFamilyChecker {
  return [](const QueueFamilyCheckContext& ctx) -> bool {
    // 支持 graphics 和 compute operation 的 queue 也必定支持 transfer operation
    return ctx.properties.queueFlags &
           (VK_QUEUE_TRANSFER_BIT | VK_QUEUE_COMPUTE_BIT | VK_QUEUE_GRAPHICS_BIT);
  };
}

class QueueRequestor {
public:
  QueueRequestor(VkSurfaceKHR surface) {
    _requirements = {
      { FamilyType::GRAPHICS, getGraphicQueueChecker(), 1 },
      { FamilyType::PRESENT, getPresentQueueChecker(surface), 1 },
      { FamilyType::TRANSFER, getTransferQueueChecker(), 1 },
    };
  }
  auto checkPdevice(DeviceCapabilityBuilder& request) -> std::expected<void, std::string>;
  /**
   * @brief call after @ref rd::Device is constructed
   */
  auto createExecutorManager() -> std::unique_ptr<ExecutorManager> {
    return std::make_unique<ExecutorManager>(
      _family_infos[rd::Device::getInstance().getPdevice().get()]
    );
  }

private:
  std::vector<QueueFamilyRequirement> _requirements;
  std::unordered_map<VkPhysicalDevice, std::vector<std::pair<FamilyType, FamilyQueueCount>>>
    _family_infos;
};

} // namespace rd