module;
#include <toy.h>
export module render.executor;
import std;
import toy;

import render.sync;
import render.resource;
import render.device;

import <vulkan_config.h>;

export namespace rd {

/**
 * @brief a command buffer bind to a timeline semaphore
 * note: must exeucte one record and submit (with signal info) before each reset
 */
class CommandBuffer : toy::AutoMoveAssigner<CommandBuffer>, public rs::CommandBuffer {
public:
  /**
   * @param cmdbuf must is a newly created command buffer
   */
  CommandBuffer(rs::CommandBuffer cmdbuf) : rs::CommandBuffer(std::move(cmdbuf)) {}

  void record(std::function<void(VkCommandBuffer cmdbuf)> const& recorder);
  auto getSema() -> IncrementalSemaphore& { return _sema; }
  auto valid() const -> bool { return get(); }

  REGISTER_BEFORE_DESTROY(CommandBuffer, {
    if (_sema.valid()) {
      _sema.wait();
    }
  })

private:
  IncrementalSemaphore _sema;
};

class CommandBufferPool : public toy::ObjectPoolHelper<CommandBuffer> {
public:
  using Base = toy::ObjectPoolHelper<CommandBuffer>;
  friend Base;
  CommandBufferPool(uint32 family_index);

  void recycle(CommandBuffer cmdbuf) { _working_cmdbufs.push_back(std::move(cmdbuf)); }

  UNCOPYABLE_MOVEABLE(CommandBufferPool);

private:
  rs::CommandPool            _pool;
  std::vector<CommandBuffer> _idle_cmdbufs;
  std::list<CommandBuffer>   _working_cmdbufs;

  void workingToIdle();
  void expand();
  void tryShrink();
  auto extract() -> CommandBuffer;
  auto isEmpty() -> bool { return _idle_cmdbufs.empty(); }
};

/**
 * @brief Must used (submit cmdbuf and signal) before destroy
 */
using DisposableCmdbuf = toy::RecyclableObject<CommandBufferPool, CommandBuffer>;

/**
 * @brief Have ownership of cmdbuf will be submitted to and semaphores will be signaled by
 * submission of the cmdbuf, user can use it to waited by another submit or host.
 * As long as the object is not destroyed, these semaphores and cmdbuf will remain associated
 * with this submission and will not be recycled.
 */
class Waitable {
public:
  using StageSemaphoreMap = std::unordered_map<VkPipelineStageFlags2, DisposableSemaphore>;
  Waitable(DisposableCmdbuf cmdbuf, StageSemaphoreMap stage_semas)
    : _stage_semas(std::move(stage_semas)), _cmdbuf(std::move(cmdbuf)) {}

  auto wait(
    VkPipelineStageFlags2 stage = VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
    uint64                nano_timeout = max_timeout
  ) -> bool;
  static auto wait(
    std::span<std::pair<Waitable*, VkPipelineStageFlags2> const> waits,
    bool                                                         any = false,
    uint64                                                       nano_timeout = max_timeout
  ) -> bool;
  auto getWaitInfo(VkPipelineStageFlags2 stage) -> std::pair<VkSemaphore, uint64>;

  UNCOPYABLE(Waitable);
  DEFAULT_MOVEABLE(Waitable);

private:
  DisposableCmdbuf  _cmdbuf;
  StageSemaphoreMap _stage_semas;
};

struct CommandBatch {
  using WaitInfo = std::pair<Waitable*, VkPipelineStageFlags2>;
  using RawWaitInfo = std::pair<VkSemaphore, VkPipelineStageFlags2>;
  using RawSignalInfo = std::pair<VkSemaphore, VkPipelineStageFlags2>;
  using SignalInfo = VkPipelineStageFlags2;
  std::function<void(VkCommandBuffer)> recorder;
  std::vector<WaitInfo>                waits;
  std::vector<SignalInfo>              signals;
  std::vector<RawWaitInfo>             raw_waits;
  std::vector<RawSignalInfo>           raw_signals;
};

class CommandExecutor {
public:
  CommandExecutor(uint32 family_index, uint32 queue_index, TimelineSemaphorePool* sema_pool)
    : _family_index(family_index), _cmdbuf_pool(family_index), _sema_pool(sema_pool) {
    vkGetDeviceQueue(Device::getInstance(), family_index, queue_index, &_queue);
  }
  auto submit(std::function<void(VkCommandBuffer)> recorder) -> Waitable {
    auto batch = CommandBatch{ std::move(recorder), {}, {}, {}, {} };
    return submit(batch);
  }
  auto submit(CommandBatch const& batch) -> Waitable;

  auto submit(std::span<CommandBatch const> batches) -> std::vector<Waitable>;

  auto getFamily() const -> uint32 { return _family_index; }
  auto getQueue() const -> VkQueue { return _queue; }

  UNCOPYABLE_MOVEABLE(CommandExecutor);

private:
  struct SubmitInfo {
    VkSubmitInfo2                              info;
    std::vector<VkSemaphoreSubmitInfo>         wait_infos;
    std::vector<VkSemaphoreSubmitInfo>         signal_infos;
    std::unique_ptr<VkCommandBufferSubmitInfo> cmdbuf_info;
  };

  auto getWaitInfos(std::vector<CommandBatch::WaitInfo> const& waits)
    -> std::vector<VkSemaphoreSubmitInfo>;
  auto getWaitInfos(std::vector<CommandBatch::RawWaitInfo> const& raw_waits)
    -> std::vector<VkSemaphoreSubmitInfo>;

  auto getCmdbufSignalInfo(CommandBuffer& cmdbuf) -> VkSemaphoreSubmitInfo;
  auto getSignalInfos(std::vector<CommandBatch::RawSignalInfo> const& signals)
    -> std::pair<std::vector<VkSemaphoreSubmitInfo>, Waitable::StageSemaphoreMap>;
  auto getSignalInfos(std::vector<CommandBatch::SignalInfo> const& signals)
    -> std::pair<std::vector<VkSemaphoreSubmitInfo>, Waitable::StageSemaphoreMap>;

  auto getSubmitInfo(CommandBatch const& batch) -> std::pair<SubmitInfo, Waitable>;

private:
  uint32  _family_index;
  VkQueue _queue;

  CommandBufferPool      _cmdbuf_pool;
  TimelineSemaphorePool* _sema_pool;
};

enum class FamilyType {
  GRAPHICS,
  TRANSFER,
  PRESENT,
};

// template <typename EnumT>
using EnumT = FamilyType;
class ExecutorManager : public PROACTIVE_SINGLETON(ExecutorManager) {
public:
  ExecutorManager(std::span<std::pair<EnumT, FamilyQueueCount> const> family_infos);

  auto getExecutor(uint32 family, uint32 queue_index = 0) -> CommandExecutor& {
    return _executors.at(family).at(queue_index);
  }
  auto getExecutor(EnumT family, uint32 queue_index = 0) -> CommandExecutor& {
    return getExecutor(_families.at(family), queue_index);
  }

  auto getFamilyIndex(EnumT family) -> uint32 { return _families.at(family); }

  auto operator[](auto... args) -> CommandExecutor& { return getExecutor(args...); }

  UNCOPYABLE_MOVEABLE(ExecutorManager);

private:
  TimelineSemaphorePool                                   _sema_pool;
  std::unordered_map<uint32, std::deque<CommandExecutor>> _executors;
  std::unordered_map<FamilyType, uint32>                  _families;
};

} // namespace rd