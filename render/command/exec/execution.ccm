module;
#include <toy.h>
#include <vulkan_tool.h>
export module render.execution;

import render.queue;
import render.tracker2;
import render.cmdbuf;
export import render.execution0;
import render.tool;
import <vulkan_config.h>;
import render;
import std;
import toy;

export namespace rd::exec {

class Submitter {
public:
  Submitter(VkQueue queue) { _queue = queue; }
  UNCOPYABLE_MOVEABLE(Submitter)
  auto getQueue() -> VkQueue { return _queue; }
  void addWait(Execution exec, VkPipelineStageFlags2 stage) {
    _batch.waits.push_back({ stage, std::move(exec) });
  }
  void addSignal(VkPipelineStageFlags2 stage) { _batch.signals.insert(stage); }
  void addWait(VkSemaphore semaphore, VkPipelineStageFlags2 stage) {
    _batch.raw_waits.push_back({ stage, semaphore });
  }
  void addSignal(VkSemaphore semaphore, VkPipelineStageFlags2 stage) {
    _batch.raw_signals.push_back({ stage, semaphore });
  }
  class CommandBuffer {
  public:
    CommandBuffer() = default;
    CommandBuffer(Submitter& submitter, size_t index, VkCommandBuffer cmdbuf) {
      _submitter = &submitter;
      _index = index;
      _cmdbuf = cmdbuf;
    }
    operator VkCommandBuffer() { return _cmdbuf; }
    auto getIndex() -> size_t { return _index; }
    auto get() -> VkCommandBuffer { return _cmdbuf; }
    auto getSubmitter() -> Submitter& { return *_submitter; }

  private:
    Submitter*      _submitter{};
    size_t          _index{};
    VkCommandBuffer _cmdbuf{};
  };
  auto addCommandBuffer() -> CommandBuffer {
    auto cmdbuf =
      CmdbufManager::getInstance().get(QueueManager::getInstance().getFamilyIndex(_queue));
    auto index = _batch.cmdbufs.size();
    _batch.cmdbufs.push_back(std::move(cmdbuf));
    return CommandBuffer{ *this, index, _batch.cmdbufs.back().get() };
  }
  auto getCommandBuffers() -> std::vector<CommandBuffer> {
    return _batch.cmdbufs | toy::enumerate | views::transform([this](auto x) {
             auto [index, cmdbuf] = x;
             return CommandBuffer{ *this, index, cmdbuf };
           }) |
           ranges::to<std::vector>();
  }
  auto getLastCommandBuffer() -> CommandBuffer {
    TOY_ASSERT(!_batch.cmdbufs.empty());
    auto index = _batch.cmdbufs.size() - 1;
    auto cmdbuf = _batch.cmdbufs.back().get();
    return CommandBuffer{ *this, index, cmdbuf };
  }

  auto submit() -> Execution { return Execution{ _queue, std::move(_batch) }; }

private:
  VkQueue      _queue{};
  CommandBatch _batch;
};

class Synchronizer {
public:
  Synchronizer(VkBuffer buffer) : _buffer(buffer) {}
  UNCOPYABLE_MOVEABLE(Synchronizer)
  void startExecution(Submitter& submitter) {
    _now_submitter = &submitter;
    TOY_ASSERT(!_is_recording);
    _is_recording = true;
  }
  void endExecution(Execution execution) {
    TOY_ASSERT(_synced_in_exec);
    TOY_ASSERT(_is_recording);
    _is_recording = false;
    _prev_exec = std::move(execution);
  }
  // diff family or queue only happens in the first time after call startExecution
  void sync(Scope scope, std::optional<Submitter::CommandBuffer> cmdbuf = std::nullopt) {
    TOY_ASSERT(_is_recording);
    _synced_in_exec = true;
    if (!cmdbuf) {
      cmdbuf = _now_submitter->getLastCommandBuffer();
    } else {
      TOY_ASSERT(&cmdbuf->getSubmitter() == _now_submitter);
    }

    auto now_queue = _now_submitter->getQueue();
    auto now_family = QueueManager::getInstance().getFamilyIndex(now_queue);

    auto familyTransfer = [&](Scope src_scope) {
      auto prev_family = QueueManager::getInstance().getFamilyIndex(_prev_exec.getQueue());
      auto family_info = FamilyTransferInfo{ prev_family, now_family };
      auto release_cmdbuf = CmdbufManager::getInstance().get(now_family);
      recordBufferBarrier(release_cmdbuf, _buffer, BarrierScope::release(src_scope), family_info);
      auto cmdbufs = std::vector<RecordableCmdbuf>{};
      cmdbufs.push_back(std::move(release_cmdbuf));
      auto exec = Execution{
        _prev_exec.getQueue(),
        CommandBatch{
          .cmdbufs = std::move(cmdbufs),
        },
      };
      addWait(std::move(exec), VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT);
      recordBufferBarrier(*cmdbuf, _buffer, BarrierScope::acquire(scope), family_info);
    };
    auto waitPrevExec = [&](VkPipelineStageFlags2 wait_stage) {
      if (!_prev_exec.canWait(wait_stage)) {
        wait_stage = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
      }
      addWait(std::move(_prev_exec), wait_stage);
    };
    auto recordBarrier = [&](Scope src_scope) {
      toy::debugf("record barrier: \n\tsrc_scope: \n{}\n\tdst_scope: \n{}", src_scope, scope);
      recordBufferBarrier(*cmdbuf, _buffer, BarrierScope{ src_scope, scope }, {});
    };

    if (_prev_exec.valid() && _prev_exec.getQueue() != now_queue) {
      // first record and diff queue, can't directly use barrier, and need sync all previous scopes
      auto prev_family = QueueManager::getInstance().getFamilyIndex(_prev_exec.getQueue());
      auto need_sync = _tracker.getAllNeedSync();
      if (!need_sync) {
        // call syncHost before: dont need sync any scopes, just want to transfer family (if needed)
        if (now_family != prev_family) {
          familyTransfer(Scope{});
          _tracker.setNeedSync(scope);
        } else {
          _tracker.updateScope(scope);
        }
      } else {
        _tracker.resetScope();
        if (now_family != prev_family) {
          familyTransfer(*need_sync);
          _tracker.setNeedSync(scope);
        } else {
          waitPrevExec(need_sync->stage_mask);
          _tracker.updateScope(scope);
        }
      }
      _prev_exec.detach();
    } else {
      auto need_sync = _tracker.getNeedSync(scope);
      if (need_sync) {
        recordBarrier(*need_sync);
      }
      _tracker.updateScope(scope);
    }
  }
  void addWait(Execution exec, VkPipelineStageFlags2 stage) {
    TOY_ASSERT(_is_recording);
    _now_submitter->addWait(std::move(exec), stage);
  }

  void syncHost(AccessTypeFlags access) {
    TOY_ASSERT(!_is_recording);
    TOY_ASSERT(access);
    if (_prev_exec.valid()) {
      auto need_sync = _tracker.getAllNeedSync();
      if (need_sync) {
        auto prev_family = QueueManager::getInstance().getFamilyIndex(_prev_exec.getQueue());
        auto cmdbuf = CmdbufManager::getInstance().get(prev_family);
        auto dst_scope = Scope{
          .stage_mask = VK_PIPELINE_STAGE_2_HOST_BIT,
        };
        if (access & AccessType::READ) {
          dst_scope.access_mask |= VK_ACCESS_2_HOST_READ_BIT;
        }
        if (access & AccessType::WRITE) {
          dst_scope.access_mask |= VK_ACCESS_2_HOST_WRITE_BIT;
        }
        recordBufferBarrier(cmdbuf, _buffer, BarrierScope{ *need_sync, dst_scope }, {});
        auto cmdbufs = std::vector<RecordableCmdbuf>{};
        cmdbufs.push_back(std::move(cmdbuf));
        auto exec = Execution{
          _prev_exec.getQueue(),
          CommandBatch{
            .cmdbufs = std::move(cmdbufs),
          },
        };
        exec.hostWait();
        _tracker.resetScope();
      }
    }
  }

private:
  VkBuffer     _buffer;
  Execution    _prev_exec;
  ScopeTracker _tracker;
  // use to make sure must call a sync() between startExecution and endExecution
  bool         _synced_in_exec = false;
  // use to make sure start -> end, and must call sync between them, call syncHost outside
  bool         _is_recording = false;
  Submitter*   _now_submitter{};
};

class SubmitterAutoSync : public Submitter {
public:
  SubmitterAutoSync(VkQueue queue) : Submitter(queue) {}
  void sync(
    Synchronizer& syner, Scope scope, std::optional<Submitter::CommandBuffer> cmdbuf = std::nullopt
  ) {
    if (!_syners.contains(&syner)) {
      _syners.insert(&syner);
      syner.startExecution(*this);
    }
    syner.sync(scope, std::move(cmdbuf));
  }
  auto submit() -> Execution {
    auto execution = Submitter::submit();
    for (auto& syner : _syners) {
      syner->endExecution(execution);
    }
    _syners.clear();
    return execution;
  }

private:
  std::unordered_set<Synchronizer*> _syners;
};

} // namespace rd::exec
