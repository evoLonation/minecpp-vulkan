module;
#include <toy.h>
export module render.queue;

import render.device;
import std;
import toy;
import <vulkan_config.h>;

export namespace rd::exec {

enum class FamilyType;

struct FamilyInfo {
  uint32               family_index;
  std::vector<VkQueue> queues;
};

class QueueManager : public PROACTIVE_SINGLETON(QueueManager) {
public:
  QueueManager() = default;
  QueueManager(std::unordered_map<FamilyType, FamilyInfo> family_infos) {
    _family_infos = std::move(family_infos);
    for (auto& [family, info] : _family_infos) {
      _index2family[info.family_index] = family;
      for (auto& queue : info.queues) {
        _queue2family[queue] = family;
      }
    }
  }
  auto getFamilyIndex(FamilyType family) -> uint32 {
    TOY_ASSERT(_family_infos.contains(family));
    return _family_infos.at(family).family_index;
  }
  auto getFamilyIndex(VkQueue queue) -> uint32 {
    TOY_ASSERT(_queue2family.contains(queue));
    return _family_infos.at(_queue2family.at(queue)).family_index;
  }
  auto getFamilyType(uint32 family_index) -> FamilyType {
    TOY_ASSERT(_index2family.contains(family_index));
    return _index2family.at(family_index);
  }
  auto getFamilyType(VkQueue queue) { return getFamilyType(getFamilyIndex(queue)); }
  auto getQueues(FamilyType family) -> std::span<VkQueue> {
    TOY_ASSERT(_family_infos.contains(family));
    return _family_infos.at(family).queues;
  }
  auto getQueues(uint32 family_index) -> std::span<VkQueue> {
    return getQueues(getFamilyType(family_index));
  }
  auto getQueue(FamilyType family, size_t index) -> VkQueue { return getQueues(family)[index]; }
  auto getQueue(uint32 family_index, size_t index) -> VkQueue {
    return getQueue(getFamilyType(family_index), index);
  }

private:
  std::unordered_map<FamilyType, FamilyInfo> _family_infos;
  std::unordered_map<uint32, FamilyType>     _index2family;
  std::unordered_map<VkQueue, FamilyType>    _queue2family;
};

struct QueueFamilyCheckContext {
  VkPhysicalDevice        device;
  size_t                  index;
  VkQueueFamilyProperties properties;
};

using QueueFamilyChecker = std::function<bool(QueueFamilyCheckContext)>;

struct QueueFamilyRequirement {
  FamilyType                                   family;
  uint32                                       queue_count;
  std::function<bool(QueueFamilyCheckContext)> checker;
};

enum class FamilyType {
  GRAPHICS,
  TRANSFER,
  PRESENT,
};

auto getGraphicQueueChecker() -> QueueFamilyChecker {
  return [](const QueueFamilyCheckContext& ctx) -> bool {
    return ctx.properties.queueFlags & VK_QUEUE_GRAPHICS_BIT;
  };
}

auto getPresentQueueChecker(VkSurfaceKHR surface) -> QueueFamilyChecker {
  return [surface](const QueueFamilyCheckContext& ctx) -> bool {
    VkBool32 presentSupport = VK_FALSE;
    vkGetPhysicalDeviceSurfaceSupportKHR(ctx.device, ctx.index, surface, &presentSupport);
    return presentSupport == VK_TRUE;
  };
}

auto getTransferQueueChecker() -> QueueFamilyChecker {
  return [](const QueueFamilyCheckContext& ctx) -> bool {
    // 支持 graphics 和 compute operation 的 queue 也必定支持 transfer operation
    return ctx.properties.queueFlags &
           (VK_QUEUE_TRANSFER_BIT | VK_QUEUE_COMPUTE_BIT | VK_QUEUE_GRAPHICS_BIT);
  };
}

class QueueManagerBuilder {
public:
  QueueManagerBuilder(std::span<QueueFamilyRequirement> family_requirements) {
    TOY_ASSERT(
      (family_requirements | views::transform([](auto& r) { return r.family; }) |
       ranges::to<std::unordered_set>())
        .size() == family_requirements.size()
    );
    _requirements.append_range(family_requirements);
  }
  // pass to device constructor
  auto checkPdevice(DeviceCapabilityBuilder& request) -> std::expected<void, std::string>;
  auto build() -> QueueManager {
    auto  pdevice = Device::getInstance().getPdevice().get();
    auto& family_indices = _family_indices.at(pdevice);
    auto  queue_counts =
      _requirements |
      views::transform([](auto& r) { return std::pair{ r.family, r.queue_count }; }) |
      ranges::to<std::unordered_map>();
    auto family_infos = //
      family_indices | views::transform([&](auto pair) {
        auto [family, index] = pair;
        auto queue_count = queue_counts.at(family);
        auto queues = std::vector<VkQueue>{};
        queues.resize(queue_count);
        for (size_t i = 0; i < queue_count; ++i) {
          vkGetDeviceQueue(Device::getInstance(), index, i, &queues[i]);
        }
        return std::pair{ family, FamilyInfo{ index, std::move(queues) } };
      }) |
      ranges::to<std::unordered_map>();
    return QueueManager{ std::move(family_infos) };
  }

private:
  std::vector<QueueFamilyRequirement>                                          _requirements;
  std::unordered_map<VkPhysicalDevice, std::unordered_map<FamilyType, uint32>> _family_indices;
};

/**
 * @brief 二分图匹配算法
 */
auto hungarian(std::span<const std::vector<int>> graph, int right_count)
  -> std::optional<std::vector<int>> {

  auto left_count = (int)graph.size();
  auto match = std::vector<int>(right_count);
  ranges::fill(match, -1);
  auto found = std::vector<bool>(right_count);

  auto results = std::vector<int>(left_count);

  std::function<bool(int)> dfs = [&](int u) -> bool {
    toy::debugf("u: {}", u);
    for (auto v : graph[u]) {
      toy::debugf("u {} lookup {}", u, v);
      if (!found[v]) {
        found[v] = true;
        if (match[v] == -1 || dfs(match[v])) {
          toy::debugf("u {} select {}", u, v);
          match[v] = u;
          results[u] = v;
          return true;
        }
      }
    }
    toy::debugf("u {} no satisfied select", u);
    return false;
  };

  if (!ranges::all_of(views::iota(0u, graph.size()), [&dfs, &found](int u) {
        ranges::fill(found, false);
        return dfs(u);
      })) {
    return std::nullopt;
  } else {
    return results;
  }
}

auto QueueManagerBuilder::checkPdevice(DeviceCapabilityBuilder& request) -> toy::Expected<void> {
  auto& pdevice = request.getPdevice();

  auto family_count = pdevice.getAllQueueFamilyProperties().size();
  auto requirement_count = _requirements.size();
  toy::debugf(
    "queue family count: {}, queue family requirement count: {}", family_count, requirement_count
  );
  // requirement_i -> family_i
  std::vector<std::vector<int>> graph(requirement_count);

  for (auto [family_i, properties] : pdevice.getAllQueueFamilyProperties() | toy::enumerate) {
    // auto queue_count = static_cast<int>(properties.queueCount);
    toy::debugf("check queue family {}, which has {} queues", family_i, properties.queueCount);
    for (auto [requirement_i, requirement] : _requirements | toy::enumerate) {
      // auto& [queue_checker, queue_number] = queue_requirement;
      if (properties.queueCount >= requirement.queue_count &&
          requirement.checker(QueueFamilyCheckContext{ pdevice.get(), family_i, properties })) {
        graph[requirement_i].push_back(family_i);
        toy::debugf("queue request {} success", requirement_i);
      } else {
        toy::debugf("queue request {} failed", requirement_i);
      }
    }
  }
  if (auto res = hungarian(graph, family_count); res.has_value()) {
    // res: family_indices for each requirement
    for (auto [req_i, family_i] : res.value() | toy::enumerate) {
      _family_indices[pdevice.get()][_requirements[req_i].family] = family_i;
      request.family_queue_counts.emplace_back(family_i, _requirements[req_i].queue_count);
    }
    return {};
  } else {
    return toy::UnExpected("queue request failed");
  }
}

} // namespace rd::exec
