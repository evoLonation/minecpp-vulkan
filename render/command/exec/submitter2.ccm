module;
#include <toy.h>
#include <vulkan_tool.h>
export module render.submitter2;

import render.queue;
import render.tracker2;
import render.cmdbuf;
export import render.execution;
import render.reflections;
import render.tool;
import <vulkan_config.h>;
import render;
import std;
import toy;

export namespace rd::exec {

class Submitter {
public:
  Submitter(VkQueue queue) {
    _queue = queue;
    addCommandBuffer();
  }
  UNCOPYABLE_MOVEABLE(Submitter)
  auto getQueue() -> VkQueue { return _queue; }
  void addWait(Execution exec, VkPipelineStageFlags2 stage = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT) {
    _batch.waits.push_back({ stage, std::move(exec) });
  }
  void addSignal(VkPipelineStageFlags2 stage) { _batch.signals.insert(stage); }
  void addWait(VkSemaphore semaphore, VkPipelineStageFlags2 stage) {
    _batch.raw_waits.push_back({ stage, semaphore });
  }
  void addSignal(VkSemaphore semaphore, VkPipelineStageFlags2 stage) {
    _batch.raw_signals.push_back({ stage, semaphore });
  }
  // just a fat pointer to submitter, index and VkCommandBuffer
  class CommandBuffer {
  public:
    CommandBuffer() = default;
    CommandBuffer(Submitter& submitter, size_t index, VkCommandBuffer cmdbuf) {
      _submitter = &submitter;
      _index = index;
      _cmdbuf = cmdbuf;
    }
    operator VkCommandBuffer() { return _cmdbuf; }
    auto getIndex() -> size_t { return _index; }
    auto get() -> VkCommandBuffer { return _cmdbuf; }
    auto getSubmitter() -> Submitter& { return *_submitter; }

  private:
    Submitter*      _submitter{};
    size_t          _index{};
    VkCommandBuffer _cmdbuf{};
  };
  auto addCommandBuffer() -> CommandBuffer {
    auto cmdbuf =
      CmdbufManager::getInstance().get(QueueManager::getInstance().getFamilyIndex(_queue));
    auto index = _batch.cmdbufs.size();
    _batch.cmdbufs.push_back(std::move(cmdbuf));
    return CommandBuffer{ *this, index, _batch.cmdbufs.back().get() };
  }
  auto getCommandBuffers() -> std::vector<CommandBuffer> {
    return _batch.cmdbufs | toy::enumerate | views::transform([this](auto x) {
             auto [index, cmdbuf] = x;
             return CommandBuffer{ *this, index, cmdbuf };
           }) |
           ranges::to<std::vector>();
  }
  auto getLastCommandBuffer() -> CommandBuffer {
    TOY_ASSERT(!_batch.cmdbufs.empty());
    auto index = _batch.cmdbufs.size() - 1;
    auto cmdbuf = _batch.cmdbufs.back().get();
    return CommandBuffer{ *this, index, cmdbuf };
  }

  auto submit() -> Execution { return Execution{ _queue, std::move(_batch) }; }
  void reset() {
    _batch = CommandBatch{};
    addCommandBuffer();
  }

private:
  VkQueue      _queue{};
  CommandBatch _batch;
};

struct BufferBarrier {
  // if submitter is valid, queue will be nullptr; otherwise queue is valid and submitter is nullptr
  Submitter*         submitter;
  VkQueue            queue;
  VkBuffer           buffer;
  BarrierScope       scope;
  FamilyTransferInfo family_info;

  friend auto operator==(BufferBarrier const& x, BufferBarrier const& y) -> bool = default;

  auto toJson() const -> json::Json {
    return json::Json::array(
      {
        std::format("0x{:x}", uint64(submitter)),
        std::format("0x{:x}", uint64(queue)),
        std::format("0x{:x}", uint64(buffer)),
        scope.src_scope.toJson(),
        scope.dst_scope.toJson(),
        family_info.src_family,
        family_info.dst_family,
      }
    );
  }
};
struct ImageBarrier {
  // if submitter is valid, queue will be nullptr; otherwise queue is valid and submitter is nullptr
  Submitter*           submitter;
  VkQueue              queue;
  VkImage              image;
  LayoutTransitionInfo layout_transition;
  BarrierScope         scope;
  FamilyTransferInfo   family_info;

  friend auto operator==(ImageBarrier const& x, ImageBarrier const& y) -> bool = default;
};
struct WaitExecution {
  Execution             awaited_exec;
  Submitter*            waiter;
  VkPipelineStageFlags2 wait_stage;
};
class SyncOperationQueue {
public:
  SyncOperationQueue() = default;
  auto popBufferBarrier(
    bool invalid_submitter = false, std::source_location loc = std::source_location::current()
  ) -> BufferBarrier {
    toy::checkf(loc, !_buffer_barriers.empty(), "no buffer barrier to pop");
    auto barrier = _buffer_barriers.front();
    _buffer_barriers.pop();
    if (invalid_submitter) {
      barrier.submitter = nullptr;
    } else {
      barrier.queue = nullptr;
    }
    return barrier;
  }
  auto popWaitExecution(std::source_location loc = std::source_location::current())
    -> WaitExecution {
    toy::checkf(loc, !_wait_executions.empty(), "no wait execution to pop");
    auto exec = _wait_executions.front();
    _wait_executions.pop();
    return exec;
  }
  auto isEmpty() -> bool { return _buffer_barriers.empty() && _wait_executions.empty(); }
  void push(BufferBarrier barrier) { _buffer_barriers.push(std::move(barrier)); }
  void push(WaitExecution exec) { _wait_executions.push(std::move(exec)); }

private:
  std::queue<BufferBarrier> _buffer_barriers;
  std::queue<WaitExecution> _wait_executions;
};

class Synchronizer {
public:
  Synchronizer(VkBuffer buffer) : _context(BufferContext{ buffer }) {}
  Synchronizer(VkImage image, VkImageSubresourceRange subresource_range)
    : _context(ImageContext{ image, subresource_range }) {}
  UNCOPYABLE_MOVEABLE(Synchronizer)
  void setSyncOperationQueue(SyncOperationQueue& queue) {
    _context.sync_op_queue = &queue;
    _sync_op_queue = &queue;
  }
  void startExecution(Submitter& submitter) {
    _now_submitter = &submitter;
    TOY_ASSERT(!_is_recording);
    _is_recording = true;
  }
  void endExecution(Execution execution) {
    TOY_ASSERT(_synced_in_exec);
    TOY_ASSERT(_is_recording);
    _is_recording = false;
    _prev_exec = std::move(execution);
  }
  using ScopeVariant = std::variant<Scope, ImageScope>;
  // diff family or queue only happens in the first time after call startExecution
  void sync(ScopeVariant scope, std::optional<Submitter::CommandBuffer> cmdbuf = std::nullopt) {
    TOY_ASSERT(
      std::holds_alternative<Scope>(scope) == std::holds_alternative<BufferContext>(_context)
    );
    TOY_ASSERT(_is_recording);
    _synced_in_exec = true;
    if (!cmdbuf) {
      cmdbuf = _now_submitter->getLastCommandBuffer();
    } else {
      TOY_ASSERT(&cmdbuf->getSubmitter() == _now_submitter);
    }

    auto now_queue = _now_submitter->getQueue();
    auto now_family = QueueManager::getInstance().getFamilyIndex(now_queue);

    // return if record layout transition
    auto syncAcrossFamily = [&](std::optional<ScopeVariant> src_scope_) {
      auto src_scope = src_scope_.value_or(
        std::holds_alternative<Scope>(scope) ? ScopeVariant{ Scope{} }
                                             : ScopeVariant{ ImageScope{} }
      );
      auto prev_family = QueueManager::getInstance().getFamilyIndex(_prev_exec.getQueue());
      auto family_info = FamilyTransferInfo{ prev_family, now_family };
      auto release_submitter = Submitter{ _prev_exec.getQueue() };
      _context.recordReleaseBarrier(
        release_submitter.addCommandBuffer(), src_scope, scope, family_info
      );
      addWait(release_submitter.submit(), VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT);
      _context.recordAcquireBarrier(*cmdbuf, src_scope, scope, family_info);
    };
    auto syncAcrossQueue = [&](ScopeVariant src_scope) -> bool {
      VkPipelineStageFlags2 wait_stage{};
      if (auto* x = std::get_if<Scope>(&src_scope)) {
        wait_stage = x->stage_mask;
      } else if (auto* x = std::get_if<ImageScope>(&src_scope)) {
        wait_stage = x->scope.stage_mask;
      }
      if (wait_stage != VK_PIPELINE_STAGE_2_NONE) {
        toy::debugf("wait prev exec: {}", rd::refl::stageMask(wait_stage));
        if (!_prev_exec.canWait(wait_stage)) {
          wait_stage = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
        }
        addWait(std::move(_prev_exec), wait_stage);
      }
      if (auto* x = std::get_if<ImageScope>(&src_scope);
          x && x->layout != std::get<ImageScope>(scope).layout) {
        // layout transition
        _context.recordBarrier(*cmdbuf, ImageScope{ Scope{}, x->layout }, scope);
        return true;
      } else {
        return false;
      }
    };
    auto recordBarrier = [&](ScopeVariant src_scope) {
      _context.recordBarrier(*cmdbuf, src_scope, scope);
    };

    if (_prev_exec.valid() && _prev_exec.getQueue() != now_queue) {
      // first record and diff queue, can't directly use barrier, and need sync all previous scopes
      auto prev_family = QueueManager::getInstance().getFamilyIndex(_prev_exec.getQueue());
      auto need_sync = _context.getAllNeedSync(scope);
      _context.resetScope();
      // if !need_sync (buffer), must has called syncHost before.
      if (now_family != prev_family) {
        syncAcrossFamily(need_sync);
        _context.setNeedSync(scope);
      } else {
        bool recorded_layout_transition = false;
        if (need_sync) {
          recorded_layout_transition = syncAcrossQueue(*need_sync);
        }
        if (recorded_layout_transition) {
          _context.setNeedSync(scope);
        } else {
          _context.updateScope(scope);
        }
      }
      _prev_exec.detach();
    } else {
      auto need_sync = _context.getNeedSync(scope);
      if (need_sync) {
        recordBarrier(*need_sync);
      }
      _context.updateScope(scope);
    }
  }
  void addWait(Execution exec, VkPipelineStageFlags2 stage) {
    TOY_ASSERT(_is_recording);
    if (_sync_op_queue) {
      _sync_op_queue->push(WaitExecution{ exec, _now_submitter, stage });
    }
    _now_submitter->addWait(std::move(exec), stage);
  }

  // only for buffer, not for image
  void syncHost(AccessTypeFlags access) {
    TOY_ASSERT(std::holds_alternative<BufferContext>(_context));
    TOY_ASSERT(!_is_recording);
    TOY_ASSERT(access);
    auto& tracker = std::get<BufferContext>(_context).tracker;
    if (_prev_exec.valid()) {
      auto need_sync = tracker.getAllNeedSync();
      if (need_sync) {
        auto submitter = Submitter{ _prev_exec.getQueue() };
        auto dst_scope = Scope{
          .stage_mask = VK_PIPELINE_STAGE_2_HOST_BIT,
        };
        if (access & AccessType::READ) {
          dst_scope.access_mask |= VK_ACCESS_2_HOST_READ_BIT;
        }
        if (access & AccessType::WRITE) {
          dst_scope.access_mask |= VK_ACCESS_2_HOST_WRITE_BIT;
        }
        // use _context.recordBarrier to log
        _context.recordBarrier(submitter.getLastCommandBuffer(), *need_sync, dst_scope);
        submitter.submit().hostWait();
        tracker.resetScope();
      }
    }
  }

private:
  struct BufferContext {
    VkBuffer     buffer;
    ScopeTracker tracker;
  };
  struct ImageContext {
    VkImage                 image;
    VkImageSubresourceRange subresource_range;
    ImageScopeTracker       tracker;
  };
  struct ContextVariant : std::variant<BufferContext, ImageContext> {
    SyncOperationQueue* sync_op_queue;

    void recordBarrier(
      Submitter::CommandBuffer cmdbuf, ScopeVariant const& src_scope, ScopeVariant const& dst_scope
    ) {
      toy::debugf(
        "record barrier: \n\tsrc_scope: \n{}\n\tdst_scope: \n{}",
        std::visit([](auto& x) { return std::format("{}", x); }, src_scope),
        std::visit([](auto& x) { return std::format("{}", x); }, dst_scope)
      );
      if (auto* buffer_context = std::get_if<BufferContext>(this)) {
        recordBufferBarrier(
          cmdbuf,
          buffer_context->buffer,
          BarrierScope{ std::get<Scope>(src_scope), std::get<Scope>(dst_scope) },
          {}
        );
        if (sync_op_queue) {
          sync_op_queue->push(
            BufferBarrier{
              .submitter = &cmdbuf.getSubmitter(),
              .queue = cmdbuf.getSubmitter().getQueue(),
              .buffer = buffer_context->buffer,
              .scope = BarrierScope{ std::get<Scope>(src_scope), std::get<Scope>(dst_scope) },
              .family_info = {},
            }
          );
        }
      } else if (auto* image_context = std::get_if<ImageContext>(this)) {
        recordImageBarrier(
          cmdbuf,
          image_context->image,
          image_context->subresource_range,
          LayoutTransitionInfo{
            std::get<ImageScope>(src_scope).layout,
            std::get<ImageScope>(dst_scope).layout,
          },
          BarrierScope{
            std::get<ImageScope>(src_scope).scope,
            std::get<ImageScope>(dst_scope).scope,
          },
          {}
        );
      } else {
        toy::throwf("unreachable");
      }
    }
    void recordReleaseBarrier(
      Submitter::CommandBuffer cmdbuf,
      ScopeVariant const&      src_scope,
      ScopeVariant const&      dst_scope,
      FamilyTransferInfo       family_info
    ) {
      toy::debugf(
        "record release barrier: \n\tsrc_scope: \n{}\n\tfamily: {} -> {}",
        std::visit([](auto& x) { return std::format("{}", x); }, src_scope),
        family_info.src_family,
        family_info.dst_family
      );
      if (auto* buffer_context = std::get_if<BufferContext>(this)) {
        recordBufferBarrier(
          cmdbuf,
          buffer_context->buffer,
          BarrierScope::release(std::get<Scope>(src_scope)),
          family_info
        );
        if (sync_op_queue) {
          sync_op_queue->push(
            BufferBarrier{
              .submitter = &cmdbuf.getSubmitter(),
              .queue = cmdbuf.getSubmitter().getQueue(),
              .buffer = buffer_context->buffer,
              .scope = BarrierScope::release(std::get<Scope>(src_scope)),
              .family_info = family_info,
            }
          );
        }
      } else if (auto* image_context = std::get_if<ImageContext>(this)) {
        recordImageBarrier(
          cmdbuf,
          image_context->image,
          image_context->subresource_range,
          LayoutTransitionInfo{
            std::get<ImageScope>(src_scope).layout,
            std::get<ImageScope>(dst_scope).layout,
          },
          BarrierScope::release(std::get<ImageScope>(src_scope).scope),
          family_info
        );
      } else {
        toy::throwf("unreachable");
      }
    }
    void recordAcquireBarrier(
      Submitter::CommandBuffer cmdbuf,
      ScopeVariant const&      src_scope,
      ScopeVariant const&      dst_scope,
      FamilyTransferInfo       family_info
    ) {
      toy::debugf(
        "record acquire barrier: \n\tdst_scope: \n{}\n\tfamily: {} -> {}",
        std::visit([](auto& x) { return std::format("{}", x); }, dst_scope),
        family_info.src_family,
        family_info.dst_family
      );
      if (auto* buffer_context = std::get_if<BufferContext>(this)) {
        recordBufferBarrier(
          cmdbuf,
          buffer_context->buffer,
          BarrierScope::acquire(std::get<Scope>(dst_scope)),
          family_info
        );
        if (sync_op_queue) {
          sync_op_queue->push(
            BufferBarrier{
              .submitter = &cmdbuf.getSubmitter(),
              .queue = cmdbuf.getSubmitter().getQueue(),
              .buffer = buffer_context->buffer,
              .scope = BarrierScope::acquire(std::get<Scope>(dst_scope)),
              .family_info = family_info,
            }
          );
        }
      } else if (auto* image_context = std::get_if<ImageContext>(this)) {
        recordImageBarrier(
          cmdbuf,
          image_context->image,
          image_context->subresource_range,
          LayoutTransitionInfo{
            std::get<ImageScope>(src_scope).layout,
            std::get<ImageScope>(dst_scope).layout,
          },
          BarrierScope::acquire(std::get<ImageScope>(dst_scope).scope),
          family_info
        );
      } else {
        toy::throwf("unreachable");
      }
    }
    void updateScope(ScopeVariant const& scope) {
      if (auto* buffer_context = std::get_if<BufferContext>(this)) {
        buffer_context->tracker.updateScope(std::get<Scope>(scope));
      } else if (auto* image_context = std::get_if<ImageContext>(this)) {
        image_context->tracker.updateScope(std::get<ImageScope>(scope));
      } else {
        toy::throwf("unreachable");
      }
    }
    auto getAllNeedSync(ScopeVariant const& scope) -> std::optional<ScopeVariant> {
      if (auto* buffer_context = std::get_if<BufferContext>(this)) {
        return buffer_context->tracker.getAllNeedSync();
      } else if (auto* image_context = std::get_if<ImageContext>(this)) {
        return image_context->tracker.getAllNeedSync(std::get<ImageScope>(scope).layout);
      } else {
        toy::throwf("unreachable");
      }
    }
    auto getNeedSync(ScopeVariant const& scope) -> std::optional<ScopeVariant> {
      if (auto* buffer_context = std::get_if<BufferContext>(this)) {
        return buffer_context->tracker.getNeedSync(std::get<Scope>(scope));
      } else if (auto* image_context = std::get_if<ImageContext>(this)) {
        return image_context->tracker.getNeedSync(std::get<ImageScope>(scope));
      } else {
        toy::throwf("unreachable");
      }
    }
    void setNeedSync(ScopeVariant const& scope) {
      if (auto* buffer_context = std::get_if<BufferContext>(this)) {
        buffer_context->tracker.setNeedSync(std::get<Scope>(scope));
      } else if (auto* image_context = std::get_if<ImageContext>(this)) {
        image_context->tracker.setNeedSync(std::get<ImageScope>(scope));
      } else {
        toy::throwf("unreachable");
      }
    }
    void resetScope() {
      if (auto* buffer_context = std::get_if<BufferContext>(this)) {
        buffer_context->tracker.resetScope();
      } else if (auto* image_context = std::get_if<ImageContext>(this)) {
        image_context->tracker.resetScopeWithoutLayout();
      } else {
        toy::throwf("unreachable");
      }
    }
  };
  ContextVariant      _context;
  Execution           _prev_exec;
  // use to make sure must call a sync() between startExecution and endExecution
  bool                _synced_in_exec = false;
  // use to make sure start -> end, and must call sync between them, call syncHost outside
  bool                _is_recording = false;
  Submitter*          _now_submitter{};
  SyncOperationQueue* _sync_op_queue;
};

class BufferSynchronizer : private Synchronizer {
public:
  BufferSynchronizer(VkBuffer buffer) : Synchronizer(buffer) {}
  using Synchronizer::endExecution;
  using Synchronizer::setSyncOperationQueue;
  using Synchronizer::startExecution;
  void sync(Scope scope, std::optional<Submitter::CommandBuffer> cmdbuf = std::nullopt) {
    Synchronizer::sync(scope, std::move(cmdbuf));
  }
  void syncHost(AccessTypeFlags access) { Synchronizer::syncHost(access); }
};

class ImageSynchronizer : private Synchronizer {
public:
  ImageSynchronizer(VkImage image, VkImageSubresourceRange subresource_range)
    : Synchronizer(image, subresource_range) {}
  using Synchronizer::endExecution;
  using Synchronizer::setSyncOperationQueue;
  using Synchronizer::startExecution;
  void sync(ImageScope scope, std::optional<Submitter::CommandBuffer> cmdbuf = std::nullopt) {
    Synchronizer::sync(scope, std::move(cmdbuf));
  }
};

class SubmitterAutoSync : public Submitter {
public:
  SubmitterAutoSync(VkQueue queue) : Submitter(queue) {}
  void sync(
    BufferSynchronizer&                     syner,
    Scope                                   scope,
    std::optional<Submitter::CommandBuffer> cmdbuf = std::nullopt
  ) {
    if (!_buffer_syners.contains(&syner)) {
      _buffer_syners.insert(&syner);
      syner.startExecution(*this);
    }
    syner.sync(scope, std::move(cmdbuf));
  }
  void sync(
    ImageSynchronizer&                      syner,
    ImageScope                              scope,
    std::optional<Submitter::CommandBuffer> cmdbuf = std::nullopt
  ) {
    if (!_image_syners.contains(&syner)) {
      _image_syners.insert(&syner);
      syner.startExecution(*this);
    }
    syner.sync(scope, std::move(cmdbuf));
  }
  auto submit() -> Execution {
    auto execution = Submitter::submit();
    for (auto& syner : _buffer_syners) {
      syner->endExecution(execution);
    }
    for (auto& syner : _image_syners) {
      syner->endExecution(execution);
    }
    _buffer_syners.clear();
    _image_syners.clear();
    return execution;
  }
  void reset() {
    Submitter::reset();
    _buffer_syners.clear();
    _image_syners.clear();
  }

private:
  std::unordered_set<BufferSynchronizer*> _buffer_syners;
  std::unordered_set<ImageSynchronizer*>  _image_syners;
};

} // namespace rd::exec

CUSTOM_FORMATTER_JSON(rd::exec::BufferBarrier, [](auto& x) { return x.toJson(); });