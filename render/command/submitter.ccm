module;
#include <toy.h>
export module render.submitter;

import std;
import toy;
import render.sync;
import render.tracker;
import render.executor;
import <vulkan_config.h>;

export namespace rd {

class Submitter {
public:
  Submitter(FamilyType family) { _executor = &ExecutorManager::getInstance()[family]; }
  void addNeedSync(
    ImageBarrierTracker*                   tracker,
    Scope                                  scope,
    VkImageLayout                          layout,
    std::vector<CommandBatch::RawWaitInfo> waits = {}
  );
  void addNeedSync(
    BufferBarrierTracker* tracker, Scope scope, std::vector<CommandBatch::RawWaitInfo> waits = {}
  );
  auto submit(
    std::function<void(VkCommandBuffer)>     recorder,
    std::vector<CommandBatch::RawSignalInfo> signals = {}
  ) -> Waitable;
  auto getExecutor() -> CommandExecutor& { return *_executor; }

private:
  void addNeedSync(SyncContext& sync, std::vector<CommandBatch::RawWaitInfo> waits);

  struct RecorderInfo {
    std::vector<std::function<void(VkCommandBuffer)>> recorders;
    std::vector<CommandBatch::RawWaitInfo>            waits;
  };

  CommandExecutor*                         _executor;
  std::unordered_map<uint32, RecorderInfo> _release_recorders;
  RecorderInfo                             _sync_recorder;
};

} // namespace rd
