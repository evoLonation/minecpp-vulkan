module;
#include <toy.h>
#include <vulkan_tool.h>
export module render.execution0;

import render.tool;
import render.cmdbuf;
import <vulkan_config.h>;
import render;
import std;
import toy;

export namespace rd::exec {

class TimelineSemaphore : public rs::Semaphore {
public:
  TimelineSemaphore() = default;
  TimelineSemaphore(uint64 initial_value) {
    auto type_info = VkSemaphoreTypeCreateInfo{
      .sType = VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO,
      .semaphoreType = VK_SEMAPHORE_TYPE_TIMELINE,
      .initialValue = initial_value,
    };
    VkSemaphoreCreateInfo create_info{
      .sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO,
      .pNext = &type_info,
    };
    rs::Semaphore::operator=(create_info);
  }
  auto hostWait(uint64 value, uint64 nano_timeout = max_timeout) -> bool {
    return hostWait(std::array{ std::pair{ this, value } }, false, nano_timeout);
  }
  static auto hostWait(
    std::span<std::pair<TimelineSemaphore*, uint64> const> semaphores,
    bool                                                   any = false,
    uint64                                                 nano_timeout = max_timeout
  ) -> bool {
    if (semaphores.empty()) {
      return true;
    }
    auto handles = semaphores | views::transform([](auto& s) { return s.first->get(); }) |
                   ranges::to<std::vector>();
    auto values =
      semaphores | views::transform([](auto& s) { return s.second; }) | ranges::to<std::vector>();
    auto wait_info = VkSemaphoreWaitInfo{
      .sType = VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO,
      .flags = any ? VK_SEMAPHORE_WAIT_ANY_BIT : 0u,
      .semaphoreCount = static_cast<uint32>(semaphores.size()),
      .pSemaphores = handles.data(),
      .pValues = values.data(),
    };
    auto res = CHECK_VK_RESULT(
      vkWaitSemaphores(Device::getInstance(), &wait_info, nano_timeout), { VK_SUCCESS, VK_TIMEOUT }
    );
    return res == VK_SUCCESS;
  }
  void hostSignal(uint64 value) {
    auto signal_info = VkSemaphoreSignalInfo{
      .sType = VK_STRUCTURE_TYPE_SEMAPHORE_SIGNAL_INFO,
      .semaphore = get(),
      .value = value,
    };
    CHECK_VK_RESULT(vkSignalSemaphore(Device::getInstance(), &signal_info));
  }
};

class IncrementalSemaphore {
public:
  IncrementalSemaphore() = default;
  IncrementalSemaphore(bool init) {
    if (init) {
      _sema = TimelineSemaphore(_value);
    }
  }
  auto getNowValue() -> uint64 { return _value; }
  void increaseValue() { _value++; }
  auto hostWait(uint64 nano_timeout = max_timeout) -> bool {
    return _sema.hostWait(_value, nano_timeout);
  }
  auto get() -> VkSemaphore { return _sema.get(); }
  auto valid() -> bool { return get(); }
  operator VkSemaphore() { return get(); }

private:
  TimelineSemaphore _sema;
  uint64            _value{};
};

class SemaphorePool : public toy::ObjectPoolHelper<IncrementalSemaphore>,
                      public PROACTIVE_SINGLETON(SemaphorePool) {
public:
  friend ObjectPoolHelper;

  SemaphorePool() { _idle_semas.resize(10); }
  void recycle(IncrementalSemaphore s) {
    TOY_ASSERT(s.hostWait(0));
    _idle_semas.push_back(std::move(s));
  }

private:
  std::vector<IncrementalSemaphore> _idle_semas;

  void expand() { _idle_semas.push_back({ true }); }
  auto isEmpty() -> bool { return _idle_semas.empty(); }
  auto extract() -> IncrementalSemaphore {
    auto ret = std::move(_idle_semas.back());
    ret.increaseValue();
    _idle_semas.pop_back();
    return ret;
  }
  void tryShrink() {
    auto shrink_size = 5;
    toy::debugf("shrink {} -> {}", _idle_semas.size(), shrink_size);
    if (_idle_semas.size() <= shrink_size) {
      return;
    }
    _idle_semas.erase(_idle_semas.begin() + shrink_size, _idle_semas.end());
  }
  void workingToIdle() {}
};

// once allocated, can only submit one signal op by specified value
// the signal/wait op must done before recycled
class DisposableSemaphore : private toy::RecyclableObject<SemaphorePool, IncrementalSemaphore> {
public:
  using RecyclableObject::RecyclableObject;
  using RecyclableObject::operator=;
  using RecyclableObject::get;
  using RecyclableObject::valid;
  using RecyclableObject::operator VkSemaphore;
  using RecyclableObject::getNowValue;
  using RecyclableObject::hostWait;
};

class SpinMutex {
private:
  std::atomic_flag flag;

public:
  void lock() {
    while (flag.test_and_set(std::memory_order_acquire)) {
    }
  }

  void unlock() { flag.clear(std::memory_order_release); }
};

class Execution;

using ExecWaitInfo = std::pair<VkPipelineStageFlags2, Execution>;
using RawSyncInfo = std::pair<VkPipelineStageFlags2, VkSemaphore>;
struct CommandBatch {
  std::vector<RecordableCmdbuf>             cmdbufs;
  std::vector<ExecWaitInfo>                 waits;
  std::unordered_set<VkPipelineStageFlags2> signals;
  std::vector<RawSyncInfo>                  raw_waits;
  std::vector<RawSyncInfo>                  raw_signals;
};

struct ExecutionContext {
  std::vector<RecordableCmdbuf>                                  cmdbufs;
  std::vector<std::shared_ptr<ExecutionContext>>                 wait_execs;
  std::unordered_map<VkPipelineStageFlags2, DisposableSemaphore> signal_semas;
  // if true but not destroyed, means hold by another execution to wait
  std::atomic<bool>                                              execution_done;
};

class Execution {
public:
  Execution() = default;
  Execution(VkQueue queue, CommandBatch batch) {
    auto [submit_info, _] = initToReadySubmit(batch);
    CHECK_VK_RESULT(vkQueueSubmit2(queue, 1, &submit_info, VK_NULL_HANDLE));
  }
  static auto submits(VkQueue queue, std::span<CommandBatch> batches) -> std::vector<Execution> {
    auto ret = std::vector<Execution>{};
    ret.resize(batches.size());
    auto submit_infos = std::vector<VkSubmitInfo2>{};
    auto submit_info_ctxs = std::vector<std::any>{};
    for (auto [batch, execution] : views::zip(batches, ret)) {
      auto [exec, ctx] = execution.initToReadySubmit(batch);
      submit_infos.push_back(std::move(exec));
      submit_info_ctxs.push_back(std::move(ctx));
    }
    CHECK_VK_RESULT(vkQueueSubmit2(
      queue, static_cast<uint32>(submit_infos.size()), submit_infos.data(), VK_NULL_HANDLE
    ));
    return ret;
  }

private:
  auto initToReadySubmit(CommandBatch& batch) -> std::pair<VkSubmitInfo2, std::any> {
    auto ctx = std::make_shared<ExecutionContext>();
    auto wait_infos = std::vector<VkSemaphoreSubmitInfo>{};
    for (auto& [stage, exec] : batch.waits) {
      TOY_ASSERT(exec.canWait(stage));
      if (auto exec_ctx = exec._ctx.lock(); exec_ctx && !exec_ctx->execution_done) {
        auto& sema = exec_ctx->signal_semas.at(stage);
        wait_infos.push_back(
          {
            .sType = VK_STRUCTURE_TYPE_SEMAPHORE_SUBMIT_INFO,
            .semaphore = sema,
            .value = sema.getNowValue(),
            .stageMask = stage,
          }
        );
        ctx->wait_execs.push_back(std::move(exec_ctx));
      }
    }
    for (auto& [stage, sema] : batch.raw_waits) {
      wait_infos.push_back(
        {
          .sType = VK_STRUCTURE_TYPE_SEMAPHORE_SUBMIT_INFO,
          .semaphore = sema,
          .stageMask = stage,
        }
      );
    }
    auto signal_infos = std::vector<VkSemaphoreSubmitInfo>{};
    _signal_stages = std::make_shared<std::unordered_set<VkPipelineStageFlags2>>();
    batch.signals.insert(VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT);
    for (auto& stage : batch.signals) {
      auto sema = DisposableSemaphore{ SemaphorePool::getInstance() };
      signal_infos.push_back(
        {
          .sType = VK_STRUCTURE_TYPE_SEMAPHORE_SUBMIT_INFO,
          .semaphore = sema,
          .value = sema.getNowValue(),
          .stageMask = stage,
        }
      );
      ctx->signal_semas[stage] = std::move(sema);
      _signal_stages->insert(stage);
    }
    for (auto& [stage, sema] : batch.raw_signals) {
      signal_infos.push_back(
        {
          .sType = VK_STRUCTURE_TYPE_SEMAPHORE_SUBMIT_INFO,
          .semaphore = sema,
          .stageMask = stage,
        }
      );
    }
    auto cmdbuf_infos = std::vector<VkCommandBufferSubmitInfo>{};
    for (auto& cmdbuf : batch.cmdbufs) {
      cmdbuf_infos.push_back(
        {
          .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_SUBMIT_INFO,
          .commandBuffer = cmdbuf,
        }
      );
      ctx->cmdbufs.push_back(std::move(cmdbuf));
    }
    auto submit_info = VkSubmitInfo2{
      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO_2,
      .waitSemaphoreInfoCount = static_cast<uint32>(wait_infos.size()),
      .pWaitSemaphoreInfos = wait_infos.data(),
      .commandBufferInfoCount = static_cast<uint32>(cmdbuf_infos.size()),
      .pCommandBufferInfos = cmdbuf_infos.data(),
      .signalSemaphoreInfoCount = static_cast<uint32>(signal_infos.size()),
      .pSignalSemaphoreInfos = signal_infos.data(),
    };
    _ctx = ctx;
    addToQueue(std::move(ctx));
    TOY_ASSERT(_worker.joinable());
    return {
      submit_info,
      std::tuple{ std::move(wait_infos), std::move(cmdbuf_infos), std::move(signal_infos) },
    };
  }

public:
  auto hostWait(
    VkPipelineStageFlags2 stage = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, uint64 timeout = max_timeout
  ) -> bool {
    TOY_ASSERT(canWait(stage));
    if (auto ctx = _ctx.lock(); ctx && !ctx->execution_done) {
      return ctx->signal_semas.at(stage).hostWait(timeout);
    } else {
      return true;
    }
  }
  void detach() {
    _ctx.reset();
    _signal_stages.reset();
  }
  auto valid() -> bool { return _signal_stages.get(); }
  auto getQueue() -> VkQueue;
  auto getFamily() -> uint32;
  auto canWait(VkPipelineStageFlags2 stage) -> bool { return _signal_stages->contains(stage); }

  static void initWorker() { _worker = std::thread{ work }; }

private:
  std::shared_ptr<std::unordered_set<VkPipelineStageFlags2>> _signal_stages;
  std::weak_ptr<ExecutionContext>                            _ctx;

  static inline std::deque<std::shared_ptr<ExecutionContext>> _exec_queue;
  static inline SpinMutex                                     _queue_mutex;
  static inline std::thread                                   _worker;

  void addToQueue(std::shared_ptr<ExecutionContext> ctx) {
    std::lock_guard lock{ _queue_mutex };
    _exec_queue.push_back(std::move(ctx));
  }
  static void work() {
    while (true) {
      auto ctx = std::shared_ptr<ExecutionContext>{};
      {
        auto lock = std::lock_guard{ _queue_mutex };
        if (_exec_queue.empty()) {
          _queue_mutex.unlock();
          using namespace std::chrono_literals;
          std::this_thread::sleep_for(10ms);
          continue;
        }
        ctx = _exec_queue.front();
        _exec_queue.pop_front();
      }
      auto done = ctx->signal_semas.at(VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT)
                    .hostWait(1000 * 1000 * 10); // 10ms
      if (done) {
        ctx->execution_done = true;
      } else {
        auto lock = std::lock_guard{ _queue_mutex };
        _exec_queue.push_back(ctx);
      }
    }
  }
};

} // namespace rd::exec
