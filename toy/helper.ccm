export module toy.helper;

import std;
import toy.log;
import toy.concepts;

export namespace toy {

template <uint32 I>
struct TypedIndex {};

namespace literals {

template <char... chars>
constexpr auto operator""_i() {
  struct acc {
    std::size_t   val{ 0 };
    constexpr acc operator<<(char dig) const { return { val * 10 + dig - '0' }; }
    constexpr     operator std::size_t() const { return val; }
  };
  return TypedIndex<(acc{} << ... << chars)>{};
}

} // namespace literals

// helper for string literal as non-type template parameter
template <size_t N>
struct StringLiteral {
  constexpr StringLiteral(const char (&str)[N]) { std::copy_n(str, N, value); }
  static constexpr auto from(char const* str) {
    char value[N];
    std::copy_n(str, N, value);
    return StringLiteral<N>{ value };
  }
  char value[N];
};

template <auto sv_getter>
constexpr auto stringView2Literal() {
  return StringLiteral<sv_getter().size() + 1>::from(sv_getter().data());
}

template <typename... Lambdas>
struct OverloadLambda : public Lambdas... {
  using Lambdas::operator()...;
};

auto _ptr_manager_lambda = [](auto) {};

template <typename P>
using PtrManager = std::unique_ptr<std::remove_pointer_t<P>, decltype(_ptr_manager_lambda)>;

/**
 * @brief must place it to the first base class location
 * @note reason: the auto generated move assigner operator will execute base class and members
 * move assigner by declaration order
 */
template <typename Derived>
class AutoMoveAssigner {
public:
  AutoMoveAssigner() = default;
  AutoMoveAssigner& operator=(AutoMoveAssigner&& e) noexcept {
    self().beforeDestroy();
    return *this;
  }
  AutoMoveAssigner(AutoMoveAssigner&& e) noexcept = default;

private:
  template <typename = void>
    requires requires(Derived d) { d.beforeDestroy(); }
  auto self() -> Derived& {
    return static_cast<Derived&>(*this);
  }
};

/**
 * @brief 需要主动构造，可含有参数，若在构造前调用getInstance()会抛异常
 * @tparam T
 */
template <typename Derived, StringLiteral name = "unknown">
class ProactiveSingleton {
private:
  static inline Derived* _instance_ptr = nullptr;

  auto self() -> Derived& { return static_cast<Derived&>(*this); }

public:
  ProactiveSingleton(bool init = true) {
    if (init) {
      if (_instance_ptr != nullptr) {
        toy::throwf("construct {} multi time!", name.value);
      }
      _instance_ptr = &self();
    }
  }
  ~ProactiveSingleton() {
    if (_instance_ptr == this) {
      _instance_ptr = nullptr;
    }
  }

  static auto getInstance(std::source_location loc = std::source_location::current()) -> Derived& {
    if (_instance_ptr == nullptr) {
      toy::throwf(loc, "need proactively construct {} first!", name.value);
    }
    return *_instance_ptr;
  }

  ProactiveSingleton& operator=(const ProactiveSingleton&) = delete;
  ProactiveSingleton(const ProactiveSingleton&) = delete;
  ProactiveSingleton& operator=(ProactiveSingleton&&) {
    _instance_ptr = &self();
    return *this;
  }
  ProactiveSingleton(ProactiveSingleton&&) noexcept { _instance_ptr = &self(); }
};

class Defer {
public:
  Defer() = default;
  Defer(std::function<void()> func) : _func(std::move(func)) {}
  auto operator=(std::function<void()> func) -> Defer& {
    _func = std::move(func);
    return *this;
  }
  void clear() { _func = {}; }
  ~Defer() {
    if (_func) {
      _func();
    }
  }
  Defer(const Defer&) noexcept = delete;
  Defer(Defer&&) noexcept = delete;
  auto operator=(const Defer&) noexcept -> Defer& = delete;
  auto operator=(Defer&&) noexcept -> Defer& = delete;

private:
  std::function<void()> _func;
};

namespace test_StringLiteral {

template <StringLiteral a>
void func() {}

void test() {
  func<"abcd">();
  func<StringLiteral<5>::from("abcd")>();
  func<stringView2Literal<[]() { return std::string_view{ "abcd" }; }>()>();

  class A;
  auto ptr = PtrManager<A*>{ nullptr, _ptr_manager_lambda };
  auto ptr_ = PtrManager<A*>{};
  ptr_ = std::move(ptr);
  auto ptr2 = PtrManager<void*>{};
  auto ptr2_ = PtrManager<void*>{ std::move(ptr2) };
  ptr2 = std::move(ptr2_);
}

} // namespace test_StringLiteral

} // namespace toy