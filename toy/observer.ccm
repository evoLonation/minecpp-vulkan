module;
#include <toy.h>
export module toy.observer;

import std;
import toy.traceable;
import toy.log;

export namespace toy {

/**
 * @brief Inherit Traceable to make the life time of Observer can be *LONGER* than Observable
 */

template <typename T>
class Observer {
public:
  virtual void observerNotified(T const&) = 0;
};

template <typename T>
class Observable {
public:
  Observable() = default;

  void notify(T const& value) {
    for (auto* observer : _observers) {
      observer->observerNotified(value);
    }
  }

  void addObserver(Observer<T>* observer) { _observers.insert(observer); }
  void removeObserver(Observer<T>* observer) { _observers.erase(observer); }

private:
  std::unordered_set<Observer<T>*> _observers;
};

template <typename T>
class ObserverFunc : public Observer<T> {
public:
  ObserverFunc() = default;
  ObserverFunc(std::function<void(T const&)> dealer) : _dealer(std::move(dealer)) {}

private:
  void observerNotified(T const& value) override { _dealer(value); }

  std::function<void(T const&)> _dealer;
};

} // namespace toy
