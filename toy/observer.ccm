module;
#include <toy.h>
export module toy.observer;

import std;
import toy.traceable;
import toy.log;

export namespace toy {

/**
 * @brief Inherit Traceable to make the life time of Observer can be *LONGER* than Observable
 */

template <typename Arg>
class Observer {
public:
  virtual void observerNotified(Arg) = 0;
};

template <typename Arg>
class Observable {
public:
  Observable() = default;

  void notify(Arg value) {
    for (auto* observer : _observers) {
      observer->observerNotified(value);
    }
  }

  void addObserver(Observer<Arg>* observer) { _observers.insert(observer); }
  void removeObserver(Observer<Arg>* observer) { _observers.erase(observer); }

private:
  std::unordered_set<Observer<Arg>*> _observers;
};

template <typename Arg>
class ObserverFunc : public Observer<Arg> {
public:
  ObserverFunc() = default;
  ObserverFunc(std::function<void(Arg)> dealer) : _dealer(std::move(dealer)) {}

private:
  void observerNotified(Arg value) override {
    if constexpr (std::is_reference_v<Arg>) {
      _dealer(value);
    } else {
      _dealer(std::move(value));
    }
  }

  std::function<void(Arg)> _dealer;
};

} // namespace toy
