module;
#include <toy.h>
export module toy.log;

import toy.trait;

import std;

export namespace toy {

constexpr bool enable_debug = true;
template <size_t number>
class BracesString {
private:
  static consteval auto getFormatStringArray() {
    std::array<char, number * 4> arr{};
    for (auto i : ranges::iota_view(static_cast<size_t>(0), number - 1)) {
      arr[i * 4] = '{';
      arr[i * 4 + 1] = '}';
      arr[i * 4 + 2] = ',';
      arr[i * 4 + 3] = ' ';
    }
    arr[(number - 1) * 4] = '{';
    arr[(number - 1) * 4 + 1] = '}';
    arr[(number - 1) * 4 + 2] = ' ';
    arr[(number - 1) * 4 + 3] = '\0';
    return arr;
  }
  static constexpr std::array<char, number * 4> value = getFormatStringArray();

public:
  static consteval const char* get() { return value.data(); }
};

auto formatSourceLocation(const std::source_location& location) -> std::string {
  // return std::format(
  //   "{}:{}:{} ({})",
  //   location.file_name(),
  //   location.line(),
  //   location.column(),
  //   location.function_name()
  // );
  namespace fs = std::filesystem;
  return std::format(
    "{}:{}:{}", fs::relative(location.file_name()).string(), location.line(), location.column()
  );
}

template <typename... Args>
struct BasicFormatWithLocation {
  consteval BasicFormatWithLocation(
    const char* fmt, std::source_location location = std::source_location::current()
  )
    : _fmt(fmt), _location(std::move(location)) {}
  std::format_string<Args...> _fmt;
  std::source_location        _location;
};

// use std::type_identity_t make Non-deduced contexts
template <typename... Args>
using FormatWithLocation = BasicFormatWithLocation<std::type_identity_t<Args>...>;

template <typename... Args>
void debugf(
  std::optional<std::source_location> tag, std::format_string<Args...> fmt, Args&&... args
) {
  if constexpr (enable_debug) {
    if (tag) {
      std::println(
        "{}: {}", formatSourceLocation(tag.value()), std::format(fmt, std::forward<Args>(args)...)
      );
    } else {
      std::println(fmt, std::forward<Args>(args)...);
    }
  }
}

template <typename... Args>
void debugf(FormatWithLocation<Args...> fmt_location, Args&&... args) {
  auto& [fmt, location] = fmt_location;
  debugf(location, fmt, std::forward<Args>(args)...);
}

template <typename Arg>
void debug(std::optional<std::source_location> tag, Arg&& arg) {
  debugf(tag, "{}", std::forward<Arg>(arg));
}

template <typename Arg>
void debug(Arg&& arg, std::source_location location = std::source_location::current()) {
  debug(location, std::forward<Arg>(arg));
}

template <typename... Args>
auto checkf(
  std::optional<std::source_location> tag,
  bool                                condition,
  std::format_string<Args...>         fmt,
  Args&&... args
) -> bool {
  if constexpr (enable_debug) {
    if (!condition) {
      debugf(tag, std::move(fmt), std::forward<Args>(args)...);
    }
  }
  return condition;
}

template <typename... Args>
auto checkf(bool condition, FormatWithLocation<Args...> fmt_location, Args&&... args) -> bool {
  auto& [fmt, location] = fmt_location;
  return checkf(location, condition, fmt, std::forward<Args>(args)...);
}

template <typename... Args>
struct debugs {
  debugs(Args&&... args, std::source_location location = std::source_location::current()) {
    if constexpr (enable_debug) {
      std::println(
        "{}: {}",
        formatSourceLocation(location),
        std::format(
          std::format_string<Args...>(BracesString<sizeof...(Args)>::get()),
          std::forward<Args>(args)...
        )
      );
    }
  }
};
template <typename... Args>
debugs(Args&&... args) -> debugs<Args...>;

template <typename... Args>
[[noreturn]] void throwf(
  std::optional<std::source_location> tag, std::format_string<Args...> fmt, Args&&... args
) {
  auto msg = std::format(std::move(fmt), std::forward<Args>(args)...);
  if (tag) {
    throw std::runtime_error{
      std::format("{}: {}", formatSourceLocation(tag.value()), std::move(msg))
    };
  } else {
    throw std::runtime_error{ std::move(msg) };
  }
}

template <typename Condition, typename... Args>
  requires std::same_as<std::decay_t<Condition>, bool>
constexpr void throwf(
  std::optional<std::source_location> tag,
  Condition                           condition,
  std::format_string<Args...>         fmt,
  Args&&... args
) {
  if (!condition) {
    throwf(tag, std::move(fmt), std::forward<Args>(args)...);
  }
}

template <typename... Args>
[[noreturn]] void throwf(FormatWithLocation<Args...> fmt_location, Args&&... args) {
  auto& [fmt, location] = fmt_location;
  throwf(location, fmt, std::forward<Args>(args)...);
}
template <typename First, typename... Args>
  requires std::same_as<std::decay_t<First>, bool>
constexpr void throwf(First condition, FormatWithLocation<Args...> fmt_location, Args&&... args) {
  auto& [fmt, location] = fmt_location;
  throwf(location, condition, std::move(fmt), std::forward<Args>(args)...);
}

namespace macro {

template <typename... Args>
constexpr auto getRefTuple(Args&&... args) -> std::tuple<Args&&...> {
  return std::tuple<Args&&...>{ std::forward<Args>(args)... };
}

template <typename... Args>
constexpr auto nameTupleFormat(std::string_view names, std::tuple<Args...> args) -> std::string {
  auto splited_names = //
    names | views::split(',') | views::transform([&](auto str) {
      // trim left
      // if trim right, need construct a string
      // std::isspace has 2 overload, so can not directly pass to drop_while
      auto view = str | views::drop_while([](char c) { return std::isspace(c); });
      return std::string_view{ view.begin(), view.end() };
    });
  auto iter = splited_names.begin();
  auto str = std::string{};
  toy::templateForEach<sizeof...(Args)>([&]<size_t index>() {
    str += std::format("\"{}\": {}, ", *iter++, std::get<index>(args));
  });
  return str;
}

// https://stackoverflow.com/questions/72430369/how-to-check-that-a-type-is-formattable-using-type-traits-concepts
template <typename T>
concept formattable = requires(T& v, std::format_context ctx) {
  std::formatter<std::remove_cvref_t<T>>().format(v, ctx);
};

// just format args which can be formatted
template <typename... Args>
constexpr auto nameTupleFormatIfCan(std::string_view names, std::tuple<Args...> args)
  -> std::string {
  auto splited_names = //
    names | views::split(',') | views::transform([&](auto str) {
      // trim left
      // if trim right, need construct a string
      // std::isspace has 2 overload, so can not directly pass to drop_while
      auto view = str | views::drop_while([](char c) { return std::isspace(c); });
      return std::string_view{ view.begin(), view.end() };
    });
  auto iter = splited_names.begin();
  auto str = std::string{};
  toy::templateForEach<sizeof...(Args)>([&]<size_t index>() {
    if constexpr (formattable<typename toy::TypePack<Args...>::template at<index>>) {
      str += std::format("\"{}\": {}, ", *iter, std::get<index>(args));
    }
    iter++;
  });
  return str;
}

constexpr auto nextLineIfExist(std::string current_line, std::string_view next_line)
  -> std::string {
  if (next_line.empty()) {
    return current_line;
  }
  return std::format("{}\n  {}", current_line, next_line);
}

} // namespace macro

} // namespace toy

CUSTOM_FORMATTER(std::source_location, toy::formatSourceLocation);