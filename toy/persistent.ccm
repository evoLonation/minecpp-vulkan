module;
#include <toy.h>

export module toy.persistent;

import toy.trait;
import std;
import toy.log;

export namespace toy {

template <typename T>
struct DefaultSerializerS;
template <typename T>
using DefaultSerializer = DefaultSerializerS<T>::type;

// const T 视为 T 处理
template <typename T>
struct DefaultSerializerS<T const> {
  using type = DefaultSerializerS<T>::type;
};

class OutputStream {
protected:
  virtual void writeBytes(std::span<std::byte const> b) = 0;

public:
  void write(std::span<std::byte> b) { writeBytes(b); }
  void write(std::span<std::byte const> b) { writeBytes(b); }
  template <typename T, typename SerializerT = DefaultSerializer<T>>
  void write(T const& t, SerializerT serializer = {}) {
    serializer.serialize(*this, t);
  }
};

class InputStream {
protected:
  virtual void readBytes(std::span<std::byte> b) = 0;

public:
  void read(std::span<std::byte> b) { readBytes(b); }
  template <typename T, typename SerializerT = DefaultSerializer<T>>
  auto read(SerializerT serializer = {}) -> T {
    return serializer.deserialize(*this);
  }
};

class VectorStream : public OutputStream, public InputStream {
public:
  VectorStream(std::vector<std::byte>* v) : _v(v) {}
  void writeBytes(std::span<std::byte const> b) override {
    // TOY_DEBUG(b.size());
    // TOY_DEBUG(*reinterpret_cast<int const*>(b.data()));
    _v->insert(_v->end(), b.begin(), b.end());
  }
  void readBytes(std::span<std::byte> b) override {
    TOY_ASSERT(_v->size() >= _pos + b.size(), _v->size(), _pos, b.size());
    std::copy(_v->begin() + _pos, _v->begin() + _pos + b.size(), b.begin());
    // TOY_DEBUG(b.size());
    // TOY_DEBUG(*reinterpret_cast<int const*>(b.data()));
    _pos += b.size();
  }

private:
  std::vector<std::byte>* _v;
  std::size_t             _pos = 0;
};

template <std::forward_iterator IteratorT>
  requires std::is_same_v<typename std::iterator_traits<IteratorT>::value_type, std::byte>
class IteratorStream : public OutputStream, public InputStream {
public:
  IteratorStream(IteratorT it, IteratorT end) : _it_i(it), _it_o(it), _end(end) {}

  void writeBytes(std::span<std::byte const> b) override {
    if constexpr (std::contiguous_iterator<IteratorT>) {
      TOY_ASSERT(_it_o + b.size() <= _end);
      std::copy(b.begin(), b.end(), _it_o);
      _it_o += b.size();
    } else {
      for (auto& e : b) {
        *_it_o++ = e;
      }
    }
  }

  void readBytes(std::span<std::byte> b) override {
    if constexpr (std::contiguous_iterator<IteratorT>) {
      TOY_ASSERT(_it_i + b.size() <= _end);
      std::copy(_it_i, _it_i + b.size(), b.begin());
      _it_i += b.size();
    } else {
      for (auto& e : b) {
        e = *_it_i++;
      }
    }
  }

private:
  IteratorT _it_i;
  IteratorT _it_o;
  IteratorT _end;
};

template <typename T>
concept TriviallySerializable =
  std::is_trivially_copyable_v<T> && std::is_default_constructible_v<T> && !std::is_pointer_v<T> &&
  !std::is_reference_v<T> && !std::is_const_v<T>;

template <TriviallySerializable T>
struct TrivialSerializer {
  static void serialize(OutputStream& output, T const& t) {
    output.write(std::as_bytes(std::span{ &t, 1 }));
  }
  static auto deserialize(InputStream& input) -> T {
    T t{};
    input.read(std::as_writable_bytes(std::span{ &t, 1 }));
    return t;
  }
};
template <TriviallySerializable T>
struct DefaultSerializerS<T> {
  using type = TrivialSerializer<T>;
};

template <typename T, typename ES = DefaultSerializer<typename T::value_type>>
struct SequenceSerializer {
  static constexpr bool is_trivial =
    std::is_trivially_copyable_v<typename T::value_type> && ranges::contiguous_range<T>;
  static void serialize(OutputStream& output, T const& t) {
    output.write(static_cast<std::size_t>(ranges::size(t)));
    if constexpr (is_trivial) {
      output.write(std::as_bytes(std::span{ ranges::data(t), ranges::size(t) }));
    } else {
      for (auto const& e : t) {
        output.write(e, ES{});
      }
    }
  }
  static auto deserialize(InputStream& input) -> T {
    auto size = input.read<std::size_t>();
    auto t = T{};
    if constexpr (is_trivial) {
      t.resize(size);
      input.read(std::as_writable_bytes(std::span{ ranges::data(t), ranges::size(t) }));
    } else {
      for (std::size_t i = 0; i < size; ++i) {
        t.push_back(input.read<typename T::value_type, ES>());
      }
    }
    return t;
  }
};
template <typename T>
struct DefaultSerializerS<std::vector<T>> {
  using type = SequenceSerializer<std::vector<T>>;
};
template <typename T>
struct DefaultSerializerS<std::list<T>> {
  using type = SequenceSerializer<std::list<T>>;
};
template <typename T>
struct DefaultSerializerS<std::deque<T>> {
  using type = SequenceSerializer<std::deque<T>>;
};
template <>
struct DefaultSerializerS<std::string> {
  using type = SequenceSerializer<std::string>;
};

template <typename T, typename ES = DefaultSerializer<typename T::value_type>>
struct SetSerializer {
  static void serialize(OutputStream& output, T const& t) {
    output.write(static_cast<std::size_t>(t.size()));
    for (auto const& e : t) {
      output.write(e, ES{});
    }
  }
  static auto deserialize(InputStream& input) -> T {
    auto size = input.read<std::size_t>();
    auto t = T{};
    for (auto i = 0; i < size; ++i) {
      t.insert(input.read<typename T::value_type, ES>());
    }
    return t;
  }
};
template <typename T>
struct DefaultSerializerS<std::set<T>> {
  using type = SetSerializer<std::set<T>>;
};
template <typename T>
struct DefaultSerializerS<std::unordered_set<T>> {
  using type = SetSerializer<std::unordered_set<T>>;
};

template <
  typename T,
  typename KS = DefaultSerializer<typename T::key_type>,
  typename VS = DefaultSerializer<typename T::mapped_type>>
struct MapSerializer {
  static void serialize(OutputStream& output, T const& t) {
    output.write(static_cast<std::size_t>(t.size()));
    for (auto const& [k, v] : t) {
      output.write(k, KS{});
      output.write(v, VS{});
    }
  }
  static auto deserialize(InputStream& input) -> T {
    auto size = input.read<std::size_t>();
    auto t = T{};
    for (auto i = 0; i < size; ++i) {
      auto k = input.read<typename T::key_type, KS>();
      auto v = input.read<typename T::mapped_type, VS>();
      t.insert({ std::move(k), std::move(v) });
    }
    return t;
  }
};
template <typename K, typename V>
struct DefaultSerializerS<std::map<K, V>> {
  using type = MapSerializer<std::map<K, V>>;
};
template <typename K, typename V>
struct DefaultSerializerS<std::unordered_map<K, V>> {
  using type = MapSerializer<std::unordered_map<K, V>>;
};

template <
  typename T,
  typename FS = DefaultSerializer<typename T::first_type>,
  typename SS = DefaultSerializer<typename T::second_type>>
struct PairSerializer {
  static void serialize(OutputStream& output, T const& t) {
    output.write(t.first, FS{});
    output.write(t.second, SS{});
  }
  static auto deserialize(InputStream& input) -> T {
    auto first = input.read<typename T::first_type, FS>();
    auto second = input.read<typename T::second_type, SS>();
    return { std::move(first), std::move(second) };
  }
};
template <typename T1, typename T2>
struct DefaultSerializerS<std::pair<T1, T2>> {
  using type = PairSerializer<std::pair<T1, T2>>;
};

template <typename T, typename... ESs>
struct TupleSerializer {
  static void serialize(OutputStream& output, T const& t) {
    applyIndexSequence<std::tuple_size_v<T>>([&]<size_t... is>() {
      (output.write(std::get<is>(t), ESs{}), ...);
    });
  }
  static auto deserialize(InputStream& input) -> T {
    typename toy::ToTypePack<T>::template applyTo<std::optional>::template apply<std::tuple> t_opts;
    applyIndexSequence<std::tuple_size_v<T>>([&]<size_t... is>() {
      ((std::get<is>(t_opts) = input.read<std::tuple_element_t<is, T>, ESs>()), ...);
    });
    return applyIndexSequence<std::tuple_size_v<T>>([&]<size_t... is>() {
      return T{ std::move(*std::get<is>(t_opts))... };
    });
  }
};
template <typename... Ts>
struct DefaultSerializerS<std::tuple<Ts...>> {
  using type = TupleSerializer<std::tuple<Ts...>, DefaultSerializer<Ts>...>;
};

template <typename T, typename M, typename S>
struct MemberSerializerInfo {
  M T::* member;
  S      serializer = DefaultSerializer<M>{};
};

template <typename T, typename M>
MemberSerializerInfo(M T::*) -> MemberSerializerInfo<T, M, DefaultSerializer<M>>;

template <typename T, auto creator, auto... members>
struct CustomSerializer {
  static void serialize(OutputStream& output, T const& t) {
    applyIndexSequence<sizeof...(members)>([&]<size_t... is>() {
      (output.write(t.*members.member, members.serializer), ...);
    });
  }
  static auto deserialize(InputStream& input) -> T {
    using MemberPack =
      toy::TypePack<std::remove_reference_t<decltype(std::declval<T>().*members.member)>...>;
    using SerializerPack = toy::TypePack<decltype(members.serializer)...>;
    using TupleOpt = MemberPack::template applyTo<std::optional>::template apply<std::tuple>;
    auto tuple_opt = TupleOpt{};
    templateForEach<sizeof...(members)>([&]<size_t i>() {
      using Member = MemberPack::template at<i>;
      using Serializer = SerializerPack::template at<i>;
      std::get<i>(tuple_opt) = input.read<Member, Serializer>();
    });

    return std::apply(
      [&](auto&... args) { return creator(std::move(args.value())...); }, tuple_opt
    );
  }
};

} // namespace toy
