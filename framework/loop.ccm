module;
#include <toy.h>
export module loop;

import std;
import toy;

import glfw;
import input;

import <glfw_config.h>;

import render.presentation;

export namespace loop {

enum Stage {
  BEFORE_RENDER,
  RENDER,
  AFTER_RENDER,
};

struct ActionContext : rd::Presentation::Context {
  bool recreated;
  // second
  float interval;
};

class Action {
private:
  friend class Loop;
  virtual void runLoop(ActionContext const&) = 0;

protected:
  Action() = default;
  Action(Stage stage) : _stage(stage) { add(); }

  void setStage(Stage stage) {
    remove();
    _stage = stage;
    add();
  }
  void reset() {
    remove();
    _stage.reset();
  }

  Action(const Action& e) noexcept : _stage(e._stage) { add(); }
  Action(Action&& e) noexcept : Action(e) {}
  auto operator=(const Action& e) noexcept -> Action& {
    remove();
    _stage = e._stage;
    add();
    return *this;
  }
  auto operator=(Action&& e) noexcept -> Action& {
    *this = e;
    return *this;
  }

private:
  std::optional<Stage> _stage;

  void add();
  void remove();
};

class Loop : public PROACTIVE_SINGLETON(Loop) {
public:
  Loop() = default;

  void run() {
    auto& presentation = rd::Presentation::getInstance();
    auto  count = 0;
    auto  last_time = chrono::high_resolution_clock::now();
    float interval;
    bool  recreated;
    while (!glfwWindowShouldClose(glfw::Window::getInstance())) {
      auto interval_ = chrono::high_resolution_clock::now() - last_time;
      last_time += interval_;
      interval = chrono::duration_cast<chrono::microseconds>(interval_).count() / 1'000'000.0f;
      input::InputProcessor::getInstance().processInput(interval);
      auto res = presentation.prepare();
      if (!res.has_value()) {
        if (presentation.recreate()) {
          recreated = true;
        }
      } else {
        auto ctx = ActionContext{ res.value(), recreated, interval };
        for (auto& actions : _actions | views::values) {
          for (auto& action : actions) {
            action->runLoop(ctx);
          }
        }
        presentation.present(ctx.image_index);
        if (recreated) {
          recreated = false;
        }
      }
      count++;
      if (count % 500 == 0) {
        toy::debug(count);
        toy::debugf("fps: {}", 1.0f / interval);
      }
    }
  }

private:
  friend Action;
  std::map<Stage, std::unordered_set<Action*>> _actions;
};

void Action::add() {
  if (_stage) {
    Loop::getInstance()._actions[*_stage].insert(this);
  }
}

void Action::remove() {
  if (_stage) {
    Loop::getInstance()._actions[*_stage].erase(this);
  }
}

} // namespace loop