module;
#include <toy.h>
export module framework.loop;

import std;
import toy;
import glfw;
import render;
import framework.input;
import <glfw_config.h>;

export namespace fw {

enum Stage {
  BEFORE_RENDER,

  UNIFORM_UPDATE,
  RENDER,
  AFTER_RENDER,
};

struct ActionContext : rd::Presentation::Context {
  bool recreated;
  // second
  float interval;
};

class Action {
private:
  friend class Loop;
  virtual void runLoop(ActionContext const&) = 0;

protected:
  Action() = default;
  Action(Stage stage) : _stage(stage) { add(); }
  ~Action() { remove(); }

  void setStage(Stage stage) {
    remove();
    _stage = stage;
    add();
  }
  void reset() {
    remove();
    _stage.reset();
  }

  Action(const Action& e) noexcept : _stage(e._stage) { add(); }
  Action(Action&& e) noexcept {
    e.remove();
    _stage = std::move(e._stage);
    add();
  }
  auto operator=(const Action& e) noexcept -> Action& {
    remove();
    _stage = e._stage;
    add();
    return *this;
  }
  auto operator=(Action&& e) noexcept -> Action& {
    e.remove();
    remove();
    _stage = std::move(e._stage);
    add();
    return *this;
  }

private:
  std::optional<Stage> _stage;

  void add();
  void remove();
};

class Loop : public PROACTIVE_SINGLETON(Loop) {
public:
  Loop() = default;

  void run() {
    using timer = std::chrono::high_resolution_clock;
    auto& presentation = rd::Presentation::getInstance();
    auto  count = 0;
    auto  last_time = timer::now();
    auto  last_report_time = timer::now();
    float interval;
    bool  recreated;
    while (!glfwWindowShouldClose(glfw::Window::getInstance())) {
      auto interval_ = timer::now() - last_time;
      last_time += interval_;
      interval = chrono::duration_cast<chrono::microseconds>(interval_).count() / 1'000'000.0f;
      InputProcessor::getInstance().processInput(interval);
      auto res = presentation.prepare();
      if (!res.has_value()) {
        if (presentation.recreate()) {
          recreated = true;
        }
      } else {
        auto ctx = ActionContext{ res.value(), recreated, interval };
        for (auto& [stage, actions] : _actions) {
          for (auto& action : actions) {
            action->runLoop(ctx);
          }
        }
        presentation.present(ctx.image_index);
        if (recreated) {
          recreated = false;
        }
      }
      count++;
      if (chrono::duration_cast<chrono::seconds>(timer::now() - last_report_time).count() >= 2) {
        toy::debugf("fps: {}", count / 2.0f);
        count = 0;
        last_report_time = timer::now();
      }
    }
  }

private:
  friend Action;
  std::map<Stage, std::unordered_set<Action*>> _actions;
};

void Action::add() {
  if (_stage) {
    Loop::getInstance()._actions[*_stage].insert(this);
  }
}

void Action::remove() {
  if (_stage) {
    Loop::getInstance()._actions[*_stage].erase(this);
  }
}

class ActionHandler : public Action {
public:
  ActionHandler(std::function<void(ActionContext const&)> func, Stage stage = Stage::RENDER)
    : _func(std::move(func)), Action(stage) {}

private:
  std::function<void(ActionContext const&)> _func;
  void runLoop(ActionContext const& ctx) override { _func(ctx); }
};

} // namespace fw