export module action;

import std;
import toy;

import <vulkan_config.h>;

import input;

export namespace action {

using Mouse = input::Mouse;
using Keyboard = input::Keyboard;
using ButtonState = input::ButtonState;
using CursorState = input::CursorState;
struct KeyboardStateChecker {
  auto operator[](Keyboard key) const -> std::optional<ButtonState> {
    return input::InputProcessor::getInstance().getState(key);
  }
};
struct MouseStateChecker {
  auto operator[](Mouse mouse) const -> std::optional<ButtonState> {
    return input::InputProcessor::getInstance().getState(mouse);
  }
};

struct ActionContext {
  uint32               interval_milli;
  VkExtent2D           screen;
  CursorState          cursor;
  KeyboardStateChecker keyboard;
  MouseStateChecker    mouse;
};

using KeyboardSet = toy::EnumSet<Keyboard>;
using MouseSet = toy::EnumSet<Mouse>;
using StateSet = toy::EnumSet<ButtonState::State>;

using ActionHandler = std::function<void(const ActionContext&)>;

struct ActionInterface {
  virtual void action(const ActionContext& ctx) = 0;
};
struct KeyboardTrigger {
  KeyboardSet key;
  StateSet    state;
};

class MouseAction : public ActionInterface {};

class CursorAction : public ActionInterface {};

class ActionManager : public PROACTIVE_SINGLETON(ActionManager) {
public:
  class Action : public ActionInterface {
  public:
    Action(ActionHandler handler) { insert(); }
    Action(const Action&) noexcept { insert(); }
    Action(Action&&) noexcept = default;
    auto operator=(const Action&) noexcept -> Action& = default;
    auto operator=(Action&&) noexcept -> Action& = default;
    ~Action() { erase(); }

  private:
    void insert() { ActionManager::getInstance()._actions.insert(this); }
    void erase() { ActionManager::getInstance()._actions.erase(this); }
  };

  class KeyboardAction : public ActionInterface {
  public:
    KeyboardAction(Keyboard key, ButtonState::State state) : _key(key), _state(state) {}

  private:
    Keyboard _key;
    StateSet _state;
  };

private:
  ActionContext _ctx;

  template <typename Key>
  struct Hash {
    size_t operator()(const std::pair<Key, ButtonState::State>& p) const {
      auto h1 = std::hash<Key>{}(p.first);
      auto h2 = std::hash<ButtonState::State>{}(p.second);
      return h1 ^ (h2 << 1);
    }
  };

  std::unordered_set<Action*>       _actions;
  std::unordered_set<CursorAction*> _cursor_actions;
  std::unordered_map<
    std::pair<Keyboard, ButtonState::State>,
    std::unordered_set<KeyboardAction*>,
    Hash<Keyboard>>
    _keyboard_actions;
  std::unordered_map<
    std::pair<Mouse, ButtonState::State>,
    std::unordered_set<MouseAction*>,
    Hash<Mouse>>
    _mouse_actions;

public:
  ActionManager() = default;
  void loopAction(uint32 interval_milli) {
    // auto& extent = rd::Context::getInstance().extent;
    auto& input = input::InputProcessor::getInstance();
    // _ctx.interval_milli = interval_milli;
    // _ctx.screen = { extent.width, extent.height };
    // _ctx.cursor = input.getCursorState();
    for (auto* action : _actions) {
      action->action(_ctx);
    }
    for (auto [key, state] : input.getKeyboardStates()) {
      for (auto* action : _keyboard_actions.at({ key, state.state })) {
        action->action(_ctx);
      }
    }
    for (auto [key, state] : input.getMouseStates()) {
      for (auto* action : _mouse_actions.at({ key, state.state })) {
        action->action(_ctx);
      }
    }
    if (_ctx.cursor.x_move != 0 || _ctx.cursor.y_move != 0) {
      for (auto* action : _cursor_actions) {
        action->action(_ctx);
      }
    }
  }
};

} // namespace action