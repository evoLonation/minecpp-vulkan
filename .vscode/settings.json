{
   "editor.tabSize": 2,
   "clangd.arguments": [
      // 关闭头文件自动插入
      "--header-insertion=never"
   ],
   "files.associations": {
      "*.ccm": "cpp"
   },
   "python.analysis.typeCheckingMode": "standard",
   "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?，。；、：“”！？《》【】……￥",
   "terminal.integrated.env.osx": {
      "PATH": "${workspaceFolder}/VulkanSDK/1.4.309.0/macOS/bin:${env:PATH}",
      "VK_ICD_FILENAMES": "${workspaceFolder}/VulkanSDK/1.4.309.0/macOS/share/vulkan/icd.d/MoltenVK_icd.json",
      "VK_LAYER_PATH": "${workspaceFolder}/VulkanSDK/1.4.309.0/macOS/share/vulkan/explicit_layer.d"
   }
}