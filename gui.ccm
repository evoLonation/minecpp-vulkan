export namespace gui {

void slider(const std::string& name, float& value, const float min = -50, const float max = 50) {
  ImGui::SliderFloat(name.c_str(), &value, min, max);
}

void slider(
  const std::string& name,
  glm::vec3&         value,
  const glm::vec3&   min = glm::vec3{ -5.0f },
  const glm::vec3&   max = glm::vec3{ 5.0f }
) {
  ImGui::SliderFloat(std::format("{}: x", name).c_str(), &value.x, min.x, max.x);
  ImGui::SliderFloat(std::format("{}: y", name).c_str(), &value.y, min.y, max.y);
  ImGui::SliderFloat(std::format("{}: z", name).c_str(), &value.z, min.z, max.z);
}

template <typename T>
void showPopup(T& t, std::map<T, const char*> elements) {
  if (ImGui::Button("Select..")) {
    ImGui::OpenPopup("my_select_popup");
  }
  ImGui::SameLine();
  ImGui::TextUnformatted(elements[t], elements[t]);
  if (ImGui::BeginPopup("my_select_popup")) {
    ImGui::SeparatorText("Aquarium");
    for (auto& element : elements) {
      if (ImGui::Selectable(element.second)) {
        t = element.first;
      }
    }
    ImGui::EndPopup();
  }
}

class TextInput {
private:
  static constexpr auto buf_size = 128;

  std::array<char, buf_size> _text_buf;

public:
  void draw(const std::string& label) {
    ImGui::InputText(label.data(), _text_buf.begin(), _text_buf.size());
  }
  auto getText() -> std::string { return { _text_buf.data() }; }
};

/**
 * @brief
 * @param label
 * @param text must not have any empty char
 */
void inputText(const std::string& label, std::string& text) {
  // make text has at least 3 empty char
  // size_t len = std::find(text.data(), text.data() + text.size() + 1, '\0') - text.data();
  // todo: need fix, could not work as expected
  text.resize(text.size() + 6);
  // toy::debugf("text size: {}", text.size());
  ImGui::InputText(label.data(), text.data(), text.size());
  auto iter = std::find_if(
    std::reverse_iterator{ text.data() + text.size() + 1 },
    std::reverse_iterator{ text.data() },
    [](auto c) { return c != 0; }
  );
  // the base() point to next element of reserve_iterator, which is first zero char
  auto size = iter.base() - text.data();
  // toy::debugf("new size: {}", size);
  text.resize(size);
}

template <std::derived_from<toy::EnumBase> T>
void selectEnum(const std::string& label, T& value) {
  [&]<size_t... enum_indices>(std::index_sequence<enum_indices...> _) {
    constexpr auto enum_items =
      std::array<const char*, T::count>{ toy::enum2String(T{ enum_indices })... };
    auto selected_item = static_cast<int>(value);
    ImGui::Combo(label.data(), &selected_item, enum_items.data(), enum_items.size());
    value = selected_item;
  }(std::make_index_sequence<T::count>{});
}

void inputVec3(const std::string& label, glm::vec3& input) {
  ImGui::Text("%s", std::format("{}: ", label).data());
  ImGui::SameLine();
  ImGui::PushItemWidth(80);
  ImGui::InputFloat(std::format("x##{}", label).data(), &input.x);
  ImGui::SameLine();
  ImGui::InputFloat(std::format("y##{}", label).data(), &input.y);
  ImGui::SameLine();
  ImGui::InputFloat(std::format("z##{}", label).data(), &input.z);
  ImGui::PopItemWidth();
}

// todo: replace to anyview when have reference version
template <toy::RangeOf<std::string> RangeT>
void selectable(RangeT&& range, int32_t& selected) {
  for (auto [index, item] : range | toy::enumerate) {
    if (ImGui::Selectable(item.data(), selected == index)) {
      selected = index;
    }
  }
}

auto selectable_id = 0;

template <typename T>
class SelectableList {
private:
  const T* _selected = nullptr;
  int      _id = selectable_id++;

public:
  template <typename RangeT>
    requires std::same_as<ranges::range_value_t<RangeT>, T>
  void draw(const RangeT& range) {
    for (auto& item : range) {
      ImGui::PushID(_id);
      if (ImGui::Selectable(item.data(), _selected == &item)) {
        _selected = &item;
      }
      ImGui::PopID();
    }
  }
  auto getSelected() -> const T* { return _selected; }
};

/**
 * @brief the draw implement should only contain codes relevant to GUI draw
 */
class Drawer {
public:
  virtual void draw() = 0;
};

/**
 * @brief must call after input processor
 */
class Context : public toy::ProactiveSingleton<Context> {
public:
  Context() {
    auto window = glfw::Window::getInstance().get();
    auto instance = rd::rs::Instance::getInstance().get();
    auto pdevice = rd::Device::getInstance().getPdevice().get();
    auto device = rd::Device::getInstance().get();
    auto sample_count = VK_SAMPLE_COUNT_1_BIT;
    auto attachment_info = rd::AttachmentInfo{
      .format = rd::Swapchain::getFormat(),
      .sample_count = sample_count,
      .keep_old_content = true,
      .keep_new_content = true,
    };
    auto subpass_info = rd::SubpassInfo{ .colors = { 0 } };
    auto render_pass = rd::RenderPass{ std::array{ attachment_info }, std::array{ subpass_info } };
    auto subpass_i = uint32{ 0 };
    auto family_i = render_pass.getExecutor().getFamily();
    auto queue = render_pass.getExecutor().getQueue();
    auto pool_sizes = std::array{
      VkDescriptorPoolSize{ VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1 },
    };
    auto desc_pool = rd::rs::DescriptorPool{ VkDescriptorPoolCreateInfo{
      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
      .flags = VK_DESCRIPTOR_POOL_CREATE_FREE_DESCRIPTOR_SET_BIT,
      .maxSets = 1,
      .poolSizeCount = static_cast<uint32>(pool_sizes.size()),
      .pPoolSizes = pool_sizes.data(),
    } };
    _desc_pool = std::move(desc_pool);
    _render_pass = std::move(render_pass);
    init(
      window,
      instance,
      pdevice,
      device,
      family_i,
      queue,
      _desc_pool,
      _render_pass,
      subpass_i,
      sample_count
    );
  }

private:
  static constexpr auto _base_font_size = 13;
  static constexpr auto _default_scale = 2.0f;
  static constexpr auto _max_scale = 5.0f;
  static constexpr auto _min_scale = 0.5f;
  static constexpr auto _default_font_size = static_cast<int>(_base_font_size * _max_scale / 2);

  rd::rs::DescriptorPool _desc_pool;
  rd::RenderPass         _render_pass;

  float    _scale;
  ImGuiIO* _io;

  void init(
    GLFWwindow*           window,
    VkInstance            instance,
    VkPhysicalDevice      pdevice,
    VkDevice              device,
    uint32                family_i,
    VkQueue               queue,
    VkDescriptorPool      desc_pool,
    VkRenderPass          render_pass,
    uint32                subpass_i,
    VkSampleCountFlagBits sample_count
  ) {
    // imgui 准备阶段 :
    // call ImGui::CreateContext()
    // call ImGui_ImplXXXX_Init() for each backend
    IMGUI_CHECKVERSION();
    ImGui::CreateContext();
    // install_callbacks: 如果为true，则imgui会设置glfw的相关callback,
    // 原来的callback（如果有）的函数指针会保存，imgui的callback会先调用
    ImGui_ImplGlfw_InitForVulkan(window, true);
    ImGui_ImplVulkan_InitInfo init_info = {};
    init_info.Instance = instance;
    init_info.PhysicalDevice = pdevice;
    init_info.Device = device;
    init_info.QueueFamily = family_i;
    init_info.Queue = queue;
    init_info.PipelineCache = VK_NULL_HANDLE;
    init_info.DescriptorPool = desc_pool;
    init_info.RenderPass = render_pass;
    init_info.Subpass = subpass_i;
    init_info.MinImageCount = 2;
    init_info.ImageCount = 2;
    init_info.MSAASamples = sample_count;
    init_info.Allocator = nullptr;
    init_info.CheckVkResultFn = [](VkResult err) {
      if (err == VK_SUCCESS) {
        return;
      }
      toy::debugf("[vulkan] Error: VkResult = {}", err);
    };
    ImGui_ImplVulkan_Init(&init_info);

    // Setup Dear ImGui style
    ImGui::StyleColorsDark();
    // ImGui::StyleColorsLight();
    _io = &ImGui::GetIO();
    _scale = _default_scale;
    _io->Fonts->AddFontFromFileTTF("TIMES.TTF", _default_font_size);
    _io->FontGlobalScale = _scale / (_default_font_size * 1.0f / _base_font_size);
  }

public:
  ~Context() {
    // 销毁阶段:
    // call ImGui_ImplXXXX_Shutdown() for each backend
    // call ImGui::DestroyContext()
    ImGui_ImplVulkan_Shutdown();
    ImGui_ImplGlfw_Shutdown();
    ImGui::DestroyContext();
  }

  void draw() {
    // frame 创建阶段:
    // call ImGui_ImplXXXX_NewFrame() for each backend
    // call ImGui::NewFrame()
    ImGui_ImplVulkan_NewFrame();
    ImGui_ImplGlfw_NewFrame();
    ImGui::NewFrame();
    ImGui::ShowDemoWindow();
    ImGui::Begin("Gui Window");

    slider("scale ratio", _scale, _min_scale, _max_scale);
    _io->FontGlobalScale = _scale / (_default_font_size * 1.0f / _base_font_size);
    // for (auto* drawer : _co_drawers) {
    //   drawer->next();
    // }
    ImGui::End();
    // for (auto* drawer : _drawers) {
    //   drawer->draw();
    // }
    ImGui::Render();
  }
  void recordDraw(rd::FrameImageManager* image) {
    auto recorder = [&](VkCommandBuffer cmdbuf, auto) {
      ImGui_ImplVulkan_RenderDrawData(ImGui::GetDrawData(), cmdbuf);
    };
    _render_pass.record({}, std::array{ image }, {}, recorder);
  }
};

} // namespace gui