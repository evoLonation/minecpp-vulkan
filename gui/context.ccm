module;
#include <toy.h>
export module gui.context;

import std;
import toy;
import glm;
import glfw;

import <vulkan_config.h>;
import <imgui_config.h>;

import render;

import framework;

export namespace gui {

class Drawer {
private:
  friend class Context;
  virtual void draw() = 0;

protected:
  Drawer() { add(); }
  ~Drawer() { remove(); }
  Drawer(const Drawer& e) noexcept { add(); }
  Drawer(Drawer&& e) noexcept { add(); }
  auto operator=(const Drawer& e) noexcept -> Drawer& = default;
  auto operator=(Drawer&& e) noexcept -> Drawer& = default;

private:
  void add();
  void remove();
};

/**
 * @brief must call after input processor
 */
class Context : public PROACTIVE_SINGLETON(Context), public fw::Action {
public:
  Context() {
    setStage(fw::Stage::AFTER_RENDER);
    auto window = glfw::Window::getInstance().get();
    auto instance = rd::rs::Instance::getInstance().get();
    auto pdevice = rd::Device::getInstance().getPdevice().get();
    auto device = rd::Device::getInstance().get();
    auto sample_count = VK_SAMPLE_COUNT_1_BIT;
    auto attachment_info = rd::AttachmentInfo{
      .format = rd::Swapchain::getFormat(),
      .sample_count = sample_count,
    };
    auto  subpass_info = rd::SubpassInfo{ .colors = { 0 } };
    auto  render_pass = rd::RenderPass{ std::array{ attachment_info }, std::array{ subpass_info } };
    auto  subpass_i = uint32{ 0 };
    auto& executor = rd::ExecutorManager::getInstance()[render_pass.getFamilyType()];
    auto  family_i = executor.getFamily();
    auto  queue = executor.getQueue();
    auto  pool_sizes = std::array{
      VkDescriptorPoolSize{ VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1 },
    };
    auto desc_pool = rd::rs::DescriptorPool{ VkDescriptorPoolCreateInfo{
      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
      .flags = VK_DESCRIPTOR_POOL_CREATE_FREE_DESCRIPTOR_SET_BIT,
      .maxSets = 1,
      .poolSizeCount = static_cast<uint32>(pool_sizes.size()),
      .pPoolSizes = pool_sizes.data(),
    } };
    _desc_pool = std::move(desc_pool);
    _render_pass = std::move(render_pass);
    init(
      window,
      instance,
      pdevice,
      device,
      family_i,
      queue,
      _desc_pool,
      _render_pass,
      subpass_i,
      sample_count
    );
  }

private:
  static constexpr auto _base_font_size = 13;
  static constexpr auto _default_scale = 2.0f;
  static constexpr auto _max_scale = 5.0f;
  static constexpr auto _min_scale = 0.5f;
  static constexpr auto _default_font_size = static_cast<int>(_base_font_size * _max_scale / 2);

  rd::rs::DescriptorPool _desc_pool;
  rd::RenderPass         _render_pass;

  float    _scale;
  ImGuiIO* _io;

  void init(
    GLFWwindow*           window,
    VkInstance            instance,
    VkPhysicalDevice      pdevice,
    VkDevice              device,
    uint32                family_i,
    VkQueue               queue,
    VkDescriptorPool      desc_pool,
    VkRenderPass          render_pass,
    uint32                subpass_i,
    VkSampleCountFlagBits sample_count
  ) {
    // imgui 准备阶段 :
    // call ImGui::CreateContext()
    // call ImGui_ImplXXXX_Init() for each backend
    IMGUI_CHECKVERSION();
    ImGui::CreateContext();
    // install_callbacks: 如果为true，则imgui会设置glfw的相关callback,
    // 原来的callback（如果有）的函数指针会保存，imgui的callback会先调用
    ImGui_ImplGlfw_InitForVulkan(window, true);
    ImGui_ImplVulkan_InitInfo init_info = {};
    init_info.Instance = instance;
    init_info.PhysicalDevice = pdevice;
    init_info.Device = device;
    init_info.QueueFamily = family_i;
    init_info.Queue = queue;
    init_info.PipelineCache = VK_NULL_HANDLE;
    init_info.DescriptorPool = desc_pool;
    init_info.RenderPass = render_pass;
    init_info.Subpass = subpass_i;
    init_info.MinImageCount = 2;
    init_info.ImageCount = 2;
    init_info.MSAASamples = sample_count;
    init_info.Allocator = nullptr;
    init_info.CheckVkResultFn = [](VkResult err) {
      if (err == VK_SUCCESS) {
        return;
      }
      toy::debugf("[vulkan] Error: VkResult = {}", err);
    };
    ImGui_ImplVulkan_Init(&init_info);

    // Setup Dear ImGui style
    ImGui::StyleColorsDark();
    // ImGui::StyleColorsLight();
    _io = &ImGui::GetIO();
    _io->ConfigFlags |= ImGuiConfigFlags_ViewportsEnable;
    _io->ConfigFlags |= ImGuiConfigFlags_DockingEnable;
    _scale = _default_scale;
    _io->Fonts->AddFontFromFileTTF("TIMES.TTF", _default_font_size);
    _io->FontGlobalScale = _scale / (_default_font_size * 1.0f / _base_font_size);
  }

  friend Drawer;
  std::unordered_set<Drawer*> _drawers;

public:
  ~Context() {
    // 销毁阶段:
    // call ImGui_ImplXXXX_Shutdown() for each backend
    // call ImGui::DestroyContext()
    ImGui_ImplVulkan_Shutdown();
    ImGui_ImplGlfw_Shutdown();
    ImGui::DestroyContext();
  }

  void draw() {
    // frame 创建阶段:
    // call ImGui_ImplXXXX_NewFrame() for each backend
    // call ImGui::NewFrame()
    ImGui_ImplVulkan_NewFrame();
    ImGui_ImplGlfw_NewFrame();
    ImGui::NewFrame();
    ImGui::ShowDemoWindow();
    // ImGui::Begin("Gui Window");

    // slider("scale ratio", _scale, _min_scale, _max_scale);
    _io->FontGlobalScale = _scale / (_default_font_size * 1.0f / _base_font_size);
    for (auto* drawer : _drawers) {
      drawer->draw();
    }
    // ImGui::End();
    ImGui::Render();
  }
  void recordDraw(rd::FrameImageManager* image) {
    auto recorder =
      std::function<void(VkCommandBuffer, VkExtent2D)>{ [&](VkCommandBuffer cmdbuf, auto) {
        ImGui_ImplVulkan_RenderDrawData(ImGui::GetDrawData(), cmdbuf);
      } };
    _render_pass.record({}, std::array{ image }, std::span{ &recorder, 1 });
  }

  void renderViewports() {
    if (_io->ConfigFlags & ImGuiConfigFlags_ViewportsEnable) {
      ImGui::UpdatePlatformWindows();
      ImGui::RenderPlatformWindowsDefault();
    }
  }

  void runLoop(fw::ActionContext const& ctx) override {
    draw();
    recordDraw(ctx.image_manager);
    renderViewports();
  }
};

void Drawer::add() { Context::getInstance()._drawers.insert(this); }

void Drawer::remove() { Context::getInstance()._drawers.erase(this); }

} // namespace gui