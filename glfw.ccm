module;
#include <toy.h>
export module glfw;

import <glfw_config.h>;
import toy;
import std;

import render.instance;

export namespace glfw {

class Context : public PROACTIVE_SINGLETON(Context) {
public:
  Context() {
    if (glfwInit() != GLFW_TRUE) {
      throw std::runtime_error("glfw init failed");
    }
  }
  ~Context() { glfwTerminate(); }
};

void checkGlfwError();

class Window : public PROACTIVE_SINGLETON(Window) {
public:
  Window(uint32 width, uint32 height, const std::string& title);
  auto get() const -> GLFWwindow* { return _window.get(); }
  operator GLFWwindow*() const { return get(); }

private:
  void               destroyResource();
  static inline auto deleter = [](GLFWwindow* window) { glfwDestroyWindow(window); };
  std::unique_ptr<GLFWwindow, decltype(deleter)> _window;
};

Window::Window(uint32 width, uint32 height, const std::string& title) {
  // 不要创建openGL上下文
  glfwWindowHint(GLFW_CLIENT_API, GLFW_NO_API);
  // 禁用改变窗口尺寸
  // glfwWindowHint(GLFW_RESIZABLE, GLFW_FALSE);
  _window.reset(glfwCreateWindow(width, height, title.data(), nullptr, nullptr));
  checkGlfwError();
}

void checkGlfwError() {
  const char* description;

  // todo: 使用generator实现
  auto descriptions = std::vector<std::string_view>{};
  auto errors = std::vector<int32>{};
  while (true) {
    auto error = glfwGetError(&description);
    if (error == GLFW_NO_ERROR) {
      break;
    }
    errors.push_back(error);
    descriptions.push_back(description);
  }
  if (!descriptions.empty()) {
    auto msg = std::string{};
    for (auto [desc, error] : views::zip(descriptions, errors)) {
      msg += std::format("glfw error (0x{:08X}): {}\n", error, desc);
    }
    toy::throwf("{}", msg);
  }
}

} // namespace glfw