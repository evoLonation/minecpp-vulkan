module;
#include <toy.h>
export module engine.editor.scene;

import engine.mesh;
import engine.shape;
import engine.asset;
import engine.base;
import <imgui_config.h>;
import framework;
import gui.context;
import gui.tool;
import engine.object;
import engine.node;
import engine.importer;
import std;
import toy;

export namespace eg {

class Scene : public Node {
public:
private:
};

class ScenePanel : public PROACTIVE_SINGLETON(ScenePanel), public gui::Drawer, public fw::Action {
public:
  ScenePanel() : fw::Action(fw::Stage::BEFORE_RENDER) {
    if (fs::exists(_scene_names_file)) {
      auto pickle = toy::Pickle{ _scene_names_file };
      _unloaded_nodes.insert_range(pickle.pop<std::vector<std::string>>());
    }
    _asset_manager = AssetManager{ _asset_dir };
  }
  ~ScenePanel() {
    auto pickle = toy::Pickle{};
    auto names = std::vector<std::string>{};
    names.append_range(_unloaded_nodes);
    names.append_range(_loaded_nodes | views::keys);
    pickle.push(names);
    pickle.dump(_scene_names_file);
  }
  void draw() override {
    ImGui::SeparatorText("UnLoaded Node List");
    {
      for (auto& name : _unloaded_nodes) {
        if (ImGui::Selectable(
              std::format("{}##UnloadedNodeList", name).c_str(), _selected_unloaded_name == name
            )) {
          _selected_unloaded_name = name;
        }
      }
      if (!_unloaded_nodes.contains(_selected_unloaded_name)) {
        _selected_unloaded_name = {};
      }
      
      if (ImGui::Button("Load Node")) {
        if (!_selected_unloaded_name.empty()) {
          auto node = _asset_manager.load<Node>(_selected_unloaded_name);
          node->doRecursively([](Node& node) {
            if (auto scene_object = dynamic_cast<SceneObject*>(&node)) {
              scene_object->setActive(false);
            }
          });
          _unloaded_nodes.erase(_selected_unloaded_name);
          _loaded_nodes[_selected_unloaded_name] = node;
          _selected_unloaded_name = {};
        }
      }
    }

    ImGui::SeparatorText("Loaded Node List");
    {

      for (auto& name : _loaded_nodes | views::keys) {
        if (ImGui::Selectable(
              std::format("{}##loadedNodeList", name).c_str(), _selected_loaded_name == name
            )) {
          _selected_loaded_name = name;
        }
      }
      if (!_loaded_nodes.contains(_selected_loaded_name)) {
        _selected_loaded_name = {};
      }
      if (ImGui::Button("Set as Current Node")) {
        if (_current_node) {
          _current_node->doRecursively([](Node& node) {
            if (auto scene_object = dynamic_cast<SceneObject*>(&node)) {
              scene_object->setActive(false);
            }
          });
        }
        _current_node = _loaded_nodes[_selected_loaded_name].get();
        _current_node_name = _selected_loaded_name;
        _current_node->doRecursively([](Node& node) {
          if (auto scene_object = dynamic_cast<SceneObject*>(&node)) {
            scene_object->setActive(true);
          }
        });
      }
      if (ImGui::Button("Attach to Current Node")) {
        if (!_selected_loaded_name.empty() && _current_node) {
          auto node = _loaded_nodes[_selected_loaded_name].get();
          node->attachTo(_current_node);
          node->doRecursively([](Node& node) {
            if (auto scene_object = dynamic_cast<SceneObject*>(&node)) {
              scene_object->setActive(true);
            }
          });
        }
      }
      if (ImGui::Button("Save Node")) {
        _asset_manager.save(_loaded_nodes[_selected_loaded_name]);
      }
    }

    ImGui::SeparatorText("Node Create");
    {
      // node create
      ptr<Node> node;
      // ImGui::PushItemWidth(200);
      static auto node_name = std::array<char, 30>{};
      ImGui::InputText("Node Name", node_name.data(), node_name.size());
      // ImGui::SameLine();
      if (ImGui::Button("Create Empty Node")) {
        node = std::make_shared<Node>();
      }
      // ImGui::PushItemWidth(200);
      // ImGui::InputText("##Asset Name", _asset_name.data(), _asset_name.size());
      // ImGui::SameLine();
      // if (ImGui::Button("Load Node By Asset Name")) {
      //   node = AssetManager::getInstance().load<SceneObject>(_asset_name.data());
      // }
      ImGui::Separator();
      static int shape_type = -1;
      ImGui::RadioButton("Cube", &shape_type, 0);
      ImGui::SameLine();
      ImGui::RadioButton("Sphere", &shape_type, 1);
      ImGui::SameLine();
      ImGui::RadioButton("Cylinder", &shape_type, 2);
      ImGui::SameLine();
      ImGui::RadioButton("Cone", &shape_type, 3);
      if (ImGui::Button("Create Node By Shape")) {
        auto mesh_data = MeshData{};
        if (shape_type >= 0) {
          switch (shape_type) {
          case 0:
            mesh_data = generateCube();
            break;
          case 1:
            mesh_data = generateSphere();
            break;
          case 2:
            mesh_data = generateCylinder();
            break;
          case 3:
            mesh_data = generateCone();
            break;
          }
          auto object = std::make_shared<SceneObject>();
          auto draw_unit = std::make_unique<LightUnit>();
          draw_unit->init(std::move(mesh_data));
          object->setDrawUnit(std::move(draw_unit));
          node = std::make_shared<Node>();
          object->attachTo(node.get());
        }
      }

      ImGui::Separator();
      static auto model_path = std::array<char, 100>{};
      ImGui::InputText("Model Path", model_path.data(), model_path.size());
      if (ImGui::Button("Create Node By Model File")) {
        node = std::make_shared<Node>();
        eg::DoTheImportThing(model_path.data())->attachTo(node.get());
      }

      if (node) {
        node->setName(node_name.data());
        node->setAssetName(node_name.data());
        node->doRecursively([](Node& node) {
          if (auto scene_object = dynamic_cast<SceneObject*>(&node)) {
            scene_object->setActive(false);
          }
        });
        _loaded_nodes[node_name.data()] = std::move(node);
      }
    }

    ImGui::SeparatorText("Current Node Info");
    {
      if (!_current_node) {
        ImGui::Text("No Current Node");
      } else {
        std::function<void(Node&, std::string const&, std::string const&)> drawNode{};
        drawNode = [&](Node& node, std::string const& default_name, std::string const& father_id) {
          auto name =
            node.getAssetName().empty() ? default_name.c_str() : node.getAssetName().c_str();
          if (ImGui::TreeNode(name)) {
            for (auto [i, child] : node.getChildren() | toy::enumerate) {
              auto id = std::format("{}-{}", father_id, i);
              drawNode(*child, std::format("Node {}##{}", i, id), id);
            }
            ImGui::TreePop();
            return true;
          }
          return false;
        };
        drawNode(*_current_node, _current_node_name, "Node Tree");
      }
    }
  }
  void runLoop(fw::ActionContext const& ctx) override {}

private:
  AssetManager                               _asset_manager;
  std::unordered_set<std::string>            _unloaded_nodes;
  std::unordered_map<std::string, ptr<Node>> _loaded_nodes;
  std::string                                _selected_unloaded_name;
  std::string                                _selected_loaded_name;
  int                                        _loaded_node_index = -1;
  Node*                                      _current_node{};
  std::string                                _current_node_name;
  std::array<char, 30>                       _asset_name = {};

  static inline fs::path _asset_dir = fs::path{ "assets" } / "scenes";
  static inline fs::path _scene_names_file = _asset_dir / "scene_names.pkl";
};

} // namespace eg
