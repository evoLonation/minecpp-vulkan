module;
#include <toy.h>
export module engine.editor.scene;

import engine.editor.scene.scene;

import math;
import engine.mesh;
import engine.shape;
import engine.package;
import engine.base;
import <imgui_config.h>;
import framework;
import gui.context;
import gui.tool;
import engine.object;
import engine.node;
import engine.importer;
import std;
import toy;

export namespace eg {

class ScenePanel : public PROACTIVE_SINGLETON(ScenePanel), public gui::Drawer, public fw::Action {
public:
  ScenePanel() : fw::Action(fw::Stage::BEFORE_RENDER) {
    _package = Package::get(_asset_path);
    auto names = _package->getAllAssetNames();
    _unloaded_scenes.insert_range(names);
  }
  ~ScenePanel() {}
  void draw() override {
    ImGui::SeparatorText("UnLoaded Scene List");
    {
      for (auto& name : _unloaded_scenes) {
        if (ImGui::Selectable(
              std::format("{}##UnloadedSceneList", name).c_str(), _selected_unloaded_name == name
            )) {
          _selected_unloaded_name = name;
        }
      }
      if (!_unloaded_scenes.contains(_selected_unloaded_name)) {
        _selected_unloaded_name = {};
      }

      if (ImGui::Button("Load Scene")) {
        if (!_selected_unloaded_name.empty()) {
          auto scene = SceneNode{};
          _package->loadAsset(scene, _selected_unloaded_name);
          _unloaded_scenes.erase(_selected_unloaded_name);
          _loaded_scenes[_selected_unloaded_name] = std::move(scene);
          _selected_unloaded_name = {};
        }
      }
    }

    ImGui::SeparatorText("Loaded Scene List");
    {
      for (auto& name : _loaded_scenes | views::keys) {
        if (ImGui::Selectable(
              std::format("{}##LoadedSceneList", name).c_str(), _selected_loaded_name == name
            )) {
          _selected_loaded_name = name;
        }
      }
      if (!_loaded_scenes.contains(_selected_loaded_name)) {
        _selected_loaded_name = {};
      }
      if (ImGui::Button("Set as Current Scene")) {
        _current_scene_name = _selected_loaded_name;
        _loaded_scenes[_selected_loaded_name].show();
      }
      if (ImGui::Button("Attach to Current Scene Node")) {
        if (!_selected_loaded_name.empty() && !_current_scene_name.empty()) {
          _loaded_scenes[_current_scene_name].addSubScene(_loaded_scenes[_selected_loaded_name]);
        }
      }
      if (ImGui::Button("Save Scene")) {
        _loaded_scenes[_selected_loaded_name].saveAsset();
        // _loaded_scenes[_selected_loaded_name].unshow();
        // _loaded_scenes[_selected_loaded_name].getNode().saveAsset();
      }
    }

    ImGui::SeparatorText("Scene Create");
    {
      ptr<Node> node;
      ImGui::PushItemWidth(200);
      static auto scene_name = std::array<char, 30>{};
      ImGui::InputText("Scene Name", scene_name.data(), scene_name.size());
      ImGui::SameLine();
      if (ImGui::Button("Create Empty Scene")) {
        node = std::make_shared<Node>();
      }
      // ImGui::PushItemWidth(200);
      // ImGui::InputText("##Asset Name", _asset_name.data(), _asset_name.size());
      // ImGui::SameLine();
      // if (ImGui::Button("Load Node By Asset Name")) {
      //   node = AssetManager::getInstance().load<SceneObject>(_asset_name.data());
      // }
      ImGui::Separator();
      static int shape_type = -1;
      ImGui::RadioButton("Cube", &shape_type, 0);
      ImGui::SameLine();
      ImGui::RadioButton("Sphere", &shape_type, 1);
      ImGui::SameLine();
      ImGui::RadioButton("Cylinder", &shape_type, 2);
      ImGui::SameLine();
      ImGui::RadioButton("Cone", &shape_type, 3);
      if (ImGui::Button("Create Scene By Shape")) {
        auto mesh_data = MeshData{};
        if (shape_type >= 0) {
          switch (shape_type) {
          case 0:
            mesh_data = generateCube();
            break;
          case 1:
            mesh_data = generateSphere();
            break;
          case 2:
            mesh_data = generateCylinder();
            break;
          case 3:
            mesh_data = generateCone();
            break;
          }
          auto object = std::make_shared<SceneObject>();
          auto draw_unit = std::make_unique<LightUnit>();
          draw_unit->init(std::move(mesh_data));
          object->setDrawUnit(std::move(draw_unit));
          node = std::make_shared<Node>();
          object->attachTo(*node);
        }
      }

      ImGui::Separator();
      static auto model_path = std::array<char, 100>{};
      ImGui::InputText("Model Path", model_path.data(), model_path.size());
      if (ImGui::Button("Create Scene By Model File")) {
        node = std::make_shared<Node>();
        // eg::DoTheImportThing("model/backpack/backpack.obj")->attachTo(*node);
        eg::DoTheImportThing(model_path.data())->attachTo(*node);
      }

      if (node) {
        // node->setName(scene_name.data());
        // node->setAssetName(scene_name.data());
        node->setOwnedPackage(_package.get());
        auto scene_node = SceneNode{ std::move(node), scene_name.data() };
        scene_node.setAssetName(scene_name.data());
        scene_node.setOwnedPackage(_package.get());
        _loaded_scenes[scene_name.data()] = std::move(scene_node);
      }
    }

    ImGui::SeparatorText("Current Scene Info");
    {
      if (_current_scene_name.empty()) {
        ImGui::Text("No Current Scene");
      } else {
        std::function<void(SceneNode&)> drawNode{};
        drawNode = [&](SceneNode& node) {
          if (ImGui::TreeNode(node.getName().c_str())) {
            for (auto [i, child] : node.getSubNodes() | toy::enumerate) {
              drawNode(child);
            }
            ImGui::TreePop();
            return true;
          } else {
            return false;
          }
        };
        drawNode(_loaded_scenes[_current_scene_name]);
      }
    }
  }
  void runLoop(fw::ActionContext const& ctx) override {}

private:
  std::shared_ptr<Package>                   _package;
  std::unordered_set<std::string>            _unloaded_scenes;
  std::unordered_map<std::string, SceneNode> _loaded_scenes;
  std::string                                _selected_unloaded_name;
  std::string                                _selected_loaded_name;
  std::string                                _current_scene_name;

  static inline fs::path _asset_path = fs::path{ "assets" } / "scenes.asset";
};

} // namespace eg
