void input(std::string const& label, glm::vec3& value) {
  ImGui::PushItemWidth(150);
  ImGui::InputFloat(std::format("x##{}", label).c_str(), &value.x, 0.01f, 1.0f, "%.3f");
  ImGui::SameLine();
  ImGui::InputFloat(std::format("y##{}", label).c_str(), &value.y, 0.01f, 1.0f, "%.3f");
  ImGui::SameLine();
  ImGui::InputFloat(std::format("z##{}", label).c_str(), &value.z, 0.01f, 1.0f, "%.3f");
  ImGui::SameLine();
  ImGui::Text("%s", label.c_str());
  ImGui::PopItemWidth();
}

class TransformControllerPanel : public PROACTIVE_SINGLETON(TransformControllerPanel),
                                 public gui::Drawer,
                                 public fw::Action {
public:
  TransformControllerPanel() : fw::Action(fw::Stage::BEFORE_RENDER) {
    {
      auto mode = _tool_mode == 0 ? MoveController::LOCAL : MoveController::WORLD;
      _move_controller->setMode(mode);
    }
    // {
    //   auto mode = _tool_mode == 0 ? RotateController::LOCAL : RotateController::WORLD;
    //   _rotate_controller->setMode(mode);
    // }
    // {
    //   auto mode = _tool_mode == 0 ? ScaleController::LOCAL : ScaleController::WORLD;
    //   _scale_controller->setMode(mode);
    // }
  }
  void draw() override {
    ImGui::SeparatorText("Transform Tools");
    bool changed = false;
    changed = changed || ImGui::RadioButton("None", &_tool_type, 0);
    changed = changed || ImGui::RadioButton("Translate", &_tool_type, 1);
    changed = changed || ImGui::RadioButton("Rotate", &_tool_type, 2);
    changed = changed || ImGui::RadioButton("Scale", &_tool_type, 3);
    if (changed) {
      _move_controller->resetTarget();
      // _rotate_controller->resetTarget();
      // _scale_controller->resetTarget();
      {
        auto mode = _tool_mode == 0 ? MoveController::LOCAL : MoveController::WORLD;
        _move_controller->setMode(mode);
      }
      // {
      //   auto mode = _tool_mode == 0 ? RotateController::LOCAL : RotateController::WORLD;
      //   _rotate_controller->setMode(mode);
      // }
      // {
      //   auto mode = _tool_mode == 0 ? ScaleController::LOCAL : ScaleController::WORLD;
      //   _scale_controller->setMode(mode);
      // }
    }
    if (_tool_type != 0) {
      bool changed = false;
      ImGui::Text("Transform Tool Settings:");
      ImGui::SameLine();
      changed = changed || ImGui::RadioButton("Local##ToolType", &_tool_mode, 0);
      ImGui::SameLine();
      changed = changed || ImGui::RadioButton("World##ToolType", &_tool_mode, 1);
      if (changed) {
        switch (_tool_type) {
        case 1: {
          auto mode = _tool_mode == 0 ? MoveController::LOCAL : MoveController::WORLD;
          _move_controller->setMode(mode);
          break;
        }
          // case 2: {
          //   auto mode = _tool_mode == 0 ? RotateController::LOCAL : RotateController::WORLD;
          //   _rotate_controller->setMode(mode);
          //   break;
          // }
          // case 3: {
          //   auto mode = _tool_mode == 0 ? ScaleController::LOCAL : ScaleController::WORLD;
          //   _scale_controller->setMode(mode);
          //   break;
          // }
        }
      }
    }
    if (_tool_type == 1) {
      ImGui::InputFloat("Translate Unit Length", &_move_controller->refUnitLength());
    }
    // else if (_tool_type == 2) {
    //   ImGui::InputFloat("Rotate Cycle Length", &_rotate_controller->refCycleLength());
    //   ImGui::InputFloat("Rotate Unit Length", &_rotate_controller->refUnitLength());
    // } else if (_tool_type == 3) {
    //   ImGui::InputFloat("Scale Unit Factor", &_scale_controller->refUnitFactor());
    //   _scale_controller->refUnitFactor() =
    //     std::clamp(_scale_controller->refUnitFactor(), 1.0f, 100.0f);
    // }

    if (_selected.expired()) {
      ImGui::SeparatorText("No object selected.");
    } else {
      ImGui::SeparatorText("Selected object transform info:");
      auto  selected = _selected.lock();
      auto& transform = selected->getController();
      transform.refLocation().change([](glm::vec3& location) {
        ImGui::InputFloat3("Location", &location[0]);
      });
      transform.refRotateEuler().change([](glm::vec3& rotate_euler) {
        ImGui::InputFloat3("Rotate Euler", &rotate_euler[0]);
      });
      transform.refScaleFactor().change([](glm::vec3& scale_factor) {
        ImGui::InputFloat3("Scale Factor", &scale_factor[0]);
      });
      ImGui::Text("Transform Mode:");
      static int radio = 0;
      ImGui::RadioButton("Local##ObjectMode", &radio, 0);
      ImGui::SameLine();
      ImGui::RadioButton("World##ObjectMode", &radio, 1);
    }

    // enable which translate/rotate/scale tool
    // direct set location/rotation/scale
    // direct set MODE
  }

private:
  void runLoop(fw::ActionContext const& ctx) override {
    if (auto object = ObjectClickObserver::getInstance().getClick()) {
      _selected = object->getPtr();
      if (object->isRoot()) {
        switch (_tool_type) {
        case 1:
          _move_controller->setTarget(object->getPtr());
          break;
        // case 2:
        //   _rotate_controller->setTarget(object->getPtr());
        //   break;
        // case 3:
        //   _scale_controller->setTarget(object->getPtr());
        //   break;
        }
      }
    }
  }
  wptr<SceneObject> _selected;

  int                  _tool_type = 0;
  int                  _tool_mode = 0;
  uptr<MoveController> _move_controller = std::make_unique<MoveController>();
  // uptr<RotateController> _rotate_controller = std::make_unique<RotateController>();
  // uptr<ScaleController>  _scale_controller = std::make_unique<ScaleController>();
};

