export namespace eg {

class ObjectClickObserver : public fw::Action {
public:
  ObjectClickObserver() : fw::Action(fw::Stage::BEFORE_RENDER) {}
  void exclude(wptr<Node> object) { _exclusions.push_back(object); }
  auto getClick() -> Node* { return _clicked.expired() ? nullptr : _clicked.lock().get(); }

private:
  void runLoop(fw::ActionContext const& ctx) override {
    auto& input = fw::InputProcessor::getInstance();
    if (!_clicked.expired()) {
      _clicked = {};
    }
    if (auto state = input.getState(fw::Mouse::LEFT)) {
      Node* selected = nullptr;
      if (auto* draw_unit = IdPipeline::getInstance().getSelectedDrawUnit()) {
        selected = &draw_unit->getSceneObject()->getRoot();
        if (auto iter = ranges::find_if(
              _exclusions, [selected](auto& object) { return object.lock().get() == selected; }
            );
            iter != _exclusions.end()) {
          selected = nullptr;
        }
      }
      if (state->state == fw::ButtonState::DOWN) {
        if (selected) {
          _down = selected->getPtr();
        }
      } else if (!_down.expired() && state->state == fw::ButtonState::RELEASE) {
        if (_down.lock().get() == selected) {
          _clicked = _down;
        }
        _down = {};
      }
    }
  }
  wptr<Node>              _down;
  wptr<Node>              _clicked;
  std::vector<wptr<Node>> _exclusions;
};

void input(std::string const& label, glm::vec3& value) {
  ImGui::PushItemWidth(150);
  ImGui::InputFloat(std::format("x##{}", label).c_str(), &value.x, 0.01f, 1.0f, "%.3f");
  ImGui::SameLine();
  ImGui::InputFloat(std::format("y##{}", label).c_str(), &value.y, 0.01f, 1.0f, "%.3f");
  ImGui::SameLine();
  ImGui::InputFloat(std::format("z##{}", label).c_str(), &value.z, 0.01f, 1.0f, "%.3f");
  ImGui::SameLine();
  ImGui::Text("%s", label.c_str());
  ImGui::PopItemWidth();
}

class TransformControllerPanel : public PROACTIVE_SINGLETON(TransformControllerPanel),
                                 public gui::Drawer,
                                 public fw::Action {
public:
  TransformControllerPanel() : fw::Action(fw::Stage::BEFORE_RENDER) {
    auto mode = _tool_mode == 0 ? ToolBase::LOCAL : ToolBase::WORLD;
    _move_tool->setMode(mode);
    _rotate_tool->setMode(mode);
    _click_observer.exclude(_move_tool->getRoot().getPtr());
    _click_observer.exclude(_rotate_tool->getRoot().getPtr());
    _click_observer.exclude(_scale_tool->getRoot().getPtr());
  }
  void draw() override {
    ImGui::SeparatorText("Transform Tools");
    bool changed = false;
    changed = changed || ImGui::RadioButton("None", &_tool_type, 0);
    changed = changed || ImGui::RadioButton("Translate", &_tool_type, 1);
    changed = changed || ImGui::RadioButton("Rotate", &_tool_type, 2);
    changed = changed || ImGui::RadioButton("Scale", &_tool_type, 3);
    if (changed) {
      _move_tool->resetTarget();
      _rotate_tool->resetTarget();
      _scale_tool->resetTarget();
      auto mode = _tool_mode == 0 ? ToolBase::LOCAL : ToolBase::WORLD;
      _move_tool->setMode(mode);
      _rotate_tool->setMode(mode);
    }
    if (_tool_type != 0) {
      bool changed = false;
      ImGui::Text("Transform Tool Settings:");
      if (_tool_type != 3) {
        ImGui::SameLine();
        changed = changed || ImGui::RadioButton("Local##ToolType", &_tool_mode, 0);
        ImGui::SameLine();
        changed = changed || ImGui::RadioButton("World##ToolType", &_tool_mode, 1);
      }
      if (changed) {
        auto mode = _tool_mode == 0 ? ToolBase::LOCAL : ToolBase::WORLD;
        switch (_tool_type) {
        case 1:
          _move_tool->setMode(mode);
          break;
        case 2:
          _rotate_tool->setMode(mode);
          break;
        }
      }
    }
    if (_tool_type == 1) {
      ImGui::InputFloat("Translate Unit Length", &_move_tool->refUnitLength());
    } else if (_tool_type == 2) {
      ImGui::InputFloat("Rotate Cycle Length", &_rotate_tool->refCycleLength());
      ImGui::InputFloat("Rotate Unit Length", &_rotate_tool->refUnitLength());
    } else if (_tool_type == 3) {
      ImGui::InputFloat("Scale Unit Factor", &_scale_tool->refUnitFactor());
      _scale_tool->refUnitFactor() = std::clamp(_scale_tool->refUnitFactor(), 1.0f, 100.0f);
    }

    if (_selected.expired()) {
      ImGui::SeparatorText("No object selected.");
    } else {
      ImGui::SeparatorText("Selected object transform info:");
      auto  selected = _selected.lock();
      auto& transform = selected->getController();
      transform.refLocation().set([](glm::vec3& location) {
        ImGui::InputFloat3("Location", &location[0]);
      });
      transform.refRotateEuler().set([](glm::vec3& rotate_euler) {
        ImGui::InputFloat3("Rotate Euler", &rotate_euler[0]);
      });
      transform.refScaleFactor().set([](glm::vec3& scale_factor) {
        ImGui::InputFloat3("Scale Factor", &scale_factor[0]);
      });
      ImGui::Text("Transform Mode:");
      static int radio = 0;
      ImGui::RadioButton("Local##ObjectMode", &radio, 0);
      ImGui::SameLine();
      ImGui::RadioButton("World##ObjectMode", &radio, 1);
    }

    // enable which translate/rotate/scale tool
    // direct set location/rotation/scale
    // direct set MODE
  }

private:
  void runLoop(fw::ActionContext const& ctx) override {
    if (auto root = _click_observer.getClick()) {
      _selected = root->getPtr();
      switch (_tool_type) {
      case 1:
        _move_tool->setTarget(root->getPtr());
        break;
      case 2:
        _rotate_tool->setTarget(root->getPtr());
        break;
      case 3:
        _scale_tool->setTarget(root->getPtr());
        break;
      }
    }
  }

  wptr<Node>          _selected;
  int                 _tool_type = 0;
  int                 _tool_mode = 0;
  uptr<MoveTool>      _move_tool = std::make_unique<MoveTool>();
  uptr<RotateTool>    _rotate_tool = std::make_unique<RotateTool>();
  uptr<ScaleTool>     _scale_tool = std::make_unique<ScaleTool>();
  ObjectClickObserver _click_observer;
};

} // namespace eg
