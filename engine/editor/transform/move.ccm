module;
#include <toy.h>
export module editor.transform.move;

import editor.transform.publics;
import std;
import toy;
import framework;
import math;

export namespace eg {

class MoveTool : public ToolBase {
public:
  MoveTool() {
    _arrows[0].init(mt::Axis::X, false);
    _arrows[1].init(mt::Axis::Y, false);
    _arrows[2].init(mt::Axis::Z, false);
    _arrows[0].getRoot().attachTo(getFixedDistanceNode());
    _arrows[1].getRoot().attachTo(getFixedDistanceNode());
    _arrows[2].getRoot().attachTo(getFixedDistanceNode());
    _planes[0].init(mt::Axis::X);
    _planes[1].init(mt::Axis::Y);
    _planes[2].init(mt::Axis::Z);
    _planes[0].getRoot().attachTo(getFixedDistanceNode());
    _planes[1].getRoot().attachTo(getFixedDistanceNode());
    _planes[2].getRoot().attachTo(getFixedDistanceNode());
    setMode(WORLD);
    resetTarget();
  }
  auto refUnitLength() -> float& { return _unit_length; }

private:
  std::array<MoveScaleArrow, 3> _arrows;
  std::array<MoveScalePlane, 3> _planes;
  std::optional<mt::Axis>       _axis;
  std::optional<mt::Axis>       _plane_norm;
  float                         _start_pos = 0;
  glm::vec2                     _start_plane_pos = { 0, 0 };
  float                         _unit_length = 0.3;

  void runLoop(fw::ActionContext const& ctx) override {
    if (!getTarget()) {
      return;
    }
    ToolBase::runLoop(ctx);
    auto& input = fw::InputProcessor::getInstance();
    if (input.getState(fw::Mouse::LEFT)->state == fw::ButtonState::DOWN) {
      auto& x_axis = _arrows[0];
      auto& y_axis = _arrows[1];
      auto& z_axis = _arrows[2];
      auto& x_plane = _planes[0];
      auto& y_plane = _planes[1];
      auto& z_plane = _planes[2];
      if (x_axis.isSelected()) {
        _axis = mt::Axis::X;
      } else if (y_axis.isSelected()) {
        _axis = mt::Axis::Y;
      } else if (z_axis.isSelected()) {
        _axis = mt::Axis::Z;
      } else if (x_plane.isSelected()) {
        _plane_norm = mt::Axis::X;
      } else if (y_plane.isSelected()) {
        _plane_norm = mt::Axis::Y;
      } else if (z_plane.isSelected()) {
        _plane_norm = mt::Axis::Z;
      }
      if (_axis) {
        _arrows[(int)*_axis].setDragging(true);
        auto ret = getAxisPos(*_axis, getRoot().getTransToWorld());
        TOY_ASSERT(ret);
        _start_pos = *ret;
      } else if (_plane_norm) {
        _planes[(int)*_plane_norm].setDragging(true);
        auto ret = getPlanePos(*_plane_norm, getRoot().getTransToWorld());
        TOY_ASSERT(ret);
        _start_plane_pos = *ret;
      }
    } else if (input[fw::Mouse::LEFT]->state == fw::ButtonState::RELEASE) {
      if (_axis) {
        _arrows[(int)*_axis].setDragging(false);
      } else if (_plane_norm) {
        _planes[(int)*_plane_norm].setDragging(false);
      }
      _plane_norm = {};
      _axis = {};
    } else if (_axis) {
      auto ret = getAxisPos(*_axis, getRoot().getTransToWorld());
      if (ret) {
        auto  now_pos = *ret;
        float delta;
        if (_unit_length != 0) {
          delta = _unit_length * int32((now_pos - _start_pos) / _unit_length);
        } else {
          delta = now_pos - _start_pos;
        }
        getTargetController().translate(*_axis, delta);
      }
    } else if (_plane_norm) {
      auto ret = getPlanePos(*_plane_norm, getRoot().getTransToWorld());
      if (ret) {
        auto  now_pos_1 = ret->x;
        auto  now_pos_2 = ret->y;
        auto  start_pos_1 = _start_plane_pos.x;
        auto  start_pos_2 = _start_plane_pos.y;
        float delta;
        if (_unit_length != 0) {
          delta = _unit_length * int32((now_pos_1 - start_pos_1) / _unit_length);
        } else {
          delta = now_pos_1 - _start_pos;
        }
        getTargetController().translate(mt::Axis(((int)*_plane_norm + 1) % 3), delta);
        if (_unit_length != 0) {
          delta = _unit_length * int32((now_pos_2 - start_pos_2) / _unit_length);
        } else {
          delta = now_pos_2 - start_pos_2;
        }
        getTargetController().translate(mt::Axis(((int)*_plane_norm + 2) % 3), delta);
      }
    }
  }
};

} // namespace eg
