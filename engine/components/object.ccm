module;
#include <toy.h>
export module engine.object;

import framework;
import math;
import render;
import pipeline.uniform;
import pipeline.light;
import engine.texture;
import engine.mesh;
import engine.node;
import std;
import toy;

export namespace eg {

template <typename T>
using uptr = std::unique_ptr<T>;

template <typename T>
using wptr = std::weak_ptr<T>;

class LightObject : public Component {
public:
  LightObject(std::shared_ptr<Mesh> mesh, std::shared_ptr<Texture> texture, bool uplayer = false) {
    _mesh = std::move(mesh);
    _texture = std::move(texture);
    _uniform_id_frag = _max_id++;
    setUnit(uplayer);
  }

  void setUplayer() { setUnit(true); }
  void setModelTrans(glm::mat4 const& trans) { _uniform_vertex->model = trans; }
  void setShininess(float shininess) { _uniform_frag->shininess = shininess; }
  auto getId() -> uint32 { return _uniform_id_frag.get(); }
  auto getTexture() -> Texture& { return *_texture; }

  static auto getSelectedId() -> uint32 { return LightPipeline::getInstance().getSelectedId(); }

private:
  inline static uint32 _max_id = 114514;

  ptr<Mesh>                                       _mesh;
  ptr<Texture>                                    _texture;
  UniformBuffer<LightModelVertexData>             _uniform_vertex;
  UniformBuffer<LightModelFragmentData>           _uniform_frag;
  UniformBuffer<rd::align::mat4>                  _uniform_id_vert;
  UniformBuffer<uint32>                           _uniform_id_frag;
  std::variant<LightUnit<false>, LightUnit<true>> _light_unit;
  std::variant<IdUnit<false>, IdUnit<true>>       _id_unit;

  void runLoop(fw::ActionContext const& ctx) override {
    auto& trans = _uniform_vertex->model;
    _uniform_vertex->normal_model = mt::getNormalModel(trans);
    _uniform_id_vert = trans;
  }
  void setUnit(bool uplayer) {
    auto setter = [&]<bool uplayer>() {
      _light_unit = LightUnit<uplayer>{
        { &_mesh->getVertexBuffer() },
        &_mesh->getIndexBuffer(),
        { &_uniform_vertex, &_uniform_frag, &_texture->getTexture(), &_texture->getTexture() },
      };
      _id_unit = IdUnit<uplayer>{
        { &_mesh->getVertexBuffer() },
        &_mesh->getIndexBuffer(),
        { &_uniform_id_vert, &_uniform_id_frag },
      };
    };
    if (uplayer) {
      setter.operator()<true>();
    } else {
      setter.operator()<false>();
    }
  }
};

class SceneObject : public Node {
public:
  SceneObject(uptr<LightObject> object) { setObject(std::move(object)); }
  void setObject(uptr<LightObject> object) {
    if (_object.get()) {
      _id2object.erase(_object->getId());
    }
    _object = std::move(object);
    _object->setModelTrans(getTransToWorld());
    _id2object[_object->getId()] = this;
  }
  auto getObject() -> LightObject& { return *_object; }
  auto isSelected() -> bool { return getSelected() == this; }

  static auto getSelected() -> SceneObject* {
    if (_id2object.contains(LightObject::getSelectedId())) {
      return _id2object[LightObject::getSelectedId()];
    }
    return nullptr;
  }

private:
  uptr<LightObject> _object;

  void runLoop(fw::ActionContext const& ctx) override {
    if (_object.get()) {
      _object->setModelTrans(getTransToWorld());
    }
  }

  inline static std::unordered_map<uint32, SceneObject*> _id2object;
};

class ObjectClickObserver : public fw::Action, public PROACTIVE_SINGLETON(ObjectClickObserver) {
public:
  ObjectClickObserver() : fw::Action(fw::Stage::BEFORE_RENDER) {}
  auto getClick() -> SceneObject* { return _clicked.expired() ? nullptr : _clicked.lock().get(); }

private:
  void runLoop(fw::ActionContext const& ctx) override {
    auto& input = fw::InputProcessor::getInstance();
    if (!_clicked.expired()) {
      _clicked = {};
    }
    if (auto state = input.getState(fw::Mouse::LEFT)) {
      if (state->state == fw::ButtonState::DOWN) {
        if (auto selected = SceneObject::getSelected()) {
          _down = selected->getPtr();
        }
      } else if (!_down.expired() && state->state == fw::ButtonState::RELEASE) {
        if (_down.lock().get() == SceneObject::getSelected()) {
          _clicked = _down;
        }
        _down = {};
      }
    }
  }
  wptr<SceneObject> _down;
  wptr<SceneObject> _clicked;
};

} // namespace eg
