module;
#include <toy.h>
export module tool.move;

import std;
import toy;
import glm;
import framework;
import render;
import pipeline.light;
import math;
import pipeline.uniform;
import tool.shape;
import component;
import camera;

export namespace cp {

class MovePlane {
public:
  MovePlane() = default;
  MovePlane(mt::Axis normal_axis) {
    _norm_axis = normal_axis;
    auto normal = mt::unitVec(normal_axis);
    _cube = SceneComponent{ createShape(generateCube(), glm::vec3{ 0.5, 0.5, 0.5 }) };
    _cube.getTransform().scale_factor =
      glm::vec3{ 1, 1, 1 } - normal * (1 - _thickness) - (glm::vec3{ 1, 1, 1 } - normal) * _edge;
    _cube.getTransform().location = -normal * (_thickness / 2);

    auto unit_2 = mt::unitVec(mt::Axis(((int)normal_axis + 2) % 3));
    auto unit_1 = mt::unitVec(mt::Axis(((int)normal_axis + 1) % 3));
    _edge_1 = SceneComponent{ createShape(generateCylinder(_thickness / 2, _edge), unit_1) };
    if (auto cross = glm::cross(glm::vec3{ 0, 0, 1 }, unit_1);
        !mt::eq(cross, glm::vec3{ 0, 0, 0 })) {
      _edge_1.getTransform().rotate(cross, 90);
    }
    _edge_1.getTransform().translate(unit_2 * _edge);
    _edge_2 = SceneComponent{ createShape(generateCylinder(_thickness / 2, _edge), unit_2) };
    if (auto cross = glm::cross(glm::vec3{ 0, 0, 1 }, unit_2);
        !mt::eq(cross, glm::vec3{ 0, 0, 0 })) {
      _edge_2.getTransform().rotate(cross, 90);
    }
    _edge_2.getTransform().translate(unit_1 * _edge);

    _cube.getObject().setUplayer();
    _edge_1.getObject().setUplayer();
    _edge_2.getObject().setUplayer();
    _cube.attachTo(&_root);
    _edge_1.attachTo(&_root);
    _edge_2.attachTo(&_root);
  }
  auto isSelected() -> bool {
    return _cube.isSelected() || _edge_1.isSelected() || _edge_2.isSelected();
  }
  auto getRoot() -> SceneComponent& { return _root; }
  void setDragging(bool dragging) {
    if (_dragging != dragging) {
      auto cube_color = glm::vec4{};
      auto edge1_color = glm::vec4{};
      auto edge2_color = glm::vec4{};
      if (dragging) {
        cube_color = { 1, 1, 0, 1 };
        edge1_color = { 1, 1, 0, 1 };
        edge2_color = { 1, 1, 0, 1 };
      } else {
        cube_color = { 0.5, 0.5, 0.5, 1 };
        edge1_color = { mt::unitVec(mt::Axis{ ((int)_norm_axis + 1) % 3 }), 1 };
        edge2_color = { mt::unitVec(mt::Axis{ ((int)_norm_axis + 2) % 3 }), 1 };
      }
      _cube.getObject().getTexture().writeContent(std::as_bytes(std::span{ &cube_color, 1 }));
      _edge_1.getObject().getTexture().writeContent(std::as_bytes(std::span{ &edge1_color, 1 }));
      _edge_2.getObject().getTexture().writeContent(std::as_bytes(std::span{ &edge2_color, 1 }));
    }
    _dragging = dragging;
  }

private:
  mt::Axis       _norm_axis;
  SceneComponent _root;
  SceneComponent _cube;
  SceneComponent _edge_1;
  SceneComponent _edge_2;
  bool           _dragging;

  constexpr static float _thickness = 0.05f;
  constexpr static float _edge = 0.5f;
};

class MoveArrow {
public:
  MoveArrow() = default;
  MoveArrow(mt::Axis axis) {
    _axis = axis;
    _dragging = false;
    auto unit = mt::unitVec(axis);
    _arrow = SceneComponent{ createShape(generateArrow(), unit) };
    auto arrow_dir = glm::vec3{ 0, 0, 1 };
    if (auto cross = glm::cross(arrow_dir, unit); !mt::eq(cross, glm::vec3{ 0, 0, 0 })) {
      _arrow.getTransform().rotate(cross, 90);
    }
    _arrow.getObject().setUplayer();
    _arrow.attachTo(&_root);
  }
  auto isSelected() -> bool { return _arrow.isSelected(); }
  void setDragging(bool dragging) {
    if (_dragging != dragging) {
      auto color = glm::vec4{};
      if (dragging) {
        color = { 1, 1, 0, 1 };
      } else {
        color = { mt::unitVec(_axis), 1 };
      }
      _arrow.getObject().getTexture().writeContent(std::as_bytes(std::span{ &color, 1 }));
    }
    _dragging = dragging;
  }
  auto getRoot() -> SceneComponent& { return _root; }

private:
  mt::Axis       _axis;
  SceneComponent _root;
  SceneComponent _arrow;
  bool           _dragging;

  constexpr static float _thickness = 0.05f;
  constexpr static float _edge = 0.5f;
};

class MoveController : public Component {
public:
  MoveController() = default;
  enum Mode { LOCAL, WORLD };
  MoveController(SceneComponent* component, Mode mode) {
    setStage(fw::Stage::BEFORE_RENDER);
    TOY_ASSERT(component->isRoot());
    _mode = mode;
    _component = component;
    _root.getTransform().mode = ModelTransform::LOCAL;
    _location_bind = { _component->getTransform().location, _root.getTransform().location };
    if (_mode == LOCAL) {
      _rotate_bind = {
        _component->getTransform().rotate_euler,
        _root.getTransform().rotate_euler,
      };
    }
    _arrows[0] = MoveArrow{ mt::Axis::X };
    _arrows[1] = MoveArrow{ mt::Axis::Y };
    _arrows[2] = MoveArrow{ mt::Axis::Z };
    _arrows[0].getRoot().attachTo(&_root);
    _arrows[1].getRoot().attachTo(&_root);
    _arrows[2].getRoot().attachTo(&_root);
    _planes[0] = MovePlane(mt::Axis::X);
    _planes[1] = MovePlane(mt::Axis::Y);
    _planes[2] = MovePlane(mt::Axis::Z);
    _planes[0].getRoot().attachTo(&_root);
    _planes[1].getRoot().attachTo(&_root);
    _planes[2].getRoot().attachTo(&_root);
  }

private:
  ptr<SceneComponent>           _component;
  SceneComponent                _root;
  Mode                          _mode = WORLD;
  toy::Bidirectional<glm::vec3> _location_bind;
  toy::Bidirectional<glm::vec3> _rotate_bind;
  std::array<MoveArrow, 3>      _arrows;
  std::array<MovePlane, 3>      _planes;

  void runLoop(fw::ActionContext const& ctx) override {
    auto& input = fw::InputProcessor::getInstance();
    if (input.getState(fw::Mouse::LEFT)->state == fw::ButtonState::DOWN) {
      auto& x_axis = _arrows[0];
      auto& y_axis = _arrows[1];
      auto& z_axis = _arrows[2];
      auto& x_plane = _planes[0];
      auto& y_plane = _planes[1];
      auto& z_plane = _planes[2];
      if (x_axis.isSelected()) {
        _axis = mt::Axis::X;
      } else if (y_axis.isSelected()) {
        _axis = mt::Axis::Y;
      } else if (z_axis.isSelected()) {
        _axis = mt::Axis::Z;
      } else if (x_plane.isSelected()) {
        _plane_norm = mt::Axis::X;
      } else if (y_plane.isSelected()) {
        _plane_norm = mt::Axis::Y;
      } else if (z_plane.isSelected()) {
        _plane_norm = mt::Axis::Z;
      }
      if (_axis) {
        _arrows[(int)*_axis].setDragging(true);
        auto ret = getAxisPos(*_axis);
        TOY_ASSERT(ret);
        _start_pos = *ret;
      } else if (_plane_norm) {
        _planes[(int)*_plane_norm].setDragging(true);
        auto ret = getPlanePos(*_plane_norm);
        TOY_ASSERT(ret);
        _start_plane_pos = *ret;
      }
    } else if (input[fw::Mouse::LEFT]->state == fw::ButtonState::RELEASE) {
      if (_axis) {
        _arrows[(int)*_axis].setDragging(false);
      } else if (_plane_norm) {
        _planes[(int)*_plane_norm].setDragging(false);
      }
      _plane_norm = {};
      _axis = {};
    } else if (_axis) {
      auto ret = getAxisPos(*_axis);
      if (ret) {
        auto now_pos = *ret;
        if (glm::abs(now_pos - _start_pos) >= _unit_length) {
          auto delta = _unit_length;
          if (now_pos - _start_pos < 0) {
            delta = -delta;
          }
          _root.getTransform().translate(*_axis, delta);
        }
      }
    } else if (_plane_norm) {
      auto ret = getPlanePos(*_plane_norm);
      if (ret) {
        auto now_pos_1 = ret->x;
        auto now_pos_2 = ret->y;
        auto start_pos_1 = _start_plane_pos.x;
        auto start_pos_2 = _start_plane_pos.y;
        if (glm::abs(now_pos_1 - start_pos_1) >= _unit_length) {
          auto delta = _unit_length;
          if (now_pos_1 - start_pos_1 < 0) {
            delta = -delta;
          }
          _root.getTransform().translate(mt::Axis(((int)*_plane_norm + 1) % 3), delta);
        }
        if (glm::abs(now_pos_2 - start_pos_2) >= _unit_length) {
          auto delta = _unit_length;
          if (now_pos_2 - start_pos_2 < 0) {
            delta = -delta;
          }
          _root.getTransform().translate(mt::Axis(((int)*_plane_norm + 2) % 3), delta);
        }
      }
    }
  }

  auto getAxisPos(mt::Axis axis) -> std::optional<float> {
    auto  cursor = fw::InputProcessor::getInstance().getCursorState();
    auto& camera = camera::Camera::getInstance();
    auto  extent = rd::Presentation::getInstance().getSwapchain().getExtent();
    auto  ndc_x = float(cursor.x) / extent.width * 2 - 1;
    auto  ndc_y = float(cursor.y) / extent.height * 2 - 1;
    auto  start = glm::vec3{ ndc_x, ndc_y, 0 };
    auto  end = glm::vec3{ ndc_x, ndc_y, 1 };
    auto  trans = mt::inverse(camera.getView()) * camera.getProjIV();
    // TOY_DEBUG(trans);
    start = mt::transformDot(trans, start);
    end = mt::transformDot(trans, end);
    auto line_cursor = mt::Line{
      .direction = end - start,
      .point = start,
    };
    auto line_axis = mt::Line{
      .direction = mt::transformVec(_root.getTransToWorld(), mt::unitVec(*_axis)),
      .point = mt::transformDot(_root.getTransToWorld(), glm::vec3{ 0, 0, 0 }),
    };
    if (mt::eq(glm::cross(line_cursor.direction, line_axis.direction), glm::vec3{ 0, 0, 0 })) {
      return std::nullopt;
    }
    // TOY_DEBUG(_root.getTransToWorld());
    // TOY_DEBUG(line_cursor.point, line_cursor.direction);
    // TOY_DEBUG(line_axis.point, line_axis.direction);
    auto ret = mt::distance(line_cursor, line_axis);
    // TOY_DEBUG(ret.distance, ret.point2);
    auto d = glm::dot(ret.point2 - line_axis.point, line_axis.direction);
    // TOY_DEBUG(d);
    return d;
  }
  auto getPlanePos(mt::Axis axis) -> std::optional<glm::vec2> {
    auto  cursor = fw::InputProcessor::getInstance().getCursorState();
    auto& camera = camera::Camera::getInstance();
    auto  extent = rd::Presentation::getInstance().getSwapchain().getExtent();
    auto  ndc_x = float(cursor.x) / extent.width * 2 - 1;
    auto  ndc_y = float(cursor.y) / extent.height * 2 - 1;
    auto  start = glm::vec3{ ndc_x, ndc_y, 0 };
    auto  end = glm::vec3{ ndc_x, ndc_y, 1 };
    auto  trans = mt::inverse(camera.getView()) * camera.getProjIV();
    start = mt::transformDot(trans, start);
    end = mt::transformDot(trans, end);
    auto line_cursor = mt::Line{
      .direction = end - start,
      .point = start,
    };
    auto plane_point = mt::transformDot(_root.getTransToWorld(), glm::vec3{ 0, 0, 0 });
    auto plane = mt::Surface{
      .normal = mt::transformVec(_root.getTransToWorld(), mt::unitVec(axis)),
    };
    plane.dot = glm::dot(plane_point, plane.normal);
    // TOY_DEBUG(plane.normal, plane.dot);
    auto ret = mt::intersection(line_cursor, plane);
    if (std::holds_alternative<glm::vec3>(ret)) {
      auto point = std::get<glm::vec3>(ret) - plane_point;
      // TOY_DEBUG(point);
      auto unit_1 =
        mt::transformVec(_root.getTransToWorld(), mt::unitVec(mt::Axis(((int)axis + 1) % 3)));
      auto unit_2 =
        mt::transformVec(_root.getTransToWorld(), mt::unitVec(mt::Axis(((int)axis + 2) % 3)));
      auto res = glm::vec2{ glm::dot(point, unit_1), glm::dot(point, unit_2) };
      // TOY_DEBUG(glm::vec3{ res, 0 });
      return res;
    }
    return std::nullopt;
  }

  std::optional<mt::Axis> _axis;
  std::optional<mt::Axis> _plane_norm;
  float                   _start_pos;
  glm::vec2               _start_plane_pos;

  float _unit_length = 0.3;
};

class MoveControllerManager : public fw::Action {
public:
  MoveControllerManager() : fw::Action(fw::Stage::BEFORE_RENDER) {}

private:
  void runLoop(fw::ActionContext const& ctx) override {
    if (auto selected = ObjectClickObserver::getInstance().getClick()) {
      if (selected->isRoot()) {
        _controller = { selected, MoveController::LOCAL };
      }
    }
  }
  MoveController _controller;
};

} // namespace cp
