module;
#include <toy.h>
export module pipeline.render_pass;

import framework;
import camera;
import render;
import std;
import toy;

export namespace eg {

struct PipelineInfo {
  std::vector<uint32>            colors;
  std::optional<rd::DepstOption> depst;
  std::string                    vertex_shader_name;
  std::string                    frag_shader_name;
  VkPrimitiveTopology            topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
  VkCullModeFlagBits             cull_mode = VK_CULL_MODE_BACK_BIT;
  rd::VertexLayout               vertex_layout;
  VkDescriptorSetLayout          unit_dset_layout;
  VkDescriptorSetLayout          global_dset_layout; // nullable
};

/**
 * @brief  if use_present_attachment, the color index @ref PipelineInfo::colors is begin at the
 * swapchain format
 *
 */
struct RenderPassInfo {
  std::vector<VkFormat>                color_formats;
  std::vector<VkFormat>                depst_formats;
  std::optional<VkSampleCountFlagBits> multi_sampling;
  std::vector<PipelineInfo>            pipelines;
  bool                                 use_present_attachment = true;
};

class DrawContext {
public:
  DrawContext() = default;
  DrawContext(
    std::vector<rd::VertexBuffer*> vertex_buffers,
    rd::IndexBuffer*               index_buffer,
    rd::DescriptorSet              dset,
    std::optional<uint8>           stencil_ref = {}
  ) {
    init(std::move(vertex_buffers), index_buffer, std::move(dset), stencil_ref);
  }
  /**
   * @param index_buffer nullable
   */
  void init(
    std::vector<rd::VertexBuffer*> vertex_buffers,
    rd::IndexBuffer*               index_buffer,
    rd::DescriptorSet              dset,
    std::optional<uint8>           stencil_ref = {}
  ) {
    _vertex_buffers = std::move(vertex_buffers);
    _index_buffer = index_buffer;
    _dset = std::move(dset);
    _stencil_ref = stencil_ref;
  }
  ONLY_MOVEABLE(DrawContext);
  auto getVertexBuffers() -> std::span<rd::VertexBuffer*> { return _vertex_buffers; }
  auto getIndexBuffer() -> rd::IndexBuffer* { return _index_buffer; }
  auto getDescriptorSet() -> rd::DescriptorSet& { return _dset; }
  auto getStencilRef() -> uint8 {
    TOY_CHECK_ASSERT(_stencil_ref.has_value());
    return *_stencil_ref;
  }

private:
  std::vector<rd::VertexBuffer*> _vertex_buffers;
  rd::IndexBuffer*               _index_buffer;
  rd::DescriptorSet              _dset;
  std::optional<uint8>           _stencil_ref;
};

class RenderPass {
public:
  RenderPass() = default;
  RenderPass(RenderPassInfo const& info) { init(info); }
  void init(RenderPassInfo const& info) {
    auto& swapchain = rd::Presentation::getInstance().getSwapchain();
    auto  attachment_infos = std::vector<rd::AttachmentInfo>{};
    {
      auto color_formats = std::vector<VkFormat>{};
      if (info.use_present_attachment) {
        color_formats.push_back(swapchain.getFormat());
      }
      color_formats.append_range(info.color_formats);
      for (auto& color_format : color_formats) {
        attachment_infos.push_back(rd::AttachmentInfo{
          .format = color_format,
          .sample_count = info.multi_sampling.value_or(VK_SAMPLE_COUNT_1_BIT),
          .load_op = rd::LoadOp::CLEAR,
          .is_store = !info.multi_sampling,
        });
        if (info.multi_sampling) {
          attachment_infos.push_back(rd::AttachmentInfo{
            .format = color_format,
            .sample_count = VK_SAMPLE_COUNT_1_BIT,
          });
        }
      }
      for (auto& depst_format : info.depst_formats) {
        attachment_infos.push_back(rd::AttachmentInfo{
          .format = depst_format,
          .sample_count = info.multi_sampling.value_or(VK_SAMPLE_COUNT_1_BIT),
          .load_op = rd::LoadOp::CLEAR,
          .is_store = false,
        });
      }
    }
    auto subpass_infos = std::vector<rd::SubpassPipelineInfo>{};
    for (auto& pipeline : info.pipelines) {
      auto colors = std::vector<uint32>{};
      auto resolves = std::vector<std::optional<uint32>>{};
      for (auto i : pipeline.colors) {
        if (info.multi_sampling) {
          colors.push_back(i * 2);
          resolves.push_back(i * 2 + 1);
        } else {
          colors.push_back(i);
        }
      }
      auto dset_layouts = std::vector<VkDescriptorSetLayout>{ pipeline.unit_dset_layout };
      if (pipeline.global_dset_layout) {
        dset_layouts.push_back(pipeline.global_dset_layout);
      }
      auto subpass_info = rd::SubpassPipelineInfo{
        .colors = colors,
        .multi_sample = info.multi_sampling.transform(
          [&](auto x) { return rd::SubpassInfo::MultiSample{ resolves, x }; }
        ),
        .depst = pipeline.depst,
        .vertex_shader_name = pipeline.vertex_shader_name,
        .frag_shader_name = pipeline.frag_shader_name,
        .topology = pipeline.topology,
        .cull_mode = pipeline.cull_mode,
        .vertex_layout = pipeline.vertex_layout,
        .dset_layouts = std::move(dset_layouts),
        .push_constants = { 
          rd::PushConstantInfo{ 
            .stage = VK_SHADER_STAGE_VERTEX_BIT, 
            .size = sizeof(CameraData), 
            .alignment = alignof(CameraData),
          },
        },
      };
      if (subpass_info.depst) {
        auto color_attachment_size = info.color_formats.size();
        if (info.use_present_attachment) {
          color_attachment_size += 1;
        }
        subpass_info.depst->attachment +=
          info.multi_sampling ? color_attachment_size * 2 : color_attachment_size;
      }
      subpass_infos.push_back(subpass_info);
      auto dyn_ref =
        pipeline.depst ? pipeline.depst->stencil ? pipeline.depst->stencil->dyn_ref : false : false;
      _dynamic_references.push_back(dyn_ref);
    }
    _render_pass = rd::RenderPassPipeline{ attachment_infos, subpass_infos };
    _multi_sampling = info.multi_sampling;
    _use_present_attachment = info.use_present_attachment;
    _draw_contexts.resize(info.pipelines.size());
    _global_dsets.resize(info.pipelines.size());

    createFramebuffers(info.color_formats, info.depst_formats);
  }
  void addDrawContext(uint32 index, DrawContext* draw_context) {
    _draw_contexts.at(index).insert(draw_context);
  }
  void removeDrawContext(uint32 index, DrawContext* draw_context) {
    _draw_contexts.at(index).erase(draw_context);
  }
  auto getColorAttachment(uint32 index, bool resolved = true) -> rd::FrameImageManager& {
    if (resolved && _multi_sampling) {
      return _resolve_images.at(index);
    } else {
      return _color_images.at(index);
    }
  }
  auto getDepstAttachment(uint32 index) -> rd::FrameImageManager& { return _depst_images[index]; }
  void setColorClearValue(uint32 index, rd::ColorClearValue clear_value) {
    _render_pass.setColorClear(getColorIndex(index), clear_value);
  }
  void setDepstClearValue(uint32 index, rd::DepstClearValue clear_value) {
    _render_pass.setDepstClear(getDepstIndex(index), clear_value);
  }
  void setGlobalDescriptorSet(uint32 index, rd::DescriptorSet* dset) {
    _global_dsets.at(index) = dset;
  }

  void draw(fw::ActionContext const& ctx) {
    if (ctx.recreated) {
      recreateFramebuffers();
    }
    for (auto [index, draw_contexts, global_dset] :
         views::zip(views::iota(0u), _draw_contexts, _global_dsets)) {
      _render_pass.setRecorder(index, [&](rd::PipelineDrawer drawer) {
        drawer.bindPushConstant(
          VK_SHADER_STAGE_VERTEX_BIT,
          std::as_bytes(std::span{ &Camera::getInstance().getData(), 1 })
        );
        if (global_dset) {
          drawer.bindDescriptorSet(1, global_dset);
        }
        for (auto& draw_ctx : draw_contexts) {
          for (auto [binding, vertex_buf] : draw_ctx->getVertexBuffers() | toy::enumerate) {
            drawer.bindVertexBuffer(binding, vertex_buf);
          }
          auto* index_buf = draw_ctx->getIndexBuffer();
          if (index_buf) {
            drawer.bindIndexBuffer(index_buf);
          }
          drawer.bindDescriptorSet(0, &draw_ctx->getDescriptorSet());
          if (_dynamic_references[index]) {
            drawer.setStencilReference(draw_ctx->getStencilRef());
          }
          drawer.draw();
        }
      });
    }
    auto attachments = std::vector<rd::FrameImageManager*>{};
    if (_multi_sampling) {
      if (_use_present_attachment) {
        attachments.push_back(&_present_color_image);
        attachments.push_back(ctx.image_manager);
      }
      for (auto [color, resolve] : views::zip(_color_images, _resolve_images)) {
        attachments.push_back(&color);
        attachments.push_back(&resolve);
      }
    } else {
      if (_use_present_attachment) {
        attachments.push_back(ctx.image_manager);
      }
      for (auto& color : _color_images) {
        attachments.push_back(&color);
      }
    }
    for (auto& depst : _depst_images) {
      attachments.push_back(&depst);
    }
    _render_pass.recordDraw(attachments);
  }

  UNCOPYABLE_MOVEABLE(RenderPass);

private:
  rd::RenderPassPipeline               _render_pass;
  std::optional<VkSampleCountFlagBits> _multi_sampling;
  bool                                 _use_present_attachment;
  rd::FrameImage                       _present_color_image;
  std::vector<rd::FrameImage>          _color_images;
  std::vector<rd::FrameImage>          _resolve_images;
  std::vector<rd::FrameImage>          _depst_images;

  std::vector<bool>               _dynamic_references;
  std::vector<rd::DescriptorSet*> _global_dsets;

  std::vector<std::unordered_set<DrawContext*>> _draw_contexts;

  auto getColorIndex(uint32 index) -> uint32 { return _multi_sampling ? index * 2 : index; }
  auto getResolveIndex(uint32 index) -> uint32 {
    TOY_ASSERT(_multi_sampling);
    return index * 2 + 1;
  }
  auto getDepstIndex(uint32 index) -> uint32 {
    auto color_attachment_size = _color_images.size();
    if (_use_present_attachment) {
      color_attachment_size += 1;
    }
    return index + (_multi_sampling ? 2 * color_attachment_size : color_attachment_size);
  }

  void createFramebuffers(
    std::span<VkFormat const> color_formats, std::span<VkFormat const> depst_formats
  ) {
    _color_images.clear();
    _resolve_images.clear();
    _depst_images.clear();
    auto& swapchain = rd::Presentation::getInstance().getSwapchain();
    if (_use_present_attachment && _multi_sampling) {
      _present_color_image = rd::FrameImage{
        swapchain.getFormat(),
        swapchain.getExtent().width,
        swapchain.getExtent().height,
        _multi_sampling.value(),
        {},
      };
    }
    for (auto& color_format : color_formats) {
      _color_images.push_back(rd::FrameImage{
        color_format,
        swapchain.getExtent().width,
        swapchain.getExtent().height,
        _multi_sampling.value_or(VK_SAMPLE_COUNT_1_BIT),
        VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
      });
      if (_multi_sampling) {
        _resolve_images.push_back(rd::FrameImage{
          color_format,
          swapchain.getExtent().width,
          swapchain.getExtent().height,
          VK_SAMPLE_COUNT_1_BIT,
          VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
        });
      }
    }
    for (auto& depst_format : depst_formats) {
      _depst_images.push_back(rd::FrameImage{
        depst_format,
        swapchain.getExtent().width,
        swapchain.getExtent().height,
        _multi_sampling.value_or(VK_SAMPLE_COUNT_1_BIT),
        {},
      });
    }
  }
  void recreateFramebuffers() {
    auto color_formats = std::vector<VkFormat>{};
    for (auto& image : _color_images) {
      color_formats.push_back(image.getFormat());
    }
    auto depst_formats = std::vector<VkFormat>{};
    for (auto& image : _depst_images) {
      depst_formats.push_back(image.getFormat());
    }
    auto multi_sampling = std::optional<VkSampleCountFlagBits>{};
    if (_present_color_image.valid()) {
      multi_sampling = _present_color_image.getSampleCount();
    }
    createFramebuffers(color_formats, depst_formats);
  }
};

} // namespace eg
