module;
#include <toy.h>
export module pipeline.id;

import pipeline.render_target;
import engine.base;
import engine.texture;
import engine.mesh;
import std;
import toy;
import glm;

import render;
import framework;

import math;
import pipeline.render_pass;
import engine.object;
import pipeline.uniform;
import engine.camera;

namespace eg::id {

auto vertex_layout_id = rd::VertexLayout{ {
  { Vertex::getVertexInfo(), { 0 } },
} };

constexpr auto layout_id = rd::meta::DescriptorLayout{
  rd::meta::UniformBinding{ rd::meta::type<rd::align::mat4>(), rd::meta::Stage::VERTEX },
  rd::meta::UniformBinding{ rd::meta::type<uint32>(), rd::meta::Stage::FRAGMENT },
};

struct IdContext : public CustomLightContext<layout_id> {
  using CustomLightContext::CustomLightContext;
  auto checkNeedDestroy() -> bool override { return false; }
  void beforeRecord() override { transform = getDrawUnit().getTransform().get(); }
  UniformBuffer<rd::align::mat4> transform;
  UniformBuffer<uint32>          id;

  static inline std::unordered_map<uint32, DrawUnitBase*> id2draw_unit;
  static inline std::unordered_map<DrawUnitBase*, uint32> draw_unit2id;

  ~IdContext() {
    id2draw_unit.erase(id.get());
    draw_unit2id.erase(&getDrawUnit());
  }
};

struct CameraData {
  rd::align::mat4 view;
  rd::align::mat4 proj;
};

export class IdPipeline : public RenderPass<IdPipeline, LightUnit>,
                          public PROACTIVE_SINGLETON(IdPipeline) {
public:
  auto fromDrawUnit(uint32 subpass_i, LightUnit& draw_unit) -> uptr<DrawContextBase> {
    if ((subpass_i == 1) == draw_unit.isUpLayer()) {
      auto ret = std::make_unique<IdContext>(&draw_unit);
      ret->id = _last_allocated_id++;
      ret->setDescriptorSet({ ret->transform, ret->id });
      IdContext::draw_unit2id[&draw_unit] = ret->id;
      IdContext::id2draw_unit[ret->id] = &draw_unit;
      return ret;
    }
    return nullptr;
  }

  IdPipeline() {
    auto pipeline_infos = std::vector<PipelineInfo>{
      PipelineInfo{
        .colors = { 0 },
        .depst = { { .attachment = 0, .depth = { {} } } },
        .vertex_shader_name = "id.vert",
        .frag_shader_name = "id.frag",
        .vertex_layout = vertex_layout_id,
        .unit_dset_layout = getLayoutHandle<layout_id>(),
        .push_constants = { rd::PushConstantInfo::get<CameraData>(VK_SHADER_STAGE_VERTEX_BIT) },
      },
      PipelineInfo{
        .colors = { 0 },
        .depst = { { .attachment = 1, .depth = { {} } } },
        .vertex_shader_name = "id.vert",
        .frag_shader_name = "id.frag",
        .vertex_layout = vertex_layout_id,
        .unit_dset_layout = getLayoutHandle<layout_id>(),
        .push_constants = { rd::PushConstantInfo::get<CameraData>(VK_SHADER_STAGE_VERTEX_BIT) },
      },
    };
    auto info = RenderPassInfo{
      .colors = { { VK_FORMAT_R32_UINT, true } },
      .depsts = { { VK_FORMAT_D32_SFLOAT, true }, { VK_FORMAT_D32_SFLOAT, true } },
      .multi_sampling = {},
      .pipelines = std::move(pipeline_infos),
    };
    init({ info });
    setPushConstant(0, VK_SHADER_STAGE_VERTEX_BIT, _camera_data);
    setPushConstant(1, VK_SHADER_STAGE_VERTEX_BIT, _camera_data);
    setColorClearValue(0, { 0u });
    setDepstClearValue(0, 1.0f);
    setDepstClearValue(1, 1.0f);
    _reader = { VK_FORMAT_R32_UINT, { 1, 1 } };
  }

  auto getSelectedDrawUnit() -> DrawUnitBase* {
    if (auto it = IdContext::id2draw_unit.find(_current_id); it != IdContext::id2draw_unit.end()) {
      return it->second;
    } else {
      return nullptr;
    }
  }

  void draw(RenderTarget* id_output, RenderTarget* depth, RenderTarget* depth_uplayer) {
    _camera_data = CameraData{
      .view = Camera::getInstance().getView().get(),
      .proj = Camera::getInstance().getProj().get(),
    };
    auto extent = rd::Presentation::getInstance().getSwapchain().getExtent();
    auto cursor = fw::InputProcessor::getInstance().getCursorState();
    if (cursor.visible) {
      int32 x = std::clamp(cursor.x, 0u, extent.width - 1);
      int32 y = std::clamp(cursor.y, 0u, extent.height - 1);
      _reader.loadImage(*id_output, VK_IMAGE_ASPECT_COLOR_BIT, { x, y }, { 1, 1 }, 0);
      _current_id = *reinterpret_cast<uint32*>(_reader.readPixel(0, 0));
    } else {
      _current_id = 0;
    }
    RenderPass::draw({ id_output }, { depth, depth_uplayer });
  }

private:
  CameraData           _camera_data;
  rd::ImageLocalReader _reader;
  uint32               _current_id = 0;
  uint32               _last_allocated_id = 1;
};

} // namespace eg::id