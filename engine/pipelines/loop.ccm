module;
#include <toy.h>
export module pipeline.loop;

import engine.camera;
import math;
import engine.base;
import render;
import <vulkan_config.h>;
import pipeline.render_target;
import pipeline.basic;
import pipeline.light;
import pipeline.id;
import pipeline.shadow_map;
import pipeline.depth2color;
import framework;
import std;
import toy;

export namespace eg {

class RenderPassLoop : public fw::Action {
public:
  RenderPassLoop() : fw::Action(fw::Stage::RENDER) {
    auto extent = rd::Presentation::getInstance().getSwapchain().getExtent();
    _color.init(VK_FORMAT_R8G8B8A8_SRGB, &_reval_extent, extent);
    _id_output.init(VK_FORMAT_R32_UINT, &_reval_extent, extent);
    _depth.init(VK_FORMAT_D32_SFLOAT, &_reval_extent, extent);
    _depth_id.init(VK_FORMAT_D32_SFLOAT, &_reval_extent, extent);
    _shadow_map.init(
      VK_FORMAT_D32_SFLOAT, &_reval_extent, { 1024, 1024 }, VK_IMAGE_USAGE_SAMPLED_BIT
    );

    _light.init(false, light::LightPipeline::CLEAR_ALL);
    _light_uplayer.init(true, light::LightPipeline::CLEAR_DEPST);
    _shadow_map_pipeline.init();
    _depth2color.init();

    _depth2color.setDepth(_shadow_map);
    _shadow_map_pipeline.getLightData() = shadow_map::LightData{
      .view = mt::view::create(glm::vec3{ 0.0f, 0.0f, 3.0f }),
      .proj = mt::proj::orthogonal(0, 6, 5, -5, -5, 5),
    };
  }

  void runLoop(fw::ActionContext const& ctx) override {
    if (ctx.recreated) {
      _reval_extent.notify(rd::Presentation::getInstance().getSwapchain().getExtent());
    }
    RenderTarget::tryResizeAll();
    if (ctx.recreated) {
      _depth2color.setDepth(_shadow_map);
    }
    _shadow_map_pipeline.getLightData() = shadow_map::LightData{
      .view = Camera::getInstance().getView().get(),
      .proj = Camera::getInstance().getProj().get(),
    };
    // _basic.draw(ctx);
    _light.draw(&_color, &_depth);
    _light_uplayer.draw(&_color, &_depth);
    _id.draw(&_id_output, &_depth, &_depth_id);
    // _shadow_map_pipeline.draw(&_shadow_map);
    // _depth2color.draw(&_color);

    auto submitter = rd::Submitter{ rd::FamilyType::TRANSFER };
    submitter.addNeedSync(
      &_color.getTracker(),
      { VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT },
      VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL
    );
    submitter.addNeedSync(
      &ctx.image_manager->getTracker(),
      { VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT },
      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL
    );
    submitter.submit([&](VkCommandBuffer cmdbuf) {
      rd::copyImageToImage(
        cmdbuf,
        _color.getImage(),
        ctx.image_manager->getImage(),
        VK_IMAGE_ASPECT_COLOR_BIT,
        { 0, 0 },
        { 0, 0 },
        _color.getExtent()
      );
    });
  }

private:
  toy::Observable<VkExtent2D> _reval_extent;
  RenderTarget                _color;
  RenderTarget                _id_output;
  RenderTarget                _depth;
  RenderTarget                _depth_id;
  RenderTarget                _shadow_map;

  basic::BasicPipeline  _basic;
  id::IdPipeline        _id;
  light::LightPipeline  _light;
  light::LightPipeline  _light_uplayer;
  shadow_map::Pipeline  _shadow_map_pipeline;
  depth2color::Pipeline _depth2color;
};

} // namespace eg
