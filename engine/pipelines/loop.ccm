module;
#include <toy.h>
export module pipeline.loop;

import engine.base;
import render;
import <vulkan_config.h>;
import pipeline.render_target;
import pipeline.basic;
import pipeline.light;
import pipeline.id;
import framework;
import std;
import toy;

export namespace eg {

class RenderPassLoop : public fw::Action {
public:
  RenderPassLoop() : fw::Action(fw::Stage::RENDER) {
    _reval_extent = rd::Presentation::getInstance().getSwapchain().getExtent();
    _color.init(VK_FORMAT_R8G8B8A8_SRGB, &_reval_extent);
    _id_output.init(VK_FORMAT_R32_UINT, &_reval_extent);
    _depth.init(VK_FORMAT_D32_SFLOAT, &_reval_extent);
    _depth_id.init(VK_FORMAT_D32_SFLOAT, &_reval_extent);

    _light.init(false, LightPipeline::CLEAR_ALL);
    _light_uplayer.init(true, LightPipeline::CLEAR_DEPST);
  }

  void runLoop(fw::ActionContext const& ctx) override {
    if (ctx.recreated) {
      _reval_extent = rd::Presentation::getInstance().getSwapchain().getExtent();
    }
    RenderTarget::tryResizeAll();
    // _basic.draw(ctx);
    _light.draw(&_color, &_depth);
    _light_uplayer.draw(&_color, &_depth);
    _id.draw(&_id_output, &_depth, &_depth_id);

    auto submitter = rd::Submitter{ rd::FamilyType::TRANSFER };
    submitter.addNeedSync(
      &_color.getTracker(),
      { VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT },
      VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL
    );
    submitter.addNeedSync(
      &ctx.image_manager->getTracker(),
      { VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT },
      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL
    );
    submitter.submit([&](VkCommandBuffer cmdbuf) {
      rd::copyImageToImage(
        cmdbuf,
        _color.getImage(),
        ctx.image_manager->getImage(),
        VK_IMAGE_ASPECT_COLOR_BIT,
        { 0, 0 },
        { 0, 0 },
        _color.getExtent()
      );
    });
  }

private:
  Reval<VkExtent2D> _reval_extent;
  RenderTarget      _color;
  RenderTarget      _id_output;
  RenderTarget      _depth;
  RenderTarget      _depth_id;

  BasicPipeline _basic;
  IdPipeline    _id;
  LightPipeline _light;
  LightPipeline _light_uplayer;
};

} // namespace eg
