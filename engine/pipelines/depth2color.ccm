module;
#include <toy.h>
export module pipeline.depth2color;

import pipeline.render_target;
import engine.base;
import pipeline.render_pass;
import render;
import math;
import engine.object;
import std;
import toy;

namespace eg::depth2color {

using Vertex = rd::Vertex<glm::vec2, glm::vec2>;

auto vertex_layout = rd::VertexLayout{ {
  { Vertex::getVertexInfo(), { 0, 1 } },
} };

constexpr auto layout_depth_texture = rd::meta::DescriptorLayout{
  rd::meta::TextureBinding{ rd::meta::Stage::FRAGMENT },
};

struct TextureUnit : public eg::DrawUnit<TextureUnit> {
  TextureUnit() = default;
  rd::SampledImage                              _sampled_image;
  rd::meta::DescriptorSet<layout_depth_texture> _dset;
};

class TextureDrawContext : public DrawContext<TextureUnit> {
public:
  TextureDrawContext(TextureUnit* draw_unit) : DrawContext(draw_unit) {
    auto vertexes = std::array<Vertex, 4>{
      Vertex{ { -1.0f, -1.0f }, { 0.0f, 0.0f } },
      Vertex{ { 1.0f, -1.0f }, { 1.0f, 0.0f } },
      Vertex{ { 1.0f, 1.0f }, { 1.0f, 1.0f } },
      Vertex{ { -1.0f, 1.0f }, { 0.0f, 1.0f } },
    };
    auto indices = std::array<uint16, 6>{ 0, 2, 1, 3, 2, 0 };
    _vertex_buffer = { vertexes };
    _index_buffer = { indices };
  }
  void recordDraw(rd::PipelineDrawer& drawer) override {
    auto& draw_unit = getDrawUnit();
    drawer.bindVertexBuffer(0, &_vertex_buffer);
    drawer.bindIndexBuffer(&_index_buffer);
    drawer.bindDescriptorSet(0, &draw_unit._dset);
    drawer.draw();
  }
  auto checkNeedDestroy() -> bool override { return false; }

private:
  rd::VertexBuffer _vertex_buffer;
  rd::IndexBuffer  _index_buffer;
};

export class Pipeline : public RenderPass<Pipeline, TextureUnit> {
public:
  auto fromDrawUnit(uint32 subpass_i, TextureUnit& draw_unit) -> uptr<DrawContextBase> {
    return std::make_unique<TextureDrawContext>(&draw_unit);
  }
  Pipeline() = default;
  void init() {
    auto pipeline_infos = std::vector<PipelineInfo>{ PipelineInfo{
      .colors = { 0 },
      .vertex_shader_name = "depth2color.vert",
      .frag_shader_name = "depth2color.frag",
      .vertex_layout = vertex_layout,
      .unit_dset_layout = getLayoutHandle<layout_depth_texture>(),
    } };
    auto info = RenderPassInfo{
      // todo: not clear
      .colors = { { rd::Presentation::getInstance().getSwapchain().getFormat(), true } },
      .multi_sampling = VK_SAMPLE_COUNT_2_BIT,
      .pipelines = pipeline_infos,
    };
    RenderPass::init({ info });
    // todo: not clear
    setColorClearValue(0, { 1.0f, 0.5f, 0.5f, 1.0f });
    _object = std::make_unique<SceneObject>();
    _object->setDrawUnit(std::make_unique<TextureUnit>());
  }

  void draw(RenderTarget* color) { RenderPass::draw({ color }, {}); }

  void setDepth(rd::FrameImage& depth) {
    TOY_ASSERT(rd::getFormatInfo(depth.getFormat()).type == rd::FormatType::DEPTH);
    _object->getDrawUnit<TextureUnit>()->_sampled_image = { depth, 1 };
    _object->getDrawUnit<TextureUnit>()->_dset = {
      _object->getDrawUnit<TextureUnit>()->_sampled_image
    };
  }

private:
  ptr<SceneObject> _object;
};

} // namespace eg::depth2color
