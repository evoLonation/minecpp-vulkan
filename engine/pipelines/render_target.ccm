module;
#include <toy.h>
export module pipeline.render_target;

import engine.base;
import render;
import <vulkan_config.h>;
import std;
import toy;

export namespace eg {

// todo: one RenderTarget should has one multi sampling type
// because the MS image will draw by multi RenderPasses, so need be the same one
class RenderTarget : public rd::FrameImage, public ReactorInterface<VkExtent2D> {
public:
  RenderTarget() = default;
  RenderTarget(VkFormat format, Reval<VkExtent2D>* extent_reval) { init(format, extent_reval); }
  void init(VkFormat format, Reval<VkExtent2D>* extent_reval) {
    _format = format;
    _extent_reval = extent_reval;
    _extent_reval->addReactor(this);
    rd::FrameImage::operator=({
      format,
      extent_reval->get().width,
      extent_reval->get().height,
      VK_SAMPLE_COUNT_1_BIT,
      VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
    });
  }
  UNCOPYABLE_MOVEABLE(RenderTarget);
  ~RenderTarget() { _extent_reval->removeReactor(this); }

  auto getMSTarget(VkSampleCountFlagBits sample_count) -> rd::FrameImage& {
    if (auto iter = _ms_targets.find(sample_count); iter == _ms_targets.end()) {
      auto extent = getExtent();
      return _ms_targets
        .emplace(
          sample_count, rd::FrameImage{ _format, extent.width, extent.height, sample_count, 0 }
        )
        .first->second;
    } else {
      return iter->second;
    }
  }

  void tryResize(VkExtent2D extent) {
    auto old_extent = getExtent();
    if (old_extent.width == extent.width && old_extent.height == extent.height) {
      return;
    }
    rd::FrameImage::operator=({
      _format,
      extent.width,
      extent.height,
      VK_SAMPLE_COUNT_1_BIT,
      VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
    });
    for (auto& [sample_count, target] : _ms_targets) {
      target = { _format, extent.width, extent.height, sample_count, 0 };
    }
  }
  static auto tryResizeAll() {
    for (auto& [target, extent] : _need_resize_targets) {
      target->tryResize(extent);
    }
    _need_resize_targets.clear();
  }

  void observerNotified(VkExtent2D const& extent) override {
    _need_resize_targets.push_back({ this, extent });
  }

private:
  VkFormat                                                  _format;
  Reval<VkExtent2D>*                                        _extent_reval = nullptr;
  std::unordered_map<VkSampleCountFlagBits, rd::FrameImage> _ms_targets;

  static std::vector<std::pair<RenderTarget*, VkExtent2D>> _need_resize_targets;
};

decltype(RenderTarget::_need_resize_targets) RenderTarget::_need_resize_targets;

} // namespace eg
