import engine.camera;

export namespace eg {

template <std::derived_from<DrawUnitBase> T>
class DrawContext : public DrawContextBase {
public:
  DrawContext(T* draw_unit) { _draw_unit = draw_unit; }

protected:
  auto getDrawUnit() -> T& { return *_draw_unit; }

private:
  T* _draw_unit = nullptr;
};

template <typename Derived, std::derived_from<DrawUnitBase>... Ts>
class RenderPass : public RenderPassBase {
public:
  RenderPass() = default;
  RenderPass(RenderPassInfo const& info) { init(info); }
  void init(RenderPassInfo const& info) {
    RenderPassBase::init(info);
    ((std::get<DrawUnitActivatedObserver<Ts>>(_activated_observers)._render_pass = this), ...);
    ((std::get<DrawUnitDeactivatedObserver<Ts>>(_deactivated_observers)._render_pass = this), ...);
    (DrawUnitObservable<Ts>::addActivateObserver(
       &std::get<DrawUnitActivatedObserver<Ts>>(_activated_observers)
     ),
     ...);
    (DrawUnitObservable<Ts>::addDeactivateObserver(
       &std::get<DrawUnitDeactivatedObserver<Ts>>(_deactivated_observers)
     ),
     ...);
  }
  ~RenderPass() {
    (DrawUnitObservable<Ts>::removeActivateObserver(
       &std::get<DrawUnitActivatedObserver<Ts>>(_activated_observers)
     ),
     ...);
    (DrawUnitObservable<Ts>::removeDeactivateObserver(
       &std::get<DrawUnitDeactivatedObserver<Ts>>(_deactivated_observers)
     ),
     ...);
  }

  UNCOPYABLE_MOVEABLE(RenderPass);

private:
  template <typename DrawUnitT>
  struct DrawUnitActivatedObserver : public toy::Observer<DrawUnitT&> {
    void observerNotified(DrawUnitT& draw_unit) override { _render_pass->addDrawUnit(&draw_unit); }
    RenderPass* _render_pass;
  };
  template <typename DrawUnitT>
  struct DrawUnitDeactivatedObserver : public toy::Observer<DrawUnitT&> {
    void observerNotified(DrawUnitT& draw_unit) override {
      _render_pass->removeDrawUnit(&draw_unit);
    }
    RenderPass* _render_pass;
  };

  auto fromDrawUnitBase(uint32 subpass_i, DrawUnitBase& draw_unit)
    -> uptr<DrawContextBase> override {
    auto ret = uptr<DrawContextBase>{};
    auto func = [&]<typename T>() {
      if (auto casted = dynamic_cast<T*>(&draw_unit)) {
        ret = static_cast<Derived*>(this)->fromDrawUnit(subpass_i, *casted);
      }
    };
    (func.template operator()<Ts>(), ...);
    return ret;
  }

private:
  std::tuple<DrawUnitActivatedObserver<Ts>...>   _activated_observers;
  std::tuple<DrawUnitDeactivatedObserver<Ts>...> _deactivated_observers;
};

class LightDrawContext : public DrawContext<LightUnit> {
public:
  using DrawContext::DrawContext;
  void setDescriptorSet(rd::DescriptorSet dset) { _dset = std::move(dset); }
  void recordDraw(rd::PipelineDrawer& drawer) override {
    TOY_ASSERT(_dset);
    auto& draw_unit = getDrawUnit();
    beforeRecord();
    auto& mesh = draw_unit.getMesh();
    drawer.bindVertexBuffer(0, &mesh.getVertexBuffer());
    auto& index_buf = mesh.getIndexBuffer();
    drawer.bindIndexBuffer(&index_buf);
    drawer.bindDescriptorSet(0, &_dset);
    drawer.draw();
  }
  virtual void beforeRecord() = 0;

private:
  rd::DescriptorSet _dset;
};

template <auto dset_layout>
class CustomLightContext : public LightDrawContext {
public:
  using LightDrawContext::LightDrawContext;
  void setDescriptorSet(rd::meta::DescriptorSet<dset_layout> dset) {
    LightDrawContext::setDescriptorSet(std::move(dset));
  }
};

template <auto dset_layout>
auto getLayoutHandle() -> VkDescriptorSetLayout {
  return rd::meta::DescriptorPools::getInstance().getPool<dset_layout>();
}

} // namespace eg
