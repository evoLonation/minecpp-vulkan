export module pipeline.uniform;

import std;
import toy;
import render;
import framework;
import glm;

import <vulkan_config.h>;

export namespace eg {

template <typename DataType>
class UniformBuffer : public fw::Action, public rd::UniformBuffer<DataType> {
  using Base = rd::UniformBuffer<DataType>;

public:
  UniformBuffer() : UniformBuffer(DataType{}) {}
  UniformBuffer(DataType const& data)
    : fw::Action(fw::Stage::UNIFORM_UPDATE), Base(data), _cache_data(data) {}

  void runLoop(fw::ActionContext const&) override {
    auto cache_bytes = std::as_bytes(std::span{ &_cache_data, 1 });
    auto buffer_data = Base::read();
    auto buffer_bytes = std::as_bytes(std::span{ &buffer_data, 1 });
    if (ranges::mismatch(cache_bytes, buffer_bytes).in1 != cache_bytes.end()) {
      // toy::debugf("update uniform buffer");
      Base::update(_cache_data);
    }
  }

  auto operator=(DataType const& data) -> UniformBuffer& {
    _cache_data = data;
    return *this;
  }
  operator DataType&() { return _cache_data; }
  operator const DataType&() const { return _cache_data; }
  auto get(this auto&& self) -> auto& { return self._cache_data; }
  auto operator->(this auto&& self) -> auto* { return &self._cache_data; }

private:
  DataType _cache_data;
};

} // namespace eg