module;
#include <toy.h>
export module pipeline.light;

import engine.base;
import engine.draw_unit;
import engine.texture;
import engine.mesh;
import std;
import toy;
import glm;

import render;
import model;
import framework;

import math;
import pipeline.base;
import pipeline.uniform;
import camera;

namespace eg {

auto vertex_layout_light = rd::VertexLayout{ {
  { Vertex::getVertexInfo(), { 0, 1, 2 } },
} };

auto vertex_layout_id = rd::VertexLayout{ {
  { Vertex::getVertexInfo(), { 0 } },
} };

struct LightModelVertexData {
  rd::align::mat4 model;
  rd::align::mat3 normal_model;
};

struct LightModelFragmentData {
  float shininess = 32.0f;
};

struct LightData {
  rd::align::vec3 direction = glm::vec3{ 0.0f, 0.0f, -1.0f };
  rd::align::vec3 ambient = glm::vec3{ 0.1f, 0.1f, 0.1f };
  rd::align::vec3 diffuse = glm::vec3{ 0.5f, 0.5f, 0.5f };
  rd::align::vec3 specular = glm::vec3{ 1.0f, 1.0f, 1.0f };
  rd::align::vec3 view_pos = glm::vec3{ 5.0f, 5.0f, 5.0f };
};

constexpr auto layout_model_light = rd::meta::DescriptorLayout{
  rd::meta::UniformBinding{ rd::meta::type<LightModelVertexData>(), rd::meta::Stage::VERTEX },
  rd::meta::UniformBinding{ rd::meta::type<LightModelFragmentData>(), rd::meta::Stage::FRAGMENT },
  rd::meta::TextureBinding{ rd::meta::Stage::FRAGMENT },
  rd::meta::TextureBinding{ rd::meta::Stage::FRAGMENT },
};

constexpr auto layout_global_light = rd::meta::DescriptorLayout{
  rd::meta::UniformBinding{ rd::meta::type<LightData>(), rd::meta::Stage::FRAGMENT },
};

constexpr auto layout_id = rd::meta::DescriptorLayout{
  rd::meta::UniformBinding{ rd::meta::type<rd::align::mat4>(), rd::meta::Stage::VERTEX },
  rd::meta::UniformBinding{ rd::meta::type<uint32>(), rd::meta::Stage::FRAGMENT },
};

struct LightContext : public CustomDrawContext<layout_model_light> {
  UniformBuffer<LightModelVertexData>   vertex_data;
  UniformBuffer<LightModelFragmentData> frag_data;
};

struct IdContext : public CustomDrawContext<layout_id> {
  UniformBuffer<rd::align::mat4> transform;
  UniformBuffer<uint32>          id;
};

export class LightPipeline : public CustomRenderPass, public PROACTIVE_SINGLETON(LightPipeline) {
public:
  void beforeRender(DrawUnit& draw_unit, DrawContextBase* draw_ctx) override {
    if (auto* ctx = dynamic_cast<LightContext*>(draw_ctx)) {
      ctx->vertex_data->model = draw_unit.getTransform();
      ctx->vertex_data->normal_model = mt::getNormalModel(draw_unit.getTransform());
    } else if (auto* ctx = dynamic_cast<IdContext*>(draw_ctx)) {
      ctx->transform = draw_unit.getTransform();
    }
  }
  auto fromDrawUnit(uint32 subpass_n, DrawUnit& draw_unit)
    -> std::optional<uptr<DrawContextBase>> override {
    if ((subpass_n == 0 || subpass_n == 1) && (subpass_n == 1) == draw_unit.isUpLayer()) {
      auto ret = std::make_unique<LightContext>();
      ret->init(
        draw_unit,
        {
          &ret->vertex_data,
          &ret->frag_data,
          &draw_unit.getTexture().getTexture(),
          &draw_unit.getTexture().getTexture(),
        }
      );
      return ret;
    } else if ((subpass_n == 2 || subpass_n == 3) && (subpass_n == 3) == draw_unit.isUpLayer()) {
      auto ret = std::make_unique<IdContext>();
      ret->id = _last_allocated_id++;
      ret->init(draw_unit, { &ret->transform, &ret->id });
      _draw_unit2id[&draw_unit] = ret->id;
      _id2draw_unit[ret->id] = &draw_unit;
      return ret;
    }
    return std::nullopt;
  }

  LightPipeline() {
    auto pipeline_infos = std::vector<PipelineInfo>{
      PipelineInfo{
        .colors = { 0 },
        .depst = { { .attachment = 0, .depth = { {} } } },
        .vertex_shader_name = "light.vert",
        .frag_shader_name = "light.frag",
        .vertex_layout = vertex_layout_light,
        .unit_dset_layout = getLayoutHandle<layout_model_light>(),
        .global_dset_layout = getLayoutHandle<layout_global_light>(),
      },
      // for move tool
      PipelineInfo{
        .colors = { 0 },
        .depst = { { .attachment = 1, .depth = { {} } } },
        .vertex_shader_name = "light.vert",
        .frag_shader_name = "light.frag",
        .vertex_layout = vertex_layout_light,
        .unit_dset_layout = getLayoutHandle<layout_model_light>(),
        .global_dset_layout = getLayoutHandle<layout_global_light>(),
      },
      PipelineInfo{
        .colors = { 1 },
        .depst = { { .attachment = 2, .depth = { {} } } },
        .vertex_shader_name = "id.vert",
        .frag_shader_name = "id.frag",
        .vertex_layout = vertex_layout_id,
        .unit_dset_layout = getLayoutHandle<layout_id>(),
      },
      PipelineInfo{
        .colors = { 1 },
        .depst = { { .attachment = 3, .depth = { {} } } },
        .vertex_shader_name = "id.vert",
        .frag_shader_name = "id.frag",
        .vertex_layout = vertex_layout_id,
        .unit_dset_layout = getLayoutHandle<layout_id>(),
      },
    };
    auto info = RenderPassInfo{
      .color_formats = { VK_FORMAT_R32_UINT },
      .depst_formats = { VK_FORMAT_D32_SFLOAT,
                         VK_FORMAT_D32_SFLOAT,
                         VK_FORMAT_D32_SFLOAT,
                         VK_FORMAT_D32_SFLOAT },
      .multi_sampling = VK_SAMPLE_COUNT_8_BIT,
      .pipelines = std::move(pipeline_infos),
    };
    init({ info });
    setColorClearValue(0, { 0.5f, 0.5f, 0.5f, 1.0f });
    setColorClearValue(1, { 0u });
    setDepstClearValue(0, 1.0f);
    setDepstClearValue(1, 1.0f);
    setDepstClearValue(2, 1.0f);
    setDepstClearValue(3, 1.0f);
    _dset_global_light = { &_uniform_light };
    setGlobalDescriptorSet(0, &_dset_global_light);
    setGlobalDescriptorSet(1, &_dset_global_light);
    _reader = { VK_FORMAT_R32_UINT, { 1, 1 } };

    _before_destroy = [this](DrawUnit& draw_unit) {
      if (_draw_unit2id.contains(&draw_unit)) {
        auto id = _draw_unit2id[&draw_unit];
        _id2draw_unit.erase(id);
        _draw_unit2id.erase(&draw_unit);
      }
    };
  }
  ~LightPipeline() { DrawUnit::removeBeforeDestroy(&_before_destroy); }

  auto getLight() -> LightData& { return _uniform_light.get(); }

  auto getSelectedDrawUnit() -> DrawUnit* {
    if (auto it = _id2draw_unit.find(_current_id); it != _id2draw_unit.end()) {
      return it->second;
    } else {
      return nullptr;
    }
  }

  UNCOPYABLE_MOVEABLE(LightPipeline);

  void draw(fw::ActionContext const& ctx) override {
    auto extent = rd::Presentation::getInstance().getSwapchain().getExtent();
    auto cursor = fw::InputProcessor::getInstance().getCursorState();
    if (cursor.visible) {
      int32 x = std::clamp(cursor.x, 0u, extent.width - 1);
      int32 y = std::clamp(cursor.y, 0u, extent.height - 1);
      _reader.loadImage(getColorAttachment(0), VK_IMAGE_ASPECT_COLOR_BIT, { x, y }, { 1, 1 }, 0);
      _current_id = *reinterpret_cast<uint32*>(_reader.readPixel(0, 0));
    } else {
      _current_id = 0;
    }
    _uniform_light->view_pos = Camera::getInstance().getViewPos();
    CustomRenderPass::draw(ctx);
  }

private:
  UniformBuffer<LightData>                     _uniform_light;
  rd::meta::DescriptorSet<layout_global_light> _dset_global_light;
  rd::ImageLocalReader                         _reader;
  uint32                                       _current_id = 0;
  uint32                                       _last_allocated_id = 1;
  std::function<void(DrawUnit&)>               _before_destroy;
  std::unordered_map<uint32, DrawUnit*>        _id2draw_unit;
  std::unordered_map<DrawUnit*, uint32>        _draw_unit2id;
};

} // namespace eg