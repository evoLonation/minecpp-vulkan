module;
#include <toy.h>
export module pipeline.light;

import pipeline.render_target;
import engine.base;
import engine.draw_unit;
import engine.texture;
import engine.mesh;
import std;
import toy;
import glm;

import render;
import model;
import framework;

import math;
import pipeline.base;
import pipeline.uniform;
import camera;

namespace eg {

auto vertex_layout_light = rd::VertexLayout{ {
  { Vertex::getVertexInfo(), { 0, 1, 2 } },
} };

struct LightModelVertexData {
  rd::align::mat4 model;
  rd::align::mat3 normal_model;
};

struct LightModelFragmentData {
  float shininess = 32.0f;
};

struct LightData {
  rd::align::vec3 direction = glm::vec3{ 0.0f, 0.0f, -1.0f };
  rd::align::vec3 ambient = glm::vec3{ 0.1f, 0.1f, 0.1f };
  rd::align::vec3 diffuse = glm::vec3{ 0.5f, 0.5f, 0.5f };
  rd::align::vec3 specular = glm::vec3{ 1.0f, 1.0f, 1.0f };
  rd::align::vec3 view_pos = glm::vec3{ 5.0f, 5.0f, 5.0f };
};

constexpr auto layout_model_light = rd::meta::DescriptorLayout{
  rd::meta::UniformBinding{ rd::meta::type<LightModelVertexData>(), rd::meta::Stage::VERTEX },
  rd::meta::UniformBinding{ rd::meta::type<LightModelFragmentData>(), rd::meta::Stage::FRAGMENT },
  rd::meta::TextureBinding{ rd::meta::Stage::FRAGMENT },
  rd::meta::TextureBinding{ rd::meta::Stage::FRAGMENT },
};

constexpr auto layout_global_light = rd::meta::DescriptorLayout{
  rd::meta::UniformBinding{ rd::meta::type<LightData>(), rd::meta::Stage::FRAGMENT },
};

struct LightContext : public CustomDrawContext<layout_model_light> {
  UniformBuffer<LightModelVertexData>   vertex_data;
  UniformBuffer<LightModelFragmentData> frag_data;
};

export class LightPipeline : public CustomRenderPass {
public:
  void beforeRender(DrawUnit& draw_unit, DrawContextBase* draw_ctx) override {
    auto* ctx = dynamic_cast<LightContext*>(draw_ctx);
    auto  model = draw_unit.getTransform();
    ctx->vertex_data->model = model;
    ctx->vertex_data->normal_model = mt::getNormalModel(model);
  }
  auto fromDrawUnit(uint32 subpass_n, DrawUnit& draw_unit)
    -> std::optional<uptr<DrawContextBase>> override {
    if (_uplayer == draw_unit.isUpLayer()) {
      auto ret = std::make_unique<LightContext>();
      ret->init(
        draw_unit,
        {
          &ret->vertex_data,
          &ret->frag_data,
          &draw_unit.getTexture().getTexture(),
          &draw_unit.getTexture().getTexture(),
        }
      );
      return ret;
    }
    return std::nullopt;
  }

  LightPipeline() = default;
  enum ClearOp { NONE, CLEAR_ALL, CLEAR_DEPST };
  void init(bool uplayer, ClearOp clear_op) {
    _uplayer = uplayer;
    auto pipeline_infos = std::vector<PipelineInfo>{
      PipelineInfo{
        .colors = { 0 },
        .depst = { { .attachment = 0, .depth = { {} } } },
        .vertex_shader_name = "light.vert",
        .frag_shader_name = "light.frag",
        .vertex_layout = vertex_layout_light,
        .unit_dset_layout = getLayoutHandle<layout_model_light>(),
        .global_dset_layout = getLayoutHandle<layout_global_light>(),
      },
    };
    auto info = RenderPassInfo{
      .colors = { { VK_FORMAT_R8G8B8A8_SRGB, clear_op == CLEAR_ALL } },
      .depsts = { { VK_FORMAT_D32_SFLOAT, clear_op == CLEAR_ALL || clear_op == CLEAR_DEPST } },
      .multi_sampling = VK_SAMPLE_COUNT_8_BIT,
      .pipelines = std::move(pipeline_infos),
    };
    CustomRenderPass::init({ info });
    if (clear_op == CLEAR_DEPST) {
      setDepstClearValue(0, 1.0f);
    } else if (clear_op == CLEAR_ALL) {
      setColorClearValue(0, { 0.5f, 0.5f, 0.5f, 1.0f });
      setDepstClearValue(0, 1.0f);
    }
    _dset_global_light = { &_uniform_light };
    setGlobalDescriptorSet(0, &_dset_global_light);
  }

  auto getLight() -> LightData& { return _uniform_light.get(); }

  void draw(RenderTarget* color, RenderTarget* depth) {
    _uniform_light->view_pos = Camera::getInstance().getViewPos();
    CustomRenderPass::draw({ color }, { depth });
  }

private:
  bool                                         _uplayer = false;
  UniformBuffer<LightData>                     _uniform_light;
  rd::meta::DescriptorSet<layout_global_light> _dset_global_light;
};

} // namespace eg