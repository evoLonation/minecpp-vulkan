module;
#include <toy.h>
export module pipeline.basic;

import pipeline.render_target;
import engine.base;
import pipeline.uniform;
import engine.draw_unit;
import engine.mesh;
import std;
import toy;
import glm;

import render;
import model;
import framework;

import pipeline.base;

namespace eg {

auto vertex_layout_basic = rd::VertexLayout{ {
  { Vertex::getVertexInfo(), { 0, 2 } },
} };

auto vertex_layout_color = rd::VertexLayout{ {
  { Vertex::getVertexInfo(), { 0 } },
} };

constexpr auto layout_model_texture = rd::meta::DescriptorLayout{
  rd::meta::UniformBinding{ rd::meta::type<rd::align::mat4>(), rd::meta::Stage::VERTEX },
  rd::meta::TextureBinding{ rd::meta::Stage::FRAGMENT },
};

constexpr auto layout_model_color = rd::meta::DescriptorLayout{
  rd::meta::UniformBinding{ rd::meta::type<rd::align::mat4>(), rd::meta::Stage::VERTEX },
  rd::meta::UniformBinding{ rd::meta::type<rd::align::vec3>(), rd::meta::Stage::FRAGMENT },
};

struct TextureContext : public CustomDrawContext<layout_model_texture> {
  UniformBuffer<rd::align::mat4> transform;
};

struct ColorContext : public CustomDrawContext<layout_model_color> {
  UniformBuffer<rd::align::mat4> transform;
  UniformBuffer<rd::align::vec3> color;
};

export class BasicPipeline : public CustomRenderPass {
public:
  void beforeRender(DrawUnit& draw_unit, DrawContextBase* draw_ctx) override {
    if (auto* ctx = dynamic_cast<TextureContext*>(draw_ctx)) {
      ctx->transform = draw_unit.getTransform();
    } else if (auto* ctx = dynamic_cast<ColorContext*>(draw_ctx)) {
      ctx->transform = draw_unit.getTransform();
    }
  }
  auto fromDrawUnit(uint32 subpass_n, DrawUnit& draw_unit)
    -> std::optional<uptr<DrawContextBase>> override {
    if (subpass_n == 0) {
      auto ret = std::make_unique<TextureContext>();
      ret->init(draw_unit, { &ret->transform, &draw_unit.getTexture().getTexture() });
      return ret;
    } else if (subpass_n == 1 || subpass_n == 2) {
      auto ret = std::make_unique<ColorContext>();
      ret->init(draw_unit, { &ret->transform, &ret->color });
      ret->color = glm::vec3{ 0.5f, 0.5f, 0.5f }; // default color
      return ret;
    }
    return std::nullopt;
  }

  BasicPipeline() {
    auto pipeline_infos = std::vector<PipelineInfo>{
      PipelineInfo{
        .colors = { 0 },
        .depst = { { .depth = { {} } } },
        .vertex_shader_name = "hello.vert",
        .frag_shader_name = "hello.frag",
        .topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST,
        .cull_mode = VK_CULL_MODE_BACK_BIT,
        .vertex_layout = vertex_layout_basic,
        .unit_dset_layout = getLayoutHandle<layout_model_texture>(),
      },
      PipelineInfo{
        .colors = { 0 },
        .depst = { { .depth = { {} } } },
        .vertex_shader_name = "solid_color.vert",
        .frag_shader_name = "solid_color.frag",
        .topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST,
        .cull_mode = VK_CULL_MODE_BACK_BIT,
        .vertex_layout = vertex_layout_color,
        .unit_dset_layout = getLayoutHandle<layout_model_color>(),
      },
      PipelineInfo{
        .colors = { 0 },
        .depst = { { .depth = { {} } } },
        .vertex_shader_name = "solid_color.vert",
        .frag_shader_name = "solid_color.frag",
        .topology = VK_PRIMITIVE_TOPOLOGY_LINE_LIST,
        .cull_mode = VK_CULL_MODE_NONE,
        .vertex_layout = vertex_layout_color,
        .unit_dset_layout = getLayoutHandle<layout_model_color>(),
      },
    };
    auto info = RenderPassInfo{
      .colors = { { VK_FORMAT_R8G8B8A8_SRGB, true } },
      .depsts = { { VK_FORMAT_D32_SFLOAT, true } },
      .multi_sampling = VK_SAMPLE_COUNT_8_BIT,
      .pipelines = std::move(pipeline_infos),
    };
    init(info);
    setColorClearValue(0, { 0.5f, 0.5f, 0.5f, 1.0f });
    setDepstClearValue(0, 1.0f);
  }

  void draw(RenderTarget* color, RenderTarget* depth) {
    CustomRenderPass::draw({ color }, { depth });
  }
};

} // namespace eg