module;
#include <engine.h>
#include <toy.h>

export module engine.texture;

import engine.base;
import engine.package;
import render;
import std;
import toy;

export namespace eg {

using FormatInfo = rd::FormatInfo;

class Texture : public Component, public Asset {
public:
  Texture() = default;
  Texture(rd::SampledTexture texture) : _texture{ std::move(texture) } {}

  auto getTexture() -> rd::SampledTexture& { return _texture; }

private:
  rd::SampledTexture _texture;

public:
  void assetSerialize(AssetPackager& packager) override {
    auto format = _texture.getImage().getFormat();
    auto extent = _texture.getImage().getExtent();
    auto mipmap = _texture.getImage().enableMipmap();
    auto use_stage = _texture.getUseStage();
    auto reader = rd::ImageLocalReader{ format, extent };
    reader.loadImage(_texture.getImage(), VK_IMAGE_ASPECT_COLOR_BIT, { 0, 0 }, extent, 0);
    auto first_pixel = reader.readPixel(0, 0);
    auto data = std::vector<std::byte>{
      first_pixel,
      first_pixel + extent.width * extent.height * rd::getFormatInfo(format).size,
    };
    packager.pack(data, format, extent, mipmap, use_stage);
  }
  void assetDeserialize(AssetUnpacker& unpacker) override {
    auto [data, format, extent, mipmap, use_stage] = unpacker.unpacks< //
      std::vector<std::byte>,
      VkFormat,
      VkExtent2D,
      bool,
      VkPipelineStageFlagBits>();
    _texture = rd::SampledTexture{ std::span{ data }, format, extent, mipmap, use_stage };
  }

private:
  REGISTER_ASSET(Texture);
};

// todo: serializer

} // namespace eg
