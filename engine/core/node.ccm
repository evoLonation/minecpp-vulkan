module;
#include <engine.h>
#include <toy.h>

export module engine.node;

import engine.package;
import engine.base;
import std;
import toy;
import framework;
import math;
import glm;
import <imgui_config.h>;

export namespace eg {

class ModelController {
public:
  ModelController();
  void setName(std::string name);
  enum SettingMode { CHANGE_MODEL, CHANGE_CONTROLLER };
  ModelController(Reval<glm::mat4>* model, SettingMode mode);
  ~ModelController() = default;
  void setModelTransformInvalid();
  void resetModelTransform();
  void setModelTransform(Reval<glm::mat4>* model, SettingMode mode);

  void translate(glm::vec3 const& delta);
  void translate(mt::Axis axis, float delta);
  void rotate(mt::Axis axis, float degree);
  void rotate(glm::vec3 const& axis, float degree);
  void scale(glm::vec3 const& factor);
  void scale(mt::Axis axis, float factor);
  enum Mode { LOCAL, WORLD };
  void setMode(Mode mode);
  auto getMode() -> Mode { return _mode; }
  auto refLocation() -> Reval<glm::vec3>& { return _location; }
  auto refRotateEuler() -> Reval<glm::vec3>& { return _rotate_euler; }
  auto refScaleFactor() -> Reval<glm::vec3>& { return _scale_factor; }

private:
  Reval<glm::mat4>* _model = nullptr;
  Reval<glm::vec3>  _location = { { 0, 0, 0 } };
  Reval<glm::vec3>  _rotate_euler = { { 0, 0, 0 } };
  Reval<glm::vec3>  _scale_factor = { { 1, 1, 1 } };
  Unbinder          _unbinder_model;
  Unbinder          _unbinder_vec;
  Mode              _mode = WORLD;

  Reval<std::tuple<glm::vec3, glm::vec3, glm::vec3>> _middle_reval;
};

class Component;

class Node : public EnableGetPtr<Node>, public AssetWithRegister<Node> {
public:
  Node();
  void setName(std::string name);
  ~Node();
  void attachTo(Node& node);
  void detach();
  auto getController() -> ModelController& { return _controller; }
  auto getTransToParent() -> Reval<glm::mat4>& { return _to_parent; }
  auto getTransToWorld() -> Reval<glm::mat4> const& { return _to_world; }
  auto getParent() -> Node& {
    TOY_ASSERT(_parent);
    return *_parent;
  }
  // just allow to get children, not modify
  auto getChildren() -> std::unordered_set<ptr<Node>>& { return _children; }
  auto isRoot() -> bool { return !_parent; }
  auto getRoot() -> Node& { return *_root; }
  void doRecursively(std::function<void(Node&)> const& dealer);

  void addComponent(ptr<Component> component, bool enable_cover = false);
  template <typename T>
  void removeComponent();
  template <typename T>
  auto getComponent() -> T&;
  template <typename T>
  auto hasComponent() -> bool;

private:
  Reval<glm::mat4>              _to_parent;
  ModelController               _controller;
  Reval<glm::mat4>              _to_world;
  Node*                         _parent = nullptr;
  std::unordered_set<ptr<Node>> _children;
  Node*                         _root = nullptr;
  Unbinder                      _unbinder;

  std::unordered_map<std::string_view, ptr<Component>> _components;

  void setParent(Node& parent);
  void resetParent();

  void removeComponent(std::string_view name);
  auto getComponent(std::string_view name) -> Component&;
  auto hasComponent(std::string_view name) -> bool;

protected:
  void assetSerialize(AssetPackager& packager) override;
  void assetDeserialize(AssetUnpacker& unpacker) override;
};

// 每个直接或者间接继承 Node 的 non abstract class 都必须同时继承 NodeRegister
template <typename Derived>
using NodeRegister = AssetRegister<Derived>;

template <typename Derived>
class NodeWithRegister : public Node, public NodeRegister<Derived> {
public:
  using Node::Node;
};

class Component : public EnableGetPtr<Component>, public AssetWithRegister<Component> {
  friend class Node;

public:
  Component() = default;
  UNCOPYABLE_MOVEABLE(Component);

  auto isAttached() -> bool { return _node != nullptr; }
  auto getNode() -> Node& {
    TOY_ASSERT(_node);
    return *_node;
  }
  ~Component() = default;

protected:
  void assetSerialize(AssetPackager& packager) override {}
  void assetDeserialize(AssetUnpacker& unpacker) override {}

  virtual void afterAddToNode() {}

private:
  Node* _node = nullptr;
};

// 每个直接或者间接继承 Component 的 non abstract class 都必须同时继承 ComponentRegister
template <typename Derived>
using ComponentRegister = AssetRegister<Derived>;

template <typename Derived>
class ComponentWithRegister : public Component, public ComponentRegister<Derived> {
public:
  using Component::Component;
};

template <typename T>
void Node::removeComponent() {
  removeComponent(std::string_view{ typeid(T).name() });
}

template <typename T>
auto Node::getComponent() -> T& {
  return dynamic_cast<T&>(getComponent(std::string_view{ typeid(T).name() }));
}

template <typename T>
auto Node::hasComponent() -> bool {
  return hasComponent(std::string_view{ typeid(T).name() });
}

} // namespace eg
