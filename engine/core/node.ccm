module;
#include <engine.h>
#include <toy.h>

export module engine.node;

import engine.assets;
import engine.base;
import std;
import toy;
import framework;
import math;
import glm;
import <imgui_config.h>;

export namespace eg {

class ModelController {
public:
  ModelController() {
    _reactor_trans = { [this](auto&& _) {
      *_model = mt::translate(_location) * mt::rotate(_rotate_euler) * mt::scale(_scale_factor);
    } };
    _reactor_split = { [this](glm::mat4 model) {
      _location = glm::vec3{ model[3] };
      model[3] = glm::vec4{ 0, 0, 0, 1 };
      _scale_factor = glm::vec3{
        glm::length(model[0]),
        glm::length(model[1]),
        glm::length(model[2]),
      };
      model[0] = glm::normalize(model[0]);
      model[1] = glm::normalize(model[1]);
      model[2] = glm::normalize(model[2]);
      _rotate_euler = mt::getEulerAngle(model);
    } };
  }
  enum SettingMode { CHANGE_MODEL, CHANGE_CONTROLLER };
  ModelController(Reval<glm::mat4>* model, SettingMode mode) : ModelController{} {
    setModelTransform(model, mode);
  }
  ~ModelController() { reset(); }
  void reset() {
    if (_model) {
      _model->removeReactor(&_reactor_split);
    }
    _model = nullptr;
    _location.removeReactor(&_reactor_trans);
    _rotate_euler.removeReactor(&_reactor_trans);
    _scale_factor.removeReactor(&_reactor_trans);
  }
  void setModelTransform(Reval<glm::mat4>* model, SettingMode mode) {
    if (_model) {
      _model->removeReactor(&_reactor_split);
      _model = model;
    } else {
      _model = model;
      _model->addReactor(&_reactor_split, mode == CHANGE_CONTROLLER);
      _location.addReactor(&_reactor_trans);
      _rotate_euler.addReactor(&_reactor_trans);
      _scale_factor.addReactor(&_reactor_trans, mode == CHANGE_MODEL);
    }
  }

  void translate(glm::vec3 const& delta) {
    if (_mode == WORLD) {
      _location += delta;
    } else {
      auto r_2 = mt::rotate(_rotate_euler) * mt::translate(delta);
      // r_2 = t_new * r_new
      // t_new = t_2[3][0-3], r_new = t_2[0-2][0-2]
      _location += glm::vec3{ r_2[3] };
      r_2[3] = glm::vec4{ 0, 0, 0, 1 };
      _rotate_euler = mt::getEulerAngle(r_2);
    }
  }
  void translate(mt::Axis axis, float delta) {
    using enum mt::Axis;
    switch (axis) {
    case X:
      translate(glm::vec3{ delta, 0, 0 });
      break;
    case Y:
      translate(glm::vec3{ 0, delta, 0 });
      break;
    case Z:
      translate(glm::vec3{ 0, 0, delta });
      break;
    }
  }
  void rotate(mt::Axis axis, float degree) {
    auto r_new = glm::mat4{};
    if (_mode == WORLD) {
      r_new = mt::rotate(axis, degree) * mt::rotate(_rotate_euler);
    } else {
      r_new = mt::rotate(_rotate_euler) * mt::rotate(axis, degree);
    }
    _rotate_euler = mt::getEulerAngle(r_new);
  }
  void rotate(glm::vec3 const& axis, float degree) {
    auto r_new = glm::mat4{};
    if (_mode == WORLD) {
      r_new = mt::rotate(axis, degree) * mt::rotate(_rotate_euler);
    } else {
      r_new = mt::rotate(_rotate_euler) * mt::rotate(axis, degree);
    }
    _rotate_euler = mt::getEulerAngle(r_new);
  }
  void scale(glm::vec3 const& factor) {
    using enum mt::Axis;
    if (_mode == WORLD) {
      auto s_r = mt::scale(factor) * mt::rotate(_rotate_euler);
      auto new_scale_factor = glm::vec3{
        glm::length(s_r[0]),
        glm::length(s_r[1]),
        glm::length(s_r[2]),
      };
      _scale_factor *= new_scale_factor;
      s_r[0] = glm::normalize(s_r[0]);
      s_r[1] = glm::normalize(s_r[1]);
      s_r[2] = glm::normalize(s_r[2]);
      _rotate_euler = mt::getEulerAngle(s_r);
    } else {
      _scale_factor[0] *= factor[0];
      _scale_factor[1] *= factor[1];
      _scale_factor[2] *= factor[2];
    }
  }
  void scale(mt::Axis axis, float factor) {
    using enum mt::Axis;
    if (_mode == WORLD) {
      auto s_r = mt::scale(axis, factor) * mt::rotate(_rotate_euler);
      auto new_scale_factor = glm::vec3{
        glm::sqrt(glm::length(s_r[0])),
        glm::sqrt(glm::length(s_r[1])),
        glm::sqrt(glm::length(s_r[2])),
      };
      _scale_factor *= new_scale_factor;
    } else {
      _scale_factor[static_cast<int>(axis)] *= factor;
    }
  }
  enum Mode { LOCAL, WORLD };
  void setMode(Mode mode) { _mode = mode; }
  auto getMode() -> Mode { return _mode; }
  auto refLocation() -> Reval<glm::vec3>& { return _location; }
  auto refRotateEuler() -> Reval<glm::vec3>& { return _rotate_euler; }
  auto refScaleFactor() -> Reval<glm::vec3>& { return _scale_factor; }

private:
  Reval<glm::mat4>*  _model = nullptr;
  Reactor<glm::vec3> _reactor_trans;
  Reactor<glm::mat4> _reactor_split;
  Reval<glm::vec3>   _location = { { 0, 0, 0 } };
  Reval<glm::vec3>   _rotate_euler = { { 0, 0, 0 } };
  Reval<glm::vec3>   _scale_factor = { { 1, 1, 1 } };
  Mode               _mode = WORLD;
};

class Node : public Component, public Asset {
public:
  Node() {
    _controller.setModelTransform(&_to_parent, ModelController::CHANGE_MODEL);
    _reactor_to_world = { [this](auto&&) {
      if (auto parent = _parent.lock()) {
        _to_world = parent->_to_world * _to_parent.get();
      } else {
        _to_world = _to_parent.get();
      }
    } };
    _to_parent.addReactor(&_reactor_to_world, true);
    setRootRecursively(this);
  }
  ~Node() {
    // can ensure _parent is nullptr (otherwise this will not destroyed)
    _to_parent.removeReactor(&_reactor_to_world);
  }
  void attachTo(Node* node) {
    if (!_parent.expired()) {
      detach();
    }
    setParent(node);
    setRootRecursively(node->_root);
  }
  void detach() {
    TOY_ASSERT(!_parent.expired());
    resetParent();
    setRootRecursively(this);
  }
  auto getController() -> ModelController& { return _controller; }
  auto getTransToParent() -> Reval<glm::mat4>& { return _to_parent; }
  auto getTransToWorld() -> Reval<glm::mat4> const& { return _to_world; }
  auto getParent() -> Node* { return _parent.lock().get(); }
  // just allow to get children, not modify
  auto getChildren() -> std::unordered_set<ptr<Node>>& { return _children; }
  auto isRoot() -> bool { return _parent.expired(); }
  auto getRoot() -> Node& { return *_root; }
  void doRecusively(std::function<void(Node*)> const& dealer) {
    dealer(this);
    for (auto& child : _children) {
      child->doRecusively(dealer);
    }
  }

private:
  Reval<glm::mat4>              _to_parent;
  ModelController               _controller;
  Reval<glm::mat4>              _to_world;
  Reactor<glm::mat4>            _reactor_to_world;
  wptr<Node>                    _parent;
  std::unordered_set<ptr<Node>> _children;
  Node*                         _root = nullptr;

  void setParent(Node* parent) {
    resetParent();
    _parent = parent->getPtr();
    parent->_children.insert(getPtr());
    parent->_to_world.addReactor(&_reactor_to_world);
  }
  void resetParent() {
    if (auto parent = _parent.lock()) {
      parent->_to_world.removeReactor(&_reactor_to_world);
      parent->_children.erase(getPtr());
      _parent.reset();
    }
  }
  void setRootRecursively(Node* root) {
    _root = root;
    for (auto& child : _children) {
      child->setRootRecursively(root);
    }
  }

public:
  auto assetSerialize() -> AssetPackager override {
    auto children_data = std::vector<AssetRef>{};
    for (auto& child : _children) {
      children_data.push_back(AssetRef{ child });
    }
    return { std::tuple{ _to_parent.get(), children_data }, Asset::assetSerialize() };
  }
  void assetDeserialize(AssetUnpacker unpacker) override {
    Asset::assetDeserialize(unpacker.extractInherited());
    auto [to_parent, children_data] = unpacker.extract<glm::mat4, std::vector<AssetRef>>();
    _to_parent = to_parent;
    for (auto& child_data : children_data) {
      auto child = child_data.consume<Node>();
      child->attachTo(this);
    }
  }
  REGISTER_ASSET_PATH("node")
};

} // namespace eg
