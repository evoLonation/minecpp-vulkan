module;
#include <engine.h>
#include <toy.h>

export module engine.node;

import engine.assets;
import engine.base;
import std;
import toy;
import framework;
import math;
import glm;
import <imgui_config.h>;

export namespace eg {

class ModelTransform {
public:
  ModelTransform() {
    auto changer = [this](auto&& any) {
      _model = mt::translate(location) * mt::rotate(rotate_euler) * mt::scale(scale_factor);
    };
    _model_observers[0] = toy::Observer{ location, changer };
    _model_observers[1] = toy::Observer{ rotate_euler, changer };
    _model_observers[2] = toy::Observer{ scale_factor, changer, true };
  }
  void translate(glm::vec3 const& delta) {
    if (mode == WORLD) {
      location += delta;
    } else {
      auto r_2 = mt::rotate(rotate_euler) * mt::translate(delta);
      // r_2 = t_new * r_new
      // t_new = t_2[3][0-3], r_new = t_2[0-2][0-2]
      location += glm::vec3{ r_2[3] };
      r_2[3] = glm::vec4{ 0, 0, 0, 1 };
      rotate_euler = mt::getEulerAngle(r_2);
    }
  }
  void translate(mt::Axis axis, float delta) {
    using enum mt::Axis;
    switch (axis) {
    case X:
      translate(glm::vec3{ delta, 0, 0 });
      break;
    case Y:
      translate(glm::vec3{ 0, delta, 0 });
      break;
    case Z:
      translate(glm::vec3{ 0, 0, delta });
      break;
    }
  }
  void rotate(mt::Axis axis, float degree) {
    auto r_new = glm::mat4{};
    if (mode == WORLD) {
      r_new = mt::rotate(axis, degree) * mt::rotate(rotate_euler);
    } else {
      r_new = mt::rotate(rotate_euler) * mt::rotate(axis, degree);
    }
    rotate_euler = mt::getEulerAngle(r_new);
  }
  void rotate(glm::vec3 const& axis, float degree) {
    auto r_new = glm::mat4{};
    if (mode == WORLD) {
      r_new = mt::rotate(axis, degree) * mt::rotate(rotate_euler);
    } else {
      r_new = mt::rotate(rotate_euler) * mt::rotate(axis, degree);
    }
    rotate_euler = mt::getEulerAngle(r_new);
  }
  void scale(glm::vec3 const& factor) {
    using enum mt::Axis;
    if (mode == WORLD) {
      auto s_r = mt::scale(factor) * mt::rotate(rotate_euler);
      auto new_scale_factor = glm::vec3{
        glm::sqrt(glm::length(s_r[0])),
        glm::sqrt(glm::length(s_r[1])),
        glm::sqrt(glm::length(s_r[2])),
      };
      scale_factor *= new_scale_factor;
      s_r[0] = glm::normalize(s_r[0]);
      s_r[1] = glm::normalize(s_r[1]);
      s_r[2] = glm::normalize(s_r[2]);
      rotate_euler = mt::getEulerAngle(s_r);
    } else {
      scale_factor[0] *= factor[0];
      scale_factor[1] *= factor[1];
      scale_factor[2] *= factor[2];
    }
  }
  void scale(mt::Axis axis, float factor) {
    using enum mt::Axis;
    if (mode == WORLD) {
      auto s_r = mt::scale(axis, factor) * mt::rotate(rotate_euler);
      auto new_scale_factor = glm::vec3{
        glm::sqrt(glm::length(s_r[0])),
        glm::sqrt(glm::length(s_r[1])),
        glm::sqrt(glm::length(s_r[2])),
      };
      scale_factor *= new_scale_factor;
    } else {
      scale_factor[static_cast<int>(axis)] *= factor;
    }
  }
  auto get() -> toy::Observable<glm::mat4>& { return _model; }

  toy::Observable<glm::vec3> location = { { 0, 0, 0 } };
  toy::Observable<glm::vec3> rotate_euler = { { 0, 0, 0 } };
  toy::Observable<glm::vec3> scale_factor = { { 1, 1, 1 } };
  enum Mode { LOCAL, WORLD };
  Mode mode = WORLD;

private:
  toy::Observable<glm::mat4>              _model;
  std::array<toy::Observer<glm::vec3>, 3> _model_observers;
};

class Node : public Component, public Asset {
public:
  Node() {
    _root = this;
    setObserver();
  }
  void attachTo(Node* node) {
    if (_parent) {
      detach();
    }
    _parent = node;
    _parent->_children.insert(getPtr());
    _root = node->_root;
    setChildrenRoot();
    setObserver();
  }
  void detach() {
    TOY_ASSERT(_parent);
    _parent->_children.erase(getPtr());
    _parent = nullptr;
    _root = this;
    setChildrenRoot();
    setObserver();
  }
  auto isRoot() -> bool { return !_parent; }
  auto getTransform() -> ModelTransform& { return _transform; }
  auto getTransToParent() -> glm::mat4 const& { return _transform.get(); }
  auto getTransToWorld() -> glm::mat4 const& { return _to_world; }
  auto getParent() -> Node* { return _parent; }
  // just allow to get children, not modify
  auto getChildren() -> std::unordered_set<ptr<Node>>& { return _children; }
  auto getRoot() -> Node& { return *_root; }
  void doRecusively(std::function<void(Node*)> const& dealer) {
    dealer(this);
    for (auto& child : _children) {
      child->doRecusively(dealer);
    }
  }

private:
  ModelTransform                _transform;
  toy::Observable<glm::mat4>    _to_world;
  Node*                         _parent = nullptr;
  Node*                         _root = nullptr;
  std::unordered_set<ptr<Node>> _children;
  toy::Observer<glm::mat4>      _transform_observer;
  toy::Observer<glm::mat4>      _parent_observer;

  void setObserver() {
    if (_parent) {
      auto observer = [this](auto) { _to_world = _parent->_to_world * _transform.get().get(); };
      _parent_observer = toy::Observer{ _parent->_to_world, observer };
      _transform_observer = toy::Observer{ _transform.get(), observer, true };
    } else {
      auto observer = [this](auto) { _to_world = _transform.get().get(); };
      _parent_observer = {};
      _transform_observer = toy::Observer{ _transform.get(), observer, true };
    }
  }
  void setChildrenRoot() {
    for (auto& child : _children) {
      child->_root = _root;
      child->setChildrenRoot();
    }
  }

public:
  auto assetSerialize() -> AssetPackager override {
    auto transform_data = std::tuple{
      _transform.location.get(),
      _transform.rotate_euler.get(),
      _transform.scale_factor.get(),
      _transform.mode,
    };
    auto children_data = std::vector<AssetRef>{};
    for (auto& child : _children) {
      children_data.push_back(AssetRef{ child });
    }
    return { std::tuple_cat(transform_data, std::tuple{ children_data }), Asset::assetSerialize() };
  }
  void assetDeserialize(AssetUnpacker unpacker) override {
    Asset::assetDeserialize(unpacker.extractInherited());
    auto [location, rotate_euler, scale_factor, mode, children_data] =
      unpacker
        .extract<glm::vec3, glm::vec3, glm::vec3, ModelTransform::Mode, std::vector<AssetRef>>();
    _transform.location = location;
    _transform.rotate_euler = rotate_euler;
    _transform.scale_factor = scale_factor;
    _transform.mode = mode;
    for (auto& child_data : children_data) {
      auto child = child_data.consume<Node>();
      child->attachTo(this);
    }
  }
  REGISTER_ASSET_PATH("node")
};

} // namespace eg
