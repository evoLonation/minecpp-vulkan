module;
#include <toy.h>
export module engine.draw_unit;

import engine.base;
import framework;
import math;
import render;
import engine.texture;
import engine.mesh;
import engine.node;
import std;
import toy;

export namespace eg {

struct MaterialInfo {
  float shininess = 16.0f;
};

class DrawUnit {
public:
  DrawUnit() = default;
  DrawUnit(ptr<Mesh> mesh, ptr<Texture> texture, bool up_layer = false) {
    init(std::move(mesh), std::move(texture), up_layer);
  }
  DrawUnit(MeshData mesh_data, glm::vec3 color = { 0.7f, 0.2f, 0.5f }, bool up_layer = false) {
    init(mesh_data, color, up_layer);
  }
  void init(ptr<Mesh> mesh, ptr<Texture> texture, bool up_layer = false) {
    _mesh = std::move(mesh);
    _texture = std::move(texture);
    _up_layer = up_layer;
    afterCreated();
  }
  void init(MeshData mesh_data, glm::vec3 color = { 0.7f, 0.2f, 0.5f }, bool up_layer = false) {
    mesh_data.tex_coords = views::repeat(glm::vec2{ 0, 0 }) |
                           views::take(mesh_data.positions.size()) | ranges::to<std::vector>();
    auto mesh = std::make_shared<Mesh>(mesh_data);
    auto color_a = glm::vec4{ color, 1.0f };
    auto texture = std::make_shared<Texture>(rd::SampledTexture{
      std::as_bytes(std::span{ &color_a, 1 }),
      VK_FORMAT_R32G32B32A32_SFLOAT,
      { 1, 1 },
      false,
      VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
    });
    init(std::move(mesh), std::move(texture), up_layer);
  }
  ~DrawUnit() { beforeDestroy(); }
  auto getTransform() -> glm::mat4 const& {
    TOY_ASSERT(isActive());
    return *_transform;
  }
  auto getMesh() -> Mesh& { return *_mesh; }
  auto getTexture() -> Texture& { return *_texture; }
  auto getMaterial() -> MaterialInfo& { return _material; }
  auto isUpLayer() -> bool { return _up_layer; }
  void setActive(glm::mat4 const* transform) { _transform = transform; }
  void resetActive() { _transform = nullptr; }
  auto isActive() -> bool { return _transform; }

private:
  glm::mat4 const* _transform = nullptr;
  ptr<Mesh>        _mesh;
  ptr<Texture>     _texture;
  MaterialInfo     _material;
  bool             _up_layer = false;

private:
  void afterCreated();
  void beforeDestroy();
};

class DrawUnitObservable : public PROACTIVE_SINGLETON(DrawUnitObservable) {
public:
  void addAfterCreated(toy::Observer<DrawUnit&>* observer) { _after_created.addObserver(observer); }
  void removeAfterCreated(toy::Observer<DrawUnit&>* observer) {
    _after_created.removeObserver(observer);
  }
  void addBeforeDestroy(toy::Observer<DrawUnit&>* observer) {
    _before_destroy.addObserver(observer);
  }
  void removeBeforeDestroy(toy::Observer<DrawUnit&>* observer) {
    _before_destroy.removeObserver(observer);
  }

private:
  friend DrawUnit;
  toy::Observable<DrawUnit&> _after_created;
  toy::Observable<DrawUnit&> _before_destroy;
};

void DrawUnit::afterCreated() { DrawUnitObservable::getInstance()._after_created.notify(*this); }

void DrawUnit::beforeDestroy() { DrawUnitObservable::getInstance()._before_destroy.notify(*this); }

} // namespace eg