module;
#include <toy.h>
export module engine.base.reactive;

import std;
import toy;

namespace eg {

class RevalBase;

// first parameter is input (guarantee not change), second parameter is output
// output maybe nullptr, means not change it
using ErasedComputer =
  std::function<void(std::span<RevalBase* const>, std::span<RevalBase* const>)>;

struct Bind : public std::enable_shared_from_this<Bind> {
  std::vector<RevalBase*> from_revals;
  std::vector<RevalBase*> to_revals;
  ErasedComputer          computer;
  Bind*                   dual = nullptr;

  auto isBidirectional() const -> bool { return dual; }
};

// user must ensure not appear circle graph except for bidirectional bind
class RevalBase {
public:
  RevalBase() = default;
  ~RevalBase();
  void reset();
  void setTrack(bool track) { _track = track; }
  void setName(std::string name) { _name = std::move(name); }
  void update();
  void spread();

  static void bind(std::shared_ptr<Bind> bind);
  static void unbind(std::shared_ptr<Bind> bind);

private:
  // _to_binds contains this at member _from_revals
  // _from_binds contains this at member _to_revals
  std::unordered_set<std::shared_ptr<Bind>> _to_binds;
  std::unordered_set<std::shared_ptr<Bind>> _from_binds;
  Bind*                                     _dirty_bind = nullptr;
  // todo: for debug
  std::string _name;
  bool        _track = false;
};

export class Unbinder {
public:
  Unbinder() = default;
  Unbinder(std::shared_ptr<Bind> bind) : _bind(std::move(bind)) {}
  void unbind() {
    if (_bind.get()) {
      RevalBase::unbind(std::move(_bind));
    }
  }
  ONLY_MOVEABLE(Unbinder);

private:
  std::shared_ptr<Bind> _bind;
};

export class PairUnbinder {
public:
  PairUnbinder() = default;
  PairUnbinder(Unbinder bind1, Unbinder bind2)
    : _unbind1(std::move(bind1)), _unbind2(std::move(bind2)) {}
  void unbind() {
    _unbind1.unbind();
    _unbind2.unbind();
  }

private:
  Unbinder _unbind1;
  Unbinder _unbind2;
};

template <typename T>
class RevalImpl : public RevalBase {
public:
  RevalImpl() = default;
  RevalImpl(T const& v) : RevalImpl() { _value = v; }
  RevalImpl(T&& v) : RevalImpl() { _value = std::move(v); }
  UNCOPYABLE_MOVEABLE(RevalImpl);
  ~RevalImpl() = default;

  auto getWithoutUpdate() -> T const& { return _value; }
  auto get() -> T {
    RevalBase::update();
    return _value;
  }
  void set(T v) {
    _value = std::move(v);
    RevalBase::spread();
  }

  void set(std::invocable<T&> auto f) {
    RevalBase::update();
    auto value = _value;
    f(_value);
    if (value != _value) {
      RevalBase::spread();
    }
  }

  template <typename... Ts>
  auto bind(auto f, RevalImpl<Ts>*... es) -> Unbinder;
  template <typename... Ts>
  auto bindNow(auto f, RevalImpl<Ts>*... es) -> Unbinder {
    auto unbinder = bind(std::move(f), es...);
    (es->RevalBase::update(), ...);
    std::get<0>(std::tuple{ es... })->RevalBase::spread();
    return unbinder;
  }

  auto bindPair(RevalImpl* e) -> PairUnbinder {
    auto unbinder1 = bind([](T const& v) { return v; }, e);
    auto unbinder2 = e->bind([](T const& v) { return v; }, this);
    set(e->get());
    return PairUnbinder{ std::move(unbinder1), std::move(unbinder2) };
  }

private:
  template <typename>
  friend class RevalImpl;
  template <typename InputPack, typename OutputPack>
  friend auto generateComputer(auto f) -> ErasedComputer;

  T _value;
};

template <typename InputPack, typename OutputPack>
auto generateComputer(auto f) -> ErasedComputer {
  auto computer = [f = std::move(f
                   )](std::span<RevalBase* const> input, std::span<RevalBase* const> output) {
    auto input_tuple =
      typename InputPack::template mapTo<std::add_pointer>::template apply<std::tuple>{};
    toy::templateForEach<InputPack::size>([&]<size_t i>() {
      std::get<i>(input_tuple) =
        &static_cast<RevalImpl<typename InputPack::template at<i>>*>(input[i])->_value;
    });
    auto ret = std::apply([&](auto*... args) { return f(*args...); }, input_tuple);
    if constexpr (OutputPack::size == 1) {
      if (output[0]) {
        static_cast<RevalImpl<typename OutputPack::template at<0>>*>(output[0])->_value =
          std::move(ret);
      }
    } else {
      toy::templateForEach<OutputPack::size>([&]<size_t i>() {
        if (output[i]) {
          auto* output_i = static_cast<RevalImpl<typename OutputPack::template at<i>>*>(output[i]);
          output_i->_value = std::move(std::get<i>(ret));
        }
      });
    }
  };
  return computer;
}

template <typename T>
template <typename... Ts>
auto RevalImpl<T>::bind(auto f, RevalImpl<Ts>*... es) -> Unbinder {
  auto computer = generateComputer<toy::TypePack<Ts...>, toy::TypePack<T>>(std::move(f));
  auto bind = std::make_shared<Bind>();
  bind->from_revals = { es... };
  bind->to_revals = { this };
  bind->computer = std::move(computer);
  RevalBase::bind(bind);
  return bind;
}

template <typename... Os>
class MultiBinderImpl {
public:
  MultiBinderImpl(RevalImpl<Os>*... es) : _outputs{ es... } {}
  template <typename... Ts>
  auto bind(auto f, RevalImpl<Ts>*... es) -> Unbinder {
    auto computer = generateComputer<toy::TypePack<Ts...>, toy::TypePack<Os...>>(std::move(f));
    auto bind = std::make_shared<Bind>();
    bind->from_revals = { es... };
    toy::applyIndexSequence<sizeof...(Os)>([&]<size_t... Is>() {
      bind->to_revals = { std::get<Is>(_outputs)... };
    });
    bind->computer = std::move(computer);
    RevalBase::bind(bind);
    return bind;
  }
  template <typename... Ts>
  auto bindNow(auto f, RevalImpl<Ts>*... es) -> Unbinder {
    auto unbinder = bind(std::move(f), es...);
    (es->RevalBase::update(), ...);
    std::get<0>(std::tuple{ es... })->RevalBase::spread();
    return unbinder;
  }
  auto bindPair(RevalImpl<Os>*... es) -> PairUnbinder {
    auto computer = [](Os const&... v) { return std::tuple{ v... }; };
    auto unbinder1 = bind(computer, es...);
    auto unbinder2 =
      std::apply([&](auto* os...) { MultiBinderImpl{ es... }.bind(computer, es...); }, _outputs);
    std::apply([&](auto* os...) { (os->set(es->get()), ...); });
    return PairUnbinder{ std::move(unbinder1), std::move(unbinder2) };
  }

private:
  std::tuple<RevalImpl<Os>*...> _outputs;
};

export template <typename T>
class Reval {
public:
  Reval() = default;
  Reval(T const& v) : _impl{ v } {}
  Reval(T&& v) : _impl{ std::move(v) } {}
  ~Reval() = default;
  UNCOPYABLE_MOVEABLE(Reval);
  void setName(std::string name) { _impl.setName(std::move(name)); }
  void setTrack(bool track) { _impl.setTrack(track); }
  void reset() { _impl.reset(); }
  auto getWithoutUpdate() const -> T const& { return _impl.getWithoutUpdate(); }
  auto get() const -> T { return _impl.get(); }
  operator T() const { return get(); }
  void update() const { _impl.update(); }
  void set(auto&& v) { _impl.set(FORWARD(v)); }
  template <typename... Ts>
  auto bind(auto f, Reval<Ts> const*... es) -> Unbinder {
    return _impl.bind(std::move(f), &es->_impl...);
  }
  template <typename... Ts>
  auto bindNow(auto f, Reval<Ts> const*... es) -> Unbinder {
    return _impl.bindNow(std::move(f), &es->_impl...);
  }
  auto bindPair(Reval* e) -> PairUnbinder { return _impl.bindPair(&e->_impl); }

private:
  template <typename>
  friend class Reval;
  template <typename...>
  friend class MultiBinder;
  mutable RevalImpl<T> _impl;

public:
  /**
   * @brief operator overloads
   */

  auto operator=(T const& v) -> Reval& {
    set(v);
    return *this;
  }
  auto operator=(T&& v) -> Reval& {
    set(FORWARD(v));
    return *this;
  }

  // forward operators
  template <typename S>
    requires(!std::is_same_v<std::remove_cvref_t<S>, Reval>)
  auto operator=(S&& v) -> Reval& {
    set(FORWARD(v));
    return *this;
  }
  auto operator+(auto&& v) -> decltype(auto) { return get() + FORWARD(v); }
  auto operator-(auto&& v) -> decltype(auto) { return get() - FORWARD(v); }
  auto operator*(auto&& v) -> decltype(auto) { return get() * FORWARD(v); }
  auto operator/(auto&& v) -> decltype(auto) { return get() / FORWARD(v); }
  auto operator%(auto&& v) -> decltype(auto) { return get() % FORWARD(v); }
  auto operator&(auto&& v) -> decltype(auto) { return get() & FORWARD(v); }
  auto operator|(auto&& v) -> decltype(auto) { return get() | FORWARD(v); }
  auto operator^(auto&& v) -> decltype(auto) { return get() ^ FORWARD(v); }
  auto operator<<(auto&& v) -> decltype(auto) { return get() << FORWARD(v); }
  auto operator>>(auto&& v) -> decltype(auto) { return get() >> FORWARD(v); }
  auto operator+() -> T { return +get(); }
  auto operator-() -> T { return -get(); }

  auto operator+=(auto&& v) -> Reval& {
    set(get() + FORWARD(v));
    return *this;
  }
  auto operator-=(auto&& v) -> Reval& {
    set(get() - FORWARD(v));
    return *this;
  }
  auto operator*=(auto&& v) -> Reval& {
    set(get() * FORWARD(v));
    return *this;
  }
  auto operator/=(auto&& v) -> Reval& {
    set(get() / FORWARD(v));
    return *this;
  }
  auto operator%=(auto&& v) -> Reval& {
    set(get() % FORWARD(v));
    return *this;
  }
  auto operator&=(auto&& v) -> Reval& {
    set(get() & FORWARD(v));
    return *this;
  }
  auto operator|=(auto&& v) -> Reval& {
    set(get() | FORWARD(v));
    return *this;
  }
  auto operator^=(auto&& v) -> Reval& {
    set(get() ^ FORWARD(v));
    return *this;
  }
  auto operator<<=(auto&& v) -> Reval& {
    set(get() << FORWARD(v));
    return *this;
  }
  auto operator>>=(auto&& v) -> Reval& {
    set(get() >> FORWARD(v));
    return *this;
  }
  auto operator++() -> Reval& {
    set(get() + 1);
    return *this;
  }
  auto operator--() -> Reval& {
    set(get() - 1);
    return *this;
  }
  auto operator++(int) -> T {
    T v = get();
    ++(*this);
    return v;
  }
  auto operator--(int) -> T {
    T v = get();
    --(*this);
    return v;
  }

  auto operator==(Reval const& e) const -> bool { return get() == e.get(); }
  template <typename S>
    requires(!std::derived_from<std::remove_cvref_t<S>, Reval>)
  auto operator==(S&& e) const -> bool {
    return get() == FORWARD(e);
  }
};

export template <typename... Os>
class MultiBinder {
public:
  MultiBinder(Reval<Os>*... es) : _impl{ &es->_impl... } {}
  template <typename... Ts>
  auto bind(auto f, Reval<Ts> const*... es) -> Unbinder {
    return _impl.bind(std::move(f), &es->_impl...);
  }
  template <typename... Ts>
  auto bindNow(auto f, Reval<Ts> const*... es) -> Unbinder {
    return _impl.bindNow(std::move(f), &es->_impl...);
  }
  auto bindPair(Reval<Os>*... es) -> PairUnbinder { return _impl.bindPair(&es->_impl...); }

private:
  MultiBinderImpl<Os...> _impl;
};

} // namespace eg
