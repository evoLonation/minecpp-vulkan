module;
#include <toy.h>
export module engine.base;

import framework;
import std;
import toy;

export import engine.base.reactive;

export namespace eg {

template <typename T>
using ptr = std::shared_ptr<T>;
template <typename T>
using uptr = std::unique_ptr<T>;
template <typename T>
using wptr = std::weak_ptr<T>;

template <typename T>
struct EnableGetPtr : public std::enable_shared_from_this<T> {
  auto getPtr() { return std::static_pointer_cast<T>(this->shared_from_this()); }

private:
  using std::enable_shared_from_this<T>::shared_from_this;
};

} // namespace eg
