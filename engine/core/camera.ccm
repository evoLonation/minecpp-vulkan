module;
#include "toy.h"
export module engine.camera;

import engine.base;
import std;
import toy;
import framework;
import math;
import render;
import <vulkan_config.h>;

export namespace eg {

class Camera : public fw::Action, public PROACTIVE_SINGLETON(Camera) {
public:
  Camera();

  void runLoop(fw::ActionContext const& ctx) override;

  auto getView() const -> Reval<glm::mat4> const& { return _view; }
  auto getProj() const -> Reval<glm::mat4> const& { return _proj; }
  auto getViewPos() const -> Reval<glm::vec3> const& { return _view_pos; }
  auto getProjIV() const -> Reval<glm::mat4> const& { return _proj_iv; }

  void move(glm::vec3 moved);

  void rotate_right(float degree);
  void rotate_up(float degree);

private:
  Reval<glm::mat4> _view;
  Reval<glm::mat4> _proj;
  Reval<glm::mat4> _proj_iv; // proj inverse
  // 1. translate -_view_pos
  // 2. rotate _rotate_z by z axis
  // 3. rotate _rotate_y by y axis
  Reval<glm::vec3> _view_pos = glm::vec3{ 5.0f, .0f, .0f };
  Reval<float>     _rotate_z = 180.0f;
  Reval<float>     _rotate_y = 0.0f;

  void updateView();
  void updateProj();
};

class CameraController : public fw::Action {
public:
  CameraController(Camera* camera);

  void runLoop(fw::ActionContext const& ctx) override;

private:
  Camera* _camera;

  float _move_speed = 3.0f;
  float _rotate_speed = 0.2f;
};

} // namespace eg