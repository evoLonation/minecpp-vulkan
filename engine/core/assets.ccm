module;
#include <toy.h>
export module engine.assets;

import toy.persistent;
import std;
import toy;

export namespace eg {

class Guid {
public:
  Guid() = default;
  Guid(std::string const& guid) : _guid(guid) {}
  auto get() const -> std::string const& { return _guid; }
  auto valid() const -> bool { return !_guid.empty(); }
  void clear() { _guid.clear(); }

  static auto generate() -> Guid { return Guid{ generateHex(16) }; }
  friend auto operator==(Guid const& lhs, Guid const& rhs) -> bool {
    return lhs._guid == rhs._guid;
  }

private:
  static auto randomChar() -> unsigned char {
    std::random_device              rd;
    std::mt19937                    gen(rd());
    std::uniform_int_distribution<> dis(0, 255);
    return static_cast<unsigned char>(dis(gen));
  }

  static auto generateHex(const unsigned int len) -> std::string {
    std::stringstream ss;
    for (auto i = 0; i < len; i++) {
      auto              rc = randomChar();
      std::stringstream hexstream;
      hexstream << std::hex << int(rc);
      auto hex = hexstream.str();
      ss << (hex.length() < 2 ? '0' + hex : hex);
    }
    return ss.str();
  }

  std::string _guid;

  friend class GuidSerializer;
};

struct GuidHasher {
  size_t operator()(const Guid& x) const { return std::hash<std::string>{}(x.get()); }
};

struct GuidSerializer : toy::CustomSerializer<
                          Guid,
                          [](std::string a) { return Guid{ std::move(a) }; },
                          toy::MemberSerializerInfo{ &Guid::_guid }> {};

template <typename T>
concept Assetable = std::derived_from<T, class Asset> && std::is_default_constructible_v<T> &&
                    std::same_as<decltype(T::asset_path), fs::path>;

// std::function is not move only, so we need to wrap it to accept move only lambda
class MoveOnlyFunctionBase {
public:
  MoveOnlyFunctionBase() = default;
  virtual void operator()(toy::Pickle&) const = 0;
  virtual ~MoveOnlyFunctionBase() = default;
  ONLY_MOVEABLE(MoveOnlyFunctionBase);
};

template <typename T>
class MoveOnlyFunctionImpl : public MoveOnlyFunctionBase {
public:
  MoveOnlyFunctionImpl(T lambda) : lambda{ std::move(lambda) } {}
  void operator()(toy::Pickle& pickle) const override { lambda(pickle); }

private:
  T lambda;
};

class AssetPackager {
private:
  template <typename... Args>
  AssetPackager(uint32 id, std::tuple<Args...> package, std::optional<AssetPackager> inherited) {
    auto lambda =
      [id, package = std::move(package), inherited = std::move(inherited)](toy::Pickle& pickle) {
        pickle.push(package);
        pickle.push(std::string{ typeid(package).name() });
        pickle.push(id);
        if (inherited) {
          inherited->pushToPickle(pickle);
        }
      };
    _push_func = std::make_unique<MoveOnlyFunctionImpl<decltype(lambda)>>(std::move(lambda));
  }

  friend class Asset;
  template <typename... Args>
  AssetPackager(std::tuple<Args...> package)
    : AssetPackager{ 0, std::move(package), std::nullopt } {}

  friend class AssetManager;
  void pushToPickle(toy::Pickle& pickle) const { (*_push_func)(pickle); }

public:
  template <typename... Args>
  AssetPackager(std::tuple<Args...> package, AssetPackager inherited)
    : AssetPackager{ 0, std::move(package), std::move(inherited) } {}
  template <typename... Args>
  AssetPackager(uint32 id, std::tuple<Args...> package, AssetPackager inherited)
    : AssetPackager{ id, std::move(package), std::optional{ std::move(inherited) } } {}

  ONLY_MOVEABLE(AssetPackager);

private:
  std::unique_ptr<MoveOnlyFunctionBase> _push_func;
};

/**
 * @brief must first extractInherited, then extract
 *
 */
class AssetUnpacker {
public:
  AssetUnpacker(toy::Pickle* pickle) : _pickle{ pickle } {}
  auto getId() -> uint32 {
    if (_id) {
      return *_id;
    }
    _id = _pickle->pop<uint32>();
    return *_id;
  }
  template <typename... Args>
  auto extract() -> std::tuple<Args...> {
    toy::throwf(_extracted_inherited, "Must call extractInherited() first");
    if (!_id) {
      TOY_ASSERT(_pickle->pop<uint32>() == 0);
    }
    auto type_name = _pickle->pop<std::string>();
    TOY_ASSERT(
      type_name == typeid(std::tuple<Args...>).name(), type_name, typeid(std::tuple<Args...>).name()
    );
    return _pickle->pop<std::tuple<Args...>>();
  }
  auto extractInherited() -> AssetUnpacker {
    _extracted_inherited = true;
    return AssetUnpacker{ _pickle };
  }

  ONLY_MOVEABLE(AssetUnpacker);

private:
  toy::Pickle*          _pickle;
  bool                  _extracted_inherited = false;
  std::optional<uint32> _id;
};

/**
 * @brief Must be *ONLY ONE Asset* in the (indirect) base classes of ANY class
 * Can ensure @ref assetDeserialize only called after default construct
 */
class Asset {
public:
  Asset() = default;
  // lazy load
  auto getAssetGuid() const -> Guid const& {
    if (!_guid.valid()) {
      generateGuid();
    }
    return _guid;
  }
  void setAssetName(std::string name) { _name = std::move(name); }
  auto getAssetName() const -> std::string const& { return _name; }

  UNCOPYABLE_MOVEABLE(Asset);

  virtual auto assetSerialize() -> AssetPackager {
    return AssetPackager{ std::tuple{ getAssetGuid().get(), getAssetName() } };
  }
  virtual void assetDeserialize(AssetUnpacker unpacker) {
    // a empty extractInherited to avoid error
    unpacker.extractInherited();
    auto [guid, name] = unpacker.extract<std::string, std::string>();
    _guid = std::move(guid);
    _name = std::move(name);
  }

  virtual auto getAssetPath() -> fs::path = 0;

private:
  friend class AssetManager;
  Asset(Guid guid, std::string name) : _guid{ std::move(guid) }, _name{ std::move(name) } {}
  void generateGuid() const { _guid = Guid::generate(); }
  void clear() {
    _guid.clear();
    _name.clear();
  }

  Guid mutable _guid;
  std::string _name;
};

class AssetRef {
public:
  AssetRef() = default;
  AssetRef(std::shared_ptr<Asset> asset) : _asset{ std::move(asset) } {}
  auto consume() -> std::shared_ptr<Asset> { return std::move(_asset); }
  template <typename T>
  auto consume() -> std::shared_ptr<T> {
    return std::static_pointer_cast<T>(consume());
  }

private:
  friend struct AssetRefSerializer;
  std::shared_ptr<Asset> _asset;
};

class AssetManager : public PROACTIVE_SINGLETON(AssetManager) {
public:
  AssetManager(
    std::unordered_map<fs::path, std::function<std::shared_ptr<Asset>()>> default_asset_map
  ) {
    _default_asset_map = std::move(default_asset_map);
    if (!fs::exists(_root_dir)) {
      fs::create_directories(_root_dir);
    }
    loadAssetPaths();
  }
  ONLY_MOVEABLE(AssetManager);
  ~AssetManager() {
    saveAssetPaths();
    for (auto const& asset_dir : _named_asset_map | views::keys) {
      saveNamedAssets(asset_dir);
    }
  }

  void save(std::shared_ptr<Asset> t) {
    auto guid = t->getAssetGuid();
    bool is_outest_call = _saving_already_saved.empty();
    if (_saving_already_saved.contains(guid)) {
      return;
    }
    _saving_already_saved.insert(guid);
    auto name = t->getAssetName();
    auto asset_dir = t->getAssetPath();
    _asset_path_map[guid] = asset_dir;
    _assets[asset_dir][guid] = t;
    if (!name.empty()) {
      if (!_named_asset_map.contains(asset_dir)) {
        loadNamedAssets(asset_dir);
      }
      toy::throwf(
        !_named_asset_map[asset_dir].contains(name), "Asset name {} already exists", name
      );
      _named_asset_map[asset_dir][name] = guid;
    }
    auto pickle = toy::Pickle{};
    auto packer = t->assetSerialize();
    packer.pushToPickle(pickle);
    auto path = _root_dir / asset_dir / (guid.get() + ".asset");
    if (auto parent_dir = path.parent_path(); !fs::exists(parent_dir)) {
      fs::create_directories(parent_dir);
    }
    pickle.dump(path);
    if (is_outest_call) {
      _saving_already_saved.clear();
    }
  }

  void save(std::shared_ptr<Asset> t, std::string name) {
    t->setAssetName(std::move(name));
    save(t);
  }

  auto load(Guid const& guid) -> std::shared_ptr<Asset> {
    auto  asset = getDefaultAssetByPath(_asset_path_map.at(guid));
    auto  asset_dir = asset->getAssetPath();
    auto& assets = _assets[asset_dir];
    if (auto it = assets.find(guid); it != assets.end() && !it->second.expired()) {
      return it->second.lock();
    }
    auto pickle = toy::Pickle{ _root_dir / asset_dir / (guid.get() + ".asset") };
    asset->assetDeserialize(AssetUnpacker{ &pickle });
    assets[guid] = asset;
    return asset;
  }

  template <Assetable T>
  auto load(Guid const& guid) -> std::shared_ptr<T> {
    return std::static_pointer_cast<T>(load(guid));
  }

  template <Assetable T>
  auto load(std::string const& name) -> std::shared_ptr<T> {
    auto path = T::asset_path;
    if (!_named_asset_map.contains(path)) {
      loadNamedAssets(path);
    }
    auto guid = _named_asset_map[path].at(name);
    return load<T>(guid);
  }

  template <Assetable T>
  auto getAssetNames() -> std::vector<std::string> {
    auto path = T::asset_path;
    if (!_named_asset_map.contains(path)) {
      loadNamedAssets(path);
    }
    return _named_asset_map[path] | views::keys | ranges::to<std::vector>();
  }
  /**
   * @brief clear all asset files of T, if has asset already in memory, reset its asset info
   */
  template <Assetable T>
  auto clearAssets() {
    auto path = T::asset_path;
    for (auto iter = _asset_path_map.begin(); iter != _asset_path_map.end();) {
      if (iter->second == path) {
        iter = _asset_path_map.erase(iter);
      } else {
        ++iter;
      }
    }
    for (auto& [guid, asset] : _assets[path]) {
      if (!asset.expired()) {
        asset.lock()->clear();
      }
    }
    _assets.erase(path);
    _named_asset_map.erase(path);
    fs::remove_all(_root_dir / path);
  }

private:
  void loadNamedAssets(fs::path const& asset_dir) {
    auto filepath = _root_dir / asset_dir / _named_assets_file;
    if (!fs::exists(filepath)) {
      return;
    }
    auto named_assets =
      json::Json::parse(std::ifstream{ _root_dir / asset_dir / _named_assets_file });
    for (auto const& [name, guid] : named_assets.to<json::Object>()) {
      _named_asset_map[asset_dir][name] = Guid{ guid.to<std::string>() };
    }
  }
  void saveNamedAssets(fs::path const& asset_dir) {
    auto filepath = _root_dir / asset_dir / _named_assets_file;
    if (auto parent_dir = filepath.parent_path(); !fs::exists(parent_dir)) {
      fs::create_directories(parent_dir);
    }
    auto named_assets = json::Object{};
    for (auto const& [name, guid] : _named_asset_map[asset_dir]) {
      named_assets[name] = guid.get();
    }
    std::ofstream ofs{ filepath };
    ofs << json::Json{ named_assets }.dump();
  }

  void loadAssetPaths() {
    auto filepath = _root_dir / _asset_path_file;
    if (!fs::exists(filepath)) {
      return;
    }
    auto asset_paths = json::Json::parse(std::ifstream{ filepath });
    for (auto& [path, guids] : asset_paths.to<json::Object>()) {
      for (auto& guid : guids.to<json::List>()) {
        _asset_path_map[Guid{ guid.to<json::String>() }] = fs::path{ path };
      }
    }
  }
  void saveAssetPaths() {
    auto filepath = _root_dir / _asset_path_file;
    if (auto parent_dir = filepath.parent_path(); !fs::exists(parent_dir)) {
      fs::create_directories(parent_dir);
    }
    auto asset_paths = std::unordered_map<std::string, std::vector<std::string>>{};
    for (auto& [guid, path] : _asset_path_map) {
      asset_paths[path.string()].push_back(guid.get());
    }
    auto json = json::Json{};
    for (auto& [path, guids] : asset_paths) {
      auto guids_json = json::List{};
      for (auto& guid : guids) {
        guids_json.push_back(guid);
      }
      json[path] = guids_json;
    }
    std::ofstream ofs{ filepath };
    ofs << json.dump();
  }

  auto getDefaultAssetByPath(fs::path const& path) -> std::shared_ptr<Asset> {
    toy::throwf(_default_asset_map.contains(path), "No default asset for path {}", path.string());
    return _default_asset_map[path]();
  }

  std::unordered_map<Guid, fs::path, GuidHasher>                      _asset_path_map;
  std::unordered_map<fs::path, std::unordered_map<std::string, Guid>> _named_asset_map;
  std::unordered_map<fs::path, std::unordered_map<Guid, std::weak_ptr<Asset>, GuidHasher>> _assets;
  // since the existance of AssetRef, a save() call maybe recusively call save(), so need avoid
  // saving one asset multiple times in one save() call
  std::unordered_set<Guid, GuidHasher> _saving_already_saved;

  std::unordered_map<fs::path, std::function<std::shared_ptr<Asset>()>> _default_asset_map;

  static inline fs::path _root_dir = "assets";
  static inline fs::path _asset_path_file = "asset_path.json";
  static inline fs::path _named_assets_file = "named_assets.json";
};

struct AssetRefSerializer {
  static void serialize(toy::Pickle& pickle, AssetRef const& t) {
    auto& manager = AssetManager::getInstance();
    manager.save(t._asset);
    pickle.push(t._asset->getAssetGuid(), GuidSerializer{});
  }
  static auto deserialize(toy::Pickle& pickle) -> AssetRef {
    auto& manager = AssetManager::getInstance();
    auto  guid = pickle.pop<Guid, GuidSerializer>();
    return AssetRef{ manager.load(guid) };
  }
};

} // namespace eg

template <>
struct toy::DefaultSerializerS<eg::AssetRef> {
  using type = eg::AssetRefSerializer;
};