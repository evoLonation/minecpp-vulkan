module;
#include <toy.h>
export module engine.base.reactive2;

import std;
import toy;

namespace eg {

using Computer = std::function<void(bool track)>;

class RevalBase {
private:
  template <typename>
  friend class RevalImpl;

  // dependencies: parents, dependents: childs
  mutable std::unordered_map<std::unique_ptr<Computer>, std::vector<RevalBase*>> _computers;
  mutable std::unordered_map<RevalBase*, Computer*>                              _dependencies;
  mutable std::unordered_set<RevalBase*>                                         _dependents;
  // the computer that will be called to update the value
  mutable Computer* _dirty_computer = nullptr;
  // use to avoid circle
  mutable bool _avoid_circle = false;

  // todo: for debug
  std::string _name;
  bool        _track = false;
};

export class Unbinder {
public:
  Unbinder() = default;
  ONLY_MOVEABLE(Unbinder);

private:
  template <typename>
  friend class RevalImpl;
  Unbinder(Computer* handle) : _handle(handle) {}
  toy::PtrManager<Computer*> _handle;
};

export class PairUnbinder : public Unbinder {
public:
  PairUnbinder() = default;
  PairUnbinder(Unbinder unbinder) : Unbinder(std::move(unbinder)) {}
  ONLY_MOVEABLE(PairUnbinder);
};

export template <typename T>
class RevalImpl : public RevalBase {
public:
  RevalImpl() { _name = std::string{ "Reval<" } + typeid(T).name() + ">"; }
  RevalImpl(T const& v) : RevalImpl() { _value = v; }
  RevalImpl(T&& v) : RevalImpl() { _value = std::move(v); }
  UNCOPYABLE_MOVEABLE(RevalImpl);
  ~RevalImpl() {
    for (auto* dependency : _dependencies | views::keys) {
      dependency->_dependents.erase(this);
    }
    for (auto* dependent : _dependents) {
      auto iter = dependent->_dependencies.find(this);
      TOY_ASSERT(iter != dependent->_dependencies.end());
      if (dependent->_dirty_computer == iter->second) {
        dependent->_dirty_computer = nullptr;
      }
      dependent->_dependencies.erase(iter);
      auto temp = std::unique_ptr<Computer>(iter->second);
      dependent->_computers.erase(temp);
      temp.release();
    }
  }
  void setName(std::string name) { _name = std::move(name); }
  void setTrack(bool track) { _track = track; }
  auto getWithoutUpdate() -> T const& { return _value; }
  auto get() -> T const& {
    update();
    return _value;
  }
  void update() {
    if (_track) {
      toy::debugf("start update {}", _name);
    }
    compute(_track);
    // after compute, some circle dep maybe need to reform, so need to call setDirty()
    // simple example: a->b and b->a, after a.compute(), need form b->a by setDirty()
    setDirty();
  }

  void set(T v) {
    if (_dirty_computer == nullptr && _value == v) {
      return;
    }
    _value = std::move(v);
    _dirty_computer = nullptr;
    setDirty();
  }

  void set(std::invocable<T&> auto f) {
    update();
    f(_value);
    // already setDirty() in update, so no need to call setDirty() again
    // setDirty();
  }

private:
  template <typename>
  friend class RevalImpl;
  void compute(bool track) {
    if (_dirty_computer) {
      auto& computer = *_dirty_computer;
      _dirty_computer = nullptr;
      computer(track);
    }
  }
  template <typename... Ts>
  auto generateComputer(
    std::invocable<std::type_identity_t<Ts> const&...> auto f, RevalImpl<Ts>*... es
  ) -> Computer {
    auto computer = [this, f = std::move(f), es...](bool track) {
      if (track) {
        toy::debugf(
          "compute {}: before value {}, first compute {}",
          _name,
          _value,
          std::vector{ es->_name... }
        );
      }
      (es->compute(track), ...);
      _value = (f(es->_value...));
      if (track) {
        toy::debugf("compute {}: after value {}", _name, _value);
      }
    };
    return computer;
  }

  /**
   * @brief traverse the dependency graph up to down and set dirty_computer to all dependent nodes
   *
   */
  void setDirty() {
    if (_track) {
      toy::debugf("set dirty {}", _name);
    }
    // bfs
    auto dirtys = std::vector<RevalBase*>{};
    auto queue = std::queue<RevalBase*>{};
    queue.push(this);
    while (!queue.empty()) {
      auto e = queue.front();
      queue.pop();
      for (auto d : e->_dependents) {
        if (d->_avoid_circle) {
          continue;
        }
        auto computer = d->_dependencies[e];
        auto temp = std::unique_ptr<Computer>(computer);
        auto deps = d->_computers.at(temp);
        temp.release();
        if (_track) {
          toy::debugf(
            "{} <- {}", deps | views::transform([](auto* d) { return d->_name; }), d->_name
          );
        }
        for (auto dep : deps) {
          dep->_avoid_circle = true;
          dirtys.push_back(dep);
        }
        d->_dirty_computer = computer;
        queue.push(d);
      }
    }
    for (auto d : dirtys) {
      d->_avoid_circle = false;
    }
  }
  /**
   * @param immediate : if false, _dirty_computer is not changed, so the dependency only builded
   * after next change on es
   */
  auto bindImpl(Computer computer, std::vector<RevalBase*> es, bool immediate) -> Computer* {
    TOY_ASSERT(ranges::all_of(es, [this](auto e) { return e != this; }));
    TOY_ASSERT(ranges::all_of(es, [this](auto e) { return !_dependencies.contains(e); }));
    auto [iter, _] =
      _computers.emplace(std::make_unique<Computer>(std::move(computer)), std::move(es));
    auto* p = iter->first.get();
    auto& es_vec = iter->second;
    for (auto e : es_vec) {
      e->_dependents.insert(this);
      _dependencies.insert({ e, p });
    }
    if (!immediate) {
      return p;
    }
    // may form a circle, so need to cut circle
    _dirty_computer = p;
    // down to up to set all node _avoid_circle = true and then call setDirty()
    // and try to find if some node._dirty_computer contains dirty node this and set it
    // to nullptr to cut circle
    auto queue = std::queue<RevalBase*>{};
    queue.push(this);
    auto dirtys = std::vector<RevalBase*>{};
    while (!queue.empty()) {
      auto e = queue.front();
      TOY_ASSERT(e->_avoid_circle == false);
      e->_avoid_circle = true;
      dirtys.push_back(e);
      queue.pop();
      if (e->_dirty_computer) {
        auto temp = std::unique_ptr<Computer>(e->_dirty_computer);
        auto dependencies = e->_computers.at(temp);
        temp.release();
        if (ranges::all_of(dependencies, [](auto d) { return !d->_avoid_circle; })) {
          queue.push_range(dependencies);
        } else {
          e->_dirty_computer = nullptr;
        }
      }
    }
    setDirty();
    for (auto d : dirtys) {
      d->_avoid_circle = false;
    }

    return p;
  }

public:
  template <typename... Ts>
  auto bind(
    std::invocable<std::type_identity_t<Ts> const&...> auto f, bool immediate, RevalImpl<Ts>*... es
  ) -> Unbinder {
    return bindImpl(
      generateComputer(std::move(f), es...), std::vector<RevalBase*>{ es... }, immediate
    );
  }

  template <typename T2>
  auto bind(
    RevalImpl<T2>* e, std::invocable<std::type_identity_t<T2> const&> auto f, bool immediate
  ) -> Unbinder {
    return bind(std::move(f), immediate, e);
  }
  void unbind(Unbinder unbinder) {
    auto computer = unbinder._handle.get();
    if (!computer) {
      return;
    }
    auto temp = std::unique_ptr<Computer>(computer);
    auto iter = _computers.find(temp);
    temp.release();
    if (iter == _computers.end()) {
      return;
    }
    for (auto* reval : iter->second) {
      reval->_dependents.erase(this);
      _dependencies.erase(reval);
    }
    if (_dirty_computer == computer) {
      _dirty_computer = nullptr;
    }
    _computers.erase(iter);
  }
  auto bindPair(RevalImpl* reval) -> PairUnbinder {
    auto computer = [](T const& v) { return v; };
    auto unbinder1 = bind(reval, computer, true);
    reval->bind(this, computer, false);
    // form a circle, can ensure after reval->compute(), reval._value is not change and this._value
    // = reval._value
    // auto v_old = reval->_value;
    // reval->compute();
    // auto v_new = reval->_value;
    // TOY_ASSERT(v_old == v_new);
    // TOY_ASSERT(_value == v_new);
    return PairUnbinder{ std::move(unbinder1) };
  }
  auto unbind(PairUnbinder unbinder) {
    auto computer = unbinder._handle.get();
    if (!computer) {
      return;
    }
    auto temp = std::unique_ptr<Computer>(computer);
    auto iter = _computers.find(temp);
    temp.release();
    if (iter == _computers.end()) {
      return;
    }
    TOY_ASSERT(iter->second.size() == 1);
    // remove reval
    auto* reval = iter->second.front();
    reval->_dependents.erase(this);
    auto* reval_computer = reval->_dependencies[this];
    reval->_dependencies.erase(this);
    temp.reset(reval_computer);
    reval->_computers.erase(temp);
    temp.release();
    if (reval->_dirty_computer == reval_computer) {
      reval->_dirty_computer = nullptr;
    }

    // remove this
    _dependencies.erase(reval);
    _dependents.erase(reval);
    _computers.erase(iter);
    if (_dirty_computer == computer) {
      _dirty_computer = nullptr;
    }
  }

private:
  T _value;
};

export template <typename T>
class Reval {
public:
  Reval() = default;
  Reval(T const& v) : _impl{ v } {}
  Reval(T&& v) : _impl{ std::move(v) } {}
  ~Reval() = default;
  UNCOPYABLE_MOVEABLE(Reval);
  void setName(std::string name) { _impl.setName(std::move(name)); }
  void setTrack(bool track) { _impl.setTrack(track); }
  auto getWithoutUpdate() const -> T const& { return _impl.getWithoutUpdate(); }
  auto get() const -> T const& { return _impl.get(); }
  operator T const&() const { return get(); }
  void update() const { _impl.update(); }
  void set(T v) { _impl.set(v); }
  void set(std::invocable<T&> auto f) { _impl.set(f); }

  template <typename>
  friend class Reval;
  template <typename... Ts>
  auto bind(std::invocable<std::type_identity_t<Ts> const&...> auto f, Reval<Ts> const*... es)
    -> Unbinder {
    return _impl.bind(std::move(f), true, &es->_impl...);
  }
  template <typename... Ts>
  auto bindDelay(
    std::invocable<std::type_identity_t<Ts> const&...> auto f, Reval<Ts> const*... es
  ) {
    return _impl.bind(std::move(f), false, &es->_impl...);
  }

  template <typename T2>
  auto bind(Reval<T2> const* e, std::invocable<std::type_identity_t<T2> const&> auto f)
    -> Unbinder {
    return _impl.bind(&e->_impl, std::move(f), true);
  }
  template <typename T2>
  auto bindDelay(Reval<T2> const* e, std::invocable<std::type_identity_t<T2> const&> auto f)
    -> Unbinder {
    return _impl.bind(&e->_impl, std::move(f), false);
  }

  void unbind(Unbinder unbinder) { _impl.unbind(std::move(unbinder)); }

  auto bindPair(Reval* e) -> PairUnbinder { return _impl.bindPair(&e->_impl); }
  void unbind(PairUnbinder unbinder) { _impl.unbind(std::move(unbinder)); }

  /**
   * @brief operator overloads
   */

  auto operator=(T const& v) -> Reval& {
    set(v);
    return *this;
  }
  auto operator=(T&& v) -> Reval& {
    set(std::move(v));
    return *this;
  }

  // forward operators
  template <typename S>
    requires(!std::is_same_v<std::remove_cvref_t<S>, Reval>)
  auto operator=(S&& v) -> Reval& {
    set(FORWARD(v));
    return *this;
  }
  auto operator+(auto&& v) -> decltype(auto) { return get() + FORWARD(v); }
  auto operator-(auto&& v) -> decltype(auto) { return get() - FORWARD(v); }
  auto operator*(auto&& v) -> decltype(auto) { return get() * FORWARD(v); }
  auto operator/(auto&& v) -> decltype(auto) { return get() / FORWARD(v); }
  auto operator%(auto&& v) -> decltype(auto) { return get() % FORWARD(v); }
  auto operator&(auto&& v) -> decltype(auto) { return get() & FORWARD(v); }
  auto operator|(auto&& v) -> decltype(auto) { return get() | FORWARD(v); }
  auto operator^(auto&& v) -> decltype(auto) { return get() ^ FORWARD(v); }
  auto operator<<(auto&& v) -> decltype(auto) { return get() << FORWARD(v); }
  auto operator>>(auto&& v) -> decltype(auto) { return get() >> FORWARD(v); }
  auto operator+() -> T { return +get(); }
  auto operator-() -> T { return -get(); }

  auto operator+=(auto&& v) -> Reval& {
    set(get() + FORWARD(v));
    return *this;
  }
  auto operator-=(auto&& v) -> Reval& {
    set(get() - FORWARD(v));
    return *this;
  }
  auto operator*=(auto&& v) -> Reval& {
    set(get() * FORWARD(v));
    return *this;
  }
  auto operator/=(auto&& v) -> Reval& {
    set(get() / FORWARD(v));
    return *this;
  }
  auto operator%=(auto&& v) -> Reval& {
    set(get() % FORWARD(v));
    return *this;
  }
  auto operator&=(auto&& v) -> Reval& {
    set(get() & FORWARD(v));
    return *this;
  }
  auto operator|=(auto&& v) -> Reval& {
    set(get() | FORWARD(v));
    return *this;
  }
  auto operator^=(auto&& v) -> Reval& {
    set(get() ^ FORWARD(v));
    return *this;
  }
  auto operator<<=(auto&& v) -> Reval& {
    set(get() << FORWARD(v));
    return *this;
  }
  auto operator>>=(auto&& v) -> Reval& {
    set(get() >> FORWARD(v));
    return *this;
  }
  auto operator++() -> Reval& {
    set(get() + 1);
    return *this;
  }
  auto operator--() -> Reval& {
    set(get() - 1);
    return *this;
  }
  auto operator++(int) -> T {
    T v = get();
    ++(*this);
    return v;
  }
  auto operator--(int) -> T {
    T v = get();
    --(*this);
    return v;
  }

  auto operator==(Reval const& e) const -> bool { return get() == e.get(); }
  template <typename S>
    requires(!std::derived_from<std::remove_cvref_t<S>, Reval>)
  auto operator==(S&& e) const -> bool {
    return get() == FORWARD(e);
  }

private:
  mutable RevalImpl<T> _impl;
};

} // namespace eg
