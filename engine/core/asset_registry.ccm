module;
#include <toy.h>
export module engine.asset.registry;

import engine.mesh;
import engine.texture;
import engine.node;
import engine.object;
import engine.asset;
import std;
import toy;

#define REGISTER_ASSET(cls) { cls::asset_id, []() { return std::make_shared<cls>(); } }
#define REGISTER_ASSET_MEMBER(cls) { cls::asset_id, []() { return std::make_unique<cls>(); } }

namespace eg {

/**
 * @brief NOTE: Every final class must registered here
 * if D -> B, B is registered but D is not, loading to D will bug
 */

export std::unordered_map<fs::path, std::function<std::shared_ptr<Asset>()>> default_asset_map = {
  REGISTER_ASSET(Mesh),
  REGISTER_ASSET(Texture),
  REGISTER_ASSET(Node),
  REGISTER_ASSET(SceneObject),
};

export std::unordered_map<fs::path, std::function<std::unique_ptr<Asset>()>>
  default_asset_member_map = {
    REGISTER_ASSET_MEMBER(LightUnit),
  };

} // namespace eg
