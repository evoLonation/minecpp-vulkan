module;
#include <toy.h>
export module engine.package;

import std;
import toy;

export namespace eg {

class FileStream : public toy::OutputStream, public toy::InputStream {
public:
  FileStream() = default;
  FileStream(std::fstream* fs) : _fs(fs) {}
  void readBytes(std::span<std::byte> b) override {
    _fs->read(reinterpret_cast<char*>(b.data()), b.size());
    TOY_ASSERT(_fs->gcount() == b.size(), _fs->gcount(), b.size());
  }
  void writeBytes(std::span<std::byte const> b) override {
    _fs->write(reinterpret_cast<char const*>(b.data()), b.size());
  }

private:
  std::fstream* _fs;
};

/**
 * @brief
 * Call setCurrent() to start a read or write, user can only choice one between read and write util done.
 * Any function call excepted write and read will make ptr undefined.
 * After write, user can call releaseTail() to release tail pages.
 */
class LinkedFile : public toy::OutputStream, public toy::InputStream {
public:
  using PageNumber = uint32;
  using MagicNumber = uint32;

  UNCOPYABLE_MOVEABLE(LinkedFile);
  LinkedFile(fs::path const& path);

  void readBytes(std::span<std::byte> b) override;
  void writeBytes(std::span<std::byte const> b) override;

  void skip(size_t size, bool enable_append = false);

  auto getReadSize() -> size_t { return _read_size; }
  auto getWriteSize() -> size_t { return _write_size; }

  void releaseTail();

  void setCurrent(PageNumber id);
  auto allocate() -> PageNumber;
  void release(PageNumber id);
  auto getAll() -> std::vector<PageNumber> { return readAllocatedPages(); }

private:
  auto toLastPage(PageNumber page) -> PageNumber;

  auto allocatePage() -> PageNumber;

  auto appendPage() -> PageNumber;

  auto readMagicNumber() -> MagicNumber;
  void writeMagicNumber(MagicNumber magic_number);
  auto readFreePage() -> PageNumber;
  void writeFreePage(PageNumber free_page);
  void writeAllocatedPages(std::vector<PageNumber> const& allocated_pages);
  auto readAllocatedPages() -> std::vector<PageNumber>;

  void seekPage(PageNumber page);
  auto readNextPage(PageNumber page) -> PageNumber;
  void writeNextPage(PageNumber page, PageNumber next_page);

  auto getCurrentPageSize() -> size_t { return _file.tellg() % _page_size - sizeof(PageNumber); }
  auto getPageRemainSize() -> size_t { return _page_size - _file.tellg() % _page_size; }
  auto getNowPage() -> PageNumber { return _file.tellg() / _page_size; }

public:
  // 如果读写过程中需要进行其他操作，可以使用snapshot来保存当前读写上下文，然后在析构时恢复
  class PtrRecover {
  public:
    PtrRecover() = default;
    PtrRecover(LinkedFile* file);
    ONLY_MOVEABLE(PtrRecover);
    void recover();
    ~PtrRecover();

  private:
    toy::PtrManager<LinkedFile*> _file;
    std::fstream::pos_type       _pos;
    size_t                       _read_size;
    size_t                       _write_size;
  };
  auto snapshot() -> PtrRecover { return this; }

private:
  FileStream   _stream;
  std::fstream _file;
  size_t       _read_size;
  size_t       _write_size;

  static constexpr MagicNumber _magic_number = 0x20774396;
  static constexpr uint32      _page_size = 1 << 10; // 1024
};

class Guid {
public:
  Guid() = default;
  Guid(std::string const& guid) : _guid(guid) {}
  auto get() const -> std::string const& { return _guid; }
  auto valid() const -> bool { return !_guid.empty(); }
  void clear() { _guid.clear(); }

  static auto generate() -> Guid { return Guid{ generateHex(16) }; }
  friend auto operator==(Guid const& lhs, Guid const& rhs) -> bool {
    return lhs._guid == rhs._guid;
  }

  static void serialize(toy::OutputStream& io, Guid const& guid) { io.write(guid._guid); }
  static auto deserialize(toy::InputStream& io) -> Guid { return Guid{ io.read<std::string>() }; }

private:
  static auto randomChar() -> unsigned char {
    std::random_device              rd;
    std::mt19937                    gen(rd());
    std::uniform_int_distribution<> dis(0, 255);
    return static_cast<unsigned char>(dis(gen));
  }
  static auto generateHex(const unsigned int len) -> std::string {
    std::stringstream ss;
    for (auto i = 0; i < len; i++) {
      auto              rc = randomChar();
      std::stringstream hexstream;
      hexstream << std::hex << int(rc);
      auto hex = hexstream.str();
      ss << (hex.length() < 2 ? '0' + hex : hex);
    }
    return ss.str();
  }
  std::string _guid;
};

struct GuidHasher {
  size_t operator()(const Guid& x) const { return std::hash<std::string>{}(x.get()); }
};

/**
 * @brief
 * 1. 同一个path只能存在一个Package实例，被用户和Asset通过shared_ptr共享
 * 2. Package持有Asset的弱引用，用户需要维护Asset的生命周期
 * 3. 序列化：Asset需要先通过setOwnedPackage(Shared)设置Package，然后调用saveAsset来保存到硬盘中
 *    Asset通过自定义的assetSerialize，通过AssetPackager::pack来序列化需要保存的数据
 *    pack 可以传入std::unique_ptr<Asset>或 std::shared_ptr<Asset>，AssetPackager会自动保存Asset的引用信息，下次反序列化时会自动加载
 *   （注意序列化时默认不会保存引用Asset）
 * 4. 反序列化：通过Package::getAssetShared或Package::getAssetUnique来获取Asset，或者先默认构造一个Asset后调用Package::loadAsset来加载数据
 *    Asset通过自定义的assetDeserialize，通过AssetUnpacker::unpack来反序列化
 *    对于引用的Asset，AssetUnpacker会自动加载引用的Asset
 * 5. Package会自动管理关联到该Package的Asset，从而 1)防止重复加载相同guid的Asset, 2)对于共享所有权的Asset如果已经加载过，再次加载时会自动获取引用
 */

struct Asset;
struct Package;
struct AssetPackager;
struct AssetUnpacker;

class Asset {
  friend Package;
  friend AssetPackager;
  friend AssetUnpacker;

public:
  Asset() = default;
  virtual ~Asset();
  ONLY_MOVEABLE(Asset);
  auto getAssetGuid() -> Guid;
  auto isUnspecifiedAsset() -> bool { return _guid.valid(); }
  auto getOwnedPackage() -> Package* { return _package.get(); }

  void setOwnedPackage(Package* package);
  void resetOwnedPackage();
  /**
   * @brief 如果某Asset有共享所有权并且想要Package管理，可以调用这个函数
   */
  static void setOwnedPackageShared(std::shared_ptr<Asset> shared, Package* package);

  void saveAsset();
  void saveAsset(Package* package);

  auto getAssetName() -> std::string const& { return _name; }
  void setAssetName(std::string name);
  void resetAssetName();

protected:
  virtual void assetSerialize(AssetPackager& packer) = 0;
  virtual void assetDeserialize(AssetUnpacker& unpacker) = 0;

private:
  std::shared_ptr<Package> _package;
  Guid                     _guid;
  std::string              _name;
};

class Package : public std::enable_shared_from_this<Package> {
public:
  static auto get(fs::path const& path) -> std::shared_ptr<Package>;
  UNCOPYABLE_MOVEABLE(Package);

  auto getPath() -> fs::path const& { return _path; }
  auto getAssetShared(Guid const& guid) -> std::shared_ptr<Asset> {
    return getAssetSharedImpl(guid);
  }
  template <std::derived_from<Asset> T>
  auto getAssetShared(Guid const& guid) -> std::shared_ptr<T> {
    return std::dynamic_pointer_cast<T>(getAssetShared(guid));
  }
  auto getAssetShared(std::string const& name) -> std::shared_ptr<Asset> {
    TOY_ASSERT(_meta_info.name2guid.contains(name));
    return getAssetShared(_meta_info.name2guid[name]);
  }
  template <std::derived_from<Asset> T>
  auto getAssetShared(std::string const& name) -> std::shared_ptr<T> {
    return std::dynamic_pointer_cast<T>(getAssetShared(name));
  }
  auto getAssetUnique(Guid const& guid) -> std::unique_ptr<Asset> {
    return getAssetUniqueImpl(guid);
  }
  template <std::derived_from<Asset> T>
  auto getAssetUnique(Guid const& guid) -> std::unique_ptr<T> {
    auto base_ptr = getAssetUnique(guid);
    auto upcast = dynamic_cast<T*>(base_ptr.get());
    TOY_ASSERT(upcast);
    base_ptr.release();
    return std::unique_ptr<T>{ upcast };
  }
  auto getAssetUnique(std::string const& name) -> std::unique_ptr<Asset> {
    TOY_ASSERT(_meta_info.name2guid.contains(name));
    return getAssetUnique(_meta_info.name2guid[name]);
  }
  template <std::derived_from<Asset> T>
  auto getAssetUnique(std::string const& name) -> std::unique_ptr<T> {
    return std::dynamic_pointer_cast<T>(getAssetUnique(name));
  }
  void loadAsset(Asset& asset, Guid const& guid);
  void loadAsset(Asset& asset, std::string const& name);
  auto getAllAssetGuids() { return _meta_info.guid2page | views::keys; }
  auto getAllAssetNames() { return _meta_info.name2guid | views::keys; }

private:
  friend Asset;
  friend AssetPackager;
  friend AssetUnpacker;

private:
  fs::path   _path;
  LinkedFile _file;

  using GuidPageMap = std::unordered_map<Guid, LinkedFile::PageNumber, GuidHasher>;
  using NameGuidMap = std::unordered_map<std::string, Guid>;
  using GuidNameMap = std::unordered_map<Guid, std::string, GuidHasher>;
  struct MetaInfo {
    GuidPageMap guid2page;
    NameGuidMap name2guid;
    GuidNameMap guid2name;
    static void serialize(toy::OutputStream& io, MetaInfo const& t);
    static auto deserialize(toy::InputStream& io) -> MetaInfo;
  };
  MetaInfo _meta_info;

  static inline std::unordered_map<Guid, std::optional<std::weak_ptr<Asset>>, GuidHasher> _assets;
  static inline std::unordered_map<fs::path, Package*>                                    _packages;

  // for avoid multi save in one saveAsset() call
  static inline bool                                 _is_inner_save;
  static inline std::unordered_set<Guid, GuidHasher> _guids_in_this_save;

private:
  Package(fs::path const& path);

  ~Package();

  void saveGuid2Page();

  static void setAssetOwner(
    Asset* asset, Package* owner, std::optional<std::weak_ptr<Asset>> weak = std::nullopt
  );

  static void setAssetOwnerShared(std::shared_ptr<Asset> asset, Package* owner);

  static void resetAssetOwner(Asset* asset);
  static void beforeDestroyAsset(Asset* asset);
  /**
   * @brief 只负责从硬盘中加载asset，不考虑内存中是否已经存在
   */
  void        loadAsset(Guid const& guid, std::function<Asset&(std::string const&)> asset_getter);
  auto        getAssetSharedImpl(Guid const& guid) -> std::shared_ptr<Asset>;
  auto        getAssetUniqueImpl(Guid const& guid) -> std::unique_ptr<Asset>;
  static auto getDefaultAssetShared(std::string const& type_name) -> std::shared_ptr<Asset>;
  static auto getDefaultAssetUnique(std::string const& type_name) -> std::unique_ptr<Asset>;

  /**
   * @param serialize_data : 是否通过用户自定义的Packager序列化asset内部的数据
   */
  static void saveAsset(Asset& asset, bool serialize_data);
};

/**
 * @brief 下面是序列化和反序列化的具体实现，主要涉及AssetRef, AssetPackager, AssetUnpacker,
 * Package::loadAsset, Package::saveAsset
 */

struct AssetRef {
  enum RefType { UNIQUE, SHARED };
  RefType  type;
  Guid     guid;
  fs::path package_path;

  static void serialize(toy::OutputStream& io, AssetRef const& t) {
    io.write(t.type);
    io.write(t.guid);
    io.write(t.package_path.generic_string());
    io.write(123456);
  }
  static auto deserialize(toy::InputStream& io) -> AssetRef {
    auto type = io.read<AssetRef::RefType>();
    auto guid = io.read<Guid>();
    auto path = io.read<std::string>();
    TOY_ASSERT(io.read<int>() == 123456);
    return { type, guid, path };
  }
};

template <typename Arg>
concept isSharedAssetRef = std::convertible_to<Arg, std::shared_ptr<Asset>>;
template <typename Arg>
concept isUniqueAssetRef = std::convertible_to<Arg, std::unique_ptr<Asset>>;
template <typename Arg>
concept isAssetRef = isSharedAssetRef<Arg> || isUniqueAssetRef<Arg>;

struct AssetPackager {
  friend Package;

private:
  template <typename Arg>
    requires isAssetRef<Arg>
  auto packAssetRefImpl(Arg const& ref, bool with_save) {
    constexpr auto ref_type = isUniqueAssetRef<Arg> ? AssetRef::UNIQUE : AssetRef::SHARED;
    auto           asset_ref = AssetRef{ ref_type, ref->getAssetGuid(), "" };
    if (!ref->_package || with_save) {
      auto recover = _package->_file.snapshot();
      if (!ref->_package) {
        if constexpr (ref_type == AssetRef::SHARED) {
          Asset::setOwnedPackageShared(ref, _package);
        } else {
          ref->setOwnedPackage(_package);
        }
      }
      if (with_save) {
        ref->saveAsset();
      }
    }
    asset_ref.package_path = ref->_package->_path;
    _stream->write(asset_ref);
  }
  template <typename Arg>
    requires(!isAssetRef<Arg>)
  auto packDataImpl(Arg const& data) {
    _stream->write(data);
  }

  template <typename... Args>
  auto packImpl(bool with_save, Args const&... data) {
    (
      [&]() {
        _stream->write(std::string{ typeid(Args).name() });
        if constexpr (isAssetRef<Args>) {
          packAssetRefImpl(data, with_save);
        } else {
          packDataImpl(data);
        }
      }(),
      ...
    );
  }

public:
  template <typename... Args>
  auto pack(Args const&... data) {
    packImpl(false, data...);
  }
  /**
   * @brief will call saveAsset() to each ref of assets
   */
  template <typename... Args>
  auto packWithSave(Args const&... data) {
    packImpl(true, data...);
  }

private:
  AssetPackager(Package* package) : _package(package), _stream(&package->_file) {}
  Package*           _package;
  toy::OutputStream* _stream;
};

struct AssetUnpacker {
  friend Package;

private:
  template <typename... Args>
  auto unpackImpl() -> std::tuple<Args...> {
    auto tuple_opt = std::tuple<std::optional<Args>...>{};
    std::apply(
      [&](auto&... opt) {
        (
          [&]() {
            auto type_name = _stream->read<std::string>();
            TOY_ASSERT(type_name == typeid(Args).name(), type_name, typeid(Args).name());
            if constexpr (isAssetRef<Args>) {
              constexpr auto ref_type = std::convertible_to<Args, std::unique_ptr<Asset>>
                                          ? AssetRef::UNIQUE
                                          : AssetRef::SHARED;
              using Element = typename Args::element_type;

              auto asset_ref = _stream->read<AssetRef>();
              TOY_ASSERT(asset_ref.type == ref_type);
              auto package = std::shared_ptr<Package>{}; // default nullptr
              auto recover = LinkedFile::PtrRecover{};
              if (_package->_path == asset_ref.package_path) {
                package = _package->shared_from_this();
              } else {
                package = Package::get(asset_ref.package_path);
              }
              {
                auto recover = _package->_file.snapshot();
                if constexpr (ref_type == AssetRef::UNIQUE) {
                  opt = package->getAssetUnique<Element>(asset_ref.guid);
                } else {
                  opt = package->getAssetShared<Element>(asset_ref.guid);
                }
              }
            } else {
              opt = _stream->read<Args>();
            }
          }(),
          ...
        );
      },
      tuple_opt
    );
    return std::apply(
      [](auto&... opt) -> std::tuple<Args...> { return { std::move(opt.value())... }; }, tuple_opt
    );
  }

public:
  template <typename... Args>
  auto unpacks() -> std::tuple<Args...> {
    return unpackImpl<Args...>();
  }
  template <typename... Args>
  void unpack(Args&... args) {
    std::tie(args...) = unpackImpl<Args...>();
  }
  template <typename Arg>
  auto unpack() -> Arg {
    return std::get<0>(unpackImpl<Arg>());
  }

private:
  AssetUnpacker(Package* package) : _package(package), _stream(&package->_file) {}

  Package*          _package;
  toy::InputStream* _stream;
};

// 每个直接或者间接继承Asset的 non abstract class 都必须同时继承 AssetRegister ，从而实现默认构造函数的注册
template <typename Derived>
using AssetRegister = toy::DefaultConstructorRegister<Derived, Asset>;

// 等价于同时继承Asset和AssetRegister
template <typename Derived>
class AssetWithRegister : public Asset, public AssetRegister<Derived> {
public:
  using Asset::Asset;
};

} // namespace eg