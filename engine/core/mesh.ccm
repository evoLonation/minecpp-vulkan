module;
#include <engine.h>
#include <toy.h>

export module engine.mesh;

import engine.base;
import render;
import toy.persistent;
import engine.asset;
import math;
import std;
import toy;

export namespace eg {

struct MeshData {
  std::vector<glm::vec3> positions;
  std::vector<glm::vec3> normals;
  std::vector<glm::vec2> tex_coords;
  std::vector<uint16>    indices;

  void transform(glm::mat4 const& trans) {
    for (auto& pos : positions) {
      pos = mt::transformDot(trans, pos);
    }
    for (auto& normal : normals) {
      normal = mt::getNormalModel(trans) * normal;
    }
  }
  static auto merge(std::span<MeshData const> meshes) -> MeshData {
    auto ret = MeshData{};
    for (auto& mesh : meshes | views::drop(1)) {
      TOY_ASSERT(meshes.begin()->positions.empty() == mesh.positions.empty());
      TOY_ASSERT(meshes.begin()->normals.empty() == mesh.normals.empty());
      TOY_ASSERT(meshes.begin()->tex_coords.empty() == mesh.tex_coords.empty());
      TOY_ASSERT(meshes.begin()->indices.empty() == mesh.indices.empty());
    }
    for (auto& mesh : meshes) {
      ret.indices.append_range(
        mesh.indices |
        views::transform([delta = ret.positions.size()](auto& i) { return i + delta; })
      );
      ret.positions.append_range(mesh.positions);
      ret.normals.append_range(mesh.normals);
      ret.tex_coords.append_range(mesh.tex_coords);
    }
    return ret;
  }
};

using Vertex = rd::Vertex<glm::vec3, glm::vec3, glm::vec2>;

struct Mesh : public Component, public Asset {
public:
  Mesh() = default;
  Mesh(MeshData const& data) { init(data); }
  void init(MeshData const& data) {
    auto light_vertices = std::vector<Vertex>{};
    for (auto [pos, norm, tex] : views::zip(data.positions, data.normals, data.tex_coords)) {
      light_vertices.push_back({ pos, norm, tex });
    }
    _vertex_buffer = rd::VertexBuffer{ light_vertices, VK_BUFFER_USAGE_TRANSFER_SRC_BIT };
    _index_buffer = rd::IndexBuffer{ data.indices, VK_BUFFER_USAGE_TRANSFER_SRC_BIT };
  }
  auto getData() -> MeshData {
    auto reader = rd::BufferLocalReader{ std::max(_vertex_buffer.size(), _index_buffer.size()) };
    reader.loadBuffer(_vertex_buffer, 0, _vertex_buffer.size());
    auto data = reader.readData(0, _vertex_buffer.size());
    auto ret = MeshData{};
    for (auto& vertex : std::span<Vertex>{ reinterpret_cast<Vertex*>(data.begin().base()),
                                           _vertex_buffer.getVertexNumber() }) {
      auto [position, normal, tex_coord] = vertex.getDataTuple();
      ret.positions.push_back(position);
      ret.normals.push_back(normal);
      ret.tex_coords.push_back(tex_coord);
    }
    reader.loadBuffer(_index_buffer, 0, _index_buffer.size());
    data = reader.readData(0, _index_buffer.size());
    for (auto& index : std::span<uint16>{ reinterpret_cast<uint16*>(data.begin().base()),
                                          _index_buffer.getIndexNumber() }) {
      ret.indices.push_back(index);
    }
    return ret;
  }
  auto getVertexBuffer() -> rd::VertexBuffer& { return _vertex_buffer; }
  auto getIndexBuffer() -> rd::IndexBuffer& { return _index_buffer; }

private:
  rd::VertexBuffer _vertex_buffer;
  rd::IndexBuffer  _index_buffer;

public:
  auto assetSerialize() -> AssetPackager override {
    auto [positions, normals, tex_coords, indices] = getData();
    return { std::tuple{ positions, normals, tex_coords, indices }, Asset::assetSerialize() };
  }
  void assetDeserialize(AssetUnpacker unpacker) override {
    Asset::assetDeserialize(unpacker.extractInherited());
    auto [positions, normals, tex_coords, indices] = unpacker.extract<
      std::vector<glm::vec3>,
      std::vector<glm::vec3>,
      std::vector<glm::vec2>,
      std::vector<uint16>>();
    auto data = MeshData{
      std::move(positions), std::move(normals), std::move(tex_coords), std::move(indices)
    };
    init(data);
  }

private:
  REGISTER_ASSET(Mesh);
};

} // namespace eg
