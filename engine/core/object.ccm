export namespace eg {

class SceneObject : public Node {
public:
  SceneObject() = default;
  ~SceneObject() {
    if (_draw_unit.get()) {
      _draw_unit2object.erase(_draw_unit.get());
    }
  }
  void setDrawUnit(uptr<DrawUnit> draw_unit) {
    if (_draw_unit.get()) {
      _draw_unit2object.erase(_draw_unit.get());
    }
    _draw_unit = std::move(draw_unit);
    setActive(true);
    if (_draw_unit.get()) {
      _draw_unit2object[_draw_unit.get()] = this;
    }
  }
  auto getDrawUnit() -> DrawUnit* { return _draw_unit.get(); }
  void setActive(bool active) {
    if (active) {
      _draw_unit->setActive(&getDrawUnitTransform());
    } else {
      _draw_unit->resetActive();
    }
  }
  auto isSelected() -> bool {
    return _draw_unit.get() && IdPipeline::getInstance().getSelectedDrawUnit() == _draw_unit.get();
  }

  static auto getSelected() -> SceneObject* {
    if (auto iter = _draw_unit2object.find(IdPipeline::getInstance().getSelectedDrawUnit());
        iter != _draw_unit2object.end()) {
      return iter->second;
    }
    return nullptr;
  }

protected:
  virtual auto getDrawUnitTransform() -> glm::mat4 const& { return getTransToWorld().get(); }

private:
  uptr<DrawUnit> _draw_unit;

  static inline std::unordered_map<DrawUnit*, SceneObject*> _draw_unit2object;

public:
  auto assetSerialize() -> AssetPackager override {
    // todo: how to deal with invalid _draw_unit
    return {
      std::tuple{
        AssetRef{ _draw_unit->getMesh().getPtr() },
        AssetRef{ _draw_unit->getTexture().getPtr() },
        _draw_unit->isUpLayer(),
      },
      Node::assetSerialize(),
    };
  }
  void assetDeserialize(AssetUnpacker unpacker) override {
    Node::assetDeserialize(unpacker.extractInherited());
    auto [mesh_ref, texture_ref, up_layer] = unpacker.extract<AssetRef, AssetRef, bool>();
    setDrawUnit(
      std::make_unique<DrawUnit>(mesh_ref.consume<Mesh>(), texture_ref.consume<Texture>(), up_layer)
    );
  }
  REGISTER_ASSET_PATH("scene_object")
};

class FixedDistanceNode : public Node,
                          public ReactorInterface<glm::mat4>,
                          public ReactorInterface<glm::vec3> {
public:
  FixedDistanceNode() {
    _fixed_distance_node = std::make_shared<Node>();
    _fixed_distance_node->attachTo(this);
    _view_pos = &Camera::getInstance().getViewPos();
    _view_pos->addReactor(this);
    getTransToWorld().addReactor(this, true);
  }
  FixedDistanceNode(float distance) : FixedDistanceNode() { setDistance(distance); }
  ~FixedDistanceNode() {
    getTransToWorld().removeReactor(this);
    _view_pos->removeReactor(this);
  }
  void setDistance(float distance) { _distance = distance; }
  auto getDistance() -> float { return _distance; }
  auto getFixedDistanceNode() -> Node& { return *_fixed_distance_node; }

private:
  void observerNotified(glm::mat4 const&) override { computeFixedDistanceTransform(); }
  void observerNotified(glm::vec3 const&) override { computeFixedDistanceTransform(); }
  void computeFixedDistanceTransform() {
    auto  location_object = mt::transformDot(getTransToWorld(), glm::vec3{ 0, 0, 0 });
    auto& location_camera = _view_pos->get();
    auto  new_location_object =
      location_camera + _distance * glm::normalize(location_object - location_camera);
    _fixed_distance_node->getTransToParent() =
      mt::translate(glm::vec3{ new_location_object - location_object });
  }

private:
  ptr<Node>               _fixed_distance_node;
  wptr<Node>              _last_root;
  Reval<glm::vec3> const* _view_pos;
  float                   _distance = 4.0f;
};

} // namespace eg
