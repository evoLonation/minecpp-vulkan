module;
#include <engine.h>
#include <toy.h>

export module engine.object;

import engine.camera;
import engine.asset;
import engine.base;
import framework;
import math;
import render;
import engine.texture;
import engine.mesh;
import engine.node;
import std;
import toy;

export namespace eg {

class SceneObject;

class DrawUnitBase : public Asset {
public:
  DrawUnitBase() = default;
  auto getTransform() -> Reval<glm::mat4> const&;
  auto getSceneObject() -> SceneObject*;
  auto isActive() -> bool { return _scene_object; }

protected:
  friend SceneObject;
  virtual void setActive(SceneObject* scene_object, Reval<glm::mat4> const* transform);
  virtual void resetActive();

private:
  SceneObject*            _scene_object = nullptr;
  Reval<glm::mat4> const* _transform = nullptr;
};

template <std::derived_from<DrawUnitBase> T>
class DrawUnitObservable {
public:
  static void addActivateObserver(toy::Observer<T&>* observer) { _activated.addObserver(observer); }
  static void addDeactivateObserver(toy::Observer<T&>* observer) {
    _deactivated.addObserver(observer);
  }
  static void removeActivateObserver(toy::Observer<T&>* observer) {
    _activated.removeObserver(observer);
  }
  static void removeDeactivateObserver(toy::Observer<T&>* observer) {
    _deactivated.removeObserver(observer);
  }

private:
  template <typename>
  friend class DrawUnit;
  static inline toy::Observable<T&> _activated;
  static inline toy::Observable<T&> _deactivated;
};

template <typename Derived>
class DrawUnit : public DrawUnitBase {
public:
  void setActive(SceneObject* scene_object, Reval<glm::mat4> const* transform) override {
    DrawUnitBase::setActive(scene_object, transform);
    DrawUnitObservable<Derived>::_activated.notify(*static_cast<Derived*>(this));
  }
  void resetActive() override {
    DrawUnitBase::resetActive();
    DrawUnitObservable<Derived>::_deactivated.notify(*static_cast<Derived*>(this));
  }
};

struct MaterialInfo {
  float shininess = 16.0f;
};

class LightUnit : public DrawUnit<LightUnit> {
public:
  LightUnit() = default;
  LightUnit(ptr<Mesh> mesh, ptr<Texture> texture, bool up_layer = false);
  LightUnit(MeshData mesh_data, glm::vec3 color = { 0.7f, 0.2f, 0.5f }, bool up_layer = false);
  void init(ptr<Mesh> mesh, ptr<Texture> texture, bool up_layer = false);
  void init(MeshData mesh_data, glm::vec3 color = { 0.7f, 0.2f, 0.5f }, bool up_layer = false);
  auto getMesh() -> Mesh& { return *_mesh; }
  auto getTexture() -> Texture& { return *_texture; }
  auto getMaterial() -> MaterialInfo& { return _material; }
  auto isUpLayer() -> bool { return _up_layer; }

private:
  ptr<Mesh>    _mesh;
  ptr<Texture> _texture;
  MaterialInfo _material;
  bool         _up_layer = false;

public:
  auto assetSerialize() -> AssetPackager override;
  void assetDeserialize(AssetUnpacker unpacker) override;

  REGISTER_ASSET_ID("light_unit")
};

class SceneObject : public Node {
public:
  SceneObject() = default;
  ~SceneObject() = default;
  void setDrawUnit(uptr<DrawUnitBase> draw_unit);
  auto getDrawUnit() -> DrawUnitBase* { return _draw_unit.get(); }
  template <std::derived_from<DrawUnitBase> T>
  auto getDrawUnit() -> T* {
    return dynamic_cast<T*>(_draw_unit.get());
  }
  void setActive(bool active);
  auto isActive() -> bool;

private:
  uptr<DrawUnitBase> _draw_unit;

public:
  auto assetSerialize() -> AssetPackager override;
  void assetDeserialize(AssetUnpacker unpacker) override;
  REGISTER_ASSET_ID("scene_object")
};

} // namespace eg
