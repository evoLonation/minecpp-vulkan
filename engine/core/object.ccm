export namespace eg {

class SceneObject : public Node {
public:
  SceneObject() = default;
  SceneObject(ptr<Mesh> mesh, ptr<Texture> texture) { init(std::move(mesh), std::move(texture)); }
  void init(ptr<Mesh> mesh, ptr<Texture> texture) {
    auto draw_unit = std::make_unique<DrawUnit>(std::move(mesh), std::move(texture));
    setDrawUnit(std::move(draw_unit));
  }
  ~SceneObject() {
    if (_draw_unit.get()) {
      _draw_unit2object.erase(_draw_unit.get());
    }
  }
  void setDrawUnit(uptr<DrawUnit> draw_unit) {
    if (_draw_unit.get()) {
      _draw_unit2object.erase(_draw_unit.get());
    }
    _draw_unit = std::move(draw_unit);
    if (_draw_unit.get()) {
      _draw_unit2object[_draw_unit.get()] = this;
    }
  }
  auto getDrawUnit() -> DrawUnit* { return _draw_unit.get(); }
  auto isSelected() -> bool {
    return _draw_unit.get() && IdPipeline::getInstance().getSelectedDrawUnit() == _draw_unit.get();
  }

  static auto getSelected() -> SceneObject* {
    if (auto iter = _draw_unit2object.find(IdPipeline::getInstance().getSelectedDrawUnit());
        iter != _draw_unit2object.end()) {
      return iter->second;
    }
    return nullptr;
  }

protected:
  void runLoop(fw::ActionContext const& ctx) override {
    _draw_unit->getTransform() = getTransToWorld();
  }

private:
  uptr<DrawUnit> _draw_unit;

  static inline std::unordered_map<DrawUnit*, SceneObject*> _draw_unit2object;

public:
  auto assetSerialize() -> AssetPackager override {
    // todo: how to deal with invalid _draw_unit
    return {
      std::tuple{
        AssetRef{ _draw_unit->getMesh().getPtr() },
        AssetRef{ _draw_unit->getTexture().getPtr() },
        _draw_unit->isUpLayer(),
      },
      Node::assetSerialize(),
    };
  }
  void assetDeserialize(AssetUnpacker unpacker) override {
    Node::assetDeserialize(unpacker.extractInherited());
    auto [mesh_ref, texture_ref, up_layer] = unpacker.extract<AssetRef, AssetRef, bool>();
    setDrawUnit(
      std::make_unique<DrawUnit>(mesh_ref.consume<Mesh>(), texture_ref.consume<Texture>(), up_layer)
    );
  }
  REGISTER_ASSET_PATH("scene_object")
};

class FixedDistanceComponent : public Component {
public:
  FixedDistanceComponent() = default;
  FixedDistanceComponent(glm::mat4* root_trans, float distance = 4.0f) {
    init(root_trans, distance);
  }
  void init(glm::mat4 const* root_trans, float distance = 4.0f) {
    _root_trans = root_trans;
    _distance = distance;
  }
  auto getFixedDistanceTransform() {
    auto& camera = Camera::getInstance();
    auto  location_object = mt::transformDot(*_root_trans, glm::vec3{ 0, 0, 0 });
    auto  location_camera = camera.getViewPos();
    auto  new_location_object =
      location_camera + _distance * glm::normalize(location_object - location_camera);
    auto transform = mt::translate(glm::vec3{ new_location_object - location_object });
    return transform;
  }
  void setDistance(float distance) { _distance = distance; }
  auto getDistance() -> float { return _distance; }
  void setRootTrans(glm::mat4 const* root_trans) { _root_trans = root_trans; }

private:
  glm::mat4 const* _root_trans;
  float            _distance = 0;
};

class FixedDistanceObject : public SceneObject {
public:
  FixedDistanceObject() { _fixed_distance_component.init(&getTransToWorld()); }
  FixedDistanceObject(ptr<Mesh> mesh, ptr<Texture> texture) : FixedDistanceObject() {
    init(std::move(mesh), std::move(texture));
  }
  using SceneObject::init;
  void setDistance(float distance) { _fixed_distance_component.setDistance(distance); }
  auto getDistance() -> float { return _fixed_distance_component.getDistance(); }

  void runLoop(fw::ActionContext const& ctx) override {
    _fixed_distance_component.setRootTrans(&getRoot().getTransToWorld());
    getDrawUnit()->getTransform() =
      _fixed_distance_component.getFixedDistanceTransform() * getTransToWorld();
    // getDrawUnit()->getTransform() = getTransToWorld();
  }

private:
  FixedDistanceComponent _fixed_distance_component;
};

class ObjectClickObserver : public fw::Action, public PROACTIVE_SINGLETON(ObjectClickObserver) {
public:
  ObjectClickObserver() : fw::Action(fw::Stage::BEFORE_RENDER) {}
  auto getClick() -> SceneObject* { return _clicked.expired() ? nullptr : _clicked.lock().get(); }

private:
  void runLoop(fw::ActionContext const& ctx) override {
    auto& input = fw::InputProcessor::getInstance();
    if (!_clicked.expired()) {
      _clicked = {};
    }
    if (auto state = input.getState(fw::Mouse::LEFT)) {
      if (state->state == fw::ButtonState::DOWN) {
        if (auto selected = SceneObject::getSelected()) {
          _down = selected->getPtr();
        }
      } else if (!_down.expired() && state->state == fw::ButtonState::RELEASE) {
        if (_down.lock().get() == SceneObject::getSelected()) {
          _clicked = _down;
        }
        _down = {};
      }
    }
  }
  wptr<SceneObject> _down;
  wptr<SceneObject> _clicked;
};

} // namespace eg
